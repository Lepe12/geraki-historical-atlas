      "schema:name": "{\"end_char\": 508, \"end_line\": 15, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [339], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 107, \"start_line\": 5}",
      "properties": {

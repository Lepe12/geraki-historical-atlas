    {
      "@id": "urn:nabou:cite_365807f7b7c0ffab53cfae32",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 5563, \"end_line\": 108, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/c3764c1daaad1bdc75f2e271.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [1], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 4859, \"start_line\": 96}",
      "properties": {
        "source_id": "src_3451e4b9f13cdcaa645b7739cf588705",
        "locator": "{\"end_char\": 5563, \"end_line\": 108, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/c3764c1daaad1bdc75f2e271.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [1], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 4859, \"start_line\": 96}",
        "exact_excerpt": "phenotype. We envision to also use crossover which\nis an operation mimics genetic recombination inspired\nby meiosis, where genetic information from two parent\nsolutions is combined to produce offspring solutions with\ndiverse traits. The reason or motivation why we propose\nMarioGA (Evolutionary Algorithm or Genetic Algorithm)\nis because of the complexity of the problem to be solved.\nSince in this COP, we do not have much options to tailor\nor handcraft, which makes it impossible to try out all\npossible combinations of the game configurations to be\nused. Since, EAs or GAs are proven to be robust in such\ncases to provide near-optimal or optimal solutions as given\nexamples in [eiben2015introduction].",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_53af7dfa12ffddf382c73651",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 5563, \"end_line\": 108, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/c3764c1daaad1bdc75f2e271.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [1], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 4859, \"start_line\": 96}",
      "properties": {
        "source_id": "src_f3934158345bcdc5aa4cb3c98787770e",
        "locator": "{\"end_char\": 5563, \"end_line\": 108, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/c3764c1daaad1bdc75f2e271.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [1], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 4859, \"start_line\": 96}",
        "exact_excerpt": "phenotype. We envision to also use crossover which\nis an operation mimics genetic recombination inspired\nby meiosis, where genetic information from two parent\nsolutions is combined to produce offspring solutions with\ndiverse traits. The reason or motivation why we propose\nMarioGA (Evolutionary Algorithm or Genetic Algorithm)\nis because of the complexity of the problem to be solved.\nSince in this COP, we do not have much options to tailor\nor handcraft, which makes it impossible to try out all\npossible combinations of the game configurations to be\nused. Since, EAs or GAs are proven to be robust in such\ncases to provide near-optimal or optimal solutions as given\nexamples in [eiben2015introduction].",
        "attribution": "stated"
      },
      "historically_verified": false
    },

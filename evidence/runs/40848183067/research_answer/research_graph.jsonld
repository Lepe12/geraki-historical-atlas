    {
      "@id": "urn:nabou:cite_a75d6e2182dc92c841335cc5",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 7398, \"end_line\": 185, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/c3764c1daaad1bdc75f2e271.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [1], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 6920, \"start_line\": 177}",
      "properties": {
        "source_id": "src_3451e4b9f13cdcaa645b7739cf588705",
        "locator": "{\"end_char\": 7398, \"end_line\": 185, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/c3764c1daaad1bdc75f2e271.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [1], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 6920, \"start_line\": 177}",
        "exact_excerpt": " A standard MarioGA approach\nis inspired from nature or natural evolution such that\nwe have an environment (SMB) which is filled with\ncandidate solutions (population) that strive for survival\nand their reproduction (crossover) where their quality\n(fitness) is determined by environment which provides a\ncriteria whether they (elites) or their children (crossover\nand mutation) are going to grow in the environment which\nare fighting for resources (as metaphor) most effectively.",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_8c4c97da3de55ddd827b1247",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 7398, \"end_line\": 185, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/c3764c1daaad1bdc75f2e271.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [1], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 6920, \"start_line\": 177}",
      "properties": {
        "source_id": "src_f3934158345bcdc5aa4cb3c98787770e",
        "locator": "{\"end_char\": 7398, \"end_line\": 185, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/c3764c1daaad1bdc75f2e271.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [1], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 6920, \"start_line\": 177}",
        "exact_excerpt": " A standard MarioGA approach\nis inspired from nature or natural evolution such that\nwe have an environment (SMB) which is filled with\ncandidate solutions (population) that strive for survival\nand their reproduction (crossover) where their quality\n(fitness) is determined by environment which provides a\ncriteria whether they (elites) or their children (crossover\nand mutation) are going to grow in the environment which\nare fighting for resources (as metaphor) most effectively.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

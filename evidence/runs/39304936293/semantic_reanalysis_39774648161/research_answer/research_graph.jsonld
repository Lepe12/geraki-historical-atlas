    {
      "@id": "urn:nabou:att_45a14b21e786a9dc9ed95f41%3Asnapshot%3A3b39c2d55d28efc70692",
      "@type": "Attestation",
      "schema:name": "The source mentions the existence of an anchorage named 'Port Couvelier' associated with Creveliers, as noted in Joseph Roux's portolan chart of Astypalaia.",
      "properties": {
        "attestation_id": "att_45a14b21e786a9dc9ed95f41",
        "status": "UNREVIEWED",

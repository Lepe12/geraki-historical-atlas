        "model_review": {
          "decision": "SUPPORTED_ATTRIBUTION",
          "flag": null,
          "historical_verification": false
        }
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_610e9b4c28150da2496da429",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 1240, \"end_line\": 14, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"greek/library_acquisition/18f781280144b88f0b78dfa5.pdf\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 997, \"start_line\": 12}",
      "properties": {
        "source_id": "src_3a9030fe7ccc34d4bc4b4c8579698899",
        "locator": "{\"end_char\": 1240, \"end_line\": 14, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"greek/library_acquisition/18f781280144b88f0b78dfa5.pdf\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 997, \"start_line\": 12}",
        "exact_excerpt": "\nAt the same time, Astypalaia was an excellent hideout for corsairs, not only because they could ﬁnd provisions there (such as bread, wine, etc.) and stock up with drinking water, but also because the island provided\nplenty of safe anchorages.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

    {
      "@id": "urn:nabou:att_f52ec72e2b32c91648c86ddf%3Asnapshot%3Ab860def6adf99485cfd9",
      "@type": "Attestation",
      "schema:name": "Astypalaia provided safe anchorages and provisions for corsairs, making it an excellent hideout.",
      "properties": {
        "attestation_id": "att_f52ec72e2b32c91648c86ddf",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",

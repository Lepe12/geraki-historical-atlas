    {
      "@id": "urn:nabou:cite_46cc614e69767db361022e87",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 495, \"end_line\": 9, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/18f781280144b88f0b78dfa5.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 10, \"start_line\": 3}",
      "properties": {
        "source_id": "src_9b47c0d72552edf54b85f1a1950c2c85",
        "locator": "{\"end_char\": 495, \"end_line\": 9, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/18f781280144b88f0b78dfa5.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 10, \"start_line\": 3}",
        "exact_excerpt": "Occasioned by the death of Creveliers oﬀ Astypalaia:\nThe island’s role in the raids by Catholic corsairs during the 17th century\nGiorgos Koutzakiotis\nBetween shortly before midnight of the 24th and early morning of the 25th of September 1679, the life of\nFrench corsair Hugues Creveliers, leader of the most important corsair company active in the Aegean sea\nin the 1670s, came to an inglorious end oﬀ the coast of Astypalaia, due to the blowing up of his ship by a\nmember of his crew.",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_2652d7728077e2a6e4302571",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 495, \"end_line\": 9, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/18f781280144b88f0b78dfa5.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 10, \"start_line\": 3}",
      "properties": {
        "source_id": "src_094f4678b81d03c3999bd97987e1db65",
        "locator": "{\"end_char\": 495, \"end_line\": 9, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/18f781280144b88f0b78dfa5.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 10, \"start_line\": 3}",
        "exact_excerpt": "Occasioned by the death of Creveliers oﬀ Astypalaia:\nThe island’s role in the raids by Catholic corsairs during the 17th century\nGiorgos Koutzakiotis\nBetween shortly before midnight of the 24th and early morning of the 25th of September 1679, the life of\nFrench corsair Hugues Creveliers, leader of the most important corsair company active in the Aegean sea\nin the 1670s, came to an inglorious end oﬀ the coast of Astypalaia, due to the blowing up of his ship by a\nmember of his crew.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Jan Jansz began his career, as did most of \nthe Dutch seafaring men who ultimately turned \npirates, as a privateer of the States against the \nSpaniards during the War of Liberation. But this \nquasi-lawful type of warfare yielded more glory \nthan profit, and Jansz presently trespassed on \nhis commission and found his way to the \nBarbary coast. There he waged war on the ships \nof all Christian nations alike, those of Holland \nnot excepted, save that when he attacked a \nSpaniard he flew the standard of the Prince of \nOrange as a tribute of sentiment to his origin. \nWhen occupied against any other nation’s ship- \nping he flew the red half-moon of the Turks. \n(Gosse, 54-5)28",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 143329,
          "end_char": 144007,
          "start_line": 3619,
          "end_line": 3633,
          "printed_page": null,
          "scan_indexes_0_based": [],

      {
        "finding_id": "section-3958de265cb008964f90",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "There  is  very  little  doubt  that  critics  will  point \nout  that  the  corsairs  were  by  no  means  universally \nsuccessful ;  that,  as  in  the  case  of  the  attack  by \nHassem,  the  ruler  of  Algiers  in  1563,  on  Oran  and \nMarzaquivir  (a  small  port  in  the  immediate  vicinity \nof  Oran),  in  the  end  the  Moslems  were  badly  beaten.",
        "years_in_scope": [
          1563
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-85cdf325f9838c1e2643",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "to  furnish  him  with  a  ship  fitted  for  that  guerre  de \ncourse,  which  he  desired  to  pursue  against  the  Chris- \ntians. The  value  of  the  corsair  as  an  auxiliary  was \nbeginning  to  be  recognised  among  the  high  Turkish \nofficials.  For  the  complaisance  of  Khorkud  there \nwere  two  reasons :  in  the  first  place,  he  was  acting \nin  the  interests  of  his  brother  in  sending  to  sea \nany  really  capable  man  to  make  head  against  his \nenemies,  and  the  fact  that  Uruj  was  a  pirate  pure \nand  simple  did  not  weigh  for  a  feather  in  the \nbalance ;  in  the  second  place,  it  was  a  decidedly \ngood  mercantile  speculation,  as  he  ordered  his  in- \nferior, the  Basha  of  Egypt,  to  bear  the  expense  of \nfitting  out  the  necessary  ship — which  came  to  some \n5,000  ducats — and  doubtless  received  a  handsome \npercentage  on  all  captures  from  his  grateful  pro- \ntege.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

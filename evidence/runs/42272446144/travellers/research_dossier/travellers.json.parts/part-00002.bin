      {
        "finding_id": "section-0773195ab50c8fb3591a",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "It  cannot  be  denied  that,  in  acting  as  he  did, \nthe  corsair  displayed  a  self-restraint  and  a  loyalty \nto  the  Sultan  hardly  to  be  expected  in  the  circum- \nstances. The  jealousy  which  so  often  obtains \namong  rival  commanders  was  singularly  in  evi- \ndence in  the  forces  of  the  Padishah :  Dragut  had \ngood  cause  to  be  dissatisfied  with  the  dispositions \nwhich  had  been  made,  and  yet,  for  the  reasons \nwhich  we  have  quoted,  he  allowed  them  to  proceed. \nBefore  the  Basha  had  left  Tripoli  he  had  been",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

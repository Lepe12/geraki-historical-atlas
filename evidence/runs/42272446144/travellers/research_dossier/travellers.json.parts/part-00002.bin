        "verified": false
      },
      {
        "finding_id": "section-e294396a5f4bfe0d3eb9",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Europeans assumed that the apostates were human \nscum, and believed that their motives for conversion were \nthe lowest imaginable: greed, resentment, revenge. Many of \nthem were already “pirates” when they converted —obvious- \nly they simply wanted an excuse for more piracy. Of course, \nsome of them were captured and offered a choice of conver- \nsion or slavery. But like cowards, they chose apostasy and \ncrime.3 Renegadoes were slain on sight in all European \ncountries and burnt to death in Spain (at least in theory), \neven if they wanted to re-convert. In this sense Islam was \nseen as a kind of moral plague, rather than simply an enemy \nideology.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 10933,
          "end_char": 11588,
          "start_line": 401,
          "end_line": 412,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

        "verified": false
      },
      {
        "finding_id": "section-a9b8a6c0a025d7b717c8",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Danser came to Algiers from Marseilles, \nwhere he had established residence, married, \nand engaged in the ship-building trade. It is \nnot clear what caused him to turn renegade \nand undertake a corsair career, but within \nthree years of his arrival he had become the \ntaiffe’s leading reis and had acquired the sur- \nname of Deli-Reis, “Captain Devil,” for his \naudacious exploits. Using captured prizes as \nmodels, Danser taught his fellow captains the \nmanagement and navigation of round ships \nequipped with high decks, banks of sails, and \ncannon. He personally accounted for forty \nprizes, which were incorporated into the cor- \nsair fleet, and from Danser’s time onward the \nAlgerians replenished their losses equally from \ncaptured ships and from their own shipyard.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

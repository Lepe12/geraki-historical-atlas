      {
        "finding_id": "section-808b5b66d35362b83a3a",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "He was an Italian, some say a Venetian, \nnamed Piccinio, who arrived in Algiers in com- \nmand of a pirate ship that he had sailed from \nthe Adriatic; he converted to Islam and quick- \nly rose to prominence in the taiffe through his \ndaring and bravery. His prizes made him rich, \nand he reinvested in new corsair vessels until \nhis own flotilla earned him the title of admiral \nof Algiers. He owned two palaces in the city, a \nvilla in the suburbs, several thousand slaves, \njewels, plate, and great wealth in merchandise. \nHe built a sumptuous public bath and a great \nmosque in Algiers as a gift to the city. He had \nhis own bodyguard of footmen as well as cav- \nalry, recruited mostly from the Koukou tribes- \nmen whose sultan became his father-in-law. In \nthe 1630's the redemptionist fathers writing \nfrom Algiers looked to him rather than the \npasha as the real ruler of the city. Francis",
        "years_in_scope": [
          1630
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

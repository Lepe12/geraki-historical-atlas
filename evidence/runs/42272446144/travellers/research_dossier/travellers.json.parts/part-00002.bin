      {
        "finding_id": "section-c2259f6268c1bef22dcd",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "There  was  nothing  remarkable  in  the  fact  that \nthe  corsairs  were  frequently  defeated ;  what  is \nreally  strange  is  that  they  should  have  achieved \nso  great  a  success  —  success  vouched  for  by \nthe  concrete  instance  that  they  established  those \nsinister  dynasties  on  the  coast  of  Northern \nAfrica  which  were  the  outcome  of  their  piratical \nactivities.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

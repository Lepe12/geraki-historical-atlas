      {
        "finding_id": "section-4a9099a0bcc17f8b2fbd",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "the  fortunes  of  those  two  great  sea-captains,  Andrea \nDoria  and  Kheyr-ed-Din  Barbarossa.  With  them \nthe  ebb  and  flow  of  conquest  and  defeat  alternated. \nGreat  as  was  the  one,  it  cannot  be  said  that  he  was \ngreater  than  the  other ;  but  when  the  supreme \narbitrament  was  within  the  grasp  of  both,  as  it \nwas  at  the  naval  battle  of  Prevesa,  neither  the \nChristian  admiral  nor  the  Moslem  corsair  would \nreach  out  his  hand  and  grasp  the  nettle  of  his  fate. \nHesitation  at  this  moment,  when,  in  the  fulness  of \ntime,  the  rivals  stood  face  to  face  with  arms  in \ntheir  hands,  was  the  last  thing  that  would  have  been \nexpected  of  such  dauntless  warriors,  such  born \nleaders  of  men  !  and  the  battle  of  Prevesa  presents \na  psychological  problem  of  the  most  baffling  and \nperplexing  description.  We  are,  however,  antici- \npating events  which  will  fall  into  their  proper \nsequence  as  we  proceed.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-a120446cc481adb6c767",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "THE  DEATH  OF  URUJ  BARBAROSSA.  73 \nreinforcements  sent  by  Selim,  their  depredations \nassumed  ever  larger  proportions,  and,  had  they \ncontinued  to  receive  this  assistance,  the  course  of \nhistory  itself  might  have  been  changed.  Ground \nto  powder  beneath  the  iron  heel  of  their  ruthless \nconquerors,  the  Moriscoes  of  Southern  Spain  were \never  waiting  the  chance  to  rise  and  shake  off  the \nyoke  by  which  they  were  so  sore  oppressed ;  from \nfar  and  near  reports  were  coming  to  hand  of  the \ncontinued  successes  of  the  corsairs,  and  all  Anda- \nlusia seethed  with  passionate  hope  that  the  day  of \ndeliverance  was  at  hand.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

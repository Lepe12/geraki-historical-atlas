      {
        "finding_id": "section-47796737ec2ab5e25927",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "The new English plantation at Baltimore \nseems to have flourished. King James, embar- \nrassed by the complaints of foreign merchants, \ninsisted on steps being taken to suppress the \npirates of south-west Ireland. Once in a while \na royal man-o-war sailed along the coast. But \nthe royal ships were ususally old and badly \nmaintained. The pirates, whose necks depend- \ned on their agility, used small Dutch-built war- \nships which, when regularly defouled, were \nthe swiftest sailors afloat. They seldom allowed \nthemselves to be caught by the royal ships, and \nif caught, they often seem to have managed to \ncome to an understanding with their captors. \nMany pirates were operating but very few \nwere hanged. The Dutch obtained King \nJames's permission to search the creeks and \nharbours of south-west Ireland for pirates, but \nwhen they appeared off Baltimore and asked \nfor a pilot to bring them into the harbour, \nThomas Crooke told them to be off. This \nwould seem to be a very high line to take with \nthe commander of a Dutch squadron operat- \ning with royal permission; but Thomas Crooke \nmust have known what he was doing because \nhe continued to prosper. It is only possible to",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 172032,
          "end_char": 173217,
          "start_line": 4373,
          "end_line": 4398,
          "printed_page": null,

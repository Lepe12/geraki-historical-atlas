      {
        "finding_id": "section-38ef04998387acafed9d",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Selim,  desired  nothing  better  than  to  become  the \nvassal  of  the  Commander  of  the  Faithful.  Also, \nhe  informed  him,  that  in  the  name  of  Selim  public \nprayer  was  offered  in  the  mosques  on  Fridays,  that \nhis  image  and  superscription  were  struck  on  the \ncoins,  that  in  every  manner  possible  recognition \nwas  made  of  the  fact  that  he,  and  he  alone,  was \nthe  chosen  of  God  upon  earth.  This  manner  of \nstating  the  situation  was  both  delicate  and  politic. \nA  less  wise  man  than  Kheyr-ed-Din  might  have \nassumed  a  note  of  equality  from  one  Moslem  po- \ntentate to  another,  but  the  corsair  was  perfectly \nconscious  of  his  limitations — he  knew  exactly  how \nthe  Grand  Turk  could  be  useful  to  him,  and  he \nwas  not  going  to  mar  his  chance  by  the  display \nof  an  untimely  arrogance.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

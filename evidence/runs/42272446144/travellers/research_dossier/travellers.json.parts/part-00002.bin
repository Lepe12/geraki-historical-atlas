      {
        "finding_id": "section-e70f2917fc657e315017",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "But  if  the  sun  of  European  progress  was  slowly \nand  painfully  struggling  through  the  clouds,  the \nlight  which  had  shone  brightly  for  over  seven  cen- \nturies of  Moslem  advance  was  certainly  and  surely \ndying.  Beneath  the  mail-clad  heel  of  the  Christian \nwarrior  the  torch  of  learning  which  had  burned  so \nbrightly  in  Cordova  and  Granada  had  been  extin- \nguished and  ground  into  the  dust,  and  the  descendants \nof  the  alumni  of  those  universities  were  seeking  their \nbread  in  the  Mediterranean  Sea  in  the  guise  of  blood- \nthirsty and  desperate  pirates.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-e838c7cfe83db58e7d99",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Barbarossa  had  succeeded  in  assembling  122 \nships.  He  was  accompanied  by  all  the  most  famous \ncorsairs  of  the  day,  among  whom  was  Dragut, \nwho  fell  at  the  siege  of  Malta,  and  of  whom  we \nshall  have  more  to  say  in  due  time.  Far  and  wide \nranged  the  swift  galleys  of  the  Ottoman  fleet,  for \nthe  plan  of  the  commander  of  the  Moslems  was \nto  locate  and  destroy  his  enemies  in  detail  if  possible. \nAt  last  news  came  to  him  that  Grimani's  ships  had \nbeen  sighted  in  the  Gulf  of  Arta.  Not  one  moment \ndid  he  lose  ;  he  would  fall  upon  the  Papal  contingent \nwith  his  whole  force  and  destroy  it  utterly.  Such, \nat  least,  was  his  plan  when  he  sailed  for  Prevesa ; \nbut,  notwithstanding  his  haste,  he  was  too  late. \nHappily  for  himself,  Grimani  had  returned  to  Corfu \nbefore  the  arrival  of  his  enemy.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/seawolvesofmedit00curruoft",
          "source_file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
          "start_char": 362394,
          "end_char": 363311,
          "start_line": 7639,

        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "23. In effect, Mamora had functioned as a pirate republic under the \ninspired leadership of Captain Henry Mainwaring. This \nEnglishman apparently never converted to Islam, which suggests \nthat turning Turke was still a voluntary act, and one which he chose \nnot to perform, despite his strong connection with Barbary. He later \ncrowned a hugely successful career by “taking the pardon” and \nretiring to England, where he wrote an important treatise on navi- \ngation and lived like a gentleman. He also wrote a treatise on how \nto suppress piracy — don't offer any pardons, Mainwaring advised.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 119826,
          "end_char": 120418,
          "start_line": 3059,
          "end_line": 3067,
          "printed_page": null,
          "scan_indexes_0_based": [],

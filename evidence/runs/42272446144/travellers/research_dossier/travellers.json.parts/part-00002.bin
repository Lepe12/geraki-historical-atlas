      {
        "finding_id": "section-69a0eccf17b966e08ffa",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "One  of  Yusuf 's  first  acts  was  the  conclusion  of  the \ntreaty  with  the  United  States.  This  was  procured  at \nfar  less  expenditure,  to  the  United  States,  of  time, \ntrouble,  and  money,  than  the  treaties  with  Algiers  and \nTunis.  The  pasha  seems  soon  to  have  come  to  appre- \nciate this  fact  and  to  realize  that  he  had  not  made  as \ngood  a  bargain  as  his  fellow  pirates.  Accordingly, \nafter  a  few  months  of  apparent  contentment  following \nthe  settlement  with  Consul  Cathcart  in  the  spring  of \n1799,2  }jg  became  dissatisfied,  and  not  less  so  as  he \nviewed  the  growing  and  unprotected  American  com- \nmerce in  the  Mediterranean.  Under  the  circumstances \nthe  temptation  to  break  the  peace  was  doubtless  strong \n*  Qreenhow,  pp.  11,  12.  *  See  above,  p.  67.",
        "years_in_scope": [
          1799
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

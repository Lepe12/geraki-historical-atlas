      {
        "finding_id": "section-5c0433aaf7cfc6e5e0a8",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Simon Danser, the “Old Dancer” or “Diablo” Reis, was \nthe famous corsair who (according to legend, at least) first \ntaught the North Africans to abandon their outmoded \nMediterranean rowed galleys with lateen rigs and take up \nsailing in “round ships”, i.e. European-style fore-and-aft- \nrigged vessels (like the caravel, made famous by Columbus). \nDanser and his comrade Captain Ward (who will re-appear \nlater) achieved enough fame to appear as characters in",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 65437,
          "end_char": 65897,
          "start_line": 1661,
          "end_line": 1668,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false

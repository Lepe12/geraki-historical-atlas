      {
        "finding_id": "section-953157802fc15be7f5e4",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "78  THE  DEATH  OF  URUJ  BARBAROSSA. \nindependent  corsair  within  easy  striking  distance \nof  the  Balearic  Islands  and  the  coast  of  Spain,  his \nfollowing  composed  of  a  horde  of  those  broken \nmen  of  whom  mention  has  been  made.  Shershell \nwas  an  unfortified  town,  and  surrendered  uncon- \nditionally upon  the  arrival  of  Uruj  and  his  army. \nKara-Hassan,  for  such  was  the  name  of  this  inde- \npendent corsair,  came  out  to  greet  his  old-time \nchief ;  he  was  met  with  violent  reproaches,  and \nthe  altercation  ended  by  Uruj  having  him  be- \nheaded on  the  spot.  It  was  ill  to  quarrel  with  the \nBarbarossas.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

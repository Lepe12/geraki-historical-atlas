      {
        "finding_id": "section-47e4c69e62411204bfe6",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "were tempted to move on, to the Carribbean, or to \nMadagascar, where the pirate scene now began to flourish. \nThe later history of Salé does not concern us, nor the later his- \ntory of Barbary in general. With the passing of the Republic \nwe lose sight of our Renegadoes —and so, in the next sections, \nwe will return to the heyday (1614-1660) of the Republic, \nand try to study the Renegadoes themselves, and then the \ndaily life of the converts —now that we've looked at their polit- \nical/military history.",
        "years_in_scope": [
          1614,
          1660
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 137590,
          "end_char": 138099,
          "start_line": 3482,
          "end_line": 3490,
          "printed_page": null,
          "scan_indexes_0_based": [],

      {
        "finding_id": "section-22ea7a046495bff59212",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "In  addition  to  the  fifteen  galleys  which  Kheyr- \ned-Din  picked  up  at  Bona  he  had  in  reserve  at \nAlgiers  some  fifty  others.  Escaping  the  attention \nof  Adan  Centurion  and  John  Doria,  and  the  in- \nfinitely more  formidable  squadron  of  Andrea,  he \nheaded  once  more  for  Algiers,  and  for  a  time \nseems  to  have  remained  quiet,  no  doubt  recuper- \nating from  the  fatigues,  disappointments,  and \nphysical  hardships  which  he  had  so  recently  under- \ngone. He  was  apparently  undisturbed  during  the \nwinter  by  his  Christian  enemies,  and  was  in  con- \nsequence able  to  think  out  his  future  plans  of \ncampaign  and  to  collect  and  put  heart  into  his \nscattered  followers,  who,  in  ones  and  twos,  were \ngradually,  such  of  them  as  were  left,  finding  their \nway  back  to  the  headquarters  of  piracy  and  its  in- \ndomitable chieftain.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

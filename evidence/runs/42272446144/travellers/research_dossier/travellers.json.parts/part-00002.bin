        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "About Sept. last (1608) Ward, being in the \nStraits, met Fisher of Redriffe, bound for \nEngland, and gave him £100 to carry to his \nwife. Others of the company also sent money \nfor wives and friends. Fisher abused his trust. \nOn their next meeting Ward despoiled Fisher's \nship, and being reviled, had Fisher ducked at \nthe yard arm, and killed. The other men to \navoid the like fate joined the pirates.",
        "years_in_scope": [
          1608
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Dungarvan lay to the east of Kinsale. It \nmay therefore have seemed a good idea to \nHackett to persuade the Algerians to move \nwesterly. Baltimore was the first harbour of \nany size west of Kinsale. It also had a reputa- \ntion as a place of refuge for English pirates and \nit might have seemed only just to Hackett to \nencourage dog to eat dog. But probably the \nmajor reason why John Hackett suggested \nBaltimore was that it was a comparatively new \nEnglish Protestant plantation.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",

        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "One of the best accounts of the Corsair Republic was \nwritten by an English “Agent 007” type named John \nHarrison, a precursor of later romantic Islamophile spies like \nSir Richard Burton, T. E. Lawrence, or Gertrude Bell. \nThanks to Harrison, England was the first European nation \nto enter diplomatic relations with the Bou Regreg Republic. \nIn 1627 Harrison's contacts in “Sallie” fed him an enticing bit \nof information —or disinformation:",
        "years_in_scope": [
          1627
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

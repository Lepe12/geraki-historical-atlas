      {
        "finding_id": "section-34f6579a214bc9b7e5fa",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Throughout this study we've used the words corsair and \npirate as if they were synonyms, but this is really not quite \ncorrect. In the strict sense a pirate is a sea-going criminal, \nwhile a corsair operates like a privateer who is granted “letters \nof marque” or a commission by one government to attack the \nshipping of another. A privateer is only a criminal from the \npoint of view of the ships he attacks; from his own point of \nview he’s committing a legitimate act of war. In the case of \nthe corsairs, the situation is complicated by the concept of a \nreligious war which transcends national interests. Algiers, \nTunis, and Tripoli commissioned privateers in the name of \nthe Sublime Porte, which expected the corsairs to honor all \nOttoman treaties, and not to attack ships of nations at peace \nwith Turkey. Several times attempts were made to discipline \ncorsairs who broke this rule; if the attempts were half-heart- \ned and usually unsuccessful, the corsairs—by their own \nlights —were simply obeying a higher power, the demands of \nthe permanent jihad. Brown quotes Moroccan historians to \ndemonstrate the ideological basis of Salé’s actions:",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

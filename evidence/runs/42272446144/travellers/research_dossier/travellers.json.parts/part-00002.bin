      {
        "finding_id": "section-b048e1374ddfc3baa319",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "There  is  nothing  more  curious  in  the  history  of \nthe  corsairs  than  the  perpetual  ups  and  downs  of \ntheir  lives.  Thus  in  the  present  instance  the  ill- \nadvised  attack  of  Uruj  on  Bougie  had  reduced \nthem  to  terrible  straits ;  immediately  afterwards \nthe  action  of  the  Grand  Turk  once  more  set  them \nupon  their  feet  and  enabled  them  to  pursue  an \nunchecked  career  of  devastation.  Aided  by  the",
        "years_in_scope": [],

      {
        "finding_id": "section-dc70ce9e80cf53319b29",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Andalusians served as men-at-arms on corsair vessels, and \nsometimes as spies (since they could pass as Spaniards). In \ntheir city of Rabat lived the international corsair community \nand the European merchants and consuls (on the rue des \nConsuls, still extant), and presumably this is where most of \nthe taverns and whorehouses were to be found as well.24 The \nAndalusians were the least enthusiastic of all three groups \nabout al-Ayyashi and the Holy War, despite their original \nacceptance of him on the basis of a shared hatred of Spain. \nThey resented his authoritarianism, and probably his \nattempts to interfere in their republican politics. Finally in \nexasperation they refused to help him with any further cru- \nsades—whereupon he turned his holy wrath upon them, and \nopened fire on Rabat with his precious cannon (both iron \nand the far-superior bronze variety), mounted on the walls of \nhis forts in Salé.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",

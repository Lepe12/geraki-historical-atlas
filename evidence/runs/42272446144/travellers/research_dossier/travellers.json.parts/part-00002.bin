      {
        "finding_id": "section-11961b4f67ea71f72712",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  theory  of  equality  obtained  among  the \nMediterranean  pirates ;  but  the  Barbarossas,  Dragut, \nand  AH  believed  that,  in  practice,  the  less  in- \nterference there  was  with  their  designs  by  those, \nwhom  Cardinal  Granvelle  denominated  in  a  letter \nto  Philip  II.  as  \"  that  mischievous  animal  the \npeople/'  the  better  it  would  be  for  all  concerned. \nThe  conception  held  of  the  rights  and  duties  of \n\"  the  mischievous  animal  \"  by  these  militant  persons \nwas,  that  it  should  behave  as  did  those  others \nrecorded  of  the  Roman  centurion  in  Holy  Writ :  if \nit  did  not,  and  difficulties  arose,  the  leaders  were \nnot  troubled  with  an  undue  tenderness  either  towards \nthe  individual  or  the  theory.  Of  this  we  shall  see \nexamples  as  we  go  on.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

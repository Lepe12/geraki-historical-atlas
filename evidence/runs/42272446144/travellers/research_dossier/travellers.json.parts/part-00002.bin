          "end_char": 144438,
          "start_line": 2971,
          "end_line": 2976,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false

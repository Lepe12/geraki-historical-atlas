      {
        "finding_id": "section-bf2c94ac2ee6c3ebf4d7",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "the  flagship  of  Reis  Hammida.  Four  hundred  and \nsix  prisoners  were  taken  in  her,  many  of  whom  were \nwounded.  About  thirty  had  been  killed,  most  of \nthem  by  the  Guerriere's  two  broadsides  ;  very  few  of \nher  crew  were  on  deck  during  the  Epervier's  fire.  The \nGuerriere  lost  one  killed  and  three  wounded  by  the \nenemy's  fire,  thi-ee  killed  and  seven  wounded  by  the \nbursting  of  a  gun.  The  Mashuda  was  sent  into  Car- \nthagena  under  convoy  of  the  Macedonian.  Hammida \nwas  a  remarkable  man  and  one  of  the  greatest  of  the \nrace  of  Bai-bary  corsairs.  He  was  a  member  of  a  tribe \nof  Kabyles,  warlike  mountaineers  of  southern  Barbary. \nHe  had  come  to  Algiers  when  a  boy  to  seek  his  fortune \nand,  going  to  sea,  had  risen  from  the  lowest  to  the \nhighest  rank.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

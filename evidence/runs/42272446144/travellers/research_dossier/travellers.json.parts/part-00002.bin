        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  \"  Africans,\"  however,  were  obdurate ;  they \nknew  a  pirate  when  they  saw  him  quite  as  well \nas  any  one  else,  and  they  were  quite  aware  that, \nshould  they  open  their  gates  to  Dragut,  sooner  or  later \nthey  would  have  to  stand  a  siege  from  the  Christian \nforces,  which  was  a  thing  they  by  no  means  desired.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-0cfe2f0e1b5a53d81caa",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "On  May  i6th,  1530,  the  corsairs  once  again \nadvanced  to  the  assault.  By  this  time  the  walls  had \nbeen  battered  until  a  practicable  breach  had  been \nformed,  and  over  this  swarmed  thirteen  hundred  of \nthe  starkest  fighters  of  the  Mediterranean.  In  the \nbreach,  bareheaded,  his  armour  hacked  and  dinted, \nstood  the  undaunted  chieftain  of  the  Spaniards  : \nover  his  head  floated  that  proud  banner  which  had \nnever  cast  its  shadow  on  a  worthier  knight  of  Spain. \nThe  garrison,  worn  to  a  shadow  by  their  hardships \nand  their  hunger,  most  of  them  wounded,  and  all  of \nthem  sore  spent,  were  in  no  case  to  resist  this,  the \nmost  formidable  attack  to  which  they  had  been \nsubjected.  It  was  all  over  in  a  very  short  time,  and \na  dreadful  massacre  ensued.",
        "years_in_scope": [
          1530
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

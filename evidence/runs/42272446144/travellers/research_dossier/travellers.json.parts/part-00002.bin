      {
        "finding_id": "section-3c2d8b1b71898559e1c6",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Jansz, what with prizes taken at sea and \nhis perquisites as Admiral, which included all \ndues for anchorage, pilotage and other harbor \nrevenues, as well as brokerage on stolen goods, \nsoon became an enormously rich man. \nNevertheless he occasionally found the routine \nof business irksome, the pirate in him asserted \nitself and he went off on a cruise. During one \nof these, in November 1622, when he was try- \ning his luck in the English Channel, he ran out \nof provisions and was forced to put in at the \nport of Veere in Holland to replenish his stock. \nIt seemed a risky undertaking, but the Admiral \nof Sallee was a subject of the Emperor of \nMorocco, who had lately made a treaty with",
        "years_in_scope": [
          1622
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

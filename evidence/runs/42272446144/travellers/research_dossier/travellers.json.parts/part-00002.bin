        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Peter Lamborn Wilson focuses on th core \nsairs’ most impressive accomplishment, the \nindependent Pirate Republic of Salé, in \nMorocco, in the 17th century. Corshirs, \nsufis, pederasts, “irresistible” Modrish \nwomen, slaves, adventurers, Irish rebels, \nheretical Jews, British spies, and radical \nworkingclass heroes, all populate a book \nwhich intends to entertain and to make a \npoint about insurrectionary communities.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",

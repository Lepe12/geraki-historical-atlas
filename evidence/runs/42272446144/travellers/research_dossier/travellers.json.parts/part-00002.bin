      {
        "finding_id": "section-941fff3d802d4ef11000",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "“One of those rare books which give historians \nnew ideas to think about. It deals with 17th-cen- \ntury European converts to Islam — usually but \nnot always as'pirates — whose numbers Wilson \nputs ot thousands. His careful analysis of [the] \nrenegadoes, their ideas, and political practice \nleads to o very.tentative suggestion that some \nof them may have links with Rosicrucianism and \nthe 18th-century Enlightenment; they may form \non ‘incipient culture of resistance’ by escapees \nfrom a civilization of economic and sexual mis- \nery... Historians will have to think about this \nbook’s novel theme and pursue its implications.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-81759a664dbfb0435619",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Popes  and  emperors,  kings  and  princes,  found \nthemselves  compelled  to  form  leagues  against  these \nSea-wolves  who  devoured  the  substance  of  their \nsubjects,  and  great  expeditions  were  fitted  out  to \nfight  with  and  destroy  the  corsairs.  Had  Christen- \ndom been  united  no  doubt  the  object  would  have \nbeen  attained ;  but,  as  will  be  seen  at  the  end  of  this \nchapter,  an  \"  Alliance  of  Christian  Princes\"  against \nthe  Turks — which  generic  term  included  the  corsairs \n— was  not  always  used  in  the  manner  best  calculated \nto  injure  those  common  enemies.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Ward's first voyage from his new-found base began in \nOctober 1606. Cara Osman paid one quarter of the costs of \nvictualling the pirate ship, which was the Gift, Ward's old \nman-of-war. The crew was entirely English, except for \ntwelve Turks put aboard by Osman, who paid for their own \nkeep. Ward did not have to wait long for his first prize. On 1 \nNovember, near Corone, he captured the John Baptist, 90 \ntons, a vessel belonging to some London merchants which \nwas employed in the local coasting trade. At this capture the \nGift had as consort a fifty-ton pinnace commanded by \nAnthony Johnson, and it seems reasonable to assume that \nthe two ships had set out from Tunis together.",
        "years_in_scope": [
          1606
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 87985,
          "end_char": 88670,
          "start_line": 2226,
          "end_line": 2237,
          "printed_page": null,
          "scan_indexes_0_based": [],

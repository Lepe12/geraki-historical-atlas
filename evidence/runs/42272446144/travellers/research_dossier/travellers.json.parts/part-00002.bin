      {
        "finding_id": "section-7c8d58fd7b13111d51fe",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "more  famous  of  the  two ;  he  had  already  made \nhimself  some  reputation  in  piratical  circles,  and \nnow  brought  his  cool  judgment  and  wise  counsel \nto  the  assistance  of  that  fiery  fighting  man  his \nelder  brother.  The  first  question  to  be  decided \nwas  that  which  we  have  already  mentioned,  namely, \nthe  disposal  of  spoil  from  prospective  captures, \nand  with  this  end  in  view  the  corsairs  approached \nthe  Sultan  of  Tunis.  This  potentate  made  a  gracious \nresponse  to  their  overtures,  and  wished  them  all \nsuccess  in  their  enterprises.  He  promised  them \nsuccour  and  support  on  the  same  terms  which  Cur- \ntogali  had  obtained,  namely,  one-fifth  of  all  the \nspoil  landed  in  his  dominions.",
        "years_in_scope": [],

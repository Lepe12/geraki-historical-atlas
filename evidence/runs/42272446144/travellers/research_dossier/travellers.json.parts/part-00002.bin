      {
        "finding_id": "section-22abdf804891cd1a331b",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Doria  got  information  that  Dragut  was  at  Monas- \ntir,  information  that  was  perfectly  correct ;  but  by \nthis  time  the  corsair  knew  that  not  only  had  he \nraised  all  Christendom,  but  that  the  admiral  was \non  his  track.  In  consequence,  he  slipped  out  of \nMonastir,  \"  for,\"  ,as  it  is  pithily  put  by  Marmol, \n\"  our  corsair  cared  not  to  be  shut  up  in  so  defence- \nless a  port ;  he  had  good  heels  and  loved  sea- \nroom.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

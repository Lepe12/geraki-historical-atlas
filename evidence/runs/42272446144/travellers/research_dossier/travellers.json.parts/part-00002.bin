      {
        "finding_id": "section-77b6d1f4b6acf832b30e",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "At first he sailed as mate to a famous cor- \nsair called Suleiman Reis, of Algiers, but after \nhis chief’s death in 1619 settled at Sallee. The \nport (“its name stunk in all Christendom”) was \nextremely well situated for the new form of \npiracy, being on the coast of the Atlantic, only \nfifty miles from Gibraltar, where the corsairs \ncould lie in ambush for everything that passed \nthrough the Straits and dash out quickly to \nmeet the East India and Guinea traders. The \nSallee fleet was not large, about eighteen all \ntold, and the individual vessels were small, \nsince a bar in the harbour prevented ships of \ndeep draught entering unless they were first \nunloaded.",
        "years_in_scope": [
          1619
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 144868,
          "end_char": 145538,
          "start_line": 3660,
          "end_line": 3674,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

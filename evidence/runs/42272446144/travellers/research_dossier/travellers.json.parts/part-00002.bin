      {
        "finding_id": "section-a9140e04c73cfc1d3e06",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "As  the  strong  sun  of  a  perfect  May  morning  in \nthe  Mediterranean  leapt  above  the  horizon,  Uruj \nloosed  his  hounds  upon  their  prey ;  the  oars  of \nthe  galleys  churned  the  clear  blue  waters  into \nfoam,  and  the  air  was  filled  with  the  yells  of  the \ncorsairs.  \"Allah!  Allah!\"  and  \"  Barbarossa ! \nBarbarossa  !  \"  they  cried.  It  was  a  war-cry  that  was \ndestined  to  re-echo  over  many  a  conflict,  both  by \nland  and  sea,  in  the  years  that  were  to  come.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-9f5fb7cad494f2217c57",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Personal  pique  and  vanity,  racial  detestation,  and \nreligious  fanaticism  were  in  his  case  all  allied  to- \ngether to  spur  him  on  in  the  chase  of  this  the  last \nof  the  Emperor's  foes ;  but,  search  as  he  might, \nduring  that  summer  Doria  could  never  get  on  to  the \ntrack  of  Dragut.  The  corsairs,  as  we  have  just",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-cbc06521ba061b5c6afe",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "French, English, Dutch, Portuguese, etc. This progressive \nrégime fails to satisfy a few extreme radicals (including Capt. \nTew), who break away to found their own settlement, based \non pure anarchism —no laws, no officers. For a number of \nyears (the Manuscript seems to have been vague about \nchronology) the Pirate Utopia flourished. When it finally fails \nit is not by fault of inner contradictions but of outside aggres- \nsion: a tribe of unfriendly Natives attacks, the settlers put off \nto sea in their ships, and are destroyed by a freak hurricane.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 308046,
          "end_char": 308602,
          "start_line": 7689,
          "end_line": 7697,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",

      {
        "finding_id": "section-bd2247e8c1be6c5cd9a3",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "The most intimate of the Dala'iyya foreign \nrelations was with the Dutch. Lengthy negoti- \nations between ‘Abdulla and the Dutch over \nthe provisions of a treaty signed in 1651, and \nrevised in 1655 and 1659, suggest that the \nDutch conducted an active trade with \nMorocco in the 1650's. A recurring problem in \nthese negotiations arose from the dual charac- \nter of Sala as a centre of trade and a base for \npiracy. The Dutch were ready to recognize the \nright of the Sala corsairs to attack the ships of \ntheir common Christian enemies, the \nSpaniards, while obtaining the promise that \ntheir own ships would not be molested. At the \nsame time they were opposed to the friendly \nrelations which the Sala pirates and the \nDala’iyya chiefs maintained with the rulers of",
        "years_in_scope": [
          1650,
          1651,
          1655,
          1659
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

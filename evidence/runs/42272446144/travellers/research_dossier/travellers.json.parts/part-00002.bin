      {
        "finding_id": "section-05f32e96ef3761e3d48a",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "The official trade carried through \nBaltimore was ludicrously small. According to \none source, only three ship loads of wine \nentered the harbour during 1614 and 1615. The \nunofficial trade must have been considerable. \nCertainly pirates’ goods brought into Ireland \nthrough Baltimore were supplied throughout \nthe province and the president of Munster him- \nself and many other leading citizens of Cork are \nknown to have bought from that source. By \n1608, no more than two years after the estab- \nlishment of the English at Baltimore, Thomas \nCrooke was called before the Privy Council in \nLondon to answer charges of having had deal- \nings with pirates. It was this charge that \nprompted the bishop of Cork’s letter of recom- \nmendation. The Privy Council acquitted him \nwith all honour; how could they do otherwise? \nThere had been revolts before in Munster, in \nwhich English planters had had their throats \ncut. If ambitious, energetic men such as Richard \nBoyle and Thomas Crooke were able to per- \nsuade large parties of Protestant English to go \nand colonise this uncertain area, how could the \nEnglish authorities jeopardize their enterprise \nby being too nice about their trading methods?",
        "years_in_scope": [
          1608,
          1614,
          1615
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

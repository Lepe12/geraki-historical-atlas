        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "There  was  a  sharp  order  repeated  and  passed  on, \nthe  corsairs  drew  back,  and  the  \"  Africans  \"  shouted \nthat  the  triumph  was  theirs ;  but  they  little  knew \nDragut,  the  sea-hawk  who  poised  to  strike  anew. \nA  blazing  beam  dropped  across  the  street,  the \ntownsfolk  shouted  in  insult  and  derision ;  but  the \njoy  which  they  had  experienced  at  seeing  their",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

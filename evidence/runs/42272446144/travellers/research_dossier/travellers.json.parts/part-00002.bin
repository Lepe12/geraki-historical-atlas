      {
        "finding_id": "section-708e5ec577740bd18c9f",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  city  opened  its  gates  once  more,  and  Bar- \nbarossa  entered  in  triumph.  The  corsair  was  as \ngood  as  his  word  to  his  Spanish  captives,  and \nrestored  to  them  their  liberty.  He  went  even \nfurther,  and  was  liberal  in  his  largesse  to  those \nwho  had  fought  so  well  for  him.  If  he  can  be \ncredited  with  such  an  emotion  as  gratitude,  he \nmust  have  felt  it  for  Moncada's  stout  infantrymen, \nas,  had  it  not  been  for  them,  it  would  have  been \nhis  head  and  not  that  of  Venalcadi  which  would \nhave  decorated  the  pole.  The  Spaniards  departed \nto  their  own  country — that  is  to  say,  such  of  them \nas  desired  to  do  so  ;  but  one  Hamet,  a  Biscayan, \ndeclared  that  life  was  so  intolerable  for  a  common \nman  such  as  he  in  his  own  country  that  he  desired \nto  throw  in  his  lot  with  Barbarossa.  Thirty-nine \nothers  followed  his  example,  abjuring  the  Christian \nfaith  and  becoming  renegadoes.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

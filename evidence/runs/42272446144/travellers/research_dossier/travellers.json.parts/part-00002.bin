      {
        "finding_id": "section-9f811a33bacb0d962280",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "One musn't imagine the typical Sallee Rover —or indeed \nany sensible pirate —as lusting for violence, or even as par- \nticularly cruel. The Comte de Castries put it thus: “Rather \nthan chance the glory of combat they preferred their prey \ndisarmed and peaceful.” [Quoted by Coindreau, 1948: 133] \nIt’s an historian’s cliché to say that the 17th century was \n“cruel”, or indeed that any century prior to the 19th or 20th \nwas “cruel”. Once the modernist Euro-American chauvinism \nis stripped from such remarks, we are left with a percetved duf- \nference between “then” and “now”. The modern era has suc-",
        "years_in_scope": [
          1948
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

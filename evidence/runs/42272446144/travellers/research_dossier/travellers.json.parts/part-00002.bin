      },
      {
        "finding_id": "section-979d79edc1a5dafdbf72",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Here then we are given an example not only of heresy as \na means of cultural transfer, but also (and even more inter- \nesting) heresy as a means of social resistance. And it is here \n(as I’ve already implied) that I find the “meaning” of the \nRenegadoes and their lost world. It’s true that this theoria or \n“vision” of the pirates must be suspect as a prolongation of my \nown particular subjectivity—and even as a “Romantic” pro- \nlongation, to be sure. But it’s also true that no subjectivity is \nentirely unique. If I make bold to interpret the Renegadoes’ \nexperience, it’s because in some sense I recognize it. Every \nhistory comprises in some degree a “history of the present” \n(as Foucault says), and perhaps even more so, a history of the \nself. But “every history” is not therefore to be deemed devoid \nof “objectivity” or to be merely subjective and romantic.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 320135,
          "end_char": 321004,
          "start_line": 7936,
          "end_line": 7949,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",

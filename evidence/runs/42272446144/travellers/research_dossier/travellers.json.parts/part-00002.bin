      {
        "finding_id": "section-4277733741be6cba5c02",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "We have speculated that 17th century mariners shared \nmore than the secrets of a craft —they may have shared cer- \ntain clandestine ideas as well: the idea of democracy, for \nexample, or for that matter the idea of spiritual freedom, of \nfreedom from “Christian Civilization” and all its miseries. If \nIslamophiliac notions circulated amongst educated Masons, \nwhy not also amongst a “masonry” of poor mariners? From \nship to ship in whispers a rumor was circulated, a tale of the \nBarbary Coast, where wealth and “Moorish nieces” were to \nbe won by the brave —by those few free spirits bold enough \nto renounce Christianity. If we have no written record of this \n“conspiracy”, we may also ask what documents ever emerge \nfrom an oral and non-literate (sub)culture? We need no texts \nbecause we have proof of conspiracy in the otherwise-inex-",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 319142,
          "end_char": 319984,
          "start_line": 7913,
          "end_line": 7926,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,

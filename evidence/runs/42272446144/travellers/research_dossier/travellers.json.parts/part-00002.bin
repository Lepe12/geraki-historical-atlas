      {
        "finding_id": "section-99b31d141005330eb956",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "We  have  spoken  of  the  two  weapons  held  by \nthe  leaders  of  the  Sea-wolves.  The  first,  as  we \nhave  said,  was  cupidity  ;  the  second  was  fanaticism, \nthe  deadly  religious  hatred  engendered,  not  only  by \nthe  wholesale  expropriation  of  the  Moslem  popula- \ntion, but  also  by  the  persecution  to  which  the \nMoriscoes — as  those  Moslems  were  known  who \nremained  in  Spain — were  subjected  by  their  Chris- \ntian masters.  It  requires  little  imagination  to  see \nhow  these  two  weapons  of  avarice  and  intolerance \ncould  be  made  to  serve  the  purpose  of  those  dom- \ninant spirits  who  rose  to  the  summit  of  the  piratical \nhierarchy.  Not  only  did  they  dazzle  the  imagina- \ntions of  those  who  followed  in  their  train  by  promises \nof  wealth  uncounted,  but  they  added  to  this  the  spe- \ncious argument  that,  in  slaying  and  robbing  the \nChristian  wheresoever  he  was  to  be  found,  the  faith- \nful Moslem  was  performing  the  service  of  God  and  the \nact  most  grateful  to  his  holy  Prophet.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

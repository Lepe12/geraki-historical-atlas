    {
      "candidate_id": "travellers-event-0013",
      "lane": "travellers",
      "source_file": "corsairsoffranc00norm_corsairsoffranc00norm_djvu.txt",
      "source_type": "OCR_CONTEXT",
      "evidence_state": "ACQUIRED",
      "title": "The corsairs of France; with portraits and a map",
      "url": "https://archive.org/details/corsairsoffranc00norm",
      "identifier": null,
      "repository": null,
      "acquired_text_excerpt": "The  biographies  of  Jean  Bart  and  of  Francois \nThurot  have  shown  us  that  the  shipowners  of  Dun- \nkirk were  keenly  alive  to  the  advantages  to  be  gained \nfrom  the  pursuit  of  privateering.  Situated  opposite \nthe  mouth  of  the  Thames,  and  on  the  very  frontiers \nof  Holland,  the  port  is  well  placed  as  a  harbour  of \nrefuge  for  Corsairs,  or  as  a  base  for  their  operations \nagainst  vessels  bound  for  London  or  Antwerp ;  this \naccounts  for  the  fact  that  it  has  ever  been  noted  as \none  of  the  most  successful  privateering  ports  in \nFrance.  \"When  the  year  1793  saw  France  and  England \nonce  more  in  arms,  the  merchants  of  Dunkirk  threw \nthemselves  heart  and  soul  into  the  old  calling.  The \nhatred  of  the  Dunkerquois  towards  the  English  was",
      "text_locator": {
        "url": "https://archive.org/details/corsairsoffranc00norm",
        "source_file": "corsairsoffranc00norm_corsairsoffranc00norm_djvu.txt",

      {
        "finding_id": "section-e45fd93b2b35c8d567c5",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Salé, by contrast with the other Barbary states, \nremained free of Ottoman control or even much influence. A \nclose relation between Algerine and Saletine corsairs (dis- \ncussed below) probably led to same Turkish cultural influ- \nence in Salé. For instance, Salé celebrated a special holiday \nwith the old Turkish custom of a candlelight procession. But \nSalé was at all times either a Moroccan possession or a free \nMoorish-Corsair state, and no “foreigners” ever seized \npower there in the name of an alien government.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 45985,

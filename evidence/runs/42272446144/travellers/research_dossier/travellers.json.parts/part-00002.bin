      {
        "finding_id": "section-6c83122829bfeb3d1d13",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "ed-Din  meant  merely  the  transference  of  his  malign \nactivities  from  one  sphere  to  another — from  the  sea \nto  the  land,  or  from  the  land  to  the  sea.  King  he \ncalled  himself,  and  king  de  facto  he  was  both  in  Algiers \nand  Tunis,  reigning  with  unexampled  cruelty,  a \nprototype  of  those  other  corsair  kings  by  whom  he \nwas  succeeded.  But  the  real  source  of  his  power  lay, \nnot  in  stone  walls  and  fortifications,  nor  in  ill-trained \nlevies  of  African  tribes,  but  in  his  own  genius  for \ncommand  at  sea,  and  the  manner  in  which  he  was \nable  to  inspire  with  his  own  dauntless  and  desperate \nspirit  those  hardy  mariners  who  followed  in  his  train, \nthe  descendants  of  the  \"  Moriscoes \"  who  hailed \nfrom  the  ancient  Moorish  kingdoms  of  Cordoba  and \nGranada.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

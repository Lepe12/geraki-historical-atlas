      },
      {
        "finding_id": "section-9703ef8aea01c90b4a76",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "survived long enough, he’d serve as commander-in-chief or \n“Agha of Two Moons”...for two months. He would then retire \ninto the Divan or Ocak chamber of government with a vote \non all important issues and appointments. All this had noth- \ning to do with “merit”, but was simply a matter of time served. \nThe lowliest Albanian slaveboy or peasant lad from the \nAnatolian outback, and the outcast converted European cap- \ntive sailor, could equally hope one day to participate in gov- \nernment—simply by wtaying alive and serving the “Corsair \nrepublic”, which was the real power-structure within the \nOttoman protectorate. As Pére Dan put it: “The state has \nonly the name of a kingdom since, in effect, they have made \nit into a republic.” No wonder the Ocak never seemed to have \ntrouble recruiting new members. Where else in the world \nwas such “upward mobility” possible?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",

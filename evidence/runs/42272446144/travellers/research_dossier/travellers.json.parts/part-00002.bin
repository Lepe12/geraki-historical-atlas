      {
        "finding_id": "section-c600d2dd595a92b358a9",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Around 1614, when the coastal city of Mamora fell to \nthe Spaniards, a large number of international pirates fled to \nSalé and were welcomed by the Hornacheros and \nAndalusians.23 They formed the nucleus of the Renegado \ncommunity, and settled in Rabat—so actually the “Sallee \nRovers” were Rabat rovers, although both settlements were \ncommonly called Salé, and all three republics were involved \nin the corsair trade. Perhaps one might think of them as \nresembling three clans of Scottish Border Raiders, feuding \nincessantly with each other but teaming up for razzias on \nEngland. Sniping, quarreling, dissention, slurs on honor and \nother pastimes gave way to open civil war from time to time, \nespecially between 1627 and 1641, but nothing was allowed \nto get in the way of business or impede the flow of booty.",
        "years_in_scope": [
          1614,
          1627,
          1641
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

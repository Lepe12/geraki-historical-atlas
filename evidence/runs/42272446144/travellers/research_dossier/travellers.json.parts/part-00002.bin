      },
      {
        "finding_id": "section-5b1db3461455c98543c5",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Defoe himself lived during the last heyday of piracy, and \nmuch of his information derived from interviews with pirates \nimprisoned in London. A great many of his readers would \nhave known a great deal about late 17th and early 18th cen- \ntury piracy, if only from news pamphlets and gallows ballads. \nAs far as I can see, however, no contemporary reader ever \nquestioned the reality of Capt. Mission. Despite the fact that \nDefoe’s two chapters on Mission read like pages out of \nRousseau—or Byron! (neither of whom were yet born) — \nand despite the fact that Libertatia’s politics were in some \nways far more radical than the politics of revolutionary \nAmerica (1776) or France (1793) —or even Russia (1917), \nfor that matter—despite all this, no one in 1728 blew the \nwhistle on “Captain Johnson” or accused him of inventing \nMission’s story out of thin air. The material was believed, \npresumably, because it was ¢nherently believable. Of course \nplenty of people believed in Lemuel Gulliver and Baron \nMunchhausen too; one cannot prove anything on the basis of \npopular belief; nevertheless, Capt. Mission was accepted as a \nfact until 1972.",
        "years_in_scope": [
          1728,
          1776,
          1793,
          1917,
          1972
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 308605,
          "end_char": 309751,
          "start_line": 7699,
          "end_line": 7718,
          "printed_page": null,

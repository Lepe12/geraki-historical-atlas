      {
        "finding_id": "section-15175912a05d18c40f1c",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "There  was  so  much  history  made  at  this  period, \nthe  stage  of  world  politics  was  occupied  by  so \nmany  great,  striking,  and  dazzling  personalities, \nthat  the  Sea-wolves  and  all  they  accomplished \nwere  to  a  great  extent  overshadowed  by  happen- \nings which  the  chroniclers  of  the  time  considered \nto  be  of  greater  importance.  In  this  no  doubt \nthey  were  right  in  the  main ;  but,  in  spite  of  this \nopinion  which  they  held,  we  find  that  time  and \nagain  the  main  stream  of  events  is  ruffled  by  the \nprows  of  the  pirate  galleys.  Such  men  as  the \nBarbarossas,  as  Dragut,  and  Ali  Basha  could  only \nhave  been  suppressed  and  exterminated  had  the \nwhole  might  of  Christendom  been  turned  against \nthem,  for  they  held  in  their  hands  two  weapons, \nthe  keenest  and  most  powerful  with  which  to \nattain  the  objects  which  they  had  in  view.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/seawolvesofmedit00curruoft",

          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "The extent to which the pirates held the \nupper hand may be judged from the fact that \nearly in 1609 Danvers himself was blockaded in \nCork by four sail of pirates carrying some three \nhundred men. The Lord-President could not \nraise even one ship strong enough to defy the \nmarauders, and so in Cork he had to stay, while \nthe unwelcome visitors sailed up and down the \ncoast seeking sustenance. So as to prevent them \nre-victualling in Co. Kerry, the supplies of corn \nwhich were usually exported from Co. Cork \nwere held up, but this seems to have annoyed the \ninhabitants far more than the pirates.",
        "years_in_scope": [
          1609
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

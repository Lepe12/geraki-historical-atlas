      {
        "finding_id": "section-9511f51b08a42a3aadcb",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  offer  was  no  sooner  made  than  accepted, \nand  the  Spanish  veterans,  fresh  and  unwearied, \nthrew  themselves  into  the  heart  of  the  fray.  Shoulder \nto  shoulder  and  blade  to  blade  in  their  disciplined \nvalour,  they  broke  through  all  opposition  ;  they \nfought  for  liberty  as  well  as  life,  to  exchange  the \nnoisome  confinement  of  the  piratical  galley  for  the \nfree  air  of  their  homes  and  their  country.  Soon \nthe  soldiers  of  Venalcadi  turned  and  fled  back  to  the \ncity;  the  day  was  once  again  with  Kheyr-ed-Din.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-085148023607cbe3f891",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "The port was nominally subject to the \nEmperor of Morocco, but shortly after Jansz’s \narrival the Sallentines declared themselves \nindependent and established what was in \neffect a pirate republic, governed by fourteen \nof themselves, with a president who was also \nthe Admiral. The Dutchman was the first to be \nelected, and to show his adopted countrymen \nhow thoroughly he had become one of them- \nselves he married a Moorish woman, though \nhe had left a wife and family at Haarlem. \n[Gosse, p. 55]",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 145541,
          "end_char": 146042,
          "start_line": 3676,
          "end_line": 3687,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

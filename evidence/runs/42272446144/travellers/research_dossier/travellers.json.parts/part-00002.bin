        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "ideal, a few trading posts were opened, and the concept of the \nPirate Utopia was revived. In some cases an individual \nadventurer might “marry the king’s daughter” or in some \nother way insinuate himself into Native society; in other cases \na group of pirates would settle in their own village, near a \nfriendly tribe, and work out their own social arrangements.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-889b1b11102558711d1b",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "It  must  be  remembered  that  the  inhabitants  of \nMehedia  were  by  no  means  enamoured  of  Dragut- \nReis  and  his  piratical  followers :  King  Stork  had \nsucceeded  .  to  King  Log,  the  part  of  the  former \nmonarch  being  taken  by  that  singularly  capable \nand  ferocious  person,  Aisa,  whose  rule  was  far \nfrom  being  to  the  liking  of  the  richer  and  more \nrespectable  portion  of  the  townsfolk.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 132986,
          "end_char": 133755,
          "start_line": 3376,
          "end_line": 3392,
          "printed_page": null,

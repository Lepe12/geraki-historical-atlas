        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "\"  My  ambition/'  said  the  silver-tongued  corsair, \n\"is  to  become  a  citizen  of  your  great  and  beautiful \ncity.  If  you  will  admit  me  to  its  privileges  it  shall \nbe  my  business  to  render  you  the  richest  people  in \nthe  whole  Mediterranean,  and  your  city  the  most \ndreaded  place  in  the  world\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

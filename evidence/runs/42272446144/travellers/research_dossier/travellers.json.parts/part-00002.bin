        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Pirates, apostates, traitors, degenerates, heretics —what \npositive meaning could possibly be expected to emerge from \nsuch a dire combination? Must we simply confess to a fasci- \nnation with the perverse? After all, this constitutes the real \nmotive of the piratologist, despite all protestations of shocked \nmoral outrage, does it not? Not to mention the heresologist!",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-c1fd9c28338085c6df76",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "In  the  years  succeeding  to  the  conquest  of  Granada \nthe  corsairs  became  the  scourge  of  the  Mediterranean. \nFrance,  Spain,  Genoa,  Venice,  were  all  at  odds  with \nthem ;  as  the  trading  vessels,  which  had  hitherto \npassed  to  and  fro  unmolested,  were  now  captured, \nhaled  into  North  African  ports,  their  cargoes  sold, \nand  their  hapless  crews  forced  to  labour,  naked  and \nchained  to  the  benches  of  the  pirate  galleys,  until \ndeath  came  and  mercifully  put  an  end  to  their \nsufferings.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

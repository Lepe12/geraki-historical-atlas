      {
        "finding_id": "section-f9aeb5a87abafb171bba",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "This  period  has  been  called  \"  The  Grand  Period \nof  the  Moslem  Corsairs  \"  because  it  was  in  some- \nthing less  than  a  century,  from  the  year  of  the \nexpulsion  of  the  Moors  from  Granada  in  1492  to  the \ndeath  of  AH  Basha  in  1580,  that  the  Sea- wolves \nwere  at  the  height  of  their  power,  that  the  piratical \nStates  of  the  Mediterranean  w,ere  in  the  making. \nThat  subsequently  they  gave  great  cause  of  trou  le \nto  Christendom  is  written  in  characters  of  blood  and \nfire  throughout  the  history  of  the  succeeding  centuries ; \nbut  the  real  interest  in  the  careers  of  these  men \nresides  in  the  fact  that  they  established,  by  their",
        "years_in_scope": [
          1492,
          1580
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-0ec2e04bc442753a0b53",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "fathers,  even  as  in  another  three  hundred  years  our \ndescendants  will  be  able  to  point  the  finger  of  scorn \nat  the  mistakes  which  we  are  now  committing. \nWe  have  seen  how  it  was  that  the  pirate  States \narose  ;  we  have  seen  also  how,  in  future  generations, \nthey  were  allowed  to  abide.  We  cannot,  in  common \nhonesty,  echo  the  words  already  quoted  of  the  his- \ntorian that  \"  these  are  the  judgments  of  God,  and \nthings  ordered  by  His  divine  providence  and  infinite \nwisdom,\"  neither  can  we  acquit  the  heirs  of  the  ages \nfor  that  slackness  which  prevented  them  from  doing \ntheir  duty  ;  we  have,  however,  to  ask  ourselves  this \nquestion,  that,  had  it  fallen  to  our  own  lot  to  deal \nwith  the  problem  of  the  extermination  of  the  pirates, \nshould  we  have  done  better  ?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-5e8595f221a83ca1d0d3",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "It seems possible, and in fact is assumed by some writers \n(e.g. Pirate Harbors), that after Crooke’s death the people of \nBaltimore decided to go straight. Their pilchard fisheries \nwere proving remarkably profitable, and the authorities were \nslowly increasing their control over the “lawless” regions. We \nmay hypothesize that in 1624 the leaders of Baltimore made \nit known on the pirate grapevine that the days of hospitality \nwere over, and the port closed to all illegality save a bit of \nharmless smuggling.",
        "years_in_scope": [
          1624
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

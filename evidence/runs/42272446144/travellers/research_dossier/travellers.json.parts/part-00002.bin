      },
      {
        "finding_id": "section-92f729a0b829d23ab3a1",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "The 17th century knew no such thing as a secular ideol- \nogy. Neither States nor individuals justified their actions by \nphilosophical appeals to science, sociology, economics, “nat- \nural rights”, or “dialectical materialism”. Virtually all social \nconstructs were predicated on religious values, or (at least) \nexpressed in religious language. As for the ideology of \nChristian monarcho-imperialism —or for that matter the ide- \nology of Islamic piracy—we are free to interpret both as \nmere window-dressing, hypocritical verbiage, sheer \nhypocrisy, or even hallucination; but this is to reduce history \nto a psychology of rape and plunder, devoid of all thought \nand intention. The influence of “ideas” on “history” remains \nproblematical and even mysterious—especially when we \nhypostatize such vague complexities as categories or even as \nabsolutes; but it does not follow from this that we can say \nnothing meaningful about ideas or about history. At the very \nleast we must admit that ideas have histories.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 322036,
          "end_char": 323049,
          "start_line": 7973,

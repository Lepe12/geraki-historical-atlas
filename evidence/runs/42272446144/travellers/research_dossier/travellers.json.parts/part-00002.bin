        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "After several comparatively bad years in \nthe Straits of Gibraltar, Jan decided to try his \nluck where no pirate, Barbary or other, had \never before ventured. In 1627 he engaged as \npilot a Danish slave who claimed to have been \nto Iceland, and instructed him to lead the way to \nthat remote island. Jansz’s three ships con- \ntained, besides Moors, three English renegades.",
        "years_in_scope": [
          1627
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

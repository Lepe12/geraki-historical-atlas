      },
      {
        "finding_id": "section-5180c386b49bb1336eb1",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Finally, in 1668, the last vestiges of Salé’s freedom were \nwiped out by the rise of the Alawite Dynasty under its Sultan \nMoulay Raschid, who succeeded in reuniting the whole coun- \ntry for the first time since 1603. The Alawite Sultan had no \nintention of putting an end to the highly profitable holy war \nof the Bou Regreg against Europe, and promised the corsairs \nhis protection. Thus, although the Republic had vanished, \npiracy survived —for a while. Unfortunately the Alawites had \nhuge appetites, and little by little increased the “bite” from \n10% to well over half. Eventually the corsairs realized that \ndecent profits were no longer possible. The Moorish pirates \nstayed on to become captains in the Sultan’s “Navy”, and per- \nhaps some of the Renegadoes did the same. Others, perhaps,",
        "years_in_scope": [
          1603,
          1668
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 136782,
          "end_char": 137580,
          "start_line": 3464,
          "end_line": 3476,
          "printed_page": null,

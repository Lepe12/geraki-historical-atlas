      },
      {
        "finding_id": "section-5cee4c649774aa119bf9",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Curiously enough, it appears that few modern historians \nhave really tried to understand the Renegadoes. Among \nEuropean historians the effect of the “demon theory” still \nlingers, although it has been rationalized and elaborated and \neven inverted into a plausible-sounding hypothesis. The rea- \nsoning goes something like this: How did the great European \npowers fail to eradicate the Barbary corsairs for three whole \ncenturted? It goes without saying that Islamic military and \nnaval technology was inferior to European. Moslems, as \neveryone knows, make bad sailors. How to explain this \napparent conundrum? Obviously—the Renegadoes. They, \nas Europeans, introduced European technology to the \nMoslems, and fought for them as well. It appears therefore \nthat Barbary piracy was “une affatre des étrangers”; without the \nRenegadoes it could never have happened [Coindreau, \n1948]. They were traitors of the worst sort—but brilliant in \ntheir crude and thuggish way. Piracy is despicable —but, \nafter all, a bit romantic!",
        "years_in_scope": [
          1948
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 13221,
          "end_char": 14245,
          "start_line": 449,
          "end_line": 466,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

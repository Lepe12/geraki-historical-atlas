      {
        "finding_id": "section-5a07e3739b1db43a2b13",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "The easiest way to understand the difference between a \npirate and a privateer is to examine the different ways they \nsplit up the booty. Pirate captains very frequently took only \none-and-a-half or two shares, the ship's officers took one-and- \na-half or one-and-a-fourth, the crewmen one share, and non- \ncombatants (boys and musicians!) one-half or three-fourths. \nBy contrast a privateer captain usually took 40 shares to the \ncrewman’s single share. Of course, one share in a successful \nprivateering cruise could be worth far more than a salary in \nthe merchant marine—or unpaid impressment into a Navy — \nbut the contrast with piratical egalitarianism is very striking. \nPirates were very nearly communistic in their pure state. \nScholars who see them simply as proto-capitalists are making \na big mistake. Pirates don’t fit the Marxist definition of “social \nbandit” (i.e., “primitive revolutionary”) because pirates have \nno “social” context, no society of peasants for whom they \nserve as focal elements of resistance. Marxists like Hobsbawm \nnever include the pirates among their approved “precursors” \nof true radicalism because they see the pirates—at best—as \nindividuals involved in resistance simply as a form of self- \naggrandizement and primitive accumulation. They forget that",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 217702,
          "end_char": 218997,
          "start_line": 5609,
          "end_line": 5629,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",

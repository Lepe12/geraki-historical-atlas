          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "remember  the  treatment  meted  out  by  Barbarossa \nto  some  of  his  unsuccessful  lieutenants,  Dragut \nmust  be  esteemed  a  very  fortunate  man.  His  master, \nwe  are  told,  advanced  him  to  all  the  military  offices \nof  the  State — it  would  be  interesting  to  know  what \nthese  were  in  a  purely  piratical  confederation  ruled \nby  a  pirate  !  In  the  end  Dragut  was  appointed \nto  be  kayia,  or  lieutenant,  and  given  entire  com- \nmand of  twelve  galleys.",
        "years_in_scope": [],

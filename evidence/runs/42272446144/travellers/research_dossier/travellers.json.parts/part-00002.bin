      {
        "finding_id": "section-604ca047863aa29c5fe3",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Prevesa  illustrates  for  us  more  than  any  other \naction  the  difficulties  with  which  the  path  of  the \npartisan  leader  in  these  days  must  always  have \nbeen  filled  ;  and  how  it  was  that  personal  ascendancy \nwas  the  only  force  to  which  such  a  leader  had  to \ntrust.  Sheer  dominance  of  the  minds,  the  wills, \nand  the  bodies  of  others  had  placed  Kheyr-ed-Din \nwhere  he  was ;  all  his  life  he  had  commanded \nundisciplined  pirates,  and  yet  now,  when  he  was \nthe  properly  accredited  officer  of  a  mighty  monarch, \nwhen  he  might  have  expected  far  more  discipline \nand  subordination  than  had  ever  been  his  lot  in  the \npast,  he  was  met  with  a  contumaciousness  which  he \nwas  unable  to  quell,  and  was  forced  into  taking",
        "years_in_scope": [],

      },
      {
        "finding_id": "section-845abbb84767a546d31c",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "I think I recognize the Renegadoes because somehow \nthey too are “present”. When Col. Qaddafi and the Irish \nRepublican Army are accused of collusion and gunrunning, \nwould it be misleading to mention the old, old Atlantean con- \nnection between Celts and North Africans? Just as the \nEuropean Consensus of the 17th century denounced such \nconspiracy as treason and apostasy, so our modern media \ndismiss it as “terrorism”. We are not used to looking at histo- \nry from the terrorist’s point of view, that is, from the point of \nview of moral struggle and revolutionary expropriation. In \nour modern consensus view, the moral right of killing and \nstealing (war and taxes) belongs only to the State; even more \nspecifically, to the rational, secular, corporate State. Those \nwho are irrational enough to believe in religion (or revolu- \ntion) as a reason for action in the world are “dangerous \nfanatics.” Clearly not much has changed since the 1600’s. On \nthe one hand, we have society; on the other hand, resistance.",
        "years_in_scope": [
          1600
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 321007,
          "end_char": 322025,
          "start_line": 7951,
          "end_line": 7967,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",

          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "The next prize to fall to the pirates was a far richer ves- \nsel, the Rubt, a Venetian argosy of upwards of 300 tons, \nwhich was returning from Alexandria with a cargo of spices \nand 3,000 pieces of gold. The Gift, flying a Dutch flag, sight- \ned the Rubi on 28 January 1607, forty miles off the coast of \nthe Morea, and Ward and his men, no doubt making full use \nof the element of surprise, captured her by boarding “verie \nsuddeine, desperate and without feare.” Ward followed this \nsuccess by taking another Venetian vessel, the Carmuinat, \nwhich was homeward-bound after a voyage to Nauplion and \nAthens. Well pleased with the way the voyage had gone,",
        "years_in_scope": [
          1607
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

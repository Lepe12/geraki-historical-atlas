      {
        "finding_id": "section-c00c2977c76c8a0afe18",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "One  word  in  conclusion.  That  which  they  did \nhas  been  set  down  here  ;  the  record,  however,  is \nnot  complete,  as  many  of  their  acts  of  cruelty,  lust, \nand  oppression  are  not  fitted  for  publication  in  the \npresent  day.  It  has  been  said,  with  truth,  that  no \nman  is  much  better  or  much  worse  than  the  age \nin  which  he  lives  ;  and  to  hold  the  scales  evenly — \nif  one  were  tempted  to  shock  contemporary  opinion \nby  too  literal  a  transcript  of  all  that  was  done  by \nthe  corsairs — it  would  also  be  necessary  to  cite \nthe  reprisals  of  their  Christian  antagonists.  It  has \nseemed  better  to  leave  such  things  unchronicled  ; \nto  present,  with  as  much  fidelity  as  possible,  the \npublic  lives  and  acts  of  these  troublers  of  the  peace \nof  the  sixteenth  century.  Looking  back,  as  we  do, \nover  three  hundred  and  fifty  years,  and  judging,  as \nfairly  as  is  possible,  it  would  seem  that  there  is  little \nwhich  can  be  said  in  their  favour.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "In 1640—no one knows how— Murad Reis effected his \nrelease or escape from the dreadful Knights of “the religion”, \nand reappeared in his old haunts again. He returned to \nMorocco, where the Sultan was moved to appoint him gov- \nernor of the fortress of Oualidia, near the coastal town of \nSafi, not far from the old stomping grounds of Salé. As \nCoindreau says, it was a sort of “golden retirement” for the \naging pirate.",
        "years_in_scope": [
          1640
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

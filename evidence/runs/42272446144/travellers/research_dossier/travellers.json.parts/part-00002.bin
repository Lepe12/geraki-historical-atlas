        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Chaban Raw, Portuguese renegade, in 1646 commanded \nan Algerian ship, The Crabbe (16 cannon and a crew of 175), \nstopped in Salé to take on stores and arms. At sea for three \nmonths, he'd seized nothing better than an English cargo of \nsalt and one fishing boat in the Gulf of Gascony, when (on \nJuly 22) he was himself taken by the Dutch pirate Cornelis \nVerbeck.",
        "years_in_scope": [
          1646
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-c83b4b2700faa94a3dc9",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "But the “golden age” dream lingered on: the sylvan idyll \nof Hispaniola became both a myth of origin, and a political \ngoal. From now on, whenever the pirates had a chance, they \nwould attempt the foundation of permanent or semi-perma- \nnent land enclaves. The ideal conditions included proximity \nto sea-lanes, friendly Natives (and Native women), seclusion \nand remoteness from all writ and reality of European power, \na pleasant tropical climate, and perhaps a trading post or",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",

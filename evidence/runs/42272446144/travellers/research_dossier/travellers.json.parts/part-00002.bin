      {
        "finding_id": "section-2dccfc335d675bd9536d",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "The  first  employment  of  the  commissioners  appears \nto  have  been  in  behalf  of  the  Betsey,  captured  by \na  cruiser  of  Morocco,  when  they  addressed  a  letter, \nMarch  28,  1785,  to  Vergennes  asking  his  advice  and \nthe  interposition  of  the  king  with  Morocco,  in  accord- \nance with  the  treaty  of  1778.  They  were  advised  to \nrequest  the  emperor  to  refrain  from  further  interfer- \nence with  American  commerce  until  Congress  should \nhave  time  to  send  him  a  consul.^  Not  long  after  this \nthe  Betsey  and  her  crew  were  released  through  the \nfriendly  interposition  of  Spain .^  Franklin  soon  re- \nturned to  America,  leaving  Paris  July  12,  1785, \nand  was  reported  to  have  been  captured  by  Algerine \npirates  on  the  way.^  After  his  departure  Adams  and \nJefferson,  who  was  now  minister  to  France,  appointed \nThomas  Barclay,  consul-general  of  the  United  States",
        "years_in_scope": [
          1778,
          1785
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/ournavybarbaryco00alle",
          "source_file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
          "start_char": 59799,
          "end_char": 60755,
          "start_line": 1321,
          "end_line": 1336,
          "printed_page": null,

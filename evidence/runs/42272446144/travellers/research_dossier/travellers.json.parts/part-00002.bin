      {
        "finding_id": "section-de30e067404cda1520fd",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Uruj  now  established  himself  at  the  island  of \nJerba,  on  the  east  coast  of  Tunis,  which  formed \nan  admirable  base  from  which  to  \"  work \"  the \nMediterranean  from  the  piratical  point  of  view. \nJerba  had  originally  been  conquered  and  occupied \nby  the  Spaniards  in  1431,  but  the  occupation  had \nbeen  allowed  to  lapse,  and  the  island  was  lying \nderelict  when  the  Barbarossas  made  it  their  head- \nquarters. Here  Uruj  was  joined  by  his  younger \nbrother  Khizr,  destined  to  become  so  much  the",
        "years_in_scope": [
          1431
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

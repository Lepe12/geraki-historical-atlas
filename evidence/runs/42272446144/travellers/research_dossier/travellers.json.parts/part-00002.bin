      {
        "finding_id": "section-db25764f375362ff1ae5",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Old Salé concerned itself primarily with al-Ayyashi’s \njthad and the rebellion against the Saadians— but the Slawis \nwere certainly not above involvement in corsair activity, \nwhether as investors, captains, crews, men-at-arms, or mer- \nchants of booty, captives, and slaves. Nevertheless, it’s ironic \nthat Salé is remembered as ¢4e corsair city, when that roman- \ntic title belongs so much more aptly to the Casbah/Rabat set- \ntlements across the river. To this day a rivalry between Salé \nand Rabat persists. As K. Brown puts it,",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",

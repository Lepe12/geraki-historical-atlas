      {
        "finding_id": "section-a978d87a71f769a1cb7c",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Like  Kheyr-ed-Din  Barbarossa,  All  was  now  lord \nof  Algiers  and  Tunis,  and  as  he  was,  for  a  corsair, \na  man  of  wide  views,  he  treated  his  new  subjects \nwith  consideration.  He  made,  however,  one  curi- \nous mistake  not  to  have  been  expected  from  one \nso  politic:  he  demanded  tribute  from  the  tribes \nof  the  hinterland.  In  those  days,  particularly \nin  Northern  Africa,  men  paid  tribute  to  an  over- \nlord because  he  was  stronger  than  they ;  because \nretribution  followed  swiftly  and  suddenly  upon  re- \nfusal. To  order  tribute  to  be  paid  without  being \nready  to  strike  was  merely  to  expose  the  man \nmaking  the  demand  to  derision.  Particularly  was \nthis  the  case  with  the  fierce  land-pirates  of  the \ndesert,  whose  habit  it  was  to  exact  and  not  to  pay \ntribute.  To  AH  the  Sheiks  replied  that  \"if  he \nwanted  tribute  from  them  he  must  demand  it \nlance  in  hand  in  the  field,  for  there  and  nowhere \nelse  were  they  accustomed  to  pay :  that  their  coin \nwas  steel  lance-heads  and  not  golden  aspers.\" \nAfter  this,  says  Morgan,  \"  the  Basha  thought  it  well \nto  dissemble.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

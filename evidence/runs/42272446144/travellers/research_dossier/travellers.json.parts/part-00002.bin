      {
        "finding_id": "section-48a5c46e5c171cb1a508",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "drum  rolled  to  welcome  the  man  honoured  of  the \nPadishah,  notorious  throughout  the  whole  world  of \nEurope  for  his  implacable  enmity  to  the  Knights. \nThe  first  preoccupation  of  the  corsair  was  to  inform \nhimself  as  to  the  conduct  of  the  operations.  These, \nwhen  disclosed  to  him,  by  no  means  met  with  his \napproval.  This  real  leader  immediately  made  it \nclear  to  Piali  and  Mustafa  that  which  they  should \nhave  done.  In  the  first  place  they  should  have  made \nthemselves  masters  of  the  castle  of  Gozo,  and  then \ncaptured  the  Citta  Notabile.  By  doing  this  the \nsupplies  to  the  town  and  fortress  of  II  Borgo  would \nhave  been  cut  off :  besides — and  more  important \nthan  aught  else — they  would  in  this  manner  have \nclosed  the  road  to  those  succours  expected  by  the \nChristians.  Piali,  who  had  desired  from  the  first \nto  undertake  nothing  without  the  advice  of  Dragut, \nnow  said  that  the  siege  of  St.  Elmo  was  not  so  far \nadvanced  after  all,  and,  if  the  Basha  of  Tripoli  should \nso  direct,  it  could  be  raised  at  once.  To  this,  however, \nDragut  would  by  no  means  consent.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-d3f205afcecaf417908a",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  corsair  recognised  that  he  could  do  no  more  : \nsullenly  he  cast  off  the  tow,  and,  forming  up  some \nthirty  of  his  galleys,  still  in  a  condition  to  navigate, \nstood  boldly  through  the  centre  of  where  the  battle \nhad  once  raged,  and  escaped.  The  Capitana  of \nMalta  had  been  taken  ;  and  to  the  Sultan  did \nOcchiali  present  the  great  standard  of  Saint  John, \nas  an  earnest  of  his  achievement.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

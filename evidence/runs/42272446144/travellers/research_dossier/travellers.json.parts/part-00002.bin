      {
        "finding_id": "section-4dd94be6c5cc94773119",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "Church  took  measures  to  warn  American  shipmas- \nters in  neighboring  waters  of  their  danger.  He  also \nobtained  from  the  Portuguese  government  convoy  for \nseveral  vessels,  but  this,  of  course,  could  only  be  de- \npended upon  as  an  occasional  arrangement,  and,  as \nHumphreys  wrote  to  Jefferson,  December  25,  1793 : \n\"  It  appears  absurd  to  trust  to  the  fleets  of  Portugal, \nor  any  other  nation,  to  protect  or  convoy  our  trade. \nIf  we  mean  to  have  a  commerce,  we  must  have  a  naval \nforce,  to  a  certain  extent,  to  defend  it.\"  Captain \nO'Brien  also  wrote  from  Algiers,  to  the  President, \nNovember  5  and  to  Humphreys  December  6,  strongly \nurging  force  as  the  only  effectual  means  of  securing \nimmunity  from  the  pirates.^",
        "years_in_scope": [
          1793
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/ournavybarbaryco00alle",
          "source_file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
          "start_char": 99201,
          "end_char": 100015,
          "start_line": 2105,

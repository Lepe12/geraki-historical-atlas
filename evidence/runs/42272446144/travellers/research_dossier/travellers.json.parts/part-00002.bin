      {
        "finding_id": "section-4feb12698818f7ecd5ea",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "A  few  months  later  the  commissioners,  Benjamin \nFranklin,  Arthur  Lee,  and  John  Adams,  requested  the \nking's  good  offices  in  behalf  of  certain  American  ves- \nsels then  in  Italy  and  in  fear  of  Barbary  pirates.  This \nled  to  a  correspondence  with  the  Comte  de  Vergennes, \nminister  of  foreign  affairs,  and  M.  de  Sartine,  min- \nister of  marine,  as  to  the  best  policy  to  be  pursued  by \nthe  United  States  towards  the  Barbary  powers.  The \nresult  was  that  by  the  advice  of  the  ministers  the  com- \nmissioners applied  to  Congress  for  authority  to  treat \nwith  the  Barbary  powers  and  for  funds  to  be  expended",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

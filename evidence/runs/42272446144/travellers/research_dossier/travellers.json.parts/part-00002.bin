      {
        "finding_id": "section-7f958350fd7c972af385",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "became  possessed  of  a  ship — how  we  do  not  know, \nand  it  were  better  perhaps  not  to  inquire.  In  this \nsmall  craft  he  repaired  to  the  coast  of  Caramania \nto  make  war  upon  the  Christians ;  or,  in  other \nwords,  to  begin  an  independent  piratical  career. \nUruj  in  these  days  was  young  and  inexperienced, \nor  he  would  not  have  chosen  this  locality  for  his \nfirst  venture,  as  this  coast  was  in  close  proximity \nto  the  island  of  Rhodes,  from  whence  the  great \ngalleys  of  the  Knights  of  Saint  John  of  Jerusalem \nset  forth  to  exterminate  the  enemies  of  their  faith.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

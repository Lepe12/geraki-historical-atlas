      {
        "finding_id": "section-60155661a6d951e4e766",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Mission now decides on a venture in intentional commu- \nnity, and moves his people to Madagascar.39 Here they begin \nto construct a purely socialist society in which private prop- \nerty is abolished and all wealth held in a common treasury. \nNo hedges separate the pirates’ plots of land. Docks and for- \ntifications are built, and two new ships, Childhood and Liberty, \nare sent to map the coast. A Session House is built, and \nMission is elected “Lord Conservator” for a three-year term. \nThe elected Assembly meets once a year, and nothing of \nmoment can be undertaken without its approval. The laws are \nprinted and distributed, as “they had some printers and letter- \nformers among them.” The English pirate Capt. Tew is \nAdmiral of the Fleet, Caraccioli is Secretary of State, and the \nCouncil consists of the ablest pirates “without distinction of \nnation or colour.” A new language is invented, a mélange of",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 306992,
          "end_char": 307907,
          "start_line": 7663,
          "end_line": 7677,
          "printed_page": null,
          "scan_indexes_0_based": [],

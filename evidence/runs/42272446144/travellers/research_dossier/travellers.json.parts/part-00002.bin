        "verified": false
      },
      {
        "finding_id": "section-6c98d60e0ecaa35fa869",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "On December 30th [Coindreau says the \n24th] of that year a Dutch ship entered Sallee \n[actually Safi], where Jansz was Governor of \nthe Castle. The ship brought a new Dutch con- \nsul who had with him, as a pleasant little sur- \nprise for the pirate, his daughter Lysbeth, now \ngrown into an attractive young woman.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",

      {
        "finding_id": "section-d83e84d5f994093ec2d8",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "When they reached the Scilly Isles the \npirates had the good luck to fall in with a \nFrench vessel, but such was the strength of \ntheir ship that they could only hope to capture \nthe Frenchmen by guile. Accordingly, the \nmajority of the pirates hid below hatches while \na few of their comrades up on deck engaged the \nother ship in conversation. They continued \nthus for several hours until their ruse finally \nsucceeded and they came close enough to \nboard and overpower their quarry.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 80632,
          "end_char": 81117,
          "start_line": 2061,
          "end_line": 2071,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

      {
        "finding_id": "section-6aa65eee394e5b023220",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  corsair  must  have  meditated  long  and  anx- \niously on  the  best  way  in  which  to  approach  the \nautocrat  of  Constantinople;  in  the  end  he  prob- \nably hit  upon  the  best  solution  of  the  problem  by \nagain  sending  an  ambassador  with  precise  instruc- \ntions as  to  the  manner  in  which  he  was  to  act. \nFor  this  important  service  his  choice  fell  upon \none  of  his  captains,  Hadj-Hossein  by  name,  and  to \nhim  he  imparted  all  that  he  was  to  say,  and — what \nwas  almost  as  important — what  he  was  not  to  say.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-6ef8286477aaba4459e1",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "From  the  earliest  days  of  the  Moslem  corsairs \nof  the  Mediterranean  they  were  in  close  communica- \ntion with  their  co-religionists  of  the  Ottoman \nEmpire ;  and  this  for  a  very  good  reason,  which \nwas  that  the  Turk  had  not  the  habit  of  the  sea, \nbut  was  essentially  a  land  warrior,  and,  as  the  story \nof  the  Sea-wolves  progresses,  we  shall  see  how \nin  a  sense  the  Grand  Turk  and  the  pirates  became \ninterdependent  in  the  ceaseless  wars  which  were \nwaged  in  the  epoch  of  which  we  treat.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

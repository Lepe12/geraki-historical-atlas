          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "In  October,  1784,  the  American  brig  Betsey.  Captain \nJames  Erving.  bound  to  Teneriffe,  was  captured  by \na  corsair  of  Morocco  and  taken  into  Tangier.  The  crew \nwere  not  enslaved,  and  after  being  held  six  months \nwere  released  with  the  vessel.  The  emperor  of  Morocco \nexpressed  a  wish  for  friendly  relations  with  the  United \nStates,  and  gave  orders  that  no  other  American  ves- \nsels should  be  molested  until  there  should  be  time  to \nhear  from  Congress  on  the  subject  of  negotiations  for \npeace.2",
        "years_in_scope": [
          1784
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,

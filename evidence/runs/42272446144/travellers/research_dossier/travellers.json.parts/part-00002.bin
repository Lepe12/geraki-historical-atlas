      {
        "finding_id": "section-875f02523b2baa802d53",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "Long  before  this  Eaton  had  become  convinced  that \nFamin  had  all  along  been  intriguing  against  him. \nHe  says :  \"  I  have  uniformly  treated  this  French \npirate  with  polite  attention,  taking  care  to  keep  the \ncommanding  grounds,  till  I  have  finally  defeated  all \nhis  projects  of  mischief ;  and  if  nothing  interfere  with",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

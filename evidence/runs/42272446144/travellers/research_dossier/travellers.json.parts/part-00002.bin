      {
        "finding_id": "section-26ef4cf899aaf94199f8",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "a  most  formidable  armada,  but  the  policy  of  those \nby  whom  it  was  composed  was  not  all  directed  to \nthe  same  end.  While  Charles  desired,  above  all \nthings,  to  exterminate  the  corsairs  for  good  and  all, \nwhich  was,  in  the  circumstances,  the  only  sound \nview  of  the  matter,  the  Venetians  were  for  fighting \ndefensive  actions  to  maintain  their  supremacy  in \nthe  Ionian  Islands,  and  were  disposed  to  let  the \nfuture  take  care  of  itself.  There  was  not,  in  con- \nsequence, that  absolute  unanimity  among  the \nvarious  commanders  of  the  expedition  as  was \nnecessary  for  its  complete  success.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

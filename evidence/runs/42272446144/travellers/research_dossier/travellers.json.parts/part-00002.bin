      {
        "finding_id": "section-b6aa3613527dde1ebdac",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Kheyr-ed-Din  Barbarossa,  Corsair,  Admiral,  and \nKing,  the  scourge  of  the  Mediterranean,  and  Andrea \nDoria,  Prince  of  Oneglia,  Admiral  of  the  modern \nCaesar,  Charles  V.,  Emperor  and  King,  were  at  last \nto  meet  face  to  face.",
        "years_in_scope": [],

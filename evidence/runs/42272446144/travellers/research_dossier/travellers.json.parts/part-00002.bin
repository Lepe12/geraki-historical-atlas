      {
        "finding_id": "section-7afc833b0ad70625ffcf",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "But,  however  this  might  have  been,  it  is  quite \ncertain  that  no  qualms  of  conscience  troubled \nUruj  concerning  those  others  :  Genoese,  Neapoli- \ntans, Catalans,  Andalusians,  French,  or  the  dwellers \nof  the  Balearic  Islands,  were  all  fish  sent  by  a \nbountiful  Providence  to  be  enclosed  in  his  net, \nand  he  seized  upon  them  without  distinction. \nWhen  in  the  full  tide  of  his  success  there  was  but \none  thing  which  preoccupied  the  mind  of  the  corsair, \nwhich  was  to  find  a  ready  market  for  his  spoils  and \na  convenient  place  in  which  to  rid  himself  of  an \nembarrassing  number  of  captives.  This,  however, \ndid  not  present  an  insuperable  difficulty,  as  we  have \nalready  seen  in  the  case  of  Curtogali,  and  a  similar \narrangement  was  carried  out  by  Uruj  Barbarossa \nand  his  brother.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

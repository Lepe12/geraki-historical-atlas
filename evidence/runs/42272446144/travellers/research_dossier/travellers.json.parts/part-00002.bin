      {
        "finding_id": "section-82914cdfcb17aa8aec6b",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Back  to  the  Golden  Horn  streamed  ship  after  ship \nladen  with  plunder  and  with  slaves.  \"  The  veritable \nman  of  the  sea  \"  was  proving  the  correctness  of  the \nchoice  of  the  Sultan,  the  acumen  of  the  Grand  Vizier \nwho  had  recommended  his  appointment.  Barbarossa \nwas  determined  to  leave  nothing  undone  to  prove \nto  Soliman  that  his  choice  had  indeed  been  a  worthy \none  when  he  had  selected  him  as  admiral  of  his  fleet : \nalso  he  had  in  his  mind  those  others  who  spoke \nslightingly  of  him  as  \"  the  African  pirate  \"  ;  they \nshould  know  as  well  as  their  master  of  what  this \npirate  was  capable.  Northward  the  devastating  host \nof  Barbarossa  took  its  way  ;  the  fair  shores  of  Italy \nsmoked  to  heaven  as  the  torches  of  the  corsairs  fired \nthe  villages.  Blood  and  agony,  torture  and  despair, \nfollowed  ever  on  the  heels  of  the  Sea-wolves  of  the \nMediterranean.  And  now  a  fresh  pack  had  been \nloosed,  as  it  was,  of  course,  in  enormously  increased \nstrength  that  Barbarossa  returned  to  the  scene  of \nso  many  of  his  former  triumphs.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

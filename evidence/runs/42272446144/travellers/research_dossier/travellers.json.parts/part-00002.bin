        "verified": false
      },
      {
        "finding_id": "section-f0cfc560d7cdaca55727",
        "file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
        "title": "Pirate Utopias: Moorish Corsairs & European Renegadoes",
        "url": "https://archive.org/details/pirate-utopias-hakim-bey",
        "source_bibliography": {
          "creator": [
            "Hakim Bey"
          ],
          "date": [
            "1995-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "As for Islamic historians, they naturally resent any sug- \ngestions of Islamic inferiority. The 19th and early 20th cen- \ntury local histories of Rabat-Salé, for example, make it quite \nclear that the Moors, Berbers and Arabs of the country con- \ntributed, in the long run, far more to the history of the “holy \nwar at sea” than did a few thousand converts. As for the con- \nverts themselves, their descendants still live in Rabat-Salé — \nthey became Moroccans, whatever their origins. The history of \nthe corsairs is not “an affair of foreigners”, but part of the his- \ntory of the Maghreb, the Far West of Islam, and of the \nemerging Moroccan nation [Hesperis, 1971].",
        "years_in_scope": [
          1971
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/pirate-utopias-hakim-bey",
          "source_file": "pirate-utopias-hakim-bey_Pirate_Utopias_Bey_0_djvu.txt",
          "start_char": 14619,
          "end_char": 15288,
          "start_line": 480,
          "end_line": 490,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",
        "uncertainties": [

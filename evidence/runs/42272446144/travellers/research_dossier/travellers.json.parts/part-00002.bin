      {
        "finding_id": "section-a36e3a5c51e41c956b3e",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Having  already  had  a  taste  of  the  quality  of  this \nredoubtable  corsair,  and  feeling  perfectly  certain \nthat  should  the  occasion  arise  he  would  be  as  good \nas  his  word,  there  was  no  more  disaffection  among \nthe  inhabitants,  who  had  to  put  up  with  their \nnative  place  being  made  a  cockpit  for  Doria  and \nDragut  to  fight  out  their  quarrel.  It  is  permissible \nto  sympathise  very  sincerely  with  these  unfortunates, \nwho,  having  been  betrayed  in  the  first  instance, \nwere  compelled  to  stand  a  siege  in  the  second.",
        "years_in_scope": [],

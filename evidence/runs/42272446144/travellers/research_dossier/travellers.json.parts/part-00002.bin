      {
        "finding_id": "section-b9df45f7686a28fa2076",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "been,  and  that  they  would  have  gone  in  and  burnt \nor  disabled  the  galleys  of  the  corsair,  slain  their \nleader,  or  driven  him  ashore.  Hot  on  the  tracks \nof  Adan  Centurion  and  his  nephew  John  came \nthe  veteran  Andrea  Doria  with  forty  galleys,  but \nhe  was  too  late,  and  the  bird  had  flown  ;  had  it \nbeen  he  who  had  arrived  in  the  first  instance,  then \nit  is  more  than  probable  that  matters  would  have \nturned  out  differently,  and  Kheyr-ed-Din  had  then \nand  there  terminated  his  career.  It  is  true  that \nAndrea  possessed  himself  of  Bona,  and  the  Corsair \nKing  was  shorn  of  yet  another  of  his  land-stations, \nbut  for  the  time  he  had  cut  himself  adrift  from \nthe  land,  and  had  gone  back  to  that  element  in  which \nhe  was  particularly  at  home.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

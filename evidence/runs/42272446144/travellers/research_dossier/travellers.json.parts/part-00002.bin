      },
      {
        "finding_id": "section-8decf7fbbb97b3cfb258",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "The  situation  in  Algiers  was  complicated  by  the \ncapture  of  the  Maria  and  Dauphin,  and  involved  the \nquestion  of  ransom  of  the  captives  as  well  as  of  peace. \nThese  vessels  were  taken  as  a  result  of  a  peace  con- \ncluded between  Algiers  and  Spain,  which  allowed  the \nAlgerines  to  pass  the  Straits.  July  19,  1785,  only  a \nfew  days  before  the  first  capture,  William  Carmichael, \nour  charge  d'affaires  in  Spain,  wrote  to  Jefferson : \n\"I  am  alarmed  on  account  of  the  Algerines.  Their \npeace  with  Spain  has  opened  a  large  field  to  their \npiracies.\"  *",
        "years_in_scope": [
          1785
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-ba9d2f3e998e06f479f0",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "That  cool  calculator  of  the  chances  of  life  knew \nthat  this  must  be  so ;  the  power  of  the  corsairs \ngenerally  had  received  the  worst  blow  it  had  ever \nencountered  since  the  dispossessed  Moriscoes  had \ntaken  to  the  sea  for  a  living ;  those  of  them  who \nremained  alive  were  without  ships — that  is  to  say, \nwithout  their  only  means  of  making  a  livelihood — and \nthat  they  should  gravitate  towards  Algiers  and  its \nmaster  was  as  nearly  a  certainty  as  anything  human \ncould  be.  And,  as  was  anticipated  by  the  chief, \nso  it  came  to  pass.  Into  the  city  straggled  broken, \nstarving,  sullen  men  who  had  lost  their  all,  for  whom \nthe  future  held  nothing  but  misery  and  despair  un- \nless they  could  get  to  sea  once  more.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

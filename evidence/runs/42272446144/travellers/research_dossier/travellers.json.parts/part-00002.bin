      {
        "finding_id": "section-a3d22937bc417803e8ca",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "There  were  no  longer  among  the  Moors  of  Anda- \nlusia learned  philosophers,  expert  mathematicians, \nwise  astronomers,  and  practical  agriculturists  ;  there \nwas  among  them  but  one  art,  one  science,  one \nmeans  of  gaining  a  livelihood — the  practice  of  war — \nand  their  very  existence  depended  on  the  spoils \nwhich  could  be  reft  from  the  hereditary  enemy. \nThe  corsair  who  grew  to  man's  estate,  brought  up \nin  Algiers,  Tunis,  Tenes,  Jerba,  or  any  other  of  the \nlurking  places  in  which  the  sea-wolves  congregated, \nhad  as  a  rule  no  chance  but  to  follow  the  sea,  to \nexist  as  his  father  had  existed  before  him ;  he  must \nfight  or  starve,  and  in  a  fighting  age  no  youngster \nwas  likely  to  be  backward  in  taking  to  the  life  of \nwild  excitement  led  by  his  elders.  Unless  following \nin  the  train  of  one  of  the  leaders,  such  as  Barbarossa,",
        "years_in_scope": [],

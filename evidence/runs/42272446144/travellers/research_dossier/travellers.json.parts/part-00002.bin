      {
        "finding_id": "section-e15b6e95cff9dde7fd34",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "84  THE  DEATH  OF  URUJ  BARBAROSSA. \ncould  keep  Uruj  Barbarossa  for  long  within  stone \nwalls ;  sortie  after  sortie  did  the  gallant  corsair \nlead  against  the  foe,  and  it  was  in  one  of  these  that \nhe  characteristically  came  by  his  death.  Ever  rash \nand  impetuous,  he  allowed  himself  to  be  drawn \ntoo  far  away  from  possible  shelter  or  support ;  and, \nas  there  was  something  dramatic  in  the  whole  life \nof  this  man,  so  also  was  there  in  the  manner  of  his \ndeath.  They  had  him  trapped  at  last,  this  grim \nSea-wolf,  and  he  stood  at  bay  in  a  stone  corral  used \nfor  the  herding  of  goats.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/seawolvesofmedit00curruoft",
          "source_file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
          "start_char": 145986,
          "end_char": 146655,
          "start_line": 3154,
          "end_line": 3165,
          "printed_page": null,

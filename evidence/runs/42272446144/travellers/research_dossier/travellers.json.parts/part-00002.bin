      {
        "finding_id": "section-583994b1ea404790e911",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "glory  of  God  and  His  Prophet.\"  To  us  this  hyper- \nbole, addressed  to  a  pirate,  seems  merely  ridiculous, \nbut  in  those  days  of  fanaticism  the  beliefs  of  men, \nboth  Christians  and  Moslems,  are  something  which \nit  is  impossible  for  us  to  realise.  On  either  side  the \nway  of  salvation  was  the  path  of  conquest,  and  the \nman  who  was  heretic  to  the  faith  which  you  pro- \nfessed was  rightly  served  if  you  could  cut  him  and \nhis  off  from  among  the  congregation.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

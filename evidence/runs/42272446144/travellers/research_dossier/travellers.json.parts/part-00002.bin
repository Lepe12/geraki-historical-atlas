      {
        "finding_id": "section-68f7d086df9b341b395e",
        "file": "storyofafricaits02brow_storyofafricaits02brow_djvu.txt",
        "title": "The story of Africa and its explorers",
        "url": "https://archive.org/details/storyofafricaits02brow",
        "source_bibliography": {

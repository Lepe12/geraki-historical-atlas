        "source_text_sha256": "ebef0a63c86f8eca812a0716c8fde4bac770ce246530d69bc074d6640e161000",
        "evidence_excerpt": "Ward fitted out his ships and put to sea again early in \n1607. This time he was in the Rudi, his Venetian prize which \nhe had converted to a man-of-war and manned with a crew \nof 140, mostly English. Once again Cara Osman had bought \na quarter share in the venture by providing the pirates with \nguns, powder, match, and shot from the Turkish armoury. \nThis time, however, there were no Turks on the expedition.",
        "years_in_scope": [
          1607
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

        "model_review": {
          "decision": "FLAGGED",
          "flag": {
            "claim_id": "c-6ea62ebecdc6b8270d79",
            "reason": "The statement claims Jean Capfi was a subject of the Porte, but the provided quote only mentions 'Gree de Milo' without specifying his relation to the Porte. The source text does not confirm his status as a subject of the Porte, only that he was associated with Milo. The quote is incomplete and contains OCR errors, making it uncertain whether the statement is supported.",
            "decision": "UNCERTAIN"
          },
          "historical_verification": false
        }
      },
      "historically_verified": false
    },

    {
      "@id": "urn:nabou:cite_a9bf877f32fc04eb52b06124",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 27474, \"end_line\": 606, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 27195, \"start_line\": 601}",
      "properties": {
        "source_id": "src_b1827baedd87779c8e9f1b0d3c650a86",
        "locator": "{\"end_char\": 27474, \"end_line\": 606, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 27195, \"start_line\": 601}",
        "exact_excerpt": " \nIn Experiment 2, the CAPSI program treated the eight lab sec¬ \ntions as separate classes. That is, each lab section was a separate \nCAPSI class. TAs only assessed answers from students in their \nlab section; and students only peer reviewed other students in \ntheir lab section.",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:att_512b490f8112c672f632f5c6%3Asnapshot%3Aa97114bd8b4b496cf5c1",
      "@type": "Attestation",
      "schema:name": "The consulted source reports that students could access the program from the first week of classes in Experiment 1, but only in the last third of the academic term in Experiment 2.",
      "properties": {
        "attestation_id": "att_512b490f8112c672f632f5c6",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",
        "source_classification": "UNVERIFIED",
        "model_review": {
          "decision": "NOT_DECIDED",
          "flag": null,
          "historical_verification": false
        }
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_7c218de31d911bf56bef9b6e",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 28549, \"end_line\": 628, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 28177, \"start_line\": 621}",
      "properties": {
        "source_id": "src_b1827baedd87779c8e9f1b0d3c650a86",
        "locator": "{\"end_char\": 28549, \"end_line\": 628, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 28177, \"start_line\": 621}",
        "exact_excerpt": " \n\nWhereas in Experiment 1, students could access the program \nfrom the first week of classes, in Experiment 2, students were \nable to take unit tests only in the last third of the academic term. \nThe purpose of this was to correspond to the timing of the re¬ \nquired third essay assignment of the non-CAPSI section and to \nthe material that was presented in the lectures.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

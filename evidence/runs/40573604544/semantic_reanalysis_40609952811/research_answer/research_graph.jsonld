    {
      "@id": "urn:nabou:cite_23f19ef4a73b5a855c133004",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 26146, \"end_line\": 546, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_travellers/library_acquisition/8152ecd35cb5feefa7ecaa81.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [5], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 25671, \"start_line\": 537}",
      "properties": {
        "source_id": "src_60d9d7f48242bff7eca9d3e6d4e14ffa",
        "locator": "{\"end_char\": 26146, \"end_line\": 546, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_travellers/library_acquisition/8152ecd35cb5feefa7ecaa81.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [5], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 25671, \"start_line\": 537}",
        "exact_excerpt": "The Abbot went On to relate that vessels armed in\nLeghorn (Tuscany) and assisted by a tartan flying a\nMaltese flag had depredated two vessels anchored in\nthe harbour of Patrnos, laden with nee and other food\nprovisions meant for the sustenance of the islanders,\nTwo more vessels, one flying the Spanish flag landed\non the seashore of Patmos, broke into the stores and\nsacked the place and took away the herds of cattle\nthat were kept there besides causing devastating\ndamage.",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_ec6571a7b744f4cfea52147a",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 26146, \"end_line\": 546, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"travellers/library_acquisition/8152ecd35cb5feefa7ecaa81.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [5], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 25671, \"start_line\": 537}",
      "properties": {
        "source_id": "src_dbbea00e3ae87fafa464871bf748876d",
        "locator": "{\"end_char\": 26146, \"end_line\": 546, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"travellers/library_acquisition/8152ecd35cb5feefa7ecaa81.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [5], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 25671, \"start_line\": 537}",
        "exact_excerpt": "The Abbot went On to relate that vessels armed in\nLeghorn (Tuscany) and assisted by a tartan flying a\nMaltese flag had depredated two vessels anchored in\nthe harbour of Patrnos, laden with nee and other food\nprovisions meant for the sustenance of the islanders,\nTwo more vessels, one flying the Spanish flag landed\non the seashore of Patmos, broke into the stores and\nsacked the place and took away the herds of cattle\nthat were kept there besides causing devastating\ndamage.",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:att_1efb2be58db5863d2f762e75%3Asnapshot%3A2a3b07a9641b2b7e7d7e",
      "@type": "Attestation",
      "schema:name": "The consulted source reports that two more vessels, one flying the Spanish flag, landed on the seashore of Patmos, broke into the stores and sacked the place and took away the herds of cattle.",
      "properties": {
        "attestation_id": "att_1efb2be58db5863d2f762e75",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",
        "source_classification": "UNVERIFIED",
        "model_review": {
          "decision": "FLAGGED",
          "flag": {
            "claim_id": "c-3555e84742da40767801",
            "reason": "The statement accurately reports the quoted text about vessels landing on Patmos, breaking into stores, and taking cattle. The source mentions 'Patmos' and the actions described align with the claim. However, the source context discusses broader issues of corsairing in the Mediterranean, not specifically focusing on the Nauσa of Paros. The claim's focus on Nauσa Paros is not directly addressed in the source, which refers to Patmos. The source also does not mention the specific time period 1600–1700, though the context is within the 17th and 18th centuries. The source's mention of 'Patrnos' may",
            "decision": "UNCERTAIN"
          },
          "historical_verification": false
        }
      },
      "historically_verified": false
    },
    {

      "@type": "Citation",
      "schema:name": "{\"end_char\": 1548, \"end_line\": 19, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/029870036e1a8292de0d651a.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1233, \"start_line\": 17}",
      "properties": {
        "source_id": "src_8485190305992c047600a796380b71d6",
        "locator": "{\"end_char\": 1548, \"end_line\": 19, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/029870036e1a8292de0d651a.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1233, \"start_line\": 17}",
        "exact_excerpt": " Excavations enlightened the form and components of the poleis during the Classical and Hellenistic periods (Palaiopolis, Vryokastro), revealed parts of cemeteries (Tenos,\nSeriphos, Paros, Naxos), and enriched our knowledge on island cultic life from the Geometric period onwards (Vryokastraki,\nSiphnos, Despotiko).",
        "attribution": "stated"
      },
      "historically_verified": false
    },

          "locator": "{\"end_char\": 1548, \"end_line\": 19, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/029870036e1a8292de0d651a.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1233, \"start_line\": 17}",

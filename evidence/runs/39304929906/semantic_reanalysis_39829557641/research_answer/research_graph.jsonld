    },
    {
      "@id": "urn:nabou:cite_1b8db2fa43ab3f3c4897aec3",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 132303, \"end_line\": 3677, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 132228, \"start_line\": 3676}",
      "properties": {
        "source_id": "src_d1feda35e76ce4e0cdf2470901dc9438",
        "locator": "{\"end_char\": 132303, \"end_line\": 3677, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 132228, \"start_line\": 3676}",
        "exact_excerpt": "Η Μήλος εν µέσω οθωμανικής κυριαρχίας, το 1677 απέ- \nκτησε πειρατή βασιλιά!",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:att_ddd36e191d123027a74b75c8%3Asnapshot%3Ac8a25bf2e8e1b8c2541d",
      "@type": "Attestation",
      "schema:name": "The consulted source reports that John Kapsis became a pirate again after the murder of his brother Trōmāras by the Ottomans.",
      "properties": {
        "attestation_id": "att_ddd36e191d123027a74b75c8",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",
        "source_classification": "UNVERIFIED",
        "model_review": {
          "decision": "SUPPORTED_ATTRIBUTION",
          "flag": null,
          "historical_verification": false
        }
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_b7b94bd7799d97fb41730cbd",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 132737, \"end_line\": 3685, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 132607, \"start_line\": 3683}",
      "properties": {
        "source_id": "src_d1feda35e76ce4e0cdf2470901dc9438",
        "locator": "{\"end_char\": 132737, \"end_line\": 3685, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 132607, \"start_line\": 3683}",
        "exact_excerpt": " Μετά από την σύντομη ανάπαυλα ο Κάψης γίνεται \nπάλι πειρατής µε αφορμή την δολοφονία του αδελφού \nτου Τροµάρα από τους Οθωμανούς.",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:att_cafa447b9d968aa90ed5e46d%3Asnapshot%3A7794d6006f7daf89705d",
      "@type": "Attestation",
      "schema:name": "The consulted source reports that Jean Capsi was a Greek from Milo who was a pilot for the King's ships and had ambitions to become the master of the island.",
      "properties": {
        "attestation_id": "att_cafa447b9d968aa90ed5e46d",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",
        "source_classification": "UNVERIFIED",
        "model_review": {
          "decision": "SUPPORTED_ATTRIBUTION",
          "flag": null,
          "historical_verification": false
        }
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_c1e4d5c3594b9cf02474f490",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 652, \"end_line\": 22, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [336], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 343, \"start_line\": 12}",
      "properties": {
        "source_id": "src_2a42a2dbff5917211b871df730432817",
        "locator": "{\"end_char\": 652, \"end_line\": 22, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [336], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 343, \"start_line\": 12}",
        "exact_excerpt": "JEAN CAPSI.\n\nE troifiéme Aventurier fut Jean\n\nA Capfi; c'éroit un Grec de Milo,\n“qui fçavoit tres bien la mer , & qui\navoit été long-tems pilote far les ναί <\nfeaux du Roi; homme; au refte,d'ùn gé-\nnie hardi & entreprenant » & qui pour\nêtre de balle naiffance n'en avoit ni\nmoins d’ambition ni moins, de cœur.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

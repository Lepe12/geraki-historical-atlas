    {
      "@id": "urn:nabou:att_e2bf7a37f1939e63cb963279%3Asnapshot%3Af571e04a626d95fb5d6b",
      "@type": "Attestation",
      "schema:name": "The consulted source reports that in 1677, the island of Myloi acquired a pirate king.",
      "properties": {

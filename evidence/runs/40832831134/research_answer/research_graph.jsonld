      "schema:name": "The consulted source reports that Jean Capsi was a Greek from Milo who knew the sea well and had been a pilot for the King's ships for a long time.",
      "properties": {
        "attestation_id": "att_5bb07fe789194b98f639c3c5",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",
        "source_classification": "UNVERIFIED",

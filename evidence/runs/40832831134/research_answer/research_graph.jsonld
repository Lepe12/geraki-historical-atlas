      "schema:name": "{\"end_char\": 515, \"end_line\": 19, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [336], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 397, \"start_line\": 16}",

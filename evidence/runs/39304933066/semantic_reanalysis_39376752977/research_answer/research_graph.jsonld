        "locator": "{\"end_char\": 666, \"end_line\": 28, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"printed_page\": null, \"scan_indexes_0_based\": [140], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 575, \"start_line\": 25}",
        "exact_excerpt": " Le\nPrince Marc de fon côté s'occupoir à\nl’embellifement & à la fareté de fon\nHle de Milo ;",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {

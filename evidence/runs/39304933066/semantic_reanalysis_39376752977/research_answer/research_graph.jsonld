    {
      "@id": "urn:nabou:cite_2e9314cb0cdf759eac27dcb8",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 666, \"end_line\": 28, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"printed_page\": null, \"scan_indexes_0_based\": [140], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 575, \"start_line\": 25}",
      "properties": {

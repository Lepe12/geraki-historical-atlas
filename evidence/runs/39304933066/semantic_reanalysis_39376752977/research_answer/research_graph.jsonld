      "schema:name": "{\"end_char\": 898, \"end_line\": 34, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"printed_page\": null, \"scan_indexes_0_based\": [140], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 705, \"start_line\": 29}",

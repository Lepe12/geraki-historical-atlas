        "model_review": {
          "decision": "FLAGGED",
          "flag": {
            "claim_id": "c-24e1c21ee2737356dd7f",
            "reason": "The statement conflates multiple actors and events without clear distinction. The source does not explicitly mention the Duke's brother consenting to peace or the Duke Jean dying in peace and rest. The text discusses the Duke's actions and the subsequent peace, but the specific details about the Duke's brother and his death are not clearly supported.",
            "decision": "UNCERTAIN"
          },
          "historical_verification": false
        }
      },
      "historically_verified": false
    },

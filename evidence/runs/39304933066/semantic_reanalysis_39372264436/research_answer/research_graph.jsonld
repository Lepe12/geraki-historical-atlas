      "schema:name": "The consulted source reports that the Duke's brother consented to peace, and the Duke Jean died in peace and rest.",
      "properties": {
        "attestation_id": "att_fe70fbf0c2d816a4ff032d23",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",

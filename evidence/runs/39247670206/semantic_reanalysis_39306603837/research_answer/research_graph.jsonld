      "schema:name": "{\"end_char\": 35029, \"end_line\": 343, \"original_inspected\": false, \"pdf_file\": \"library_acquisition/8152ecd35cb5feefa7ecaa81.pdf\", \"printed_page\": null, \"scan_indexes_0_based\": [5], \"source_file\": \"8152ecd35cb5feefa7ecaa81.txt\", \"start_char\": 33454, \"start_line\": 332, \"url\": \"https://www.um.edu.mt/library/oar/bitstream/123456789/22300/1/2004%20%28b%29.The%20Order%20of%20St%20John%20and%20corsairing%20in%20the%20Meditterranean%20in%20the%2016th%20and%20the%2017th%20Centuries.pdf\"}",
      "properties": {

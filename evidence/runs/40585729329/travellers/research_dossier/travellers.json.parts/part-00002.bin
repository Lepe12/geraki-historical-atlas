        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "Vers 450, les habitants de la côte nord d'Afrique, \navec des chefs comme Genséric, commençaient à se \nlivrer aux fameuses pirateries qui ne devaient prendre \nfin qu'en 1830. C'est l'origine de ces pirates barbares- \nques, sur lesquels nous reviendrons plus loin en raison \nd'une certaine analogie avec les corsaires et de leur \ngrande importance dans l'histoire.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

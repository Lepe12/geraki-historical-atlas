          "rights": null
        },
        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "Ainsi les corsaires dans la guerre de !a ligne d'Augs- \nbourg avaient, après l'anéantissement dp!>os escadres, \ndisputé seuls à nos ennemis l'empire de la mer ; ils \navaient sauvé la France de la famine, donné une grande \nprospérité à Dunkerque, Saint-Malo, Nantes et à tous \nnos ports de mer ; enfin, en ruinant le commerce de \nl'Angleterre, de la Hollande et de l'Espagne, ils avaient \nforcé ces nations à la paix et contribué, plus que tons \nautres, à l'un des traités les plus glorieux de notre \nhistoire. La gloire incomparable acquise par les \ncorsaires dans cette seule guerre ne pourrait-elle \nsuffire à réduire en poudre tous les sophismes des \nadversaires de la course ?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/lescorsairesetl00brongoog",
          "source_file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",

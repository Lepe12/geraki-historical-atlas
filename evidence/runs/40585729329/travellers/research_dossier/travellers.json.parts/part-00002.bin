      },
      {
        "finding_id": "section-00bf54b8e6ab1e12d239",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "There  had  been  piracy  in  the  Mediterranean  from \nthe  earliest  times,  and  for  centuries  it  was  pursued \nby  Christians  and  Moslems  alike.  The  captives  were \nreduced  to  slavery,  and  the  condition  of  the  Christian \nslaves  in  Barbary  excited  sympathy  throughout  Eu- \nrope. In  1199  was  founded  in  Paris  the  \"  Order  of \nthe  Holy  Trinity  and  Redemption  of  Captives.\"  The \nmembers,  called  Fathers  of  the  Redemption  or  Mathu- \nrins,  from  the  Church  of  St.  Mathurin,  devoted  their \nlives  to  the  ransom  of  captives  and  the  mitigation  of \ntheir  plight.  Missions  were  established  and  hospitals \nmaintained  in  Barbary.^",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/ournavybarbaryco00alle",
          "source_file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
          "start_char": 10597,
          "end_char": 11285,
          "start_line": 332,
          "end_line": 343,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",

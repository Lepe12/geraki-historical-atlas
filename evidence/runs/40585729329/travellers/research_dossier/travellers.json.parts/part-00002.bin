      {
        "finding_id": "section-bbe4ea9359ed988cf175",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "petty  pirates  who  continued  to  infest  the  Mediter- \nranean until  their  extermination  in  the  nineteenth  cen- \ntury. Many  of  them  were  European  renegades,  and \nthey  devoted  themselves  more  exclusively  to  piratical \ncruising,  while  the  civil  government  fell  into  the  hands \nof  the  Turks.  Until  1671  the  rulers  of  Algiers  were \nappointed  by  the  sultan  or  under  his  control,  but \nfrom  that  time  a  dey  was  elected  by  the  janizaries \nfrom  their  own  number,  and  any  common  soldier  was \neligible.  The  dey  had  despotic  power,  but  was  likely \nat  any  time  to  be  deposed  and  assassinated.  Few  deys \ndied  a  natural  death ;  they  followed  each  other  in \nrapid  succession,  and  it  was  a  long  story  of  anarchy \nand  bloodshed.  In  Tunis  after  1705  the  ruler,  called \nbey,  was  elected  by  the  soldiery.  Tripoli  became  par- \ntially independent  of  the  sultan  in  1714  and  was. \nruled  by  a  pasha.  Morocco  was,  and  still  continues \nto  be,  a  sovereign  power  governed  by  a  sherif  or \nemperor,  now  usually  called  sultan,  who  is  an  abso- \nlute monarch.  The  Morocco  pirates  generally  cruised \nin  the  Atlantic,  and  Sallee  was  their  chief  port,  but, \nowing  to  its  shallow  harbor,  their  vessels  were  built \nsmall  and  light,  so  that  their  operations  were  on  a \nsmaller  scale.  They  became  unusually  active  toward \nthe  end  of  the  eighteenth  century.^",
        "years_in_scope": [
          1671
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-b744a90e3a41ce1a0cd7",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "Along  the  northern  coast  of  Africa,  between  the \nMediterranean  and  the  Sahara,  stretching  from  the \nAtlantic  to  Egypt,  a  distance  of  two  thousand  miles, \nlie  the  Barbary  States.  They  are  Morocco,  Algeria, \nTunis,  and  Tripoli,  with  the  unimportant  Barca  on  the \neast,  generally  included  in  Tripoli.  Of  these  Algeria, \nformerly  called  by  the  name  of  its  capital  Algiers,  and \nnow  a  colony  of  France,  was  the  most  powerful  and \naggressive  in  the  days  of  piracy.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-e7c0fd6662aa80946631",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "off  the  coast  of  Sardinia  and  kidnapped  nearly  a  thou- \nsand people,  mostly  women  and  children.  Many  of  the \npirates  of  the  seventeenth  century  grew  immensely \nand  rapidly  rich  upon  the  plunder  thus  seized  and  the \nransom  of  their  captives.^  With  increasing  boldness \nthey  extended  their  piracies  into  the  ocean  and  along \nthe  European  coast  as  far  as  the  North  Sea  and  even \nto  Iceland.  They  ravaged  the  shores  of  England  and \nIreland,  and  seizing  unsuspecting  inhabitants  bore \nthem  away  into  captivity.^  Later,  when  better  pro- \ntection was  afforded  on  the  coast,  that  is  after  1636, \n\"  those  pirates  still  continued  to  take  prizes  in  the \nocean  ;  and  carrying  their  English  captives  to  France, \ndrove  them  in  chains  overland  to  Marseille,  to  ship  them \nthence,  with  greater  safety,  for  slaves  to  Algiers.\"  ^",
        "years_in_scope": [
          1636
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

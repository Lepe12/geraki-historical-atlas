      {
        "finding_id": "section-8c29b164c14387a6cd5a",
        "file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
        "title": "Les corsaires et la guerre maritime",
        "url": "https://archive.org/details/lescorsairesetl00brongoog",
        "source_bibliography": {
          "creator": [
            "Henry Brongniart"
          ],
          "date": [

        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "In  the  sixteenth  century  the  vessels  of  the  corsairs \nwere  called  galleys,  galleots,  or  brigantines,  according \nto  the  size,  the  latter  being  the  smallest,  with  twelve \nor  fourteen  banks  of  oars,  each  oar  handled  by  one \nman.  The  typical  galley  was  about  one  hundred  and \nfifty  feet  long  with  fifty-four  benches  or  banks,  twenty- \nseven  oars  on  a  side,  each  pulled  by  from  four  to  six",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-2c7713bad888768aeeae",
        "file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
        "title": "Les corsaires et la guerre maritime",
        "url": "https://archive.org/details/lescorsairesetl00brongoog",
        "source_bibliography": {
          "creator": [
            "Henry Brongniart"
          ],
          "date": [
            "1904-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "a A la fin du moyen âge, dit M. de Bœck, et plus \nexactement à la fin du xv\" siècle, les résultats acquis \nsont les suivants : La course a une existence décidé- \nment distincte de la piraterie ; par la concession de la \nlettre de marque, le corsaire revêt une sorte de carac- \ntère public, de plus, et par cela même, il est soumis à \nun contrôle de l'autorité publique. Il doit dans la plu- \npart des pays fournir un cautionnement. II doit con- \nduire ses prises au port d'armement, et ne peut en dis- \nposer qu'après qu'elles lui ont été adjugées par une \nsentence. C'est une cour de prises ou amirauté qui est \nchargée de rendre cette sentence, et sa juridiction est \nefficace: le pouvoir central est assez fort pour tenir \nla main à l'exécution des décisions rendues en matière \nde prises. »",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-678492f263c8c3fda0fa",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "They  were  tumbled  and  kicked  into  the  boat,  taken \naboard  the  pirate,  and  brought  before  the  commander, \nRais  Mahomet,  an  infirm  old  man  described  as  \"  an \nemaciated,  loathsome  figure.\"  Nearly  one  hundred  and \nfifty  Algerines  were  crowded  into  this  small  vessel, \nwhich  was  filthy  in  the  extreme  and  swarming  with \nvermin.  They  arrived  at  Algiers  October  30  and  were \nordered  to  the  Bagnio  Baleck.^",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

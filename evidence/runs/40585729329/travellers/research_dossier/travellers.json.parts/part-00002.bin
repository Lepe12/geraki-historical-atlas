      {
        "finding_id": "section-fabaa9e1ac22e18cf5c8",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "In  November,  1800,  and  January,  1801,  Cathcart \nsent  out  circular  letters  to  American  consuls  in  Medi- \nterranean ports  giving  warning  of  probable  trouble \nin  the  spring.  In  February  the  pasha  repudiated  the \ntreaty,  and  demanded,  as  an  alternative  to  war,  a  new \ntreaty,  without  reference  to  Algiers,  for  which  was  to \nbe  paid  two  hundred  and  fifty  thousand  dollars  and \nan  annual  tribute  of  twenty  thousand.  He  had  re- \ncently concluded  a  treaty  with  Sweden  on  these  terms. \nIt  was  the  policy  of  the  Barbary  States  always  to  be \nat  war  with  some  one,  so  as  to  give  employment  to  the \ncorsairs ;  as  soon  as  peace  was  made  with  one  nation \nit  was  necessary  to  pick  a  quarrel  with  another.  The \npasha  expressed  his  willingness,  for  a  consideration  of \na  hundred  thousand  dollars,  to  allow  the  United  States",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

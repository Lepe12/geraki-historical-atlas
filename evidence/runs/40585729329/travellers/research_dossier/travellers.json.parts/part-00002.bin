          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "« Les corsaires, comme Duguay et Jean Barl, contri- \nbuèrent donc plus que tous à permettre à Louis XIV de \ndonner la paix au monde au moment où il semblait \nréduit à la subir. Il avait désarmé la flotte et manquait \nd'argent pour continuer la guerre. Toutefois il dicta les \nconditions de la paix de Byswick. C'est que les ennemis \nétaient plus épuisés que lui et que les écumeurs de \nmer, les blessant dans leurs intérêts les plus graves, \nles avaient frappés au cœur. »",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/lescorsairesetl00brongoog",
          "source_file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
          "start_char": 77413,
          "end_char": 77885,
          "start_line": 2235,
          "end_line": 2243,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

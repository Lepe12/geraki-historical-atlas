        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "Aujourd'hui les descendants de ces redoutables \nforbans sont nos sujets, et Fromentin nous montre ce \npeuple d'Alger, dans le belvédère élevé des anciens \npirates, « se serrant encore instinctivement contre son \npalladium inutile, et regardant avec un regret inconso- \nlable la mer qui n'est plus à lui » (1).",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/lescorsairesetl00brongoog",
          "source_file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
          "start_char": 45943,
          "end_char": 46252,

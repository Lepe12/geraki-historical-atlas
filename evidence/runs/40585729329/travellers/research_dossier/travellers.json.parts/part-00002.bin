      {
        "finding_id": "section-f546081c10f9d900848b",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "addressed  to  our  honor  as  well  as  our  avarice.  Nor  does \nit  respect  us  as  to  these  pirates  only,  but  as  to  the \nnations  of  Europe.  If  we  wish  our  commerce  to  be  free \nand  uninsulted,  we  must  let  these  nations  see  that  we \nhave  an  energy  which  at  present  they  disbelieve.  The \nlow  opinion  they  entertain  of  our  powers  cannot  fail \nto  involve  us  soon  in  a  naval  war.\"  ^",
        "years_in_scope": [],

        "supporting_evidence": [
          {
            "evidence_kind": "ACQUIRED_TEXT_EXCERPT",
            "source_key": "da777bf33a44b340e528",
            "source_type": "OCR_CONTEXT",
            "text": "Two  principal  qualities  characterized  the  Saletin  fleet.  Speed  was  undoubtedly  the \nfirst,  since  the  efficiency  of  corsair  vessels  mainly  depended  on  their  mobility.  Jean- \nBaptiste  Estelle  from  Marseilles  writes  on  this  subject  that  they  “ always  make  do  with \nwhatever  wind  they  have,  due  to  the  large  sails  with  which  they  are  covered .”  The  second \ncharacteristic  was  the  low  weight  of  their  vessels  which  was  a  function  of  their  small  size, \nwhich  was  required  to  skim  over  the  sandbar  at  the  mouth  of  Bou-Regreg.  [In  1634  there \nwere  just  30  shallow-draft  Qaribs,  a  caravel  modified  for  ocean-going  corsos,  in  the \nharbor.]  Jean-Baptiste  Estelle  clearly  desribed  the  difficulties  encountered  in  entering  the \nport:",
            "locator_status": "ACQUIRED_TEXT_RANGE",
            "text_locator": {
              "url": "https://archive.org/details/2020-tr-of-sale-et-ses-corsaires-1666-1727-maziane-2009",

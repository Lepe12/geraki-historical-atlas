          "rights": null
        },
        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "De pareilles provocations ne firent qu'exciter l'ar- \ndeur de nos corsaires, qui, daûs cette guerre, ue pri- \nrent pas moins de cinq cent soixante-six navires, \nd'une valeur de plus de vingt-huit millions. Dans la seule \nannée 1781, nous en prîmes trois cent cinq, tandis que \nnous n'en perdions que cent quatre- vingt-douze La \nvaleur des captures faites par la marine royale ne \nfigure dans le chiffre total que pour quatorze millions.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/lescorsairesetl00brongoog",
          "source_file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
          "start_char": 95961,
          "end_char": 96398,
          "start_line": 2736,

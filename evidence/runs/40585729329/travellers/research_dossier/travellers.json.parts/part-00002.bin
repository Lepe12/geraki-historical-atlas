      {
        "finding_id": "section-143f17493a0dae7c8000",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "In  1609  the  final  expulsion  of  the  Moriscos  from \nSpain  greatly  recruited  the  strength  of  the  Barbary \nStates.  The  corsairs  not  only  scoured  the  sea,  but \noften  raided  the  coasts  of  Italy,  Spain,  and  the  various \nMediterranean  islands,  sometimes  advancing  consider- \nable distances  inland,  robbing  houses  and  villages  and \ncarrying  off  the  inhabitants  into  slavery.  As  late  as \n1798  an  expedition  from  Tunis  landed  on  an  island \n^  Poole,  ch.  XT ;  also  pp.  22,  262,  note.",
        "years_in_scope": [
          1609
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/ournavybarbaryco00alle",
          "source_file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
          "start_char": 19110,
          "end_char": 19646,
          "start_line": 504,
          "end_line": 512,
          "printed_page": null,
          "scan_indexes_0_based": [],

      {
        "finding_id": "section-3f6158965c9c9aa67898",
        "file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
        "title": "Les corsaires et la guerre maritime",
        "url": "https://archive.org/details/lescorsairesetl00brongoog",
        "source_bibliography": {
          "creator": [
            "Henry Brongniart"
          ],
          "date": [
            "1904-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "pouvaient fournir à la Russie les éléments d'une flotte \nde corsaires, qui, attachés à son service par des lettres \nde marque et couvrant les mers comme d'un réseau, \nharcèleraient et poursuivraient notre ennemi jusque \ndans les parages les plus reculés. Pour prévenir ce \ndanger, le cabinet de Londres tenait beaucoup à se \nconcilier les bonnes dispositions du gouvernement \nfédéral. Il avait conçu l'idée de leur proposer, en \nmême temps qu'au gouvernement français et à tous les \nÉtats maritimes, la conclusion d'un arrangement ayant \npour but la suppression de la course et permettant \nde traiter comme pirate quiconque, en temps de guerre, \nserait trouvé muni de lettres de marque. Ce projet, \nqui fut abandonné dans la suite, témoigne de l'inquié- \ntude, éprouvée par les Anglais. »",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/lescorsairesetl00brongoog",
          "source_file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
          "start_char": 137543,
          "end_char": 138331,
          "start_line": 3847,

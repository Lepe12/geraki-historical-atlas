      {
        "finding_id": "section-0f42d5c03d8764f0dd08",
        "file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
        "title": "Les corsaires et la guerre maritime",
        "url": "https://archive.org/details/lescorsairesetl00brongoog",
        "source_bibliography": {
          "creator": [
            "Henry Brongniart"
          ],
          "date": [
            "1904-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "L'État comprenait, du reste, toute l'importance de \nce genre de guerre, à un moment où l'Espagne, la \nHollande, l'Angleterre surtout, âme de tonte la coali- \ntion, s'unissaient pour nous accabler. Ces trois puis- \nsances, en effet, avaient un commerce florissant, et nos \ncorsaires firent payer cher à chacune d'elles sa parti- \ncipation à la guerre. Comprenant donc tout le parti \nqu'on pouvait tirer de ces auxiliaires volontaires de la \nflotte {lesquels avaient, du reste, déjà fait leurs preuves \ncontre ta Hollande dans la guerre précédente), le mar- \nquis de Seignelay lui-même, fils et successeur de \nColbert, et Louvois armèrent un corsaire pour leur \ncompte et choisirent, pour le commander, Jean Bart \nen personne. On voit à quel point la course était en \nhonneur.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/lescorsairesetl00brongoog",
          "source_file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
          "start_char": 69465,
          "end_char": 70239,
          "start_line": 2033,
          "end_line": 2047,
          "printed_page": null,
          "scan_indexes_0_based": [],

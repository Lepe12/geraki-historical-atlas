      {
        "finding_id": "section-1dc8acb2491c465138f0",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "It  was  hardly  to  be  expected  in  the  early  days,  with \nthe  country  exhausted  and  impoverished  by  the  struggle \nfor  independence,  that  a  correct  course  governing  our \nrelations  with  Barbary  should  have  been  laid  out  and \npursued.  It  was  easier  and  more  natural  to  follow  in \nthe  footsteps  of  Europe.  A  few  wise  and  far-seeing \nmen  knew  what  ought  to  be  done,  and  urged  it ;  but  as \nalways  happens  in  such  cases,  the  politicians  and  the \npeople  were  slow  to  follow,  giving  the  matter  little \nthought,  with  an  exaggerated  idea  of  the  power  of  the \ncorsairs,  and  preferring  measures  which  seemed  easiest \nand  cheapest  at  the  moment.  Time  was  required  to \nform  a  healthy,  self-respecting  public  opinion.  Mean- \nwhile the  wrong  course  was  entered  upon  and  led  to \na  succession  of  later  false  steps  and  complications.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

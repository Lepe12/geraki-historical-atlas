      {
        "finding_id": "section-c616c802dc26b5d5c1f1",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "The  relations  of  the  United  States  with  the  Barbary \npowers  a  century  ago  form  an  interesting  and  roman- \ntic episode  in  American  history  which  has  never  before \nbeen  presented  as  a  complete  story.  While  the  pic- \nturesque exploits  of  Preble  and  Decatur  are  familiar, \nother  adventures  of  American  seamen  and  consuls \namong  the  pirates  of  the  Mediterranean  have  escaped \nnotice,  or  are  barely  mentioned  in  most  histories.  It \nhas  been  necessary  to  explore  original  records  for \nmany  of  the  details.  The  various  events,  scattered \nover  a  period  of  about  forty  years,  are  here  brought \ntogether.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

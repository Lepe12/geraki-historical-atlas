      {
        "finding_id": "section-df8259f4053009ef6608",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "the  right  of  exacting  service.  A  circular  to  this  effect \nwas  at  once  sent  to  American  consuls  In  Mediterranean \nports.  At  last,  on  April  12,  the  Hero  arrived  with  a \nportion  of  the  long  expected  stores.  The  danger  was \nnow  averted,  and  the  bey's  corsairs,  which  had  been \nwaiting  for  orders  to  cruise  against  Americans,  were \nturned  upon  the  Danes.  Eight  Danish  vessels  were \ncaptured,  and  Eaton  purchased  six  of  them  on  credit, \nat  the  request  of  their  captains,  at  risk  of  loss ;  and \nafter  their  difficulties  had  been  settled,  although  he \nhad  an  opportunity  to  sell  the  vessels  at  a  large  profit, \nhe  gave  them  up  to  their  former  owners  on  condition \nof  his  credit  being  redeemed.  For  this  he  received  the \nthanks  of  the  king  of  Denmark.^",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/ournavybarbaryco00alle",
          "source_file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
          "start_char": 146678,
          "end_char": 147536,
          "start_line": 3025,

      {
        "finding_id": "section-b70ce023d9aade952537",
        "file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
        "title": "Les corsaires et la guerre maritime",
        "url": "https://archive.org/details/lescorsairesetl00brongoog",
        "source_bibliography": {
          "creator": [
            "Henry Brongniart"
          ],
          "date": [
            "1904-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "Les conditions de la guerre sur mer ont sans doute \nbien changé depuis nos anciens corsaires, avec la \nvapeur et les torpilles. Mais ce sout précisément les \ncombats d'escadres, les blocus, la stratégie méthodi- \nque en un root, qui, à en croire de nombreux techni- \nciens, seraient devenus parla plus difficiles, non pas la \nguerre de course, puisque tout maintenant serait à la \nmerci des coups de force et des surprises qui sont l'es- \nsence même de la course.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/lescorsairesetl00brongoog",
          "source_file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
          "start_char": 264438,
          "end_char": 264901,
          "start_line": 7315,
          "end_line": 7323,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",

        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "On ne saurait trop insister sur l'origine britannique \ndelà Déclaration de Paris. La France et l'Angleterre \ns'étaient unies pour protéger l'Empire Ottoman contre \nla Russie et s'étaient engagées à ne pas employer de \ncorsaires.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

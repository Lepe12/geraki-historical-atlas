      {
        "finding_id": "section-1ca928d051454e0b18f7",
        "file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
        "title": "Les corsaires et la guerre maritime",
        "url": "https://archive.org/details/lescorsairesetl00brongoog",
        "source_bibliography": {
          "creator": [
            "Henry Brongniart"
          ],
          "date": [
            "1904-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "Si les escadres se livraient à de tels excès, à plus \nforte raison en était-il de même des corsaires indépen- \ndants. De fait, les habitants de l'Archipel se livrèrent à \nla piraterie et pillèrent des navires neutres sous pré- \ntexte de contrebande de guerre. Ils ravagèrent surtout \nles abords du golfe de Salonique, les côtes de la Syrie \net de l'Egypte. Us établirent même des batteries dans \nl'îlot de Gabouza, où l'amiral de Rigny vint brûler \nleurs vaisseaux, acte qui lui valut les remerciements du \ngouvernement hellénique.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/lescorsairesetl00brongoog",
          "source_file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",

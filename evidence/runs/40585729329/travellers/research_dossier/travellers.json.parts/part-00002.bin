      {
        "finding_id": "section-0501a2138e931f17cdd5",
        "file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
        "title": "Les corsaires et la guerre maritime",
        "url": "https://archive.org/details/lescorsairesetl00brongoog",
        "source_bibliography": {
          "creator": [
            "Henry Brongniart"
          ],
          "date": [
            "1904-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "C'est pour se conformer à ees vues du cabinet de \nLondres que la France et l'Angleterre déclarèrent \nsimultanément renoncer -à l'usage des corsaires. \nCes explications de notre ministre prouvent encore \nque l'Angleterre se basait, non sur la décadence \nde la course, mais sur sa trop grande efficacité. \nEn redoutant le concours des corsaires américains \nau profit de la Russie, elle avouait l'utilité de la \ncourse.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-a8fc8cde4df91a9fa1ac",
        "file": "lescorsairesetl00brongoog_lescorsairesetl00brongoog_djvu.txt",
        "title": "Les corsaires et la guerre maritime",
        "url": "https://archive.org/details/lescorsairesetl00brongoog",
        "source_bibliography": {
          "creator": [
            "Henry Brongniart"
          ],
          "date": [
            "1904-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "007e06fd7df9b6dea929fb59ca89d7a17f946d9f8ee7577f6d9c3dd52d317554",
        "evidence_excerpt": "Reportons-nous pour cela à la guerre de succession \nd'Espagne et à une anecdote très suggestive rappor- \ntée par Monentheûil. Bien qu'on fût en guerre avec les \nHollandais, notre commerce ayant besoin de leur \nmarine marchande, on dut leur accorderdes passeports \npour leur permettre de venir dans nos ports. A partir \nde ce moment, nos corsaires ne rencontrèrent plus que \ndes navires portant pavillon hollandais et munis de pas- \nseports. Inutile d'insister sur le peu d'authenticité de \nces pavillons et de ces passeports de circonstance. La \ncourse devenait impossible. Il fallut réduire considéra- \nblement le nombre des passeports. Pendant la Révolu- \ntion, les fraudes de ce genre furent également nom- \nbreuses. Et, dans la guerre de Sécession, les cinq \ndouzièmes des transports, qui se faisaient en 1860 \nsous pavillon américain, se firent en 1863 sous pavil- \nlon neutre. En même temps, un sixième des navires \naméricains était vendu, souvent fictivement.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

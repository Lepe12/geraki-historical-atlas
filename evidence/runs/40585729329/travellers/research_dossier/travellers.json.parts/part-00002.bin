      {
        "finding_id": "section-a57c2f90924f1b53ee43",
        "file": "lescorsairesbar00gravgoog_lescorsairesbar00gravgoog_djvu.txt",
        "title": "Les corsaires barbaresques et la marine de Soliman le Grand",
        "url": "https://archive.org/details/lescorsairesbar00gravgoog",
        "source_bibliography": {
          "creator": [
            "Edmond Jurien De La Gravière, Jurien de la Gravière"
          ],

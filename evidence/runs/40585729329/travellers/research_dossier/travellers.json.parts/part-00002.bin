      {
        "finding_id": "section-51d27f14b90014bc8822",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "After  making  peace  with  Spain,  Algiers  went  to \nwar  with  Portugal,  and  the  latter  power  kept  the  Straits \nof  Gibraltar  closed  against  Algerine  cruisers,  so  that \nAmerican  vessels  in  the  Atlantic  were  safe  from  the \ncorsairs.  Few  Americans  entered  the  Mediterranean, \nand  those  that  did  were  generally  protected  by  the \nDutch,  Portuguese,  or  Spanish  cruisers.  Sometimes \nAmericans  had  forged  or  purchased  passes,  so  that \nthe  Algerines  could  not  distinguish  them  from  English \nvessels,  with  which  they  dared  not  interfere.  These \npasses  were  given  to  the  vessels  of  nations  having \ntreaties  with  Algiers.  They  were  inscribed  with  Arabic \ncharacters,  and  the  corsairs  tested  their  genuineness \nby  means  of  a  stick  with  notches  corresponding  to \nengraved  figures  on  the  margin  of  the  pass.^",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

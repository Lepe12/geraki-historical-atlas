      },
      {
        "finding_id": "section-fc77aaa6e3908aee74d0",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "amicable.  They  traded  together  and  made  enlight- \nened treaties.  But  with  the  dawn  of  the  sixteenth  cen- \ntury appears  a  change  in  the  conditions,  and  hence- \nforth a  state  of  chronic  warfare  between  Christians \nand  Moors.  Then  began  the  period  of  activity  of  the \nBarbary  corsairs  which  lasted  about  three  hundred \nyears.  This  was  chiefly  the  result  of  the  conquest  of \nGranada  in  1492,  which  was  followed  by  the  exodus \nof  thousands  of  Moriscos  who  passed  over  to  Africa \nand  not  only  greatly  swelled  the  numbers  in  Barbary, \nbut  carried  with  them  a  hatred  of  the  Spanish  and \na  thirst  for  vengeance  which  early  found  vent  in \npiratical  raids  along  the  Spanish  coast.^",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

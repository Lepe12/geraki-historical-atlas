      {
        "finding_id": "section-5057ace381a60073ffb0",
        "file": "ournavybarbaryco00alle_ournavybarbaryco00alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco00alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e15e3a557e79edec2ea71b2b5ccd1015a5ec882a666c35aba27115b05eadb074",
        "evidence_excerpt": "The  Alleghany  sailed  at  once  for  Gibraltar.  On \nthe  passage  she  fell  in  with  a  British  brig-of-war,  but \nwas  not  detained,  the  fact  of  war  having  been  declared \nby  the  United  States  against  England  about  six  weeks \nbefore  being  still  unknown  in  the  Mediterranean.  In \nhis  report  Lear  says :  \"  Should  our  differences  with \nGreat  Britain  be  so  accommodated  as  to  admit  of \nsending  a  naval  force  into  this  sea,  I  am  sure  there \nis  only  one  course  which  the  government  will  pursue, \nand  what  has  now  taken  place  may  be  a  happy  and \nfortunate  event  for  the  United  States,  by  relieving \nthem  from  a  disgraceful  tribute  and  an  imperious  and \npiratical  depredation  on  their  commerce.  If  our  small \nnaval  force  can  operate  freely  in  this  sea,  Algiers  will \nbe  humbled  to  the  dust.  ...  I  shall  proceed  in  the \nAlleghany  to  Gibraltar,  where  I  shall  dispose  of  her",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

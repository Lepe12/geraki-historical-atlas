        "source_id": "src_a0e0467a577198f4d3b6c4cde090fe2d",
        "locator": "{\"end_char\": 5239, \"end_line\": 108, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 5047, \"start_line\": 108}",

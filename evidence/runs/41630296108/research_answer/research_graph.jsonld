    {
      "@id": "urn:nabou:cite_abb4954caa2deb8e5528e749",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 1490, \"end_line\": 91, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1313, \"start_line\": 91}",
      "properties": {
        "source_id": "src_c8ceb856a90ba889085a390073ceb604",
        "locator": "{\"end_char\": 1490, \"end_line\": 91, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1313, \"start_line\": 91}",

    {
      "@id": "urn:nabou:att_55d23b5094508d4b83696aaf%3Asnapshot%3A7e0f21315bc1061884b6",
      "@type": "Attestation",
      "schema:name": "The consulted source reports that Kimolos was referred to as Argintierra by the Italians, due to its silver-colored coasts or believed silver mines.",
      "properties": {
        "attestation_id": "att_55d23b5094508d4b83696aaf",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",
        "source_classification": "UNVERIFIED",
        "model_review": {
          "decision": "FLAGGED",
          "flag": {
            "claim_id": "c-87a9fe2db28365a2dccc",
            "reason": "The statement claims that Kimolos was referred to as Argintierra by the Italians due to silver-colored coasts or believed silver mines. However, the provided quote does not mention 'Argintierra' or any reference to the Italians, silver-colored coasts, or silver mines. The quote discusses the island's role as a pirate base during the Turkish-Venetian war and other historical events, but does not support the specific claim about the name 'Argintierra' or its etymology.",
            "decision": "UNSUPPORTED"
          },
          "historical_verification": false
        }
      },
      "historically_verified": false
    },

    },
    {
      "@id": "urn:nabou:cite_d7dea210a17b2d46c690d10f",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 19451, \"end_line\": 494, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 19164, \"start_line\": 490}",
      "properties": {
        "source_id": "src_1ab717d973c5fda51489b52e3d9a7da0",
        "locator": "{\"end_char\": 19451, \"end_line\": 494, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 19164, \"start_line\": 490}",
        "exact_excerpt": "  The  corsairs  not  only  scoured  the  sea,  but \noften  raided  the  coasts  of  Italy,  Spain,  and  the  various \nMediterranean  islands,  sometimes  advancing  consider- \nable distances  inland,  robbing  houses  and  villages  and \ncarrying  off  the  inhabitants  into  slavery.",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_24b66874b03680dbedbfc9af",

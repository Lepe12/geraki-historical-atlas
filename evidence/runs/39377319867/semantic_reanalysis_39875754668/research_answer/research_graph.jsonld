    {
      "@id": "urn:nabou:att_59bd281edc513f5600eb3381%3Asnapshot%3A0f925aadac4d5e0598b6",
      "@type": "Attestation",
      "schema:name": "The source reports that Dieudé left Crete in 1686 and settled in Milos, collaborating with Ottoman adversaries.",
      "properties": {
        "attestation_id": "att_59bd281edc513f5600eb3381",
        "status": "UNREVIEWED",
        "historically_verified": false,

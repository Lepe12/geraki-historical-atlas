    {
      "@id": "urn:nabou:att_ced19cc17c2425efd6ed095f%3Asnapshot%3A061dd4f0606d3810e072",
      "@type": "Attestation",
      "schema:name": "The source reports that Astypalaia provided safe anchorages for corsairs, allowing them to stock up on provisions and water.",
      "properties": {
        "attestation_id": "att_ced19cc17c2425efd6ed095f",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",

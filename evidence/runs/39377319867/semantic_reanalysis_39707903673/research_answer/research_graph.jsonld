    {
      "@id": "urn:nabou:att_8c550e36f2102b8c6a1162fe%3Asnapshot%3Ac31aeb0f9f250c20e284",
      "@type": "Attestation",
      "schema:name": "The source reports that a corsair from Zante, Stathis Romanos, known as Manettas, participated in activities on the islands of the Levant.",
      "properties": {
        "attestation_id": "att_8c550e36f2102b8c6a1162fe",
        "status": "UNREVIEWED",
        "historically_verified": false,

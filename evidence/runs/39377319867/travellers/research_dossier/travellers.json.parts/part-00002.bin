      {
        "finding_id": "section-30b203f144a1647ce76b",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "In  Kheyr-ed-Din  Barbarossa  sound  strategical \ninstinct  went  hand  in  hand  with  the  desperate \nvalour  of  the  corsair.  To  dally  in  the  Golden  Horn \nwhile  so  rich  a  prey  was  at  sea  to  be  picked  up \nby  his  Christian  foes  was  altogether  opposed  to  his \ninstincts  :  never  to  throw  away  a  chance  in  the \ngame  of  life  had  ever  been  his  guiding  principle.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-67763d93809f70f60fa7",
        "file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco02alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1135a3a79197e1c82225ecc0079d7260b2a1d27346d5b5129e0575b8a3277b07",
        "evidence_excerpt": "In  1509  a  Spanish  expedition  under  Cardinal \nXimenes  captured  Oran,  which  was  held  by  Spain  for \ntwo  centuries.  The  Spaniards  also  took  Algiers  the \nnext  year,  but  held  only  the  small  island,  just  off \nshore,  from  which  the  city  takes  its  name,  and  which \nthey  fortified.  This  stronghold,  called  Peiion  de  Alger, \ncompletely  controlled  the  harbor  and  greatly  interfered \nwith  the  movements  of  the  corsairs.  The  island  was \nafterwards  connected  with  the  city  by  a  causeway.  In \n1516  Horuk  Barbarossa  went  to  Algiers,  having  been \n1  Poole,  pp.  7,  8.  2  Ibid.  ch.  iii.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/ournavybarbaryco02alle",
          "source_file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",

      {
        "finding_id": "section-ff6eaafc141a04a54014",
        "file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco02alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1135a3a79197e1c82225ecc0079d7260b2a1d27346d5b5129e0575b8a3277b07",
        "evidence_excerpt": "The  attitude  of  Europe  towards  the  Barbary  States \nwas  cowardly  and  dishonorable  from  first  to  last.  The \naction  of  the  stronger  powers  was  prompted  largely  by \npolicy.  In  order  to  injure  their  enemies  and  to  crush \nthe  commercial  competition  of  their  weak  neighbors, \nthey  were  willing  to  bribe  and  subsidize  the  corsairs, \nsubmitting  to  the  indignity  and  dishonor  of  being \ntributary  nations  and  encouraging  a  system  of  ruthless \npiracy  and  slavery.  For  two  hundred  and  thirty  years \nEngland  sent  consuls  to  Algiers  who  were  forced  to \nendure  every  insult  and,  if  showing  the  least  spirit, \nwere  recalled  at  the  dictation  of  the  dey  and  more \nobsequious  substitutes  sent  with  presents  and  friendly \nor  apologetic  letters.  As  late  as  the  nineteenth  cen- \ntury a  Danish  and  a  French  consul  were  thrown  into \nprison  and  made  to  labor  with  the  slaves  because  of \ndelay  in  paying  tribute.^",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-b602dc8e9375aef14d29",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "This  contention  is  by  no  means  invalidated  by \nthe  fact  that  frequently  the  corsairs  were  defeated \nby  land  forces  embarked  on  board  ship.  Thus  when \nDragut  was  defending  Tripoli  against  an  expedi- \ntion sent  against  him  in  1559  by  the  combined \nforces  of  Spain,  Tuscany,  Rome,  Naples,  Sicily,  and \nGenoa,  of  one  hundred  sail  which  embarked  four- \nteen thousand  troops,  he  was  relieved  by  Piali,  the \nAdmiral  of  Soliman  the  Magnificent,  who  came  to \nhis  assistance  with  eighty-six  galleys,  each  of  which \nhad  on  board  one  hundred  Janissaries,  and  who \ngained  so  striking  a  victory  over  the  Christians  that \nthe  Turkish  Admiral  returned  to  Constantinople \nwith  no  less  than  four  thousand  prisoners.  But \nin  this  case,  as  in  so  many  others,  the  actual  hos- \ntilities took  place  on  shore,  where  the  troops \nhad  the  opportunity  of  displaying  their  sterling \nqualities.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-b4d2d8a0849be1faade4",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  deeds  of  the  buccaneers  of  the  next  century \nin  the  Spanish  Main  sink  into  comparative  insig- \nnificance when  compared  with  what  was  accom- \nplished by  such  a  man  as  Kheyr-ed-Din  Barbarossa, \nwho  was  known,  and  rightly  known,  by  his  con- \ntemporaries, and  for  many  generations  of  Moslem \nseamen  yet  to  come,  as  \"  the  King  of  the  Sea.\"  The \ncapture  of  Panama  by  Sir  Henry  Morgan  in  January \n1671  was  possibly  as  remarkable  a  feat  of  arms  as \nwas  ever  accomplished,  but  it  cannot  rank  in  its \nimportance  to  civilised  mankind  on  the  same  plane \nas  those  memorable  battles  in  the  Mediterranean  of \nwhich  mention  has  been  made  as  having  been  fought \nby  the  Moslem  corsairs.",
        "years_in_scope": [
          1671
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

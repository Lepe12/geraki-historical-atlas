      {
        "finding_id": "section-cc426d9196ed358373b4",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "When  this  happened  he  became  either  a  \"  gal- \nlerian,\"  rowing  out  his  heart  on  the  benches  of  the \nMoslem  galleys,  or  he  festered  in  some  noisome \ndungeon  in  Algiers,  Oran,  or  Tlemcen.  For  him, \nhowever,  there  was  always  one  avenue  of  escape  open: \nhe  had  but  to  acknowledge  that  Mahomet  was  the \nProphet  of  God  and  the  prison  doors  would  fly  open, \nor  the  shackles  be  knocked  off  the  chain  which \nbound  him  to  the  hell  of  the  rower's  bench.  Many \nof  the  Christian  captives  had  really  nothing  to  bind \nthem  to  the  faith  of  their  fathers — neither  home  nor \nlands,  wealth  nor  kindred,  and  they  were  doubtless \ndazzled  by  the  amazing  success  which  accompanied \nthe  arms  of  the  leaders  of  the  pirates.  Is  it  wonder- \nful, then,  that  such  men  in  such  an  age  should  grasp \nat  the  chance  of  freedom  and  throw  in  their  lot \nwith  their  captors  ?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

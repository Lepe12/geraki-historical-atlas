      {
        "finding_id": "section-6b8d5bf3ae276dbde153",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "With  the  results  to  Europe  of  this  amazing \nbattle  we  have  nothing  to  do  in  this  book.  That \nwhich  it  demonstrated,  as  far  as  the  Sea-wolves \nwere  concerned,  was  that  they  still  remained  the \nmost  competent  seamen  and  sea-fighters  in  the \nMediterranean,  and  that  the  legend  of  the  invinci- \nbility of  the  Ottomans  at  sea  rested  on  what  had \nbeen  accomplished  during  a  long  period  of  years  by \nthese  insatiable  pirates  and  magnificent  warriors.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

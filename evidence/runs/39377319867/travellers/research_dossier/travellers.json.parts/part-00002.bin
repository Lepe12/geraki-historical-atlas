        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "The corsair captains stood partly outside the register. A captain's standing was \nreckoned in his ship and his shares, and a ship, unlike an office, was property that could \nbe sold and left to heirs. That standing survived a change of dey; it did not survive a \nchange in the balance of power at sea. The captains’ interest was in war with those who \nhad not bought a peace, and in fewer treaties rather than more. For most of the order's \nhistory that interest ran with the corps's, because prizes paid the pay. After the \nbombardment of 1816 and the loss of the corsair trade, the one group in the ruling \norder whose wealth was reckoned in heritable capital lost the flow that capital had been",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/the-regency-of-algiers",
          "source_file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
          "start_char": 252342,
          "end_char": 253039,
          "start_line": 4729,
          "end_line": 4736,
          "printed_page": null,
          "scan_indexes_0_based": [],

      {
        "finding_id": "section-9ace97e524215af0c0c8",
        "file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco02alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1135a3a79197e1c82225ecc0079d7260b2a1d27346d5b5129e0575b8a3277b07",
        "evidence_excerpt": "One  of  Yusuf's  first  acts  was  the  conclusion  of  the \ntreaty  with  the  United  States.  This  was  procured  at \nfar  less  expenditure,  to  the  United  States,  of  time, \ntrouble,  and  money,  than  the  treaties  with  Algiers  and \nTunis.  The  pasha  seems  soon  to  have  come  to  appre- \nciate this  fact  and  to  realize  that  he  had  not  made  as \ngood  a  bargain  as  his  fellow  pirates.  Accordingly, \nafter  a  few  months  of  apparent  contentment  following \nthe  settlement  with  Consul  Cathcart  in  the  spring  of \n1799,2  he  became  dissatisfied,  and  not  less  so  as  he \nviewed  the  growing  and  unprotected  American  com- \nmerce in  the  Mediterranean.  Under  the  circumstances \nthe  temptation  to  break  the  peace  was  doubtless  strong \n^  Greenhow,  pp.  11,  12.  ^  See  above,  p.  67.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/ournavybarbaryco02alle",
          "source_file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",
          "start_char": 180846,
          "end_char": 181697,
          "start_line": 3695,
          "end_line": 3708,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,

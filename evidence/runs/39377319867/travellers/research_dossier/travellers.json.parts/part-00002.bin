      {
        "finding_id": "section-b28b97148a17cc351c4d",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Once  again  was  Andrea  Doria  ordered  to  put \nto  sea  to  fight  against  neither  small  nor  great \nsave  Dragut  alone ;  he  was  to  take  him  dead  or \nalive,  but  alive  by  choice,  in  order  that  he  might \nbe  made  to  answer  at  the  bar  of  Christian  justice \nfor  all  the  atrocities  committed  by  him  both  by \nland  and  sea.  The  corsair  had  returned  in  the \nmeanwhile  to  Jerbah,  an  island  on  the  east  coast \nof  Tunis  much  affected  by  the  sea-wolves,  and \nwhich  in  contemporary  histories  is  known  as \nJerbah,  as  Los  Gelues  (by  the  Spanish  writers), \nas  Gelves,  and  various  other  names  which  greatly \nconfuse  its  identity.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "Put those two passages side by side and the arrangement that held the Regency \ntogether for three centuries is already visible. The ordinary soldier lost nothing when a \ndey was killed; he gained a rise in pay. The officers who did not conspire lost nothing by \nbowing to the winner, and risked everything by refusing. The conspirators risked their \nlives for the only prize in the order that no rule of seniority could deliver. And nobody",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-69ac51491f55fce5c657",
        "file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
        "title": "The Regency Of Algiers",
        "url": "https://archive.org/details/the-regency-of-algiers",
        "source_bibliography": {
          "creator": "Thomas J. Bryan, Claude/Anthropic",
          "date": [
            "2026-09-16T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "The English version of Laugier de Tassy's history, published in 1750 from a French \noriginal written by a man who, catalogue descriptions say, served in the French \nconsulate at Algiers in 1717-18, gives the arrangement as the Regency's own officials \nremembered it two centuries later. The sultan sent two thousand janissaries fully \narmed; and \"the Ottoman Porte was very punctual in sending over Recruits every Year, \nwith Money for the Payment\" of the troops. In the first generation, then, the men who \nheld Algiers came from the sultan and were paid, at least in part, from the sultan's \npurse. They were the sultan’s men lent to his lieutenant, and the lieutenant's other \nforce — the corsair crews who had come west with the brothers and were paid in shares \nof what they took — was a separate body with a separate paymaster.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,

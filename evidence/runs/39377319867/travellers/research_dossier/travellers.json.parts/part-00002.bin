        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Dragut  now  returned  to  Constantinople  to  receive \ncongratulations  upon  his  escape,  and  to  take  part \nin  a  fresh  design  of  stirring  up  the  Sultan  against \nthe  Christians.  All  who  professed  this  faith  were \nnaturally  obnoxious  to  the  corsair  ;  but  his  private",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

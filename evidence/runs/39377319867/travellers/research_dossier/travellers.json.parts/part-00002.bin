      {
        "finding_id": "section-800c4a7c227e74f2807f",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Meanwhile  in  Tunis  Kheyr-ed-Din  was  working \ndouble  tides.  He  was  kept  well  informed  by  his \nspies  of  all  that  was  going  on,  and  his  preparations \nfor  defence  were  as  adequate  as  they  could  be  made ; \nthe  corsairs,  as  we  have  said,  had  come  flocking  in \nat  his  call.  He  had  withdrawn  as  many  of  his \nfighting  men  from  Algiers  as  he  deemed  prudent. \nKnowing  that  the  attack  was  directed  against  him \npersonally,  he  had  not  much  fear  that  it  would  be \ndiverted  at  the  last  moment.  It  would  have  been \ntrue  strategy  on  the  part  of  Charles  to  have  done \nthis,  but  the  Emperor  considered  that  his  honour \nrequired  that  the  attack  should  be  an  absolutely \ndirect  one,  and  so  Algiers  was  left  on  one  side,  to  the",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

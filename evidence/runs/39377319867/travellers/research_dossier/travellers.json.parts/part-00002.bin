      {
        "finding_id": "section-489f13e12ff060f25a92",
        "file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
        "title": "The Regency Of Algiers",
        "url": "https://archive.org/details/the-regency-of-algiers",
        "source_bibliography": {
          "creator": "Thomas J. Bryan, Claude/Anthropic",
          "date": [
            "2026-09-16T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "And the comparison with the Atlantic is true and is not an acquittal. The scale of \none crime does not reduce another; the man chained in the bagnio at Algiers was not \nconsoled by the statistics of Liverpool, and the African in the hold of a Liverpool ship \nwas not consoled by the price list of the Batistan. What the comparison does establish is \nthat the word the tribute-payers used — pirates — described a licensed maritime war \nthat their own states conducted too, and that the moral language they aimed at Algiers \nwas not available to them on the evidence of their own ships.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

      {
        "finding_id": "section-462664cfec8a3938960b",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Alert,  strong,  capable,  and  vigorous,  he  became \nin  early  manhood  chief  boatswain  in  the  galley  in \nwhich  his  apprenticeship  had  been  passed — a  posi- \ntion which  enabled  him  to  accumulate  a  small  store \nof  ducats,  with  which  he  bought  a  share  in  a  brig- \nantine.  Here  he  soon  acquired  sufficient  wealth \nto  become  captain  and  owner  of  a  galley,  in  which \nhe  soon  gained  the  reputation  of  being  one  of  the \nboldest  corsairs  on  the  Barbary  coast.  Having  in \nsome  sort  made  a  name  for  himself,  Lis  next  step \nwas  to  seek  for  a  patron  who  could  make  use  of  his \nvalour,  address,  and  capability  for  command.  His \nchoice  was  soon  made,  as  who  in  all  the  Mediter- \nranean, in  his  early  days,  held  such  a  name  as \nDragut  ?  He  accordingly  entered  the  service  of  the \nBasha  of  Tripoli,  and,  under  his  command,  became \nwell  known  to  the  officers  of  the  Grand  Turk,  par- \nticularly to  the  Admiral,  Piali  Basha,  to  whom  he \nwas  able  to  render  some  important  services.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

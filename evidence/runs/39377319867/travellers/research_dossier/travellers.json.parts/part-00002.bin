      {
        "finding_id": "section-01f05ca2204648f781d4",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "In  the  year  1546,  Kheyr-ed-Din  Barbarossa  died, \nand  to  replace  him  the  Sultan  Soliman  ordered  all \nthe  mariners  hi  his  dominions  to  acknowledge  Dragut- \nReis  as  their  admiral,  and  to  obey  him  in  the  same \nmanner  as  they  had  obeyed  his  predecessor.  From \nthis  date  he  was  the  foremost  corsair  in  the  Mediter- \nranean, and  the  feats  which  were  performed  by  him \nshowed  that  the  Padishah  had  not  erred  in  his \nselection.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,

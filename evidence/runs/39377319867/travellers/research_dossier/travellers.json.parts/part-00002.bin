      {
        "finding_id": "section-90b43b4151d608ac96ae",
        "file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
        "title": "The Regency Of Algiers",
        "url": "https://archive.org/details/the-regency-of-algiers",

      {
        "finding_id": "section-d8186cbd7220be5be5c5",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "THE  rise  and  progress  of  the  Moslem  corsairs \nof  the  Mediterranean  is  a  most  curious  and \ninteresting  historical  fact.  The  causes  which  led \nto  results  so  deplorable  to  commerce,  civilisation, \nand  Christianity  are  set  forth  in  this  chapter  in \norder  that  some  idea  may  be  formed  of  the  state  of \naffairs  in  that  region  at  the  end  of  the  fifteenth  and \nthe  beginning  of  the  sixteenth  centuries,  and  also  that \nthe  reflex  action  of  the  great  triumph  of  the  Christian \narmies  in  Spain  may  be  more  fully  understood.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/seawolvesofmedit00curruoft",
          "source_file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
          "start_char": 61343,
          "end_char": 61933,
          "start_line": 1430,
          "end_line": 1439,
          "printed_page": null,
          "scan_indexes_0_based": [],

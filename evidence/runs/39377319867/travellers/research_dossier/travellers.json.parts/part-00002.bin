        "file": "peopleplaces00gold_peopleplaces00gold_djvu.txt",
        "title": "People and places",
        "url": "https://archive.org/details/peopleplaces00gold",
        "source_bibliography": {
          "creator": "Goldring, Douglas, 1887-1960",

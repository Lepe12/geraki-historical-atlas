      {
        "finding_id": "section-891388cb3e996f35e4ee",
        "file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
        "title": "The Regency Of Algiers",
        "url": "https://archive.org/details/the-regency-of-algiers",
        "source_bibliography": {
          "creator": "Thomas J. Bryan, Claude/Anthropic",
          "date": [
            "2026-09-16T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "And beneath all five lies the word the study was built to set aside: pirate. Corsairing \nfrom Algiers was licensed, taxed, recorded in a register with a share table, conducted \nunder a flag and limited by treaties with named powers — which is to say it was \nprivateering, the instrument every maritime state of the period used, including the \nKnights of St John on the opposite shore. The study establishes the table, the register",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/the-regency-of-algiers",
          "source_file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
          "start_char": 9606,
          "end_char": 10036,
          "start_line": 258,
          "end_line": 262,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "original_inspected": false
        },

      {
        "finding_id": "section-c0a3d494932ade1d7573",
        "file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
        "title": "The Regency Of Algiers",
        "url": "https://archive.org/details/the-regency-of-algiers",
        "source_bibliography": {
          "creator": "Thomas J. Bryan, Claude/Anthropic",
          "date": [
            "2026-09-16T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "The first thing this ground forces is a correction to the question of where the \nchallenger came upon organised violence. The received account, which I carried into \nthe research, has a corsair seizing a city. The three witnesses, writing from three \npositions that share nothing — a Spanish churchman, a Granadan Muslim in Christian \nItaly, and the brothers’ own panegyrist — agree on something more specific: the \nbrothers came as hired protection. The town had been buying its security for a \ngeneration from whoever could reach it, and in 1516 it hired Aruj against the Spanish \nfort on the same terms it had used before. The conqueror's violence entered this \ncountry as a wage paid by the people who would be conquered, and the conquest \nproper was the moment the contractor killed the employer and kept the contract. That \nis a route to power the framework should carry explicitly — the order founded by the \nprotector the conquered hired — because it predicts a specific inheritance: an apex \nwhose standing began as an employment and whose men would always know it.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/the-regency-of-algiers",
          "source_file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
          "start_char": 52489,
          "end_char": 53563,
          "start_line": 1059,
          "end_line": 1071,
          "printed_page": null,

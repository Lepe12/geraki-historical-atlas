          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Ali  was  never  married,  and  left  no  descendants  ; \nin  the  later  years  of  his  life  he  built  himself  a  sump- \ntuous palace  some  five  miles  from  Constantinople, \nand  no  man  in  all  the  realm  save  the  Sultan  himself \nwas  so  great  a  man  as  the  Calabrian  renegado,  the \nunknown  waif  from  Southern  Italy  who  possessed \nneither  name  nor  kindred.  He  was  tall  and  robust \nin  stature,  but  all  his  life  suffered  from  \"  scald- \nhead  \" ;  for  a  definition  of  which  ailment  we  may \nrefer  the  curious  to  the  dictionary.  He  possessed, \nfor  a  chieftain  and  a  fighting  man,  the  disadvantage \nof  a  voice  so  hoarse  as  to  be  inaudible  at  a  few \npaces  distant.  In  default  of  offspring  he  maintained \nat  his  charges  five  hundred  corsairs,  whom  he  called \nhis  children.  He  died  in  the  year  1580,  and  with \nhim  what  has  been  called  the  \"  Grand  Period  of \nthe  Moslem  Corsairs  \"  in  this  book  may  be  said  to \nhave  come  to  an  end.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

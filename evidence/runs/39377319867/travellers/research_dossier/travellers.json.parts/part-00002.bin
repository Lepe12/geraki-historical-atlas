          "rights": null
        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "The second is why the violence, where it happened, did not change the order. Every \nman in the corps held his standing in the register, and the register did not depend on \nwho was dey. The soldier gained a rise when a dey was killed and bowed to the winner \nfrom prudence; the conspirator risked only himself; the defeated faction's leaders died \nand the structure did not. Each man defending his own place defended the whole, and \nthe dey was the one piece of the whole that none of them needed to defend.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/the-regency-of-algiers",
          "source_file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",

      {
        "finding_id": "section-ca985f704b2b161cbd4e",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "It  is  with  these  constituent  elements  that  the \npiratical  leader  had  to  deal,  trusting  to  the  strength \nof  his  own  arm,  the  subtlety  of  his  own  unassisted \nbrain.  Some  among  these  leaders  have  risen  to \neminence  in  their  evil  lives,  most  of  them  have \nbeen  the  captains  of  single  ships  preying  on  com- \nmerce in  an  indiscriminate  manner ;  but  this  was \nnot  the  case  with  the  Sea-wolves  of  the  Mediter- \nranean. Primarily  sea-robbers  they  were  of  course, \nbut  as  time  and  opportunity  developed  their  char- \nacters they  rose  to  meet  occasion,  to  take  fortune \nat  the  flood,  in  a  manner  that,  had  they  been  pur- \nsuing any  other  career,  would  most  certainly  have \ncaused  them  to  rise  to  eminence.  Into  the  fierce \nand  blood-stained  turmoil  of  their  lives  there \nentered  something  unknown  to  any  other  pirates  : \nthis  was  religious  fanaticism — a  fanaticism  so  en- \ngrained in  character,  a  belief  held  to  with  such \npassionate  tenacity,  that  men  stained  with  every \nconceivable  crime  held  that  their  passage  to  Para- \ndise was  absolutely  secure  because  of  the  faith \nwhich  they  professed.  Tradition,  sentiment,  dis-",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

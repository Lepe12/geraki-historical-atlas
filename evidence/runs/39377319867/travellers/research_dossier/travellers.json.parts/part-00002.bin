      },
      {
        "finding_id": "section-9287ad2ad7f99bdeb77a",
        "file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco02alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1135a3a79197e1c82225ecc0079d7260b2a1d27346d5b5129e0575b8a3277b07",
        "evidence_excerpt": "The  situation  in  Algiers  was  complicated  by  the \ncapture  of  the  Maria  and  Dauphin,  and  involved  the \nquestion  of  ransom  of  the  captives  as  well  as  of  peace. \nThese  vessels  were  taken  as  a  result  of  a  peace  con- \ncluded between  Algiers  and  Spain,  which  allowed  the \nAlgerines  to  pass  the  Straits.  July  19,  1785,  only  a \nfew  days  before  the  fu'st  capture,  William  Carmichael, \nour  charge  d'affaires  in  Spain,  wrote  to  Jefferson : \n\"  I  am  alarmed  on  account  of  the  Algerines.  Their \npeace  with  Spain  has  opened  a  large  field  to  their \npiracies.\"  *",
        "years_in_scope": [],

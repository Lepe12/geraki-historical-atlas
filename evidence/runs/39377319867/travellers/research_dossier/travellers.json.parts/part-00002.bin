      {
        "finding_id": "section-5cc2088147c05bed64bd",
        "file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
        "title": "The Regency Of Algiers",
        "url": "https://archive.org/details/the-regency-of-algiers",
        "source_bibliography": {
          "creator": "Thomas J. Bryan, Claude/Anthropic",
          "date": [
            "2026-09-16T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "The second is that every change that did alter the order was made by armed men \nwithin it or by a power above or outside it: the captains who founded it, the two \ncorporations that merged, the corps that took the government from unpaying \ngovernors, the dey who bought the pasha’s title, the factions who wrote the covenant, \nthe kouloughlis who tried and failed, the bey of Oran who came within three leagues of \nthe capital, the dey who broke the corps from the citadel, the fleets that ended the \ncorsair trade, and the army that took the Kasba. Where the ruled appear in these \nchanges, they appear as the danger one armed faction names to another, or as a guard \none faction arms against the rest.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-60aec390fd6ed1192392",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  capture  of  Algiers  by  Count  Pedro  Navarro \nwas  a  crowning  misfortune  for  the  exiles,  and  when \nthis  commander  seized  upon  the  place  he  extracted \nfrom  the  inhabitants  an  oath  of  fidelity  to  the  Span- \nish crown ;  he  further  erected  a  strong  tower  to \noverawe  the  town,  and  to  keep  its  turbulent  in- \nhabitants in  order.  But  such  an  oath  as  this,  ex- \ntracted at  the  point  of  the  sword,  was  writ  in  water  ; \nit  meant,  of  course,  the  suppression  of  piracy,  and \nit  also  meant  the  starvation  of  most  of  those  persons \nwho  dwelt  in  the  vicinity.  How  the  Moslem  popu- \nlation existed  for  the  six  years  after  the  incursion \nof  Navarro  is  a  mystery  ;  but  they  probably  moved \ntheir  galleys,  of  which  they  possessed  some  twenty, \nfurther  along  the  coast  out  of  the  range  of  the  guns \nfrom  Navarro 's  Tower,  and  secure  from  the  observa- \ntion of  those  who  held  it  for  the  Spanish  king.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-ae83b5d1d8f1602893de",
        "file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco02alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1135a3a79197e1c82225ecc0079d7260b2a1d27346d5b5129e0575b8a3277b07",
        "evidence_excerpt": "Bainbridge  now  had  an  audience  with  the  dey,  who \nwas  in  a  bad  humor  and  soon  flew  into  a  violent  rage. \nWith  his  guard  of  janizaries  ready  to  obey  any  com- \nmand of  the  irresponsible  despot  on  the  instant,  it \nseemed  a  perilous  moment  for  the  captain,  and  might \nhave  proved  so,  had  he  not  suddenly  thought  of  the \ncapud  an -pasha's  firman.  This  he  at  once  drew  from \nhis  pocket,  and  the  effect  was  magical.  The  ferocious \npirate  was  transformed  into  a  cringing  supplicant, \nanxious  to  serve  the  man  whom  a  moment  before  he \nhad  seemed  ready  to  destroy.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "It  was  an  appeal  for  aid  to  the  Moslem  corsairs \nfrom  Algiers,  from  Tlemcen,  from  Oran,  from  Los \nGelues  (or  Jerbah),  and  from  all  the  countless  islands \nof  the  Archipelago,  where  they  lurked  to  seize  their \nprey — Tunis,  which  flew  the  Crescent  flag  of  the",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

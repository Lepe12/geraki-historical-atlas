      {
        "finding_id": "section-bb6ea6075bb4ba85836f",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "It  was  one  of  the  cruellest  of  ages,  and  rough \ncruelty  was  the  principal  means  adopted  to  ensure \nsuccess  ;  sheer  terror  was  the  weapon  of  the  leader. \nThus  when  one  Hassan,  a  subordinate  of  Kheyr-ed- \nDin,  failed  to  take  a  Spanish  ship  because  she \nmade  too  stout  a  resistance,  his  chief  caused  him \nto  be  soundly  flogged,  and  then  thrown  into  prison. \nSuch  methods  naturally  raised  up  hosts  of  enemies \nin  the  wake  of  the  piratical  commanders,  ready \nat  any  time  to  do  them  a  mortal  injury,  and  it \nis  little  short  of  miraculous  that  they  should \nthroughout  a  long  period  of  years  have  been  able \nnot  only  to  maintain,  but  to  increase,  their  suprem- \nacy over  the  wild  spirits  of  which  their  following \nwas  composed.  It  was,  however,  the  golden  age \nof  autocracy,  when  men  surrendered  their  judg- \nment to  some  great  leader,  content  to  follow  where \nhe  led,  to  endorse  his  policy  at  the  cost  of  their \nlives.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/seawolvesofmedit00curruoft",
          "source_file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",

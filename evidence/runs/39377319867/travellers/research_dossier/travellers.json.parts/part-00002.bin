        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "The first came from outside. The bombardment of August 1816 by the British and \nDutch fleets destroyed the navy and ended both Christian slavery and the corsair trade \nthat had filled the hoard. Shaler, writing in the 1820s, says that since 1815 the Regency \nhad derived no benefit from its corsairs, and his account of the year 1822 shows the \ncorps's pay exceeding the treasury's receipts by more than four hundred thousand \ndollars a year. The fleet was rebuilt; the income was not.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

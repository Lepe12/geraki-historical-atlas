          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Piali,  as  we  have  said,  was  in  command  of  the \nfleet,  and  Mustafa  of  the  army;  the  corsairs  did \nnot  arrive  on  the  scene  till  some  days  afterwards.",
        "years_in_scope": [],

      {
        "finding_id": "section-074787a8ce2d9313f0ca",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "There  is  no  object  to  be  gained  in  lingering  over \nthe  earlier  years  of  this  notable  corsair,  as  we  should \nthus  only  be  repeating  what  has  been  said  about \nDragut,  whose  lieutenant  and  trusted  follower  he \nbecame.  He  accompanied  his  master  to  the  siege \nof  Malta,  and  when  Dragut  was  slain  the  Capitan- \nBasha,  Piali,  named  him  as  successor  to  his  chief \nas  Viceroy  of  Tripoli.  All  sailed  from  Malta  to \nTripoli,  taking  with  him  the  remains  of  Dragut,  to \nbe  buried  as  that  chieftain  had  directed.  When  he \narrived  on  the  Barbary  coast  he  made  himself \nmaster  of  the  slaves  and  treasure  which  had  been \nleft  behind  by  Dragut ;  shortly  after  this  he  was",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

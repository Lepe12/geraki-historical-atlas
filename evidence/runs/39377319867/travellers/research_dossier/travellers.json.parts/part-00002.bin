      {
        "finding_id": "section-5504028c5160929eec44",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  price  to  be  paid  was  a  stiff  one,  and  was \nso  regarded  by  the  active  partners  in  this  arrange- \nment ;  they  were,  however,  young  and  unknown, \nand  had  not  the  least  intention  of  holding  to  their \nbargain  when  more  favourable  circumstances  pre- \nsented themselves.  Now  they  held  fair  speech \nwith  the  puppet  princes  of  North  Africa ;  the  day \nwas  to  come  when  they  should  chase  them  from  their \ninsecure  thrones.  It  was  at  this  time,  shortly  after \nthe  treaty  with  the  Sultan  of  Tunis  was  concluded, \nthat  the  younger  Barbarossa  received  from  the \nGrand  Turk  the  glorious  name  of  Kheyr-ed-Din, \nor  \"  The  Protector  of  Religion.\"  It  was  a  somewhat \nremarkable  title  for  a  pirate,  but  perhaps  its  be- \nstower  was  slightly  deficient  in  a  sense  of  humour.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

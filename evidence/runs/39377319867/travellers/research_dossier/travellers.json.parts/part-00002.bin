      {
        "finding_id": "section-a25fc58f3529f311581f",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Torch-bearers  among  the  pirates  leaped  into  houses \nand  set  them  ablaze,  the  flames  volleyed  and  crackled, \nthe  dense  smoke  rolled  upwards  to  the  stainless \nsky,  the  night  was  a  hell  of  blood  and  fire.",
        "years_in_scope": [],

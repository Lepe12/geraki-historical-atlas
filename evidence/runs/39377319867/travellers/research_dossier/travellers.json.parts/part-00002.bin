      {
        "finding_id": "section-a59cf668749bcc93c5e0",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "to  row  until  he  died,  and  the  calculating  mercy \nwhich  causes  a  man  to  feed  and  treat  his  beast  well \nin  order  that  it  may  do  the  better  work  was  not  to \nbe  relied  upon  here,  as  life  was  cheap  and  slaves  were \nplentiful.  Very  soon  the  beak  of  the  galley  over- \nhung the  stern  of  the  little  ship.  Escape  was  im- \npossible, to  fight  would  have  meant  the  massacre \nof  all  on  board ;  the  choice  was  instant  submis- \nsion or  a  watery  grave.  Uruj  lowered  his  sail,  and \nhe  and  his  little  company  were  ironed  and  flung \ninto  the  depths  of  the  galley  until  such  time  as  they \nshould  be  wanted  to  take  their  turn  at  the  oars. \nIn  this  ignominious  fashion  ended  his  first  attempt \nat  independent  piracy.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

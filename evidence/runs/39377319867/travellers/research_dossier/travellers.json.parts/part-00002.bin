      {
        "finding_id": "section-bf32e394979cbb6f3658",
        "file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
        "title": "The Regency Of Algiers",
        "url": "https://archive.org/details/the-regency-of-algiers",
        "source_bibliography": {
          "creator": "Thomas J. Bryan, Claude/Anthropic",
          "date": [
            "2026-09-16T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "Modern reference works, which this study has not tested against primary text and \nmarks as theirs, supply six more. They say that Mohammed Trik — Plantet's Hadji \nMohammed, the first dey — left office alive in 1681; that his successor Baba Hassan was \nkilled in 1683 by the corsair captain Mezzomorto, who took the office and later left \nAlgiers to die an Ottoman admiral; that Baba Mohammed ben Osman, the dey \nVenture served under, died in office in 1791 at about eighty; that his successor Sidi \nHassan died in office in 1798; and that Hadji Mohammed, the dey of March 1815, was \nassassinated after seventeen days.",
        "years_in_scope": [
          1681,
          1683
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

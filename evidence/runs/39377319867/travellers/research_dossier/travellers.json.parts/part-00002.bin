        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "The economics of tribute are those of insurance. A corsair fleet produces a flow of \nprizes that varies wildly from year to year with war, weather and luck; the prize register \nshows gross proceeds in francs of under two thousand in 1773 and more than two \nmillion in 1812. A treaty with a fixed annual payment converts part of that uncertain \nflow into a certain one. For the paying state, the tribute was a premium set below the \nlosses its merchants expected at sea; for the Regency it was an annuity set, if well",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-bd233755190dfff7f54f",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Doria,  Grimani,  and  Capello  had  now  nearly \n200  ships  carrying  nearly  60,000  men.  Such  a \nforce,  in  all  ages,  has  been  considered  great.  William \nthe  Conqueror  conquered  Britain  with  a  less  num- \nber ;  it  is  almost  half  the  total  of  the  personnel  of \nthe  British  fleet  in  the  present  day  which  has  to \ndefend  a  country  with  40,000,000  inhabitants,  and \nall  this  force  had  been  raised,  armed,  and  equipped \nto  combat  with  a  Moslem  corsair.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

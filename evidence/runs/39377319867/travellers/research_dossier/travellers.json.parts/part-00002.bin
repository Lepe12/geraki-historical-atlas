      {
        "finding_id": "section-af49ed5fa3d2d3025fae",
        "file": "studiesinnorthaf0000gran_studiesinnorthaf0000gran_djvu.txt",
        "title": "Studies in North Africa",
        "url": "https://archive.org/details/studiesinnorthaf0000gran",
        "source_bibliography": {
          "creator": "Grant, Cyril Fletcher",
          "date": [
            "1923-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "75673ef6cd5c3422a56d91532eed41c92aa6b4d4c68a81636004012e2f399b15",
        "evidence_excerpt": "Of all the great barbarian invaders, Genseric \nseems to have been the ablest and most versatile. \nNot content with his African conquests, he built \na fleet and seized the Balearic Islands, Sicily, \nCorsica, and Sardinia; the Vandal fleet became \nthe scourge of the Mediterranean, as the Barbary \ncorsairs were later on in history. ‘‘Whither shall’ \nwe steer?’’ asked his ship’s master, when starting \non one of these buccaneering expeditions. \n‘Where God wills,’? was Genseric’s answer; and \n‘“‘God’’ seems generally to have ‘‘willed’’ that he \nshould go wherever booty was most plentiful and \nleast protected.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/studiesinnorthaf0000gran",
          "source_file": "studiesinnorthaf0000gran_studiesinnorthaf0000gran_djvu.txt",
          "start_char": 289165,
          "end_char": 289775,
          "start_line": 7998,
          "end_line": 8010,
          "printed_page": null,
          "scan_indexes_0_based": [],

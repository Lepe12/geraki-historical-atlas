      },
      {
        "finding_id": "section-250529a9d9691aaad335",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "In  a  simultaneous,  and  as  we  have  seen  a  con- \ncerted attack,  the  beaks  of  the  galleys  crushed  into \nthe  broadsides  of  The  Galley  of  Naples,  and,  ever \nforemost  in  the  fray,  Uruj  and  Kheyr-ed-Din  were \nthe  first  two  men  to  board.  Then,  when  men  were \nhand  to  hand  and  foot  to  foot,  when  Moslem  scimi- \ntar rang  on  Christian  sabre,  and  the  air  was  filled \nwith  the  oaths  and  shouts  of  the  combatants,  the \nthird  remaining  pirate  craft  grappled  The  Galley",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

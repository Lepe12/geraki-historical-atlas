      {
        "finding_id": "section-32fa7b63ff28cec9fc6f",
        "file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
        "title": "The Regency Of Algiers",
        "url": "https://archive.org/details/the-regency-of-algiers",
        "source_bibliography": {
          "creator": "Thomas J. Bryan, Claude/Anthropic",
          "date": [
            "2026-09-16T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "\"It is however, to be observed, that every Turk, in the Kingdom of Algiers, being \nqualified to rise to the Deylik, some are of so turbulent an Ambition, that they are \nalways carrying on Plots against the reigning Dey,\" and each conspiracy believed itself \nthe only one. When a party learned that another was at work, it struck first; the dey was \ndispatched and its chief proclaimed. And then the rest of the corps did what every man \nin it had reason to do. The officers in the hall, the account says, dared not show the least \ndisapproval, which would be answered by the conspirators’ sabres; \"they tamely do \nHomage to the new Dey, and after them, the whole Body of the Soldiery, from the \nsame prudent Motives.\" The new dey began his reign \"by taking off the Leaders of any \nother Cabal,” or drove them to flee the country. \"If the Succession be not carried on by \nViolence, but a Relation or Confident of the deceased be proclaimed Dey, he \nendeavours to extirpate those who had any hand in the Death of his Predecessor.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/the-regency-of-algiers",
          "source_file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",

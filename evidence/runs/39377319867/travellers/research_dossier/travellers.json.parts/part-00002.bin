          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Plunder  and  slaves  were  all  very  well  in  their \nway,  and  acceptable  enough  on  the  shores  of  the \nGolden  Horn  ;  but  Kheyr-ed-Din  had  a  pet  project \nin  view  on  this  particular  cruise,  which  was  to  cap- \nture Julia  Gonzaga  and  to  present  her  to  Soliman \nfor  his  harem.  The  lady  destined  by  him  for  this \npleasant  fate  was  reported  to  be  the  loveliest  woman \nin  Europe,  a  fitting  gift  for  such  an  one  as  the  Grand \nTurk.  The  fame  of  her  surpassing  loveliness  had \nreached  even  the  corsairs.  She  was  the  widow  of \nVespasian  Colonna,  Duchess  of  Trajetto,  and  Count- \ness of  Fundi ;  she  had  now  been  a  widow  since  1528, \nand  lived  at  Fundi,  some  ninety  miles  north-east  of",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

          "start_char": 347454,
          "end_char": 347855,
          "start_line": 7323,
          "end_line": 7329,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "original_inspected": false
        },
        "reported_cited_pages": [],

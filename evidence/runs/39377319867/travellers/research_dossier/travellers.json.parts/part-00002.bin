        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "The second is the tribute-payers’ account, assembled by the consuls, navies and \ndiplomats of states that paid the Regency and resented paying. Shaler belongs to it, and \nso, in its English dress, does the Laugier account, whose French author argued that the \nAlgerines were misunderstood and whose English translator sold him as a historian of \npirates. The American version of this account is the loudest and has shaped the modern \nAnglophone picture.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

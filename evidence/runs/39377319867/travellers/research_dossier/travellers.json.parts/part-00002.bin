      {
        "finding_id": "section-1577bf1cf2a02bd8192b",
        "file": "lesphniciensetl00brgoog_lesphniciensetl00brgoog_djvu.txt",
        "title": "Les Phéniciens et l'Odyssée ..",
        "url": "https://archive.org/details/lesphniciensetl00brgoog",

      {
        "finding_id": "section-c8c59e48eb3ae58472b1",
        "file": "lesphniciensetl01brgoog_lesphniciensetl01brgoog_djvu.txt",
        "title": "Les Phéniciens et l'Odyssée",
        "url": "https://archive.org/details/lesphniciensetl01brgoog",
        "source_bibliography": {
          "creator": [
            "Bérard, Victor, 1864-1931"
          ],
          "date": [
            "1902-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "546cd788b1466b58c53d885b39d91600bd70c74ff8550a408c649d552bebc791",
        "evidence_excerpt": "Le  corsaire  phénicien  apporte  dans  la  maison  du  roi  de  Syria  «  un  collier  d'or \nenfilé  d'ambres  »,",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",

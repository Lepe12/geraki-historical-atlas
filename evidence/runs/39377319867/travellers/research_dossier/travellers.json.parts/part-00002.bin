      {
        "finding_id": "section-d7d4900eddae77b15f16",
        "file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco02alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1135a3a79197e1c82225ecc0079d7260b2a1d27346d5b5129e0575b8a3277b07",
        "evidence_excerpt": "The  dey  at  first  refused  to  consider  the  question \nof  peace  with  the  United  States,  but  finally  yielded, \nand  in  July,  1795,  the  captives  were  cheered  by  the \nnews  that  Joseph  Donaldson  was  on  his  way  to  Algiers \nfor  the  purpose  of  negotiating  with  that  potentate. \nDonaldson  arrived  September  3  ;  on  the  5th  a  treaty \nwas  concluded,  and  the  American  flag  was  given  a \nsalute  of  twenty-one  guns.  The  overjoyed  slaves  now \nlooked  forward  to  speedy  emancipation.  In  this,  how- \never, they  were  disappointed,  for  long  delay  in  raising \nthe  money  for  their  ransom  kept  them  still  in  cap- \ntivity. They  were  greatly  disheartened,  but  somewhat \nencouraged  in  February,  1796,  on  receiving  a  sympa- \nthetic letter  from  Colonel  Humphreys,  and  in  March \nJoel  Barlow  arrived  to  assist  in  the  negotiations.  The \ndey  became  very  impatient  at  the  delay,  and  made \ndire  threats  of  renewed  hostilities  and  piracy.  Finally \nBarlow  succeeded  in  procuring  the  necessary  funds \nfrom  a  Jew  named  Bacri,  a  merchant  in  Algiers.^",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

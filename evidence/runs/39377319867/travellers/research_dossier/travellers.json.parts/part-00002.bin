      {
        "finding_id": "section-74e0c220dc1184aa2a70",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  maritime  Christian  States  of  the  Mediter- \nranean at  this  epoch  were  at  the  height  of  their \npower  and  prosperity,  but  were  faced  by  the  might \nof  the  Ottoman  Empire,  against  which  they  waged \nperpetual  warfare.  Bitter  and  unceasing  was  the \nstrife  prosecuted  by  the  Cross  against  the  Crescent, \nand  by  the  Crescent  against  the  Cross  ;  and  riding \nlike  eagles  on  the  storm  came  the  corsairs  in  their \nswift  galleys  ready  to  strike  down  the  luckless  argosy \nof  the  merchantman  wheresoever  she  was  to  be  met. \nBut  this  was  not  all,  as  the  shore  as  well  as  the \nsea  yielded  up  to  them  its  tribute  in  the  shape  of \nslaves  and  booty,  and  Christian  mothers  trembling \nin  the  insecurity  of  their  homes  would  hush  their \nwailing  children  with  the  terror  of  the  names  of \nBarbarossa,  of  Dragut,  or  of  Ali  Basha.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

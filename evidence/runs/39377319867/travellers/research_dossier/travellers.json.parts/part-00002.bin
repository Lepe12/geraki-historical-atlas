      {
        "finding_id": "section-cf0bb32710bed359d3a9",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "\"  I  have  forty  galleys,\"  replied  the  corsair  ;  \"  you \nhave  forty  more.  With  these  I  will  take  the  sea  ; \nbut,  mark  you,\"  he  continued,  softening  somewhat, \n\"  you  do  right  to  fear  the  displeasure  of  the  Sultan, \nand  I  also  have  no  wish  to  encounter  it ;  but  vessels \nraised  and  equipped  in  a  hurry  will  be  of  small  use \nto  me.  In  the  name  of  Allah  the  compassionate \nand  his  holy  Prophet  give  me  my  eighty  galleys \nand  let  me  go.\"",
        "years_in_scope": [],

        "verified": false
      },
      {
        "finding_id": "section-15319d2b3200b1f7bf99",
        "file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
        "title": "The Regency Of Algiers",
        "url": "https://archive.org/details/the-regency-of-algiers",
        "source_bibliography": {
          "creator": "Thomas J. Bryan, Claude/Anthropic",
          "date": [
            "2026-09-16T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "The Order of St John is the Regency's structural sibling and its mirror: a corsairing \ncorporation on an island, recruiting its fighting members from outside the population \nit ruled, running the same traffic in captives in the opposite direction, with a slave \nmarket of its own. Its study finds that a permanent holy war will have a boundary, and \nthat the boundary will be in the licences rather than in the manifestos — a \nproclamation at the Rhodes customs house forbidding the corso against the Turks, \nbefore a Turkish ambassador; three thousand ducats a year paid while the word tribute \nwas refused; a privateering licence of 1507 fixing the limits of a truce between two \nnamed points. The firman that invested the deys of Algiers carried the same boundary \nwritten the other way: war on the unbeliever, except within the limits agreed with \nVenice and against any power holding the Porte's aman. Two corporations waging holy \nwar on each other across the same sea wrote its limits into their licences in the same \nmanner, because a war that is also a business needs to know which ships it may take.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/the-regency-of-algiers",
          "source_file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
          "start_char": 339092,
          "end_char": 340201,

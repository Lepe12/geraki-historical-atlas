      {
        "finding_id": "section-15ac3bb72d3f33a49ca9",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Sailing  from  Tunis  in  the  spring  of  the  year \n1512,  the  brothers,  with  three  galleys,  fell  in  with \nThe  Galley  of  Naples,  an  enormous  nef  with  a \ncrew  of  three  hundred.  They  instantly  attacked, \nbut  were  repulsed,  night  falling  without  either  side \nhaving  gained  an  advantage.  This  audacious  pro- \nceeding illustrates  the  hardihood  of  the  Moslem \ncorsairs  at  this  time.  They  were  amply  strong",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

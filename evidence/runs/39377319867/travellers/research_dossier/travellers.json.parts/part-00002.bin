      {
        "finding_id": "section-5d49f8f92196898eeb5e",
        "file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco02alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1135a3a79197e1c82225ecc0079d7260b2a1d27346d5b5129e0575b8a3277b07",
        "evidence_excerpt": "There  had  been  piracy  in  the  Mediterranean  from \nthe  earliest  times,  and  for  centuries  it  was  pursued \nby  Christians  and  Moslems  alike.  The  captives  were \nreduced  to  slavery,  and  the  condition  of  the  Christian \nslaves  in  Barbary  excited  sympathy  throughout  Eu- \nrope. In  1199  was  founded  in  Pai-is  the  \"  Order  of \nthe  Holy  Trinity  and  Redemption  of  Captives.\"  The \nmembers,  called  Fathers  of  the  Redemption  or  Mathu- \nrins,  from  the  Church  of  St.  Mathurin,  devoted  their \nlives  to  the  ransom  of  captives  and  the  mitigation  of \ntheir  plight.  Missions  were  established  and  hospitals \nmaintained  in  Barbary.^",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/ournavybarbaryco02alle",
          "source_file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",

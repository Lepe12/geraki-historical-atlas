      {
        "finding_id": "section-bedf48d45c34ceaab3e9",
        "file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",
        "title": "Our navy and the Barbary corsairs",
        "url": "https://archive.org/details/ournavybarbaryco02alle",
        "source_bibliography": {
          "creator": [
            "Allen, Gardner Weld, 1856-1944"
          ],
          "date": [
            "1905-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1135a3a79197e1c82225ecc0079d7260b2a1d27346d5b5129e0575b8a3277b07",
        "evidence_excerpt": "The  first  of  the  great  corsairs  were  the  brothers \nHoruk  and  Khair-ed-Din  Barbarossa,  natives  of  Lesbos, \nwho  had  in  youth  joined  a  gang  of  pirates  in  the  east \nMediterranean.  Not  finding  free  scope  for  his  ambi- \ntion so  near  the  sultan's  fleet,  Horuk  determined  to \ntry  his  fortune  on  the  Barbary  coast.  He  first  went  to \nTunis  in  1504,  which  he  made  his  base.  From  Tunis \nand  later  from  other  ports  he  cruised  with  brilliant \nthough  not  uninterrupted  success,  making  many  cap- \ntures and  collecting  a  strong  fleet.^",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/ournavybarbaryco02alle",
          "source_file": "ournavybarbaryco02alle_ournavybarbaryco02alle_djvu.txt",
          "start_char": 12238,
          "end_char": 12832,
          "start_line": 354,
          "end_line": 363,
          "printed_page": null,
          "scan_indexes_0_based": [],

            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Very  soon  the  Moslems  acquired  the  habit  of  the \nsea,  and  very  soon  the  Christian  States  discovered \nhow  different  was  the  Mohammedan  dwelling  at \npeace  in  Andalusia,  or  at  worst  fighting  with  his \nco-religionists,  to  the  desperate  corsairs  created  by \ntheir  own  act  who  now  ravaged  the  shores  of  the \ntideless  sea.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

        },
        "source_text_sha256": "1135a3a79197e1c82225ecc0079d7260b2a1d27346d5b5129e0575b8a3277b07",
        "evidence_excerpt": "They  were  tumbled  and  kicked  into  the  boat,  taken \naboard  the  pirate,  and  brought  before  the  commander, \nKais  Mahomet,  an  infirm  old  man  described  as  \"  an \nemaciated,  loathsome  figure.\"  Nearly  one  hundred  and \nfifty  Algerines  were  crowded  into  this  small  vessel, \nwhich  was  filthy  in  the  extreme  and  swarming  with \nvermin.  They  arrived  at  Algiers  October  30  and  were \nordered  to  the  Bagnio  Baleck.^",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

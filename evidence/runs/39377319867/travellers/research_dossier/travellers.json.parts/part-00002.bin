      {
        "finding_id": "section-ffee730826760270a763",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "That  \"  no  vessel  durst  pass  from  Spain  to  Italy  \" \nis  no  doubt  a  picturesque  form  of  exaggeration  on \nthe  part  of  the  historian ;  at  the  same  time,  when \nDragut  was  at  the  height  of  his  activities  there  is \nno  doubt  that  any  one  passing  through  those  seas \nran  a  great  risk  of  capture  ;  so  much  so  in  fact \nthat  at  this  period,  from  1538,  the  date  of  the \nbattle  of  Prevesa,  until  Lepanto  in  1571,  all  mari- \ntime commerce  in  the  Mediterranean  was  greatly \ncircumscribed.  At  the  beginning  of  this  epoch, \nwhich  saw  the  rise  of  the  Moslem  corsairs,  these \nrobbers  perforce  confined  themselves  more  to  the \nNorth  African  coast  than  was  the  case  later  on. \nThe  pioneers  of  the  piratical  movement,  after  the \nfatal  date  1492,  which  saw  the  wholesale  expulsion \nof  the  Moors  from  Spain,  were  comparatively  speak-",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

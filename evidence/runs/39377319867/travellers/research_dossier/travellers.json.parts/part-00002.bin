      {
        "finding_id": "section-574f68ccf31bba1db378",
        "file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
        "title": "The Regency Of Algiers",
        "url": "https://archive.org/details/the-regency-of-algiers",
        "source_bibliography": {
          "creator": "Thomas J. Bryan, Claude/Anthropic",
          "date": [
            "2026-09-16T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "Every clause should be read for what it made ownable, because this is the moment at \nwhich what Aruj had taken by a murder in a bath became something that could be held \nby right. The first clause made the town the sultan's, by its own petition, so that anyone \nwho attacked it attacked the sultan. The second transferred to the sultan's name the \ntwo instruments by which a Muslim population recognised its rightful ruler — the \ninstruments Aruj had tried to claim for himself with a coin nobody had authorised. \nThe third made Khayr al-Din an officer: not a sovereign in his own right, and not a \ncorsair holding a town, but the lieutenant of a sovereign, whose authority now derived \nfrom an appointment the whole coast could recognise. The title he received is itself a \nsmall historiographical problem — the chronicle says bey, modern reference works \nvariously say sanjak bey or beylerbey — and it is left here as the chronicle gives it.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/the-regency-of-algiers",
          "source_file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
          "start_char": 48078,
          "end_char": 49021,
          "start_line": 980,
          "end_line": 990,
          "printed_page": null,

      {
        "finding_id": "section-efe3fe5ea02a1c49a671",
        "file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
        "title": "The Regency Of Algiers",
        "url": "https://archive.org/details/the-regency-of-algiers",
        "source_bibliography": {
          "creator": "Thomas J. Bryan, Claude/Anthropic",
          "date": [
            "2026-09-16T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "6138c424ee238e85fb6fb48ba525f1c29c7f976cf104138f88baec22a14297cd",
        "evidence_excerpt": "For the city of Algiers the answer is yes, and the apparatus that did the lifting is on \nthe record. A city Shaler put at perhaps fifty thousand people lived on grain delivered in \nkind by the tribes — two hundred thousand measures of wheat a year in 1822 — on \nthe flow of prizes and ransoms from the sea, on the tribute of Christian powers, and on \na harbour that the slaves of the state maintained by hauling stone to the mole every day \nof every year. The note on that lift was serviced in three currencies: coercion in the \ncountryside, which produced the grain; the labour of captives, which kept the harbour; \nand the fear of European shipping, which produced the prizes and the tribute. When \nthe bombardment of 1816 ended the corsair trade, the third currency failed, and the \ncity's support shifted onto the hoard in the Kasba, which by 1822 was paying more \nthan four hundred thousand dollars a year beyond what came in. The note was being \ncalled from outside, and the order did not survive long enough to see it fall due.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/the-regency-of-algiers",
          "source_file": "the-regency-of-algiers_The_Regency_of_Algiers_djvu.txt",
          "start_char": 316642,
          "end_char": 317676,
          "start_line": 5954,
          "end_line": 5965,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",
        "uncertainties": [
          "ORIGINAL_NOT_INSPECTED",
          "SOURCE_GENEALOGY_PENDING",
          "INDEPENDENCE_UNRESOLVED",
          "TOPONYM_AND_USAGE_REQUIRE_SEMANTIC_EXTRACTION",
          "DATE_OUTSIDE_SCOPE",
          "REGIONAL_SCOPE_REQUIRES_REVIEW"
        ],

    {
      "@id": "urn:nabou:att_ca64f41717d77c0bf090fe5b%3Asnapshot%3A46a14bff6a3a07a40ee0",
      "@type": "Attestation",
      "schema:name": "A series of coastal toponyms documented on maps or utilized in the modern vernacular of Phournoi are probably the living remnants of pirate activity in the past: Kourniachto (a place for hiding or lurking), Kleftolimano (harbor of thieves), Fygou (escape), Fylakio (guard-post), Vardia (shift or guard), Tourkolimnionas (harbor of the Turks), Pano and Kato Maneta (upper and lower Maneta).",
      "properties": {
        "attestation_id": "att_ca64f41717d77c0bf090fe5b",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",
        "source_classification": "SECONDARY_SOURCE",
        "model_review": {
          "decision": "FLAGGED",
          "flag": {
            "claim_id": "c-9baea3dc745067fa5498",
            "reason": "The statement attributes the toponyms to pirate activity based on a secondary source that discusses the etymology and possible historical associations of the names. The source does not provide direct evidence or primary sources confirming the pirate activity, but rather presents a hypothesis. The toponyms are listed with their possible meanings, but the source does not confirm their use as pirate bases or raid locations. The source mentions a corsair named Manetas, but the connection to the toponyms is speculative. The source is a secondary source, and the claim is based on a hypothesis, not verified historical evidence.",
            "decision": "UNCERTAIN"
          },
          "historical_verification": false
        }
      },
      "historically_verified": false
    },

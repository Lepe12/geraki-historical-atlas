    {
      "entity_id": "mention:55b3d047c6811d70076c6ad2",
      "predicate": "SOURCE_STATEMENT",
      "value": "The source states that Russia began to nurture a naval and maritime policy after acquiring the Black Sea port of Azov in 1696.",
      "citations": [
        {
          "source_id": "src_49b25457e6940ddfcabad683cd8cc233",
          "locator": "{\"end_char\": 702, \"end_line\": 16, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/87fd9f63375a2cc4416f2e8c.pdf\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 494, \"start_line\": 13}",
          "exact_excerpt": " With the\nadvent of Peter I, however, and especially after his declaration of war\nagainst Turkey and the acquisition of the Black Sea port of Azov in 1696,\nRussia began to nurture a naval and maritime policy.",
          "attribution": "stated"
        }
      ],

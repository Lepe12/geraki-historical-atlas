    {
      "entity_id": "mention:5304d2ae9cce4b611f536fac",
      "predicate": "SOURCE_STATEMENT",
      "value": "A series of coastal toponyms documented on maps or utilized in the modern vernacular of Phournoi are probably the living remnants of pirate activity in the past: Kourniachto (a place for hiding or lurking), Kleftolimano (harbor of thieves), Fygou (escape), Fylakio (guard-post), Vardia (shift or guard), Tourkolimnionas (harbor of the Turks), Pano and Kato Maneta (upper and lower Maneta).",
      "citations": [
        {
          "source_id": "src_c3359f825b2e8df131f721f5162e99e7",
          "locator": "{\"end_char\": 1128360, \"end_line\": 12896, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/bad2f54f36da12ea92871556.pdf\", \"printed_page\": null, \"scan_indexes_0_based\": [335], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1127969, \"start_line\": 12892}",
          "exact_excerpt": "\nA series of coastal toponyms documented on maps or utilized in the modern vernacular of Phournoi\nare probably the living remnants of pirate activity in the past: Kourniachto (a place for hiding or lurking),\n­Kleftolimano (harbor of thieves), Fygou (escape), Fylakio (guard-post), Vardia (shift or guard), Tourkolimnionas\n(harbor of the Turks), Pano and Kato Maneta (upper and lower Maneta).",
          "attribution": "stated"
        }
      ],
      "start_year": null,
      "end_year": null,
      "status": "UNREVIEWED",
      "reviewer": null,
      "reviewed_at": null,
      "id": "att_1015afbaf71b30d6580d8dba",
      "historically_verified": false,
      "model_claim_id": "c-9baea3dc745067fa5498",
      "assertion_class": "SOURCE_STATEMENT",
      "source_classification": "SECONDARY_SOURCE",
      "model_review": {
        "decision": "FLAGGED",
        "flag": {
          "claim_id": "c-9baea3dc745067fa5498",
          "reason": "The statement attributes the toponyms to pirate activity based on a secondary source that conjecturally links the names to piracy. The source explicitly states that the association is a 'conjectural association in popular consciousness' and does not provide direct evidence. The toponyms are listed as 'probably the living remnants of pirate activity in the past' but without independent corroboration or primary source verification. The source also mentions that the names may derive from historical figures like Eustathios Romanos Manetas, but this is presented as a hypothesis rather than a verified fact. The source does not provide exact citations for the toponyms' origins or their usage in historical contexts. The classification as a secondary source and the lack of primary inspection are noted as limitations.",
          "decision": "UNCERTAIN"
        },
        "historical_verification": false
      }
    },
    {
      "entity_id": "mention:6c58a4bcb45ab96578f43e7a",
      "predicate": "SOURCE_STATEMENT",
      "value": "The source mentions the Ottoman Empire and its Barbary corsairs as a common enemy of Malta and Russia.",
      "citations": [
        {
          "source_id": "src_49b25457e6940ddfcabad683cd8cc233",
          "locator": "{\"end_char\": 241, \"end_line\": 10, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/87fd9f63375a2cc4416f2e8c.pdf\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 170, \"start_line\": 9}",
          "exact_excerpt": " It was the Ottoman Empire, its Muslim Turks, and\nits Barbary corsairs.",
          "attribution": "stated"
        }
      ],
      "start_year": null,
      "end_year": null,

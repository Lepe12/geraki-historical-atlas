    {
      "@id": "urn:nabou:cite_870ed53ce074574da0b45a8c",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 1128502, \"end_line\": 12896, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_greek/library_acquisition/bad2f54f36da12ea92871556.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [335], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1127969, \"start_line\": 12892}",
      "properties": {
        "source_id": "src_38b93bffc4dd1028ac2cb1794992fd2d",
        "locator": "{\"end_char\": 1128502, \"end_line\": 12896, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_greek/library_acquisition/bad2f54f36da12ea92871556.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [335], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1127969, \"start_line\": 12892}",
        "exact_excerpt": "\nA series of coastal toponyms documented on maps or utilized in the modern vernacular of Phournoi\nare probably the living remnants of pirate activity in the past: Kourniachto (a place for hiding or lurking),\n­Kleftolimano (harbor of thieves), Fygou (escape), Fylakio (guard-post), Vardia (shift or guard), Tourkolimnionas\n(harbor of the Turks), Pano and Kato Maneta (upper and lower Maneta). Many of these names are commonplace along the Aegean coastline and are also encountered on other islands historically associated with piracy.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

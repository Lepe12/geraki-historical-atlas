  "attestations": [
    {
      "entity_id": "mention:007a576e52c235cc0b34fdba",
      "predicate": "SOURCE_STATEMENT",
      "value": "The source indicates that Astypalaia provided safe anchorages and provisions for corsairs.",
      "citations": [
        {
          "source_id": "src_abe987a040149f44b6d534c127658a53",
          "locator": "{\"end_char\": 1240, \"end_line\": 14, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_greek/library_acquisition/18f781280144b88f0b78dfa5.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 997, \"start_line\": 12}",
          "exact_excerpt": "\nAt the same time, Astypalaia was an excellent hideout for corsairs, not only because they could ﬁnd provisions there (such as bread, wine, etc.) and stock up with drinking water, but also because the island provided\nplenty of safe anchorages.",

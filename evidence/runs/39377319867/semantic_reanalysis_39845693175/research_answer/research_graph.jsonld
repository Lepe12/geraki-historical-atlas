    {
      "@id": "urn:nabou:cite_6a8a6be650d789a4f0c91c08",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 115227, \"end_line\": 2973, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 115057, \"start_line\": 2970}",
      "properties": {
        "source_id": "src_9838970184609b1d69e6d53254bb67ea",
        "locator": "{\"end_char\": 115227, \"end_line\": 2973, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 115057, \"start_line\": 2970}",
        "exact_excerpt": " In the middle distance is an old stone \ntower standing on a tiny headland, and far away, \non the horizon, is the dark outline of the cliffs of the \nisland of Formentara.",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:att_6558c23dd65f5c528c6284fc%3Asnapshot%3A1caf4d925d2fa91dbe75",
      "@type": "Attestation",
      "schema:name": "The consulted source reports corsairs often went to the area of the islands of Saint Pierre and Sardaigne to collect wood and water and provide tallow to their ships.",
      "properties": {

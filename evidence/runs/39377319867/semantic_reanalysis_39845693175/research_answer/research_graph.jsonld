      "schema:name": "{\"end_char\": 858514, \"end_line\": 12976, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 858215, \"start_line\": 12972}",
      "properties": {
        "source_id": "src_17c58df57dce0f331f39e30032a079b3",
        "locator": "{\"end_char\": 858514, \"end_line\": 12976, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 858215, \"start_line\": 12972}",
        "exact_excerpt": "  Que  les  pre- \nmiers navigateurs  du  détroit  aient  connu  et  fréquenté  ce  refuge;  que,  Tyriens \nou  Carthaginois,  ces  caboteurs  de  la  côte  africaine  aient  adopté  cette  merveil- \nleuse station  de  poche,  de  commerce  et  de  piraterie,  nous  pourrions  a  priori \nl'affirmer.",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:att_b8bddbef068d9de6e5cca001%3Asnapshot%3Ae171036def55278ee924",

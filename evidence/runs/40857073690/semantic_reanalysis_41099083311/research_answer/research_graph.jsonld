    {
      "@id": "urn:nabou:cite_2aa437f344ea9b2f2b7f2a73",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 701328, \"end_line\": 12057, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 701041, \"start_line\": 12053}",
      "properties": {
        "source_id": "src_8b66fe39d94826d5703466699f81e007",
        "locator": "{\"end_char\": 701328, \"end_line\": 12057, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 701041, \"start_line\": 12053}",
        "exact_excerpt": "  A  learned \ntraveller,  who,  like  me,  has  examined  the  Cimolian  earth  in  the \nIfland  of  Argentiera,  affirms  that  this  fubftance,  very  abundant,  but \nlittle  known,  is  only  a  flow  and  gradual  decompofition  of  porphyries, \noccafioned  by  fubterraneous  fires.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

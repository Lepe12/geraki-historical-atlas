    {
      "@id": "urn:nabou:att_7ab9a62d21094fe53854f257%3Asnapshot%3A010507b3f4124ae528a5",
      "@type": "Attestation",
      "schema:name": "The consulted source reports that Kimolos was referred to as «Argentara» by medieval cartographers.",

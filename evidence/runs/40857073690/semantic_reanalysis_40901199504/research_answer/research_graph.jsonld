        "attestation_id": "att_725560f2da5672dc05499038",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",
        "source_classification": "UNVERIFIED",
        "model_review": {
          "decision": "FLAGGED",
          "flag": {
            "claim_id": "c-8fcee5bd8b8735adab5f",
            "reason": "The source mentions «Argentara» as one of the names for Kimolos, but the statement attributes this to medieval cartographers. The source text refers to the 1318 map by Petrus Visconti, which is from the late 13th century, not medieval cartographers in general. The term «Argentara» is explicitly mentioned in the quote, but the claim's attribution to medieval cartographers is not directly supported by the source text. The source does not specify that «Argentara» was used by medieval cartographers in general, only that it appears on a specific map from the late 13th century.",
            "decision": "UNSUPPORTED"
          },
          "historical_verification": false
        }
      },
      "historically_verified": false
    },

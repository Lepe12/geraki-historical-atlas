    {
      "@id": "urn:nabou:cite_c9b24d21d4022f7247d4a7ed",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 10560, \"end_line\": 812, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 10347, \"start_line\": 812}",
      "properties": {
        "source_id": "src_2d4da6922cc3829c33f2f906a5f79554",
        "locator": "{\"end_char\": 10560, \"end_line\": 812, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 10347, \"start_line\": 812}",
        "exact_excerpt": "Ο Tournefort αναφέρει χαρακτηριστικά ότι η Κίμωλος ήταν το μέρος όπου οι πειρατές περνούσαν τον χρόνο τους με «φρικτές ακολασίες», καταναλώνοντας τεράστιες ποσότητες κρασιού και ξοδεύοντας αφειδώς το χρυσάφι τους.",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:att_09971e1e556e350e57a418a8%3Asnapshot%3A5231ff3acda4130e846c",
      "@type": "Attestation",
      "schema:name": "The consulted source reports that the legal definition of piracy was established through the Montego Bay Convention of 1982.",
      "properties": {
        "attestation_id": "att_09971e1e556e350e57a418a8",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",
        "source_classification": "UNVERIFIED",
        "model_review": {
          "decision": "FLAGGED",
          "flag": {
            "claim_id": "c-1352fa4b1ab8c717d754",
            "reason": "The statement claims the Montego Bay Convention of 1982 established the legal definition of piracy. The quoted text mentions the Montego Bay Convention as a legal reference, but the source text does not explicitly state that the convention established the definition. The text refers to the convention as a source of legal definition, but the exact establishment of the definition is not clearly stated. The source also references UNCLOS (United Nations Convention on the Law of the Sea) as the source of the legal definition, which is a different document. The claim conflates the Montego Bay\nBay 19",
            "decision": "UNCERTAIN"
          },
          "historical_verification": false
        }
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_f1f039a4bac09cca3ffe03a2",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 51301, \"end_line\": 1051, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/6845a59c8953ea910ceea404.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [29], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 51008, \"start_line\": 1046}",
      "properties": {
        "source_id": "src_938d297cb4d5f61efd7440725b08d1ad",
        "locator": "{\"end_char\": 51301, \"end_line\": 1051, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/6845a59c8953ea910ceea404.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [29], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 51008, \"start_line\": 1046}",
        "exact_excerpt": "\nΈτσι έχοντας ως νομικό δείκτη την ανωτέρω Σύμβαση φτάσαμε στη σύναψη\nτης Σύμβασης των Ηνωμένων Εθνών για το Δίκαιο της Θάλασσας του Montego\nBay 1982 όπου στα άρθρα 100 έως 107 περιγράφεται η πειρατεία ως έγκλημα\nεθιμικής προέλευσης προσδιοριζόμενο μεταξύ άλλων και από τον τόπο διάπραξης\nτου.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

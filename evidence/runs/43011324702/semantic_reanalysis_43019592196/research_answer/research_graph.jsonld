      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_0cb6219a4c088a0c34420d30",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 3613, \"end_line\": 278, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 3363, \"start_line\": 278}",
      "properties": {
        "source_id": "src_d60ea0da92ff2873dcdd1ccb9bcfa126",
        "locator": "{\"end_char\": 3613, \"end_line\": 278, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 3363, \"start_line\": 278}",
        "exact_excerpt": " Το Φεβρουάριο του έτους 1749 μ. Χ. ο εν λόγω Μανιάτης πειρατής με τη φελούκα του έρχεται στα Κύθηρα και κάνει ληστρική επιδρομή στις αποθήκες των Κυθήρων, όμως ένα γαλλικό καράβι, που ήταν ελλιμενισμένο, με κανονιοβολισμούς απομακρύνει τους πειρατές",
        "attribution": "stated"
      },
      "historically_verified": false
    },

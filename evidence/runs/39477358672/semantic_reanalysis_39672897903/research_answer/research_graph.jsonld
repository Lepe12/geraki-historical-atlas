      "@id": "urn:nabou:att_c9508dc9f3acbe34b46f0b3b%3Asnapshot%3A54762f25d26203d2e279",
      "@type": "Attestation",
      "schema:name": "The passage states that a Catholic church honoring Saint George was built by the Tuscan corsair Francesco Barbieri in Ayionissi in 1695.",
      "properties": {
        "attestation_id": "att_c9508dc9f3acbe34b46f0b3b",

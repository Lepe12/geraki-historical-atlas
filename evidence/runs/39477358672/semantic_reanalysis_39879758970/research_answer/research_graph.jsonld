    {
      "@id": "urn:nabou:att_04f19e2bc4c306a1d5e9876e%3Asnapshot%3A5722b76529ad4fe2c9d2",
      "@type": "Attestation",
      "schema:name": "The source mentions that Astypalaia provided safe anchorages for corsairs.",
      "properties": {

      {
        "finding_id": "section-d1e039bb5edfe04f3fc4",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,
          "date": [
            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "who are curious about the minutest details of building \nand equipping galleys need only consult Master Joseph \nFurttenbach’s Architectura Navalis: Das ist, Von \ndem Schif-Gebraw, auf dem Meer und Seekusten zu \ngebrauchen,” printed in the town of Ulm, in the \nHoly Roman Empire, by Jonam Saurn, in 1629. Any \none could construct a galley from the numerous plans \nand elevations and sections and finished views in this \ninteresting and precise work.! Furttenbach is an en- \nthusiastic admirer of a ship’s beauties, and he had seen \nall varieties; for his trade took him to Venice, where \nhe had a galleasse,? and he had doubtless viewed many \na Corsair fleet, since he could remember the battle of \nLepanto and the death of Ochiali. His zeal runs \nclean away with him when he describes a stolo, or \ngreat flagship (capitanea galea) of Malta in her \npomp and dignity and lordliness, as she rides the seas",
        "years_in_scope": [
          1629
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/greatpiratesstor0000jose",

      {
        "finding_id": "section-ea6d6f9d3a40b2aa258d",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Indochina occupied a central role in the great debates in France about \ncolonial expansion in the 1870s. Despite strong resistance from some politi- \ncians, particularly on the left, the momentum gradually shifted in favour of \na more interventionist policy during the 1870s. In 1881, the more assertive \nFrench policy in the region manifested itselfin the approval by Parliament \nfor an increase in the funds for the navy's operations in Indochina. The \nfunding allowed for a substantial increase in the number of vessels available \nfor anti-piracy operations, signalling that the country would take a more \nproactive role in upholding law and order at sea and on the rivers, particularly",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 664182,
          "end_char": 664871,
          "start_line": 12554,
          "end_line": 12562,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,

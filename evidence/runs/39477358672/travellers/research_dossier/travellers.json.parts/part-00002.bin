      {
        "finding_id": "section-07cddb65ee2e02be4086",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "A reminder of the hazards of a Eurocentric approach to the phenomenon \nof piracy, this chapter studies interactions between the Qing regime and \npirates. Late imperial China saw the development of three overlapping \nmaritime \"regimes\" along its coasts, namely, the imperial dynastic \npower, the European overseas enterprise, and the \"pirates\" themselves. \nNotably, the latter two regimes challenged the first in various ways. \nA reassessment of the Qing imperial claims of sovereignty in the face \nof activities labelled as piracy provides crucial understanding of the \nway empire was constructed. One may point at both parallels and dis- \nsimilarities between East Asian and Western forms of piracy, revealing \nhow the various players off China's coasts contended with each other \nover maritime space.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

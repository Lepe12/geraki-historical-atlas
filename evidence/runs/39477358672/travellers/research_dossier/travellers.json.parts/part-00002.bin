      {
        "finding_id": "section-9b606eedac654af5a482",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "As these titles indicate, the historiography of piracy in the late nineteenth \nand early twentieth centuries was by no means confined to Europe or \nEuropean pirates. Nevertheless, for most of the colonial period and the \ndecades following World War II, the sources and perspectives were princi- \npally European. This remained so into the twentieth century, even when \nscholars in the late colonial and early postcolonial period began to write \nmore balanced histories of piracy and its suppression, compared to earlier, \ngenerally salutary, and pro-colonial studies.?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

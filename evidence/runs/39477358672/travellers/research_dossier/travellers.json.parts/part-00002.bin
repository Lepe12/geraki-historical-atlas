      {
        "finding_id": "section-8a7a4c7823f9fca7ad49",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "There was a sharp order repeated and passed on, \nthe corsairs drew back, and the “ Africans” shouted \nthat the triumph was theirs; but they little knew \nDragut, the sea-hawk who poised to strike anew. \nA blazing beam dropped across the street, the \ntownsfolk shouted in insult and derision; but the \njoy which they had experienced at seeing their \nadversaries recoil was but a short and fleeting \nemotion. Giving himself and those who had \nhitherto been engaged time to breathe and recover \nthemselves, Dragut waited while the noise of the \nstrife died down, and nought was heard but the \nroar of the flames and the crash of the burning \nbuildings.",
        "years_in_scope": [],

      {
        "finding_id": "section-10badc0c51fee3113460",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Piracy in World History helps to move the history of piracy more firmly \ninto the realm of world history. The volume features an expansion of the \ngeographic and chronological contexts of sea raiding and inquires whether \nfinding patterns of “concurrence,” synchronous approaches to piracy in \ndifferent social arenas and linguistic traditions, can alter well-established \nEurocentric accounts. Taken together, the chapters offer some interesting \nanswers, and one goal of my essay is to highlight these insights and to \nsketch the outlines of ongoing programs for research that come into clear \nview when the chapters are read together.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

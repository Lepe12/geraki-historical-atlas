      {
        "finding_id": "section-4f4cfe1e15d28a220b56",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The controversy over jurisdiction and sovereignty at sea came to the fore \nwhen, from around the turn of the seventeenth century, the Dutch began \nto send commercial expeditions to Asian seas, that is to lands that the \nPortuguese considered to be under their sovereignty and in their maritime \nsphere of influence. Accusations of piracy, in this context, were a useful tool \nforthe Portuguese (and other European powers) to assert their rights to, and \ncontrol over, trade and maritime traffic in relation to other Europeans. In \n1602, the Portuguese, on dubious grounds, accused six Dutchmen of piracy \nin Chinese waters, which led to their execution by Chinese authorities in \nCanton. By way of retaliation, the Dutch seized a Portuguese carrack, the \nSanta Catarina, in the Strait of Malacca the following year? In order to \njustify the seizure, legally and morally, the Dutch jurist Hugo Grotius wrote \nhis famous tract Mare liberum, which argued for the right of any nation to \nuse the sea for trade and marine transportation. Such activities, in Grotius's \nview, were legal by international law. Piracy, on the other hand, was illegal \nfrom the point of view of all nations.",
        "years_in_scope": [
          1602
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 37402,
          "end_char": 38583,
          "start_line": 789,

      {
        "finding_id": "section-019262c7829924029760",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "But if the sun of European progress was slowly \nand painfully struggling through the clouds, the \nlight which had shone brightly for over seven \ncenturies of Moslem advance was certainly and \nsurely dying. Beneath the mail-clad heel of the \nChristian warrior the torch of learning which had \nburned so brightly in Cordova and Granada had \nbeen extinguished and ground into the dust, and \nthe descendants of the alumni of those universities \nwere seeking their bread in the Mediterranean Sea \nin the guise of bloodthirsty and desperate pirates.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

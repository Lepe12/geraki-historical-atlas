      {
        "finding_id": "section-1f58bdf385a88d9d3cdc",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "But news travelled in the first half of the six- \nteenth century, although newspapers, war corre- \nspondents, and telegraphs were not; when all the \nfeudatories of the greatest king in Christendom \nwere busy it was impossible for the matter to \nremain hidden. Even had it been within the \nrange of possibility to conceal what was going on \nthere was one circumstance which would have \nrendered all effort to this end nugatory. Charles \nhad invited Francis of France to join in this holy \nwar against the scourge of Christendom: not only \ndid Francis refuse to join, but he had the in- \ncredible baseness to betray the scheme to Bar- \nbarossa. It would be pleasanter to think that \nsome mistake had been made in this matter, but \nunfortunately it is beyond dispute, as the facts \nhave been placed on record by Sandoval, whose \nhistory, it must be remembered, was published in \n1614. In this matter he is quite precise, as he \nstates that a “Clerigo Francese,” one Monsieur \nde Floreta, was sent with despatches from Francis \nto Barbarossa at Tunis, and that this treacherous \nenvoy from Christendom gave the corsair king \nall the available information that he had been \nable to collect before starting.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",

        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "and bloodshed. Barbarossa had in his train sixty \nSpanish soldiers captured by him from the force \nof Don Hugo de Moncada. Well did the corsair \nknow their value: there were no finer fighting \nmen in all the Christian armies. Hastily sum- \nmoning them, he promised them their freedom if \nthey would now throw in their lot with him and \nassist in the downfall of Venalcadi.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

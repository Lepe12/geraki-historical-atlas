      {
        "finding_id": "section-f5281c72e5238cebb6c1",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "One may then legitimately make a case for not just a more complex \nunderstanding of piracy in the Indian context but to see its manifestation \nas a curious and complex interplay between larger regional pressures and \nlocal politics. There was a law-and-order dimension in the sense that a \nsection of coastal society was defying the emerging dispensation along the \nlittoral, it was also an assertion of local interests that fitted into a scheme \nof markets and protection money. In the case of Okhamandal, there was a \nnexus between temple trustees, local chiefs, and merchants. In the case of \nCutch, piracy was an arm ofthe state as it deployed pirate groups to harass \ntheir competitors. And yet, these complex elements were not always evident, \nespecially as imperial discourse tended to flatten the narrative. It is here \nthat the historian has to remain sensitive to the reading of the archive and \nrecognize how representation itself is a deeply political project.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

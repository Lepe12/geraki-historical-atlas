      },
      {
        "finding_id": "section-480ef532e48f4b88adca",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The early Qing (1650s-1680s) was a time of transition, political anarchy, \nand social unrest marked by the Ming-Qing dynastic wars. The Manchu \nconquerors not only had to contend with Ming pretenders and loyalist \nforces, but also other formidable groups of insurgents, bandits, and pirates. \nThis pirate upsurge was symptomatic of the general crisis in China that \naccompanied the change in dynasties. Given the political and economic \nanarchy of the times, clear distinctions between piracy, rebellion, and \ncommerce were impossible. It took the Manchus nearly fifty years to \nestablish their control and sovereignty over all of China, which nonetheless \nremained patchy at best. In its struggle to create and consolidate a new \nQing Empire, tenacious bands of pirates off the southern coasts of China \n(in the outer oceans) posed one of the most daunting challenges to the \nnew regime, and in fact pirates were the last organized armed resistance \nto capitulate.'",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 468554,
          "end_char": 469520,
          "start_line": 8779,
          "end_line": 8792,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

      {
        "finding_id": "section-106e4b6cc0a3ead37511",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The fact that the international community had produced its own enemies \nin the case of the privateers also characteristically sheds light on another \nrespect on a European community of nations whose members were gradu- \nally growing closer together as a result of the increasingly dense network \nof contractual relations established after the Peace of Westphalia. What \nwelded the various nations and peoples of Europe together was not merely \nthe shared principles of a developing a Jus Publicum Europaeum, or the \nshared values, customs, and regulations agreed on in treaties.9 A double \nprocess of integration took place not just inwardly, but by means of outward \ndelimitation in the formation of a European community of nations under \ninternational law. Pirates, above all, were a useful means to promote integra- \ntion by exclusion, as demonstrated by the European policies that tightened \nup the private law of prize.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 133771,
          "end_char": 134695,
          "start_line": 2572,
          "end_line": 2584,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

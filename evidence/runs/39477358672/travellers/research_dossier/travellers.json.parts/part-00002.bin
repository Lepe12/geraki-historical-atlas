      {
        "finding_id": "section-b1c821b7027c24ccd841",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "that might yield less reductive analyses. Abstracting and comparing the \ndynamics they shared made it possible to infer new theoretical views on \npiracy, beyond those offered by a critique of colonial perspectives and \nrelativist cultural arguments about piracy's representation. To build such \nan analytical strategy entailed asking not only how to look across eras and \nbeyond European colonialism; it also meant employing methods open to \nthe question of whether one could analyse piracy without adopting statist \nperspectives. Given that agents of the state have produced most of the \nrelevant sources, how might one approach piracy without adopting statist \nperspectives?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 223748,
          "end_char": 224424,
          "start_line": 4315,
          "end_line": 4324,

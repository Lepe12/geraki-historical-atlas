      {
        "finding_id": "section-72b96ff5de511e0fde9a",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  whole  story  is  an  illustration  of  the  extra- \nordinary relations  existing  among  the  Mediterranean \nStates  at  this  time.  Soliman  the  Magnificent,  Sul- \ntan of  Turkey,  had  lent  three  hundred  of  his  Janis- \nsaries, his  own  picked  troops,  to  assist  the  corsairs \nin  their  depredations  on  Venetian  commerce. \nHaving  done  this,  and  the  Janissaries  having \nbeen  caught  and  summarily  and  rightly  put \nto  death  as  pirates,  the  Sultan,  as  soon  as  he  heard \nof  what  had  occurred,  sent  an  ambassador,  one \nYonis  Bey,  to  Venice  to  demand  satisfaction  for \nthe  insult  passed  upon  him  by  the  beheading  of  his \nown  soldiers  turned  pirates.  The  conclusion  of \nthe  affair  was  that  the  Venetians  released  \"  The \nYoung  Moor  of  Alexandria\"  as  soon  as  he  was \ncured  of  the  eight  wounds  which  he  had  received \nin  the  conflict,  and  sent  him  back  to  Africa  with \nsuch  of  his  galleys  as  were  left.  There  was  one \nrather  comical  incident  in  connection  with  this  affair,",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

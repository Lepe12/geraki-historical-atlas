      {
        "finding_id": "section-0304d579c89007bc11fe",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Cusack's transfer to prison and the warrant of arrest for \"piracy and robbery\" \nin several cases are dated 1 September 1674.5? In the following two months, \nthe questioning of the accused and the witnesses took place. All of those \naccused of serious robbery and piracy referred to Cusack's French letter of \nmarque as a legitimation of their plundering raids. They presented them- \nselves throughout as legitimate “privateers.” The court proceedings were \nled by Sir Leoline Jenkins, senior judge ofthe Admiralty Court. Jenkins later \nmade a career as a top-ranking diplomat ofthe English Crown, participating, \namong other things, as envoy at the negotiations for the peace of Nijmegen \nin 1678-1679. He is widely regarded as a central figure in the history of \ninternational law and many of his verdicts developed into precedence cases \nof modern international maritime law, in particular of prize law.»",
        "years_in_scope": [
          1674,
          1678,
          1679
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

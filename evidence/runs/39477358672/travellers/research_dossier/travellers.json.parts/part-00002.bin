      {
        "finding_id": "section-f40b70516c33460e5249",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "on the exploits of Drake and Raleigh.\" The substantial expansion of the \nCompany's political influence as a local power situated in the littoral helped \nadd weight to the older policy of arranging for convoy and protection against \nmaritime depredations and transformed the narrative stance towards piracy \nand violence. Thus, the staging and framing of maritime violence in the \nIndian seas was not politically neutral or innocent; indeed, representation \nemerged as an integral part of politics. Under the circumstances, the English \ncould hardly afford to ascribe any kind of political agency to piracy, even if \nthe actors themselves put forward a different point of view.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

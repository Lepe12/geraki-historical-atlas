      {
        "finding_id": "section-818776c3cdd48fd84cd0",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Repositioning sea raiders as full participants in regional politics supports \nalternative narratives of piracy in internationallaw. The term \"international \nlaw,” used frequently by authors in this volume, is an anachronism for the \nperiod under analysis. There was no settled European law of nations, no \nsingular legal approach to piracy, and no professional group of international \nlawyers in the early modern world. An alternative focus on “interpolity law\" \ncan open analysis to legal practices across political communities rather \nthan beginning with past or present doctrines.?' This approach examines \nsets of legal practices across political divides, with \"law\" defined broadly \nas a medium of imperial, regional, and global ordering.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

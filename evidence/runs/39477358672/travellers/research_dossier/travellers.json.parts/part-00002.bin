      {
        "finding_id": "section-df6a664c3e93d78a5fd6",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The second section of the book deals primarily with piracy in the context \nof imperial expansion. Hans Hágerdal's contribution focuses on the Bugis \nand Makassar peoples of South Sulawesi, who, along with several other \nethnic groups in maritime Southeast Asia, were frequently associated with \npiracy in colonial discourses and representations. Hágerdal asks how raiding \ncorrelated with other types of activities, such as commerce or service as \nauxiliaries, through two cases. The first is Lombok and Sumbawa in the late \nseventeenth and early eighteenth centuries, where landless Makassarese \naristocrats fought or allied with various groups to create a political platform. \nThe second case is the seascape around Timor, further to the east, where \na socially different type of maritime enterprise evolved, entailing both \ncommercial activities and raiding of vulnerable small-scale island societies. \nWhile Dutch writers termed all these seafarers “pirates,” this fails to capture \nthe range of their socio-political roles. Moreover, Hágerdal demonstrates how \nthe Dutch East India Company contributed to the rise of piratical activity \nthrough colonial advances on Sulawesi in the 1660s.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 60053,
          "end_char": 61246,
          "start_line": 1174,
          "end_line": 1189,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

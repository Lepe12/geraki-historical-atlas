      {
        "finding_id": "section-add59ad3de278dcefc95",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In France, meanwhile, labelling the Black Flags pirates was a rhetorical \ndevice that served to drum up support for the military intervention and \nconquest of Vietnam, particularly in the wake of the death of Riviére. The \nassociation between the Black Flags and piracy was facilitated by the fact \nthat their very name - Pavillons noirs in French — readily evoked visual \nand symbolic associations to the Jolly Roger, the well-known pirate flag \nof the eighteenth-century Atlantic. Moreover, by describing Vietnam as \na pirate-infested country and by shouldering the responsibility for sup- \npressing the supposedly ancient scourge in the region, the proponents of \ncolonisation could tie the colonial venture to a progressive vision of peace \nand progress - that is, the French mission civilisatrice.5?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

      {
        "finding_id": "section-2282d989f5274e7aaa34",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "The sons of Mahomed, that “gran marinero,” \nnaturally took to the sea, and as a young man Uruj \nbecame possessed of a ship——how we do not know, \nand it were better perhaps not to inquire. In this \nsmall craft he repaired to the coast of Caramania \nto make war upon the Christians; or, in other words, \nto begin an independent piratical career. Uruj in \nthese days was young and inexperienced, or he \nwould not have chosen this locality for his first \nventure, as this coast was in close proximity to the \nisland of Rhodes, from whence the great galleys of \nthe Knights of Saint John of Jerusalem set forth to \nexterminate the enemies of their faith.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 79644,
          "end_char": 80293,
          "start_line": 2244,
          "end_line": 2256,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

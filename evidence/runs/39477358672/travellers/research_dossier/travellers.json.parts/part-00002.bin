      {
        "finding_id": "section-0d6e1a00aa0b74e42328",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Uruj now established himself at the island of \nJerba, on the east coast of Tunis, which formed \nan admirable base from which to “work” the \nMediterranean from the piratical point of view. \nJerba had originally been conquered and occupied \nby the Spaniards in 1431, but the occupation had \nbeen allowed to lapse, and the island was lying \nderelict when the Barbarossas made it their head- \nquarters. Here Uruj was joined by his younger \nbrother Khizr, destined to become so much the \nmore famous of the two; he had already made \nhimself some reputation in piratical circles, and \nnow brought his cool judgment and wise counsel \nto the assistance of that fiery fighting man his \nelder brother. The first question to be decided \nwas that which we have already mentioned, namely, \nthe disposal of spoil from prospective captures, \nand with this end in view the corsairs approached \nthe Sultan of Tunis. This potentate made a \ngracious response to their overtures, and wished \nthem all success in their enterprises. He promised \nthem succour and support on the same terms \nwhich Curtogali had obtained, namely, one-fifth \nof all the spoil landed in his dominions.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 88419,
          "end_char": 89577,
          "start_line": 2456,
          "end_line": 2479,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

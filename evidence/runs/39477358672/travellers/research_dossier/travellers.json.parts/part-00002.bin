      {
        "finding_id": "section-7f6eccb2dd40629d5972",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "IN  all  the  ages  of  which  we  have  any  record  there \nhave  been  men  who  gained  a  living  by  that  prac- \ntice of  robbery  on  the  high  seas  which  we  know  by  the \nname  of  Piracy.  Perhaps  the  pirates  best  known \nto  the  English-speaking  world  are  the  buccaneers \nof  the  Spanish  Main,  who  flourished  exceedingly \nin  the  seventeenth  century,  and  of  whom  many \nchronicles  exist :  principally  owing  to  the  labours \nof  that  John  Esquemelin,  a  pirate  of  a  literary \nturn  of  mind,  who  added  the  crime  of  authorship \nto  the  ill  deeds  of  a  sea-rover.  The  Sea-Wolves \nof  the  Mediterranean  in  the  preceding  century \ndid  not  raise  up  a  chronicler  from  among  them- \nselves :  for  not  much  tincture  of  learning  seems \nto  have  distinguished  these  desperate  fighters  and \naccomplished  seamen,  descendants  of  those  Spanish \nMoslems  who  had,  during  the  Middle  Ages,  lived  in \na  land  in  which  learning  and  culture  had  been \nheld  in  the  highest  estimation.  Driven  from  their",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/seawolvesofmedit00curruoft",
          "source_file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",

      {
        "finding_id": "section-79a050b7581ed5e3b2f3",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "For some time, John Locke was identified as the author of an extended \nintroductory essay on the history of navigation for the Collection of Voyages \nand Travels (1704) produced by his publisher, Awnsham Churchill. The \nintroductory essay positioned the commercial and intellectual benefits \nof “the empire of Europe [...] now extended to the utmost bounds of the \nearth where several of its nations have conquests and colonies,\" within a \nmuch longer history of contest for the “sovereignty of the seas.\"3 The essay \nseemed to echo the argument in Locke's Two Treatises that the extension of \nBritain's imperial sovereignty in America was a token of progress away from \nthe insecurity of the state of nature, for which the savagery of “pyrates” on \nthe high seas served as an analogue. The pyrate in particular was construed \nnot simply by Locke, but also by his contemporary Tindal, as an agent ofthe \nendemic insecurity ofthe state of nature, a figure who exercised violence \nsolely on his or her own account without any legitimate state sanction. The \nlongevity of this construction of the pirate has enabled the anachronistic \nelision by which piratical sailors ofthe late seventeenth and early eighteenth \ncenturies are construed as \"essentially terrorists.””4",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 193124,

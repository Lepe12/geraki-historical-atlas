      {
        "finding_id": "section-82bb29cd0f3484ba0ab1",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Lakshmi Subramanian's chapter also sets out to counter Eurocentric \nbias in depictions of maritime power and violence along India's western \nlittoral during the period of British East India Company expansion in the \nlate eighteenth and early nineteenth centuries. She adapts recent analyses \noflegal pluralism in maritime spaces to explore the role of piracy in Indian \nconceptions of power and jurisdiction at sea. Piracy, she argues, was a matter \nof contention among Indian and British governing authorities that drew \nboth of them into efforts to understand the phenomenon as part of local \nhistories and traditions. Despite the efforts of some to understand piracy \nin this context, the British ultimately portrayed maritime predation as an \nethnographic marker ofa \"savagery\" over and against which their sovereignty \ncould be asserted. Like Subramanian, Joshua White takes a non-Eurocentric \npoint of view and aims to highlight the concurrent concepts of piracy and \nother forms of maritime violence in the early modern Mediterranean. He \nshows that a wide range of concepts were used in the early modern Ottoman \nEmpire to conceptualize what Europeans termed piracy or privateering. As \nin Europe, there was considerable ambiguity in the use and interpretation \nof these terms, and the practices that they described. In contrast to the \nemphasis that contemporary Europeans put on the distinction between \npiracy and privateering, in theory if not always in practice, Ottoman Islamic \nlaw did not differentiate between foreign Christian pirates and foreign \nChristian corsairs or privateers.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 61249,
          "end_char": 62848,
          "start_line": 1191,
          "end_line": 1212,
          "printed_page": null,

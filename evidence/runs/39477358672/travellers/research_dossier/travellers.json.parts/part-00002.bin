      {
        "finding_id": "section-a857387c2f53be9d4251",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The two Ottoman Turkish words most frequently associated with the \npractitioners of maritime violence in the sixteenth and seventeenth centuries \nwere korsan and levend. In Ottoman administrative and legal documents, \nthese could signify naval irregulars, corsairs, or sometimes unambiguous \npirates - the full spectrum of scale, legality, and professionalization. The \nwords korsan and korsanlık, derived from the Arabic qursan, which in turn \nwas derived from the Italian corsaro, carried the meaning of “corsair” and \n“corsairing” in the early modern period and were then used much as their \ncognates were in Italian; in modern Turkish, however, they are typically \ndefined as “pirate” and \"piracy.\"5 Corsairs, particularly those associated \nwith the major enterprises, whether Muslim or Christian, whether based \nout of Algiers or Malta, could be referred to as korsan. In theory, a corsair \nor privateer enjoyed political and/or religious sanction to raid designated \nenemies - that sanction being what separated them from mere pirates — but \nuse of the term certainly did not imply Ottoman (or Venetian) approval, \nor even acceptance of the legitimacy or legality of the korsan's raiding, \nthough it might indicate recognition of a degree of professionalization on \nthe raiders' part. Thus, Maltese corsairs were routinely referred to in the \nsame breath as “damned infidels” and “thieves,” and both the Ottomans and \nVenetians referred to Algiers- or Tunis-based raiders who illegally attacked",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

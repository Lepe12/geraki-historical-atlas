      {
        "finding_id": "section-67ac684376afbeb7ebc1",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In keeping with the underlying rationale ofthe present volume, namely, \nto look at non-European understandings of maritime violence, this chapter \nwill draw attention to three important sub-themes that constituted the \nphenomenon of predation and raiding, as it was pursued actively by littoral \nsociety, as it was described by the early colonial state and, subsequently, \nby imperialist and nationalist historiography. It is important to stress at \nthe outset that the chapter does not propose to speak of non-European \nperspectives on maritime violence in an abstract way or as hermetically \nsealed off from European understanding of the same. Histories of piracy \nand privateering (Indian, European) in the context of European claims \nto sovereignty expressed in terms of a monopoly on the legitimate use of \nviolence to safeguard private property, were entangled in complex ways with \nlocal realities and contingencies to produce confusing and contradictory \nnarratives. The challenges of reading the archive constitutes, therefore, \nthe second broad concern of the paper. Thirdly, it will try and identify the \nspecificity of the context, i.e. the western Indian littoral, to contextualize \nthe workings and ramifications of maritime violence from the latter decades \nof the eighteenth century by linking it with networks of labour mobility, \npolitical articulations of regional littoral states, and the resultant escalation \nof violence in littoral society.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

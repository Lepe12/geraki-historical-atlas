      {
        "finding_id": "section-85a333f777b3be93d0ce",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The chapter focuses on how piracy was rendered in Spanish records from \nthe Philippine Islands from around 1570 to 1800. The author demonstrates \nthat the label “pirate” was used to denote a wide range of hostile elements \nor peoples, including other Europeans, Chinese, Japanese, and indigenous \nPhilippine groups. Several of these alleged pirates have been largely \novershadowed by later, mainly nineteenth-century, accounts that focused \nexclusively or overwhelmingly on the maritime raiding of indigenous \nMuslim “Moro piracy.” The chapter thus demonstrates the complex nature \nof piracy and the multiplicity of actors, practices, and representations of \nthe phenomenon during the long period under study.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,

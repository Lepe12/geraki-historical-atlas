      {
        "finding_id": "section-8f40f07d2de4bffb83c9",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The tension between predation carried out by non-state actors on the one \nhand, and state-sponsored pillaging on the other, undergirds many debates \nabout what was, or was not, piracy. While corsairs worked under some \nform of sponsorship by a political authority, whether a privateer's letter of \nmarque and reprisal, or, as in Southeast Asia, a relation of clientship to a \npatron, piratical actions lay beyond the state. For the most part, it may be \nmore accurate not to conceive this \"beyond\" in territorial terms, because \nwhen it comes to most historical piracy claims, territory was not the main \ndeterminant of sovereignty's limits. Nevertheless, territory did play an \never-greater role in the parameters of sovereignty from the late nineteenth \ncentury and into the twentieth.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

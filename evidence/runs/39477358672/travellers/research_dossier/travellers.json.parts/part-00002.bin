      {
        "finding_id": "section-0bfcbf3d750b46619cf9",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The suppression of piracy was a major aspect ofthe process of colonization \nin Southeast Asia during the nineteenth century, not only for France, but \nalso for other colonial powers in the region such as Great Britain, the Neth- \nerlands, Spain, and the United States.5° However, only in the context of the \nFrench colonization of Indochina did the label piracy take on such a broad \nsignificance as to include virtually any act or person that resisted French \ncolonization, regardless of the motivation, location, or modus operandi. \nBy contrast, in other parts of Southeast Asia, and indeed in other parts of \nthe world, the term piracy continued, for the most part, to be reserved for \nraiders or rebels that used some form of maritime transportation.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",

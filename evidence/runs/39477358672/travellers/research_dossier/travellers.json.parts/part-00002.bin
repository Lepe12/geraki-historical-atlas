      {
        "finding_id": "section-dcdb47e27fdcc55be039",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "For the advocates in France of further colonial intervention piracy became \nincreasingly important in the wake of Garnier's death. In 1874, the French \ngovernment sought to convince a reluctant Parliament to ratify a treaty \nbetween France and Vietnam, and the treaty was, among other things, \npresented as essential in order to suppress piracy in the Gulf of Tonkin. \nThe government argued that the pirates formed veritable naval squadrons \nand obstructed commerce on the Vietnamese coast, a circumstance that \non several occasions had forced the French to undertake costly and bloody \nexpeditions. The government further argued that the suppression of piracy \nwas part ofthe work of civilization and that the French navy would swiftly \nbe able to eliminate the pirates, who, since time immemorial, had carried",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

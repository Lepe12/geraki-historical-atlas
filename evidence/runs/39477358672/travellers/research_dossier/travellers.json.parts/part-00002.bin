        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "The corsair must have meditated long and \nanxiously on the best way in which to approach \nthe autocrat of Constantinople; in the end he \nprobably hit upon the best solution of the problem \nby again sending an ambassador with precise \ninstructions as to the manner in which he was \nto act. For this important service his choice fell \nupon one of his captains, Hadj-Hossein by name, \nand to him he imparted all that he was to say, \nand—what was almost as important—what he was \nnot to say.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

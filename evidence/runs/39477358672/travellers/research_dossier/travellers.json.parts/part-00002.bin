      {
        "finding_id": "section-86ea2e802efe2c841e5c",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "between the Qing regime and pirates. Late imperial China saw the develop- \nment of three overlapping maritime “regimes” along its coasts, namely, \nthe imperial dynastic power, the European overseas enterprise, and the \n“pirates” themselves. Notably, the latter two regimes challenged the first \nin various ways. A reassessment ofthe Qing imperial claims of sovereignty \nin the face of activities labelled as piracy provides crucial understanding \nof the way empire was constructed. Here, Antony points at both parallels \nand dissimilarities between East Asian and Western forms of piracy and \nshows how the various players off China's coasts contended with each other \nover maritime space.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

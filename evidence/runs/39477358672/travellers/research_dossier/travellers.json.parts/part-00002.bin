      {
        "finding_id": "section-a9607479b4149bfc55b7",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,
          "date": [
            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "This terrible living grave of a galley, let us remem- \nber, is depicted from Christian models. A hundred \nand fifty years ago such scenes might be witnessed on \nmany a European vessel. The Corsairs of Algiers \nonly served their enemies as they served them: their \ngalley slaves were no worse treated, to say the least, \nthan were Doria’s or the King of France’s own. \nRank and delicate nurture were respected on neither \nside: a gallant Corsair like Dragut had to drag his \nchain and pull his insatiable oar like any convict at the \ntreadmill, and a future grand master of Malta might \nchance to take his seat on the rowing bench beside \ncommonest scoundrel of Naples. No one seemed to \nobserve the horrible brutality of the service, where \neach man, let him be never so refined, was compelled \nto endure the filth and vermin of his neighbour who \nmight be half a savage and was bound to become \nwholly one; and when Madame de Grignan wrote an \naccount of a visit to a galley, her friend Madame de \nSévigné replied that she would ‘‘much like to see this \nsort of Hell,’ and the men “groaning day and night \nunder the weight of their chains.’ Autres temps, \nautres moeurs!",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/greatpiratesstor0000jose",
          "source_file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",

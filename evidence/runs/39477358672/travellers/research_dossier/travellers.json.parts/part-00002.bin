      {
        "finding_id": "section-897243b100b0de83832d",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Images of piracy lie at the heart of talk about \"failed states,\" a term that \nentered the political lexicon ofthe United States in the early 1990s and that \ncame to occupy a prominent place in international peace and security.' \nWhile this timing suggests that the notion offailed states and its association \nwith piracy are recent additions to political theory, I argue here that they do \nnot originate from the context of offshore Somalia and related international \ninterventions in the western Indian Ocean. Instead, the failed states concept",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

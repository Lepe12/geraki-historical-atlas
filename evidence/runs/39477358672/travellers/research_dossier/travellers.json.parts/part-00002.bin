      {
        "finding_id": "section-63ac69c195e31d047772",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Walker's report on the Northern pirates did not receive many takers in the \nBombay Council. Most of its members were reluctant to draw a distinction \nbetween pirate states and communities and did not endorse the Resident's \nsuggestions about relinquishing indemnification. Nor did they value his ideas \nabout holding pirate states to their commitments, which the Resident saw \nas a kind of political apprenticeship for the states to start envisaging public \nresponsibility more seriously. In the end, as military options became the \nonly viable course of action, the official discourse took the form of treating \nthem as lawless subjects and criminals, albeit within a complex political \nstructure that was based on alliances between the Rajput groups, Vaghelas \nand Jadejas, and coastal communities like the Wadellas.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

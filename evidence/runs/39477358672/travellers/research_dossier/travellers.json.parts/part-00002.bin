      {
        "finding_id": "section-80033570a153260f968a",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "From at least the 1480s, all Ottoman commercial treaties (ahdname) with \nEuropean maritime powers included anti-piracy clauses that: prohibited \nattacks on each other's ships, shores, and subjects; mutually prohibited \nenslavement; required the parties to secure bonds from their corsairs to \nensure their good behaviour; and provided mechanisms for the provision of \nrestitution in the event of violations. They also embraced an attitude towards \npirates akin to the Ciceronian hostis humanigeneris. For example, the 1482",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 391877,
          "end_char": 392399,
          "start_line": 7377,
          "end_line": 7383,
          "printed_page": null,

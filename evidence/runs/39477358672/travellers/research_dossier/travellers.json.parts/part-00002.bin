      {
        "finding_id": "section-43f003c4061643ee4162",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Mustafa Ali named Lefkada among the chief destinations for an up-and- \ncoming Anatolian pirate in 1599, and most of Aya Mavra's levends were \nvolunteers who flocked there from distant coastal regions of the empire. \nGreek-accented Turkish, Greek, and lingua franca, the Romance pidgin \nunderstood in every Mediterranean port, could all be heard in the taverns \nand along the wharves of this frontier outpost.?? The fortress and its levends \nfulfilled legitimate security needs — until its reconquest by Venice in 1684, \nLefkada was the only Ionian island held by the Ottomans - and they played \nan important role in harassing enemy shipping and the nearby Venetian \nislands in wartime. But in peacetime, the unruly and largely unsupervised \nlevends of this insular ‘Little Algiers’, as the seventeenth-century Ottoman \ntraveler Evliya Celebi (d. 1682) called it, often turned to piracy, plundering \nthe ships and villages of both the neighbouring Venetian islands and the \nnearby Ottoman mainland and carrying off their inhabitants in order to \nbuild and row their frigates.5",
        "years_in_scope": [
          1682,
          1684
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 409158,
          "end_char": 410233,
          "start_line": 7667,
          "end_line": 7681,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",
        "uncertainties": [
          "ORIGINAL_NOT_INSPECTED",
          "SOURCE_GENEALOGY_PENDING",
          "INDEPENDENCE_UNRESOLVED",
          "TOPONYM_AND_USAGE_REQUIRE_SEMANTIC_EXTRACTION"

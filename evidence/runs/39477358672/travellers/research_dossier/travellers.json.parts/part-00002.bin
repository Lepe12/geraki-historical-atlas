      {
        "finding_id": "section-be2cefc5c02040e02154",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "sack the islands of Paxos, Antipaxos, and Cephalonia because some people \non the shore had hurled insults at the passing ships and a couple had fired \ntheir arquebuses, while their fleets were wholly justified in seizing Venetian \nships since they were simply compensating themselves for losses sustained \nfrom Venetian anti-piracy patrols. The Istanbul government rejected all \nthese excuses - those responsible for the attacks were labeled rebels and \ncriminals — but as the North African port cities arrogated to themselves the \nright to make peace or war as they saw fit, any naval entrepreneur could \njoin them and benefit from the legitimacy and infrastructure they could \nprovide. In seventeenth- and eighteenth-century Algiers and Tunis, which \nhad their own political and religious leaders, the corsairs could continue \nto claim the political and religious legitimacy that Istanbul denied them.*",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

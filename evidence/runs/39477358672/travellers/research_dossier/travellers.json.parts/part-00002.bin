      {
        "finding_id": "section-b22d7f7b092daadc7295",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Thus, pirates personified the restlessness of the sea itself. Since the me- \ndieval period, the French expression “écumeurs de la mer” has been applied \nto pirates and others who struck terror into peoples’ hearts.”° The sea was \naccessible for use by all,” and this necessarily meant that trade, war, and \nplunder existed inseparably side by side. In this way, in the concept of the \npirate in international law, the sea represented ex negativo the shared traffic \nspace of nations. The sea was the medium, the topographical precondition, \nfor understanding pirates as virtual assailants of all people and all nations.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

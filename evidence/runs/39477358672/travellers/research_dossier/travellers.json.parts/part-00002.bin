          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Cicero's writings about pirates thus placed them outside the law and repre- \nsented them as subversive enemies, not only of Rome but ofall nations. He \nechoed the words ofthe Greek historian Polybius, who described the Illyrians \nfrom the West Balkans in the second century BCE as the enemies of all.?? \nIf unchecked, such persistent, large-scale piracies could pose existential \nthreats to the state and society.?? The perceived threat helped to establish the \nlegal and moral discourse, which Cicero had pioneered, according to which \npirates were defined as the generic enemies of humanity. Any measures \nwere justified to deal with them.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",

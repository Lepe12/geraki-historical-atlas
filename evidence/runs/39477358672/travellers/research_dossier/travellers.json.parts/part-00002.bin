        "file": "mb.-marine-et-marins-alger_MB.Marine_et_Marins_Alger_djvu.txt",
        "title": "MB. Marine Et Marins Alger",
        "url": "https://archive.org/details/mb.-marine-et-marins-alger",
        "source_bibliography": {
          "creator": [

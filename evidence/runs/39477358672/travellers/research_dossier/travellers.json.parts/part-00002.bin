      {
        "finding_id": "section-031baac54cf859c1702f",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,
          "date": [
            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "which it seems was the signal agreed upon among the \nconspirators for seizing the ship. Bunch no sooner \nheard them, but he cried out aloud, that I will, for I \nam parson, and struck Mr. Carr again several blows \nwith his own sword. Mr. Carr and Turnley both \nseized him, and they began to struggle, when Dennis \nMackarthy, with several others, returned from the \ncabin with each a cutlass in one hand, and a loaded \npistol in the other, and running up to them, said, \nWhat! do the governor's dogs offer to resist? \nAnd beating Turnley and Carr with their cutlasses, \nthreatened to shoot them, at the same time firing \ntheir pistols close to their cheeks, upon which Turnley \nand Carr begged their lives.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

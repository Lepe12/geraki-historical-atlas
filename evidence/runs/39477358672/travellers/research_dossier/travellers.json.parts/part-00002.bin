      {
        "finding_id": "section-667d8d88e01da5384fd5",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "After reviewing these points, my essay turns to a summary of some ofthe \nmany valuable insights from the chapters and sketches several promising \ntrajectories in research on piracy. Much like the editors' and authors' focus \non “convergence,” a first direction for research identifies global patterns of \ndiscourse and practice in maritime violence. A second pathway opens new \nlines of inquiry about the relation of maritime violence to spatial and politi- \ncal change on regional and global scales. A third suggests new approaches \nto the history of international law, advancing the non-Eurocentric study of \ninterpolity law and replacing a focus on piracy with a broader analysis of \nraiding as a legal phenomenon. The essay's title, \"Pirate Passages in Global \nHistory,\" refers both to this set of pathways and to the still-incomplete \ntransition towards a global history of sea raiding.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

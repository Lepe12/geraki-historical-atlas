      {
        "finding_id": "section-f972f14ec8e56f09b8f4",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Take, for instance, the Straits of Tiworo, in what is now Southeast Sulawesi, \nIndonesia. During the mid-seventeenth century, this amphibious polity first \ncame into the sights of the VOC (Vereenigde Oost-Indische Compagnie, \nDutch East India Company) for its alliance with Makassar and its role in \nthe Great Ambon War, which formed part of the spice wars. The people of \nthis maritime-oriented polity became the targets of a colonial campaign, \nthough Dutch records of the time called neither Tiworo, nor its mariners \n“pirates” when the VOC first attacked Tiworo during the mid-1650s. In that \n1655 attack, two hundred of Tiworo's men - those who were not off elsewhere \nat the time - were slaughtered, while three hundred of Tiworo’s women \nand children, including the wives and daughters of Tiworo's ruling family, \nwere taken captive by the VOC and its largely Ternaten allies. Possibly, some \nwere eventually sold off as slaves, but records show that the VOC granted \nthese captives to their local fighters, allowing those fighters to keep them. \nAside from the political indignity and the personal tragedy of falling into \nthe hands of enemies, this transfer of people also undermined the strength \nofties between Tiworo and its main ally, Makassar. In this situation, one of \nmany where the line between war and raiding overlapped, it is fair to say \nthat it was not Tiworo's maritime-oriented people, but rather the VOC and \ntheir largely Ternatan allies, who had plundered captives.’",
        "years_in_scope": [
          1655
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 238954,
          "end_char": 240448,
          "start_line": 4565,
          "end_line": 4584,
          "printed_page": null,

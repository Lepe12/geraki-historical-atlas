      {
        "finding_id": "section-03d8236875c7587e7734",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Contemporary views of piracy often associate it with state failure. \nHowever, asJennifer Gaynor shows, this view may be traced to nineteenth- \ncentury debates about Southeast Asia, and in particular, the writings of \nRaffles for whom it became a pretext for intervention. Prior to this, European \nobservers tended either to naturalize piracy as a part of Southeast Asian \nlife, or to label foes as pirates. Both nineteenth-century colonial debates \nand earlier stereotypes disconnected from maritime settings do not provide \nreliable evidence of piracy. Instead, they offer evidence of colonial ideology \nand statecraft. Gaynor historicizes piracy's association with failed states \nand offers another way to theorize piracy without adopting either statist \nor relativist points of view.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 59203,
          "end_char": 59989,
          "start_line": 1158,
          "end_line": 1168,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

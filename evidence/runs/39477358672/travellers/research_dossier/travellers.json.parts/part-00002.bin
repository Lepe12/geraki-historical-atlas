      {
        "finding_id": "section-5ebddc0dd653438e1d19",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Contemporary views of piracy often associate it with state failure. However, \nthis view may be traced to nineteenth-century debates about Southeast \nAsia, and in particular, the writings of Sir Stamford Raffles for whom it \nbecame a pretext for intervention. Prior to this, European observers and \nofficials tended either to naturalize piracy as a part of Southeast Asian \nlife, or to label foes as pirates. Both nineteenth-century colonial debates \nand earlier stereotypes disconnected from maritime settings do not \nprovide reliable evidence of piracy. Instead, they offer evidence of colonial \nideology and statecraft. This essay historicizes piracy's association with \nfailed states and offers another way to theorize piracy without adopting \neither statist or relativist points of view.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",

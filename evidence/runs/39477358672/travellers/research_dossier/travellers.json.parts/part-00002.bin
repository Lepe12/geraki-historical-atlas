        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The sources of this complexity cannot be reduced to a gap between \ntheory and practice—as an effect, that is, of a relatively settled theory \nof piracy as a universal crime contrasting with the practical realities of \nblurred distinctions between piracy and warfare, and between pirates \nand common criminals.? The idea of a gap between theory and practice is \nsomewhat useful (though still imperfect) for framing the politics of piracy \nsuppression after the late nineteenth century.” In the long, earlier period \ncovered by this book, definitions of piracy remained unsettled in both \ntheory and practice, within and beyond Europe.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-aecd75e3207fb4773fb1",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Some boats left textual wakes on their travels, inscribing aspects of their \nundertakings in the historical record, if only a fraction of what occurred in \nwider maritime lives and settings. Tracing their paths through the sources \ncan reveal considerably more than just their geographic mobility. While \nsources for piracy are hard to find in the languages ofthe region, neverthe- \nless, the activities of mariners, both Southeast Asian mariners and others, did \nleave their mark in colonial archives, as well as in some indigenous language \nsources. These textual wakes may be followed, analysed, and contextualized, \nto help elucidate the times and places in which some mariners engaged in \nacts that might be considered piratical.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

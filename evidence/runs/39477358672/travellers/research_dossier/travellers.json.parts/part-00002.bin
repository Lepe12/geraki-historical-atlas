      {
        "finding_id": "section-c9b91b2aa565d9a30919",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "of the Ottoman Mediterranean faced death, or a short, miserable life \nchained to the oar. Within the diverse maritime ecology of the Ottoman \nMediterranean, the line between holy war and criminal rebellion, between \nlegitimate and illegitimate sea robbery, was thin and easily crossed - the \nsame individuals and groups could be responsible for both, not just at dif- \nferent stages of their career, but on the very same cruise. At the same time, \nthe cessation of conflict instantly transformed privateers into pirates when \nthey persisted in attacking their erstwhile enemies. This was certainly true \nfor the Ottomans vis-à-vis Venice after 1573, just as it was for the English \nand Dutch vis-à-vis Spain after 1604 and 1609, respectively; what had been \nlegitimate, respectable korsanlik became, in essence, piracy, to their former \nsponsors, even if we might hesitate to apply the label pirate to those Otto-",
        "years_in_scope": [
          1604,
          1609
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-d877ed4df410d41e0fb0",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,

      {
        "finding_id": "section-bef9b6eabc97febd2786",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "these multiplied themselves to the tale of something \nlike twenty-four, the conviction was strengthened \nthat that which had so profoundly interested the \nwriter, would not be altogether indifferent to others. \nFor some inscrutable reason the deeds of sea-robbers \nhave always possessed a fascination denied to those \nof their more numerous brethren of the land ; and in \nthe case of the Sea-wolves of the sixteenth century \nwe are dealing with the very aristocrats of the pro- \nfession. Circumstances over which they had no \ncontrol flung the Moslem population of Southern \nSpain on to the shores of Northern Africa: to \nrevenge themselves upon the Christian foe by \nwhom this expropriation had been accomplished \nwas natural to a warrior race; and those who \nheretofore had been land-folk pure and simple took \nto piracy as a means of livelihood. It is of the \ndeeds of these men that this book treats; of their \nmarvellous triumphs, of their apparently hopeless \ndefeats, of the manner in which they audaciously \nmaintained themselves against the principalities \nand the powers of Christendom always hungering \nfor their destruction.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

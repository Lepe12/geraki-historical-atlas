      {
        "finding_id": "section-da2187347a9995fabcc0",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Seductive as Schmitt's rationalization of piracy's great historical irrelevance \nis, I argue here that the ambivalence manifested in Johnson's text reflects \na persistent ambiguity represented by the figure of the “pyrate” in British \npolitical thought between 1690 and 1730 — a period often referred to as the \n“Golden Age\" of European or Atlantic piracy.? For those engaged in political \ndebate in these decades, “pyrates” embodied versatile possibilities, beyond \ntheir designation as hostis humani generis, and yet short of being consigned \nto a watery realm of perpetual sovereign-less, insecurity.",
        "years_in_scope": [
          1690
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 150068,
          "end_char": 150671,
          "start_line": 2915,
          "end_line": 2922,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

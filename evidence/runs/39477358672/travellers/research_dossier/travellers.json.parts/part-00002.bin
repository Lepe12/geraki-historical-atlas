      {
        "finding_id": "section-dd0fd9670b499b70f6ab",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Barbarossa  was  never  one  to  let  the  grass  grow \nunder  his  feet ;  he  had  the  Christians  on  the  run, \nand  he  intended  to  take  full  advantage  of  this \npleasing  circumstance.  Accordingly  he  despatched \na  trusted  lieutenant,  one  Hassan,  with  instructions \nto  harass  the  coast  of  Valentia,  to  ravage  with  fire \nand  sword  all  those  unfortunate  towns  and  villages \nwhich  he  could  reach.  This  corsair  entered  the \nRio  de  Ampasta  and  destroyed  all  before  him,  the \ninhabitants  fleeing  as  the  news  was  carried  by \nescaped  fugitives  and  by  the  red  glare  of  the  villages \nflaming  to  heaven  in  the  night.  Satiated  with  blood,",
        "years_in_scope": [],

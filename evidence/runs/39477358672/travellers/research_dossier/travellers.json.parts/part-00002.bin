      {
        "finding_id": "section-38d9544503732d22a896",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "European overseas expansion during the Early Modern period is par- \nticularly illustrative with regard to the ambiguity between piracy and \nstate power. From the turn of the sixteenth century, European navies and \ntrading companies around the world excelled in maritime violence. Their \ncompetitive advantage in this field enabled them to harass and eliminate \ncommercial and political rivals, Europeans as well non-Europeans. Maritime \nviolence exercised by states and trading companies was seen in principle \n(atleast in Europe) as legitimate, in contrast to the piratical violence exer- \ncised by non-state sponsored actors. At the same time, however, imperial \nrivalry at sea and on the coasts of the Americas, Africa, and Asia during \nthe Early Modern period encouraged piratical activity and created a vast \ngrey zone between licit and illicit maritime violence. To the non-Europeans \nwho frequently were subject to the violence, extortion, and coercion of \nEuropean navigators, moreover, the difference between, on the one hand, \nillicit piratical violence and, on the other hand, purportedly legitimate \nforms of maritime violence, such as naval warfare and patrols, punitive \nexpeditions, blockades, or privateering, was often imperceptible and of \nlittle practical consequence.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

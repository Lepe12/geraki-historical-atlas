          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "From the Vietnamese point of view, the French interventions and aggres- \nsion from the mid-nineteenth century onwards obviously merited the use of \nthe term giác.?? Interestingly, the French and the Vietnamese connotations \nassociated with pirates and [hai] gidc, respectively, had several points of \ncommonality, particularly the implication of subversion, treason, war, and \nrebellion, in addition to simple theft and banditry. The main difference \nbetween the French colonizers and the Nguyen Dynasty with regard to the \nlabel pirate or gidc seems above all to have concerned the question of to \nwhom it was best applied, rather than the relevance of the terms as such.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

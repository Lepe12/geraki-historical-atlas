      {
        "finding_id": "section-228cec4018a29184e8f1",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "From the concept of universal enmity, Gentili derived the universal right \nto pursue and punish pirates. All human beings were affected by their \nviolations no matter where or against whom they were committed. Therefore, \nany person was empowered to fight against pirates wherever they may be \nfound.?? To the present day, piracy is regarded as the first international \ncrime or — in the words of Carl Schmitt — as “the archetype of the so-called \nworld crimes.\" These are criminal actions for which the law enforcement \nauthorities of all states have the responsibility to prosecute in international \nwaters.?? Gentili reasoned that all states should be on a warlike footing \nagainst piracy everywhere, which later helped to promote the acceptability \nof the principle of intervention in international law. Some have drawn \nthe connection between the justification of a bellum piraticum and the \nbeginnings of international police and punitive expeditions, which were \ncontroversial in the nineteenth century and have remained so to the present \nday.?3",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 94580,
          "end_char": 95633,
          "start_line": 1838,
          "end_line": 1852,
          "printed_page": null,

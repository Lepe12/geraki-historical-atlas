      {
        "finding_id": "section-cbddc8508a0703563a83",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Piracy should be an ideal subject for world historians. Sea raiding occurred \nin every region, some piracy spanned interconnected oceans, and anti-piracy \ncampaigns aimed eventually at global prohibition. Still, broad or comparative \naccounts of piracy in world history have been surprisingly elusive. The \nproblem in part reflects maritime historians' traditional focus on the study \nof seaborne trade and navies and the relative neglect of broader political \ncontexts.' The study of piracy has helped to produce its own isolation, too,",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

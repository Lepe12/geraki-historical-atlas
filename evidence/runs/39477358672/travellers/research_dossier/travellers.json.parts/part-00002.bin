      {
        "finding_id": "section-72f69f142b65f64e8864",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "The question may be asked, how can it be that \nthe lives and actions of such men as these are worth \nchronicling? It is because, not only that they \nmodified profoundly the course of history in the \nage in which they lived, but also because that, \nhidden deep down, somewhere, in these men stained \nby a thousand crimes, ruthless, lustful, bloodthirsty, \ncruel as the grave, was the germ of true greatness, \nsome dim spark of the divine fire of genius. Con- \ntending against principalities and powers, they held \ntheir own; in the welter of anarchy in which they \nlived they proved that there existed no finer fight- \ning men, which alone give them some claim to \nconsideration ; but that which is most interesting \nto watch is the absolute domination obtained by \nthe leaders over their followers. There is no other \nrecord of pirates who commanded on so large a \nscale; there is none which shows men such as these \nbargaining on equal terms with the great ones of \nthe earth,",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 26714,
          "end_char": 27691,
          "start_line": 920,
          "end_line": 939,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

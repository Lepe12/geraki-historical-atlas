      {
        "finding_id": "section-0c7b41ba09e642cbf3c0",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "writers fancifully reimagined him not only escaping the law, but defending \nthe virtue ofthe women aboard the Mughal's ship? Captain Charles Johnson \nwas one among others who ventured into this domain of public taste with \na play that portrayed Avery as a comic hero. When he later came to write \nthe much more successful General History he chose to begin it by recounting \nAvery's exploits. Here, though, Johnson told a rather different tale: one that \ndid not culminate in comedy and chivalry, but in the perpetual jealousies, \nmutual fears, and irremediable insecurities into which these “successful” \npirates sank on Madagascar. The mystery that still surrounds the real identity \nof Captain Charles Johnson may help to explain why he took such a different \nview. Despite its lurid tales of far distant piracies in exotic locations, the book \nmay well have been fuelled by a mortal dread far closer to home.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

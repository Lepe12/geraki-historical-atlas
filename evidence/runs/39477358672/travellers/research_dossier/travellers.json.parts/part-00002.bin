      },
      {
        "finding_id": "section-0eab2bc2a7a57cbe0baa",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "The price to be paid was a stiff one, and was \nso regarded by the active partners in this arrange- \nment; they were, however, young and unknown, \nand had not the least intention of holding to their \nbargain when more favourable circumstances pre- \nsented themselves. Now they held fair speech \nwith the puppet princes of North Africa; the day \nwas to come when they should chase them from \ntheir insecure thrones. It was at this time, shortly \nafter the treaty with the Sultan of Tunis was con- \ncluded, that the younger Barbarossa received from \nthe Grand Turk the glorious name of Kheyr-ed- \nDin, or “The Protector of Religion.” It was a \nsomewhat remarkable title for a pirate, but perhaps \nits bestower was slightly deficient in a sense of \nhumour.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 89608,
          "end_char": 90360,
          "start_line": 2485,
          "end_line": 2500,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

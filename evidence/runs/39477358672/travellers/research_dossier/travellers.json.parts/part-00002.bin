      {
        "finding_id": "section-efbff27f56d29d02373d",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "These efforts, however, were soon overshadowed by the French discourse \non piracy, which was mobilized to drum up support for the colonization of \nVietnam. In the French metropolitan context, the discourse of piracy thus \ntook on a different guise, serving, above all, to link the French colonial \nproject in Indochina to a vision of peace and prosperity and to the French \nmission civilisatrice. Finally, the image of Vietnam as country teeming \nwith vicious and racially inferior \"pirates\" also served to fulfil the cultural \nappetite among the French public for stories of adventure, the horrific and \nthe exotic. In doing so, la grande piraterie both satisfied the desire among \nthe French for entertainment and contributed to sustain the image of the \npirate as a racialized other.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

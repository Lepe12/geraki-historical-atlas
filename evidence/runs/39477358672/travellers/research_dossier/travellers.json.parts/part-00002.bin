        "verified": false
      },
      {
        "finding_id": "section-e5e86d27f3e6fa5d4eb0",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Southern Ming emperors bestowed on pirate leaders prestigious titles and \nranks of office. The most prominent example is that of Zheng Chenggong, \nbetter known in the West as Koxinga (Guoxingye), which translates as \"Lord \nof the Imperial Surname,’ a title granted to him by the Southern Ming \nLongwu Emperor for his allegiance. With the collapse of Ming resistance \nafter the 1670s, several pirate-loyalist groups refused to capitulate and instead \nrelocated themselves and their families to several locations in Vietnam, \nCambodia, and elsewhere in Southeast Asia, where for generations they \ncontinued to adhere to Ming customs and dress.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 470630,

      {
        "finding_id": "section-baa39b501dbe343c707b",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "It was well for the corsairs that the Christians \nhad selected the previous year for their attack, as, \nhad they fallen upon them when Barbarossa was \nno longer in power at Algiers and the pirates were \nfighting among themselves, the latter would have \nbeen wiped out of existence. It was ill fighting \nwith Kheyr-ed-Din, whether you professed the \nreligion of Christ or that of Mahomet, and this \nthe revolting corsairs were very soon to discover. \nBarbarossa sailed away from Algiers a hunted \nfugitive, only to return again as a conqueror.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-07eed77f14a07dde84bf",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "This  quotation  is  given  in  full  to  set  out  the \namazing  fact  that  in  this  battle  over  three  thousand \nwere  killed  while  only  four  hundred  were  cap- \ntured, which  shows  that  it  must  have  been  in  the \nnature  of  an  indiscriminate  massacre ;  the  only \ncaptive  of  any  note  was  the  captain,  Juan  del \nRio.  Diego  de  Vera  had  had  enough  of  the  cor- \nsairs, and  sailed  away  with  the  remainder  of  his \nforce.  Of  what  became  of  him  or  of  them  there \nis  no  record,  but  he  must  have  been  a  singularly \nincompetent  commander  when  he  could  not  make \nhead  against  a  rabble  of  pirates  and  Moors  with \nthe  army  at  his  disposition.  Sandoval  does  not \nattempt  to  minimise  the  defeat,  which,  of  course, \nwould  have  been  impossible  ;  he  contents  himself \nwith  the  following  delightfully  quaint  reflection : \n\"  But  many,  many  times  Homer  nods  ;  this  disaster \nmust  have  come  upon  us  for  our  sins,  upon  which \nit  is  most  important  that  we  should  always  think \nand  meditate.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-3ea68d39877deef529fb",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "As a one-time Secretary to the Council of Trade and Plantations (in the \nearly 1670s) and a member of the Board of Trade and Plantations (1696-1700), \nJohn Locke was engaged in the long-running campaign to eradicate pirates \nfrom preying upon Britain's (and its colonies’) sea-going trade.” It was in \nthe context of this campaign that pirates came to be defined as the hostis \nhumani generis, the barbarous enemy whose very existence beyond and in \ndefiance of the law necessitated their elimination.” It is hardly surprising \nthat Locke would have adopted such a view of pirates who threatened the \ncommerce of the seas, the property and lives of merchants, and the rights \nof nations to exchange and trade. Yet, Locke’s references to pirates do not \nindicate that he viewed them alone as the major threat. In fact, Locke’s \nscattered discussions of “pyrates” reveals some interesting prevarications.”°",
        "years_in_scope": [
          1696,
          1700
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

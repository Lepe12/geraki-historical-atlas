      {
        "finding_id": "section-b852466437efa7eda686",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "A major aim of this book is to explore the different meanings of pirati- \ncal violence and the encounters between different concepts and cultural \nunderstandings of such violence during the period from 1500 to 1900. Our \nchosen time period is crucial in the global history of piracy. It witnessed \nthe development of a legal and political discourse on piracy in Europe, \ntriggered largely by the competition and anomalies that European overseas \ncommercial and imperial expansion gave rise to. The period was also forma- \ntive with regard to the development of international law, in the context of \nwhich laws pertaining to piracy and other forms of maritime violence and \njurisdiction at sea played central roles.\" While the European experience of \npiracy in the context of expanding maritime commerce and empire in this \nperiod is well known, our volume also looks to non-European perspectives \non piracy and related forms of maritime violence — not least the acts of \nviolence and coercion perpetrated by European navigators — for example \nin the Ottoman Empire, China, India, Vietnam, and various parts of the \nMalay Archipelago.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 23558,
          "end_char": 24691,
          "start_line": 534,
          "end_line": 549,
          "printed_page": null,

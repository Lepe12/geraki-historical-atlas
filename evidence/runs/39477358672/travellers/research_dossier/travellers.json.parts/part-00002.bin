      {
        "finding_id": "section-f569608e81778601d912",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "of peaceful trade which had been pursued for \ngenerations by Venetian and Genoese, by Spaniard \nand Frenchman; gone also, apparently never to \nreturn, was all sense of security for the wretched \ndwellers on the littoral of the Mediterranean, \nwho lived in daily, and particularly in nightly, \ndread of the falcon swoop of the pirate galleys.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

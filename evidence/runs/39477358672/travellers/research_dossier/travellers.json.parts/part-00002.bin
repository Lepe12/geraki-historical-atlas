      {
        "finding_id": "section-89db8585101217f5d198",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "King of Algiers, de facto King of Tunis, \nAdmiralissimo to Soliman the Magnificent, his \nname a portent in Christendom, his fame reaching \nfrom Spartel to Tunis, and from the shores of \nFrance to the foothills of the Atlas, Kheyr-ed-Din \nBarbarossa was at the height of his power. Never \nbefore had a corsair risen to such eminence, never \nagain was there destined to be so magnificent a \nsea-robber. Thus it was that the year 1535 \nopened gloomily for all those Powers whose coasts \nwere washed by the tideless sea. Italy, torn and \nbleeding, her strong men slain, her fairest matrons \nand maids carried off into the most odious cap- \ntivity, was lamenting the terrible fate to which \nshe had been exposed by the raids of the pirate \nadmiral. In Catalonia, in Genoa, in Venice, along \nwhat is now known as the Riviera, men trembled \nand women wept; for who could say that it \nmight not be upon them that the next thunder- \nbolt might fall? In Venice taxation was raised \nto the breaking strain to provide galleys where- \nwith to combat the foe, while the Genoese forti- \nfied their coasts and poured out money like water \nupon arms, armaments, and ammunition. Says \nSandoval :",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 233543,
          "end_char": 234720,

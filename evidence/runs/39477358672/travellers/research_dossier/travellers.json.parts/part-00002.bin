      {
        "finding_id": "section-bb008e2a5b040489b698",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The essay takes a non-Eurocentric point of view and aims to highlight the \nconcurrent concepts of piracy and other forms of maritime violence in \nthe early modern Mediterranean. The author shows that a wide range of \nconcepts were used in the early modern Ottoman Empire to conceptualize \nwhat Europeans termed piracy or privateering. As in Europe, there was \nconsiderable ambiguity in the use and interpretation of these terms, \nand the practices that they described. In contrast to the emphasis that \ncontemporary Europeans put on the distinction between piracy and \nprivateering, in theory if not always in practice, Ottoman Islamic law did \nnot differentiate between foreign Christian pirates and foreign Christian \ncorsairs or privateers.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

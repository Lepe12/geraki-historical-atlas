      {
        "finding_id": "section-8e1f3b6dbc60682ed1e2",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "at this time one of the principal refuges of the \nMoorish fugitives, who had been driven from \nGranada, from Cordoba, and from Southern Spain \ngenerally by Ferdinand and Isabella eighteen years \npreviously. To say that the condition of these \npeople was desperate is to speak but the bare \ntruth, for what could exceed the misery of the \nsituation in which they were left after the suc- \ncessful incursion of their Christian foes? What we \nare apt to lose sight of in the light of present-day \ncircumstances is the fact that these Spanish Moors \nwere a most highly civilised people, far more so \nindeed than their Christian contemporaries; that \nthey had been driven with fire and sword from the \nland in which they and their forefathers had dwelt \nfor over seven centuries, and that they now had \nbeen cast out literally to starve on the inhospitable \nshores of Northern Africa. So it came about that \nthe common people exchanged the life of the \npeaceful and prosperous artisan or husbandman \nfor that of the hand-to-mouth pirate, and the case \nof knight and noble among them was no better— \nperhaps rather worse—than the meanest among \nthose who had been expropriated.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 108925,

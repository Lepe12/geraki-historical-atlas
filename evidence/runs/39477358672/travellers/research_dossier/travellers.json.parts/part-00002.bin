        "verified": false
      },
      {
        "finding_id": "section-6e6d9dfda3d05930c810",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "A major sea change occurred at the beginning of the eighteenth century, \nwhen Britain, then emerging as the major European naval power, began to \ntake the lead in the global struggle against piracy. In 1700, Parliament passed \na law that outlawed piracy more clearly than before and prescribed severe \npunishments for piratical activities. The law was passed against a background \nof outrage at the ravages of Henry Avery and William Kidd in India in the \nlast years of the seventeenth century, jeopardizing English relations with \nthe Mughal court, embarrassing the English East India Company and the \nCrown. The result was that the British began to take stern measures against \npirates. Kidd and Avery, together with their crews, were tried and sentenced \non charges of piracy and several of the perpetrators of the attacks on Mughal \nships in the Indian Ocean were executed. Largely due to British suppression \nfollowing the War of Spanish Succession, the Golden Age of Atlantic piracy \nas well as the ravages by European pirates in the Indian Ocean came to an \nend around 1730.\"",
        "years_in_scope": [
          1700
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

        "verified": false
      },
      {
        "finding_id": "section-10f4fae2a7e0356d84fb",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The nineteenth-century vision that linked piratical activities to Southeast \nAsian maritime people does not seem to be connected in any substantial \nway to the historical role seventeenth-century Tiworo played as a vital \nnon-urban maritime hub and opponent of European powers and their allies \nduring the spice wars. In fact, one can trace in the historical record how \nTiworo fell out of notice, disregarded rather than spurned, the memory of \nits social and political place in wider networks of political economy and \nsocial interaction faded beyond recognition.” Later stereotypes of regional \nsea people as pirates, especially those of the Iranun and Balangingi Sama, \ninstead appear to have roots in earlier Spanish views about piratas in the \nPhilippines, views that flourished in connection with the raiding these \nmariners conducted from bases in the Southern Philippines during the \nlate eighteenth and nineteenth centuries. Below, I discuss the changing \ndynamics of colonial “anti-piracy” efforts across the nineteenth century, \nand the popularization of the idea that such “piracy” grew out of native \nstate decay. Yet, it must also be noted, as James Warren has argued, that \nIranun and Balanangingi Sama raiding across the archipelago was carried \nout under the authority of the Tausug datus of the Sulu sultanate, hence, \ntheir activities were an extension of the state. In other words, Iranun and \nBalangingi Sama raiders effectively operated as clients of the Sulu state, and",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 245588,
          "end_char": 247081,
          "start_line": 4675,
          "end_line": 4694,
          "printed_page": null,
          "scan_indexes_0_based": [],

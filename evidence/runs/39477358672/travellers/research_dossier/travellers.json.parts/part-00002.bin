      {
        "finding_id": "section-4d6c7b4a1a30f0cbd762",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Towards the end ofthe nineteenth century, the term “pirate wars\" (guerras \npiraticas) was coined by a new generation of Spanish historians. The term \ncame to refer to clashes between what they thought of as *Moro\" inhabitants \nofthe south and Spanish colonial troops.? The term Moro was introduced \nto Philippine contexts by early Spanish colonizers to distinguish between \nMuslim and non-Muslim local populations and had originally been used \nfor Islamic inhabitants of Southern Spain and North Africa.5? Exploring \nnew avenues in the history of the Muslim Philippines beginning from the \nperiod prior to any form of colonial contact, Isaac Donoso sees parallels in \nthe way the Spanish perceived Muslims as alien to the territory, both in \nthe case of Andalusia and in the Southern Philippines. This perception of \nthe Other came to support the concept of the Reconquista (reconquest).°9 \nAs a result, local Muslim sultans campaigned in insular Southeast Asia to \ngain support in striking back the spread of Christianity.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 554008,
          "end_char": 555031,
          "start_line": 10462,
          "end_line": 10475,
          "printed_page": null,

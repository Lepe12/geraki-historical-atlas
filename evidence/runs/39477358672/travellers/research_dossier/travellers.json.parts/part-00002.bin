      {
        "finding_id": "section-a3d7d263b7e011dab643",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "and princes bargaining with piratical ruffians who \nheld in thrall thousands upon thousands of their \nsubjects. How it came about that the Christian \nStates tolerated such an abuse is one of those mys- \nteries which can never be explained; and if sub- \nsequent centuries displayed a greater refinement of \nmanners, a more apt appreciation of all that is \nsofter and kindlier in the human relationships of \nnation towards nation and of people towards people, \nthey have not perhaps so much to plume themselves \nupon as had their rude forefathers of the sixteenth \ncentury, who, seeing the evil and feeling the effects \nthereof, did their best to extirpate those by whom \nthis evil was caused.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

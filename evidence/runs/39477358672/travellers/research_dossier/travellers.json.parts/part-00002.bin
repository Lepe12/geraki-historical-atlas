      {
        "finding_id": "section-eb07693bcb8f923cdf5e",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The Dutch were disappointed, for the two cronies appeared in Sumbawan \nwaters in full force in 1700. According to what the Company later heard, \nthe close ally of the VOC in Sulawesi, Boné, had a hand in this. Boné was \nruled by a nephew of Arung Palakka, who aimed to increase his influence \non rice-producing Sumbawa by forming a strategic alliance with the sultan \nof the western kingdom. The court hesitated to receive the Bonese princess \ndue to the enormous costs that such a marriage would involve in terms of \nbride-wealth and pomp. Boné therefore supposedly encouraged the two \nraiding princes to ravage the island, which they happily did. The Dutch \nreports relate how the locals received the “pirates” with the honours due to \nruling princes, to no avail as the coastal areas were badly ravaged. A local \nSumbawan potentate revealed to the Dutch that there was even more at \nstake. Jarannika entertained contacts with Surapati, a Balinese runaway \nslave who had carved out a little principality in East Java and who was the \narch-enemy of the VOC.”° The general idea, it was suggested, was to force \nthe Sumbawan kingdoms in the alliance and then to “wage war together \nagainst Batavia.\"\" This was truly alarming news for the Dutch.",
        "years_in_scope": [
          1700
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

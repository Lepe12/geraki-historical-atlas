      {
        "finding_id": "section-e60965498b1d19d42ce5",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Lumping together pirates at sea, bandits on land, petty thieves, and \nnational resistance fighters and calling all ofthem pirates obviously served \nrhetorical purposes in France, particularly in the context of the campaign \nto drum up support for the annexation of Vietnam after Henri Riviére was \nkilled by the Black Flags in 1883. As the discourse took hold and seemed \nto have the desired effect on public opinion, it continued to be used long \nafter most anti-colonial resistance, as well as banditry and piracy at sea, \nhad been suppressed or defeated by the mid-1890s.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 677462,
          "end_char": 678036,
          "start_line": 12809,
          "end_line": 12816,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",

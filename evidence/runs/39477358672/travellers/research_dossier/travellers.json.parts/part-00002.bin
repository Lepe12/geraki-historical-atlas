      {
        "finding_id": "section-d38d274e5ddc663b0fff",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "The whole story is an illustration of the extra- \nordinary relations existing among the Mediterranean \nStates at this time. Soliman the Magnificent, \nSultan of Turkey, had lent three hundred of his \nJanissaries, his own picked troops, to assist the \ncorsairs in their depredations on Venetian com- \nmerce. Having done this, and the Janissaries \nhaving been caught and summarily and rightly put \nto death as pirates, the Sultan, as soon as he heard \nof what had occurred, sent an ambassador, one \nYonis Bey, to Venice to demand satisfaction for \nthe insult passed upon him by the beheading of his \nown soldiers turned pirates. ‘The conclusion of the \naffair was that the Venetians released “‘ The Young \nMoor of Alexandria” as soon as he was cured of \nthe eight wounds which he had received in the \nconflict, and sent him back to Africa with such \nof his galleys as were left. There was one rather \ncomical incident in connection with this affair, \nwhich was that when Yonis Bey was on his way \nfrom Constantinople to Venice he was chased by \na Venetian fleet, under the command of the Count \nGrandenico, and driven ashore. The Count was \nprofuse in his apologies when he discovered that he \nhad been chasing a live ambassador ; but the occur- \nrence so exasperated Soliman that he increased his \ndemands in consequence.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",

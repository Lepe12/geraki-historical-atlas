      {
        "finding_id": "section-252bee0119e3cfc5cd5a",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "DRAGUT  had  made  it  a  practice  never  to  appear \nin  the  harbour  of  \"  Africa  \"  in  any  great  force, \nas  he  had  no  desire  to  frighten  the  birds  whom  he \ndesired  to  snare ;  on  the  occasion  of  which  we  are \nnow  speaking  he  had  but  two  galleys,  and  their  de- \nparture from  the  outer  harbour  passed  almost  un- \nnoticed, as  the  ruck  of  the  population  were  accus- \ntomed to  visits  from  the  corsairs,  who  came  to  fill \nup  with  provisions  and  fresh  water.  Swiftly  as \nhawks  his  vessels  swept  along  the  coast  collecting \nthe  garrisons  of  Susa,  Sfax,  and  Monastir  to  aid  him \nin  his  latest  design ;  they  were  all  picked  men  and \nsingularly  apt  for  the  stern  business  which  their \nleader  destined  them  to  undertake.  In  this  manner \nhe  soon  collected  five  hundred  of  the  stoutest  and \nmost  reckless  fighters  who  sailed  out  of  the  ports  of \nNorthern  Africa,  and,  when  it  became  noised  abroad \namong  them  what  the  service  was  for  which  they \nwere  required,  there  was  universal  joy  and  eager- \nness. True  the  adventure  was  a  formidable  one: \nto  capture  \"Africa\"  was  no  light  task,  even  for \nsuch  men  as  these  under  so  renowned  a  leader  ;  there",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

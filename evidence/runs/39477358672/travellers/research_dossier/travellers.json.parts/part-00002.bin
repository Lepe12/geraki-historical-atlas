      {
        "finding_id": "section-05a28e1fba48ac8fe1cb",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "This chapter turns to the prominent role of “piracy” in French colonial \nexpansion in Vietnam in the late nineteenth and early twentieth century. \nThe author demonstrates how the long-standing European fascination with \npirates in popular culture made it expedient for French colonial officials \nto label anyone who resisted French colonial expansion in Vietnam as \npirates, even if this meant that the concept was stretched to its limit and \napplied to bandits as well as Vietnamese court officials who had never \nset foot on a sea-going vessel. Amirell also juxtaposes the French and \nVietnamese concepts associated with piracy, banditry, and subversion \nand shows how the Vietnamese king Tu Duc, not unreasonably, accused \nthe French navy of piracy.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

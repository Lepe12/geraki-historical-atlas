      {
        "finding_id": "section-25cb7d013515ab9b37d4",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In this way, privateering practice led to the development of a particular \ntype of sea robber, who, unlike the corsairs and merchant warriors of the \nsixteenth and early seventeenth centuries, was not committed to serving \na single nation but operated on a freelance basis for one sovereign after \nanother or for several simultaneously. With freelance privateers like Cusack \nand the rest the national links of the licenced sea robbers gradually began to \ndissolve. This development was encouraged by the fact that they lived solely \noff their booty: “no purchase, no pay” - this was the customary international \nprinciple limiting the “pay” of a privateer to the booty taken, a principle \nalso accepted by the young seamen from London who operated as privateers \nunder the leadership of Cusack.”° For this reason, the privateer can only be",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

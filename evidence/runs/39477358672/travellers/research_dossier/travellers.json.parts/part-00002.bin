      {
        "finding_id": "section-2954f8d263b1ba0a5625",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "If Locke consulted Exquemelin at all while revising the Two Treatises, it is \nhard to imagine that he took much else from it than the sensational stories \nof cruel atrocities, ambushes, tortures, lootings, and sackings committed \nby the French buccaneer captain Francois l'Olonnais (c. 1630-c. 1669).55 \nOne of the features of piracy that Locke emphasized was that pirates were \nthose with whom no faith could be kept. Pirates not only placed themselves \nbeyond the reach of laws, but also defied those very laws by claiming a \nright to act on their own account. Therefore, they could not be trusted to \nkeep their bargains.",
        "years_in_scope": [
          1630,
          1669
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 180097,
          "end_char": 180721,
          "start_line": 3448,
          "end_line": 3456,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "6 ‘We Call Them Pirates Out Here’ is a satirical reworking of E. Philips Fox's painting ‘Land- \ning of Captain Cook at Botany Bay, 1770' from 1902. Boyd's painting is kept at the Museum of \nContemporary Art in Sydney, Australia. A video of Daniel Boyd's description of the work and \nits context can be viewed at the MCA website here: https://www.mca.com.au/artists-works/ \nworks/2006.25/. We are grateful to Daniel Boyd and the Roslyn Oxleyg Gallery in Sydney for \ngranting permission to reproduce this painting.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

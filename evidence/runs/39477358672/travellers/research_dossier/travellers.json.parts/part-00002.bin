      {
        "finding_id": "section-8e44689d44cf934586a2",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "It may here be mentioned how terrible was the \ndamage wrought by the piratical fraternity in the \nMediterranean, and the manner in which it has \nbeen brought to light in somewhat remarkable \nfashion quite recently. Since the French occupa- \ntion of Tunis it was charged against them that \nthey had taken away from the natives of the \ncountry those fertile lands which lay upon the \nshores of the sea, and had given them to French \nsubjects. The facts of the case were that for \ncenturies these lands had been entirely out of \ncultivation, the reason being that, until the com- \nplete suppression of piracy in the Mediterranean \ntook place, none dared to dwell within raiding \ndistance of the sea for fear of being carried off into \nslavery.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

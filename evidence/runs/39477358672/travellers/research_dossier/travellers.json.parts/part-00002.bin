      {
        "finding_id": "section-fea65d49f1fdf594dd89",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "There was one undeniable advantage in the \nsystem which swept off into slavery the whole of \nthe inhabitants of a country-side, and that was, if \nat any time you required a guide at any particular \npoint on the coast, he was sure to be forthcoming \nfrom one of the vessels in the fleet. Now Bar- \nbarossa did not exactly know where Julia Gonzaga \nwas to be found, so he set his captains to work \nto discover the necessary slave. This was soon \naccomplished, and there was really no occasion \nfor a slave on this occasion, as a renegado of \nNaples knew the castle in which Julia Gonzaga \nwas residing at the time, and readily agreed to \nact as guide to the expedition sent to accomplish \nher capture. Kheyr-ed-Din had made a sudden \ndash along the coast with some of the swiftest \nof his galleys for the purposes of this capture. In \nconsequence the people in Naples and the neigh- \nbourhood were not even aware that the piratical \nsquadron was on the coast before they anchored, \nas near as it was practicable to do, to the residence \nof the Duchess of Trajetto. The fleet actually \narrived after dark, having kept out to sea and out \nof sight during the day.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      },
      {
        "finding_id": "section-be543a714be940f56e93",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "where it implies state sponsorship.5 On the one hand, his use of this term \nis striking, given later Spanish use of the term piratas from at least the \nmid-seventeenth century onwards, especially in reference to “Moros” in \nthe Philippines. On the other hand, it is also unsurprising that Pires should \nuse the term corsairs in his writings on Indian Ocean and Asian maritime \nworlds, given his Iberian provenance. Pires' use ofthe term corsairs reflects \nhis understanding of the political structures in which many archipelagic \nmariners undertook plunder during the early sixteenth century. In other \nwords, he recognized their pillaging as being, in some sense, sponsored \nby Southeast Asian political authorities, rather than, as we have come to \nunderstand piracy, conducted beyond sovereignty's bounds.?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 212279,
          "end_char": 213088,
          "start_line": 4117,
          "end_line": 4127,
          "printed_page": null,
          "scan_indexes_0_based": [],

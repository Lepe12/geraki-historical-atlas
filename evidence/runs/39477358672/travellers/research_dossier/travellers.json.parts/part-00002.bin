      {
        "finding_id": "section-f0069cab15f54af624a0",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In European history, the understanding of the pirate as a universal enemy \nhad developed in the context of considerations of the laws of war, which had \ntheir beginnings in Roman antiquity. In the last century before Christ, the \nspread of piracy in the Mediterranean had led scholars and lawyers of the \nLate Republic to embark on a legal clarification of the difference between \nwar and piracy. Once war had been understood as a legal process, the next \nstep was to distinguish between legal war enemies (perduelles or hostes) and \nnon-legal enemies. In the case ofthe former, fundamental norms had to be \nobserved, including the principle of contractual fidelity and, in particular, \nthe observance of promises made under oath. The same did not apply to \nirregular opponents. The classical lawyers defined legal wartime enemies \nby the criterion of official warfare. Enemies were those against whom the \nRoman people had publicly declared war. Hostile peoples against whom \nwar could not be declared were termed robbers or bandits.’ Regarding this \nlatter category, Cicero pointed to the pirate, whom he defined not as a legal \nwartime enemy but the common enemy of all (communis hostis omnium), \nas standing outside all legal order.?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 85187,
          "end_char": 86424,
          "start_line": 1675,
          "end_line": 1691,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

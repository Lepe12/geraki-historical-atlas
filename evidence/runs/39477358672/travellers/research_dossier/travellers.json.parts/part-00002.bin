        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The findings I have surveyed illustrate several new directions in histories \nof sea raiding in general, and piracy in particular. Many of the chapters \npointto the importance of histories of piracy for understanding the spatial \ndimensions of sea raiding and its regulation. Others open new vistas on the \npolitics of piracy and its relation to processes of forming and sustaining \nvarieties of political communities across the globe. Still others support \nthe movement towards new approaches to the history of international law.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

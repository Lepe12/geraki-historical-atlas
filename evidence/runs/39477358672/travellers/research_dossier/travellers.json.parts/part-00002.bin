      {
        "finding_id": "section-212374f6b1d892ca5893",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Uruj Barbarossa, Kheyr-ed-Din Barbarossa, \nDragut Reis, and Occhiali, or Ali Basha, were \nmen who, in the sixteenth century, did much to \nchange the conditions of the times in which they \nlived: it was the time of the Renaissance in Europe, \na period of splendour in all the arts and sciences. \nThese men added nothing to the knowledge of the \ncivilised world as it then existed, save and except \nin one particular, which was, as Kheyr-ed-Din \nexplained to Soliman the Magnificent on a certain \nmemorable occasion, that he who rules on the sea \nwill rule on the land also. In the present day, \nwhen all the nations and languages sit at the feet \nof Captain (now Rear-Admiral) Mahan, and ac- \nclaim his “Sea Power” series of books, it is \ninteresting to find that he was anticipated in the \nmost practical fashion possible by a corsair of \nthe sixteenth century.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 29011,
          "end_char": 29872,
          "start_line": 979,
          "end_line": 996,
          "printed_page": null,
          "scan_indexes_0_based": [],

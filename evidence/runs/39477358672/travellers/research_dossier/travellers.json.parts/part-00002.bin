        "verified": false
      },
      {
        "finding_id": "section-75886f2f0942eb2e807d",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The concept of universal enmity referred not only to a potential hostility \ntowards all people, but also to the inhumanity of the crime itself. As Bruce \nBuchan discusses at greater length in his contribution to this book, in London \nin 1693 some legal experts refused to treat the privateers of the deposed \nJames II as pirates because they were not enemies of all humanity but only \nof the new English government. The supporters of the ruling king, William \nIII, objected however: “Hostis humani generis, is neither a Definition, or as \nmuch as a Description of a Pirat, but a Rhetorical Invective to shew the \nOdiousness of that Crime.\"? By placing themselves in opposition to the \nlaws of sovereigns and nations, pirates were cast as opponents of the very \npossibility of laws between sovereigns and nations, and thus as a universal \nantagonist of all humanity. Accordingly, in the English legal literature of the \nseventeenth and eighteenth centuries, pirates were often depicted as “beasts \nof prey\" or “savage beasts.\"? Piracy was regarded in English criminal law as a \ncomprehensive crime. As an accumulative crime, piracy included accusations \nof robbery, murder, barbarity, treason, and atheism.'? Contemporary observ- \ners accused the sea robbers of savageness and disgusting bestiality, denied \nthat they possessed a national character, held their ethnic heterogeneity",
        "years_in_scope": [
          1693
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 92123,
          "end_char": 93503,
          "start_line": 1791,
          "end_line": 1808,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,

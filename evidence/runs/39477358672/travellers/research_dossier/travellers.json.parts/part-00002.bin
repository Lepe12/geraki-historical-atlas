      {
        "finding_id": "section-c6d39bc909d13ecf7b84",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "For many land-based powers, extending sovereign control over the sea was a \nnecessary consequence for controlling navigation and trade and the people \nin charge of it. The tools and practices of control, however, could differ \nsignificantly. In Asian waters, non-European regulations regarding piracy \nand related forms of maritime violence in the early modern era met with \nthe Spanish understanding or the idealized forms of it. This complex process \nstarted with ambiguities such as the colonial administrators' overemphasis \non military defence. Regardless of the importance of foreign trade for the \nsurvival of the colony, high-ranking Spaniards preferred strong military \ncommand to liberal trade. Such a view not only misinterprets East Asian \nforeign policies but also ignores the colonial discourses on masculinity. \nThis discourse flourished among the many soldiers involved in fending \noff aggression from neighbouring Muslim communities, Dutch maritime \nattacks, and became moreover handy when refusing to give up its claims \non the Moluccas to which the Spaniards held commercial and territorial \ninterests into the 1660s. Piracy not only described a profit-seeking enterprise \nbut also a socio-economic phenomenon. As indicated above, many such \nenterprises were sponsored by local authorities. Hence, the Spaniards were \nnot all wrong when they unilaterally referred to them as corsairs.*5",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 562073,
          "end_char": 563478,
          "start_line": 10617,
          "end_line": 10635,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

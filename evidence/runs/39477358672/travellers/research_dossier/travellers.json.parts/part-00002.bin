      {
        "finding_id": "section-a93dcd2dddb597d11ca0",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Uruj Barbarossa was undoubtedly a remarkable \nman. At atime when the Mediterranean swarmed \nwith warriors none was more feared, none was \nmore redoubtable than he. By sheer valour and \ntenacity he had fought his way to the front, and \nthe son of the obscure renegado of Mitylene died \na king. It is true that his sovereignty was pre- \ncarious, that it was maintained at the edge of the \nsword ; none the less, in that welter of anarchy \nin which he lived he had forced himself to the \nsummit, and, pirate, sea-wolf, and robber as he \nwas, we cannot withhold from him a meed of the \nmost hearty admiration.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 127626,
          "end_char": 128231,
          "start_line": 3430,
          "end_line": 3442,
          "printed_page": null,
          "scan_indexes_0_based": [],

          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The corsairs who raided and enslaved the designated enemies of the \nfaith at the designated times were celebrated as holy warriors of the sea. \nIn fact, all those who fought in the sultan's wars, including those waged \nagainst fellow Muslims, were lauded as gazis and miicahids, since Ottoman \nreligious-legal authorities issued fatwas — legal opinions — declaring every \nOttoman war a holy war.” However, when Ottoman corsairs attacked the \nsultan's own subjects or attacked the subjects of the powers to which the \nsultan had extended peace and protection — by 1612, a list that included \nVenetian, Ragusan, French, English, and Dutch subjects — they became rebels \nand, by extension, pirates. Sultanic authorization was what consecrated the \nraiding of “enemy infidels” and kept the corsair on the right side of Mustafa \nAli's jihad island.",
        "years_in_scope": [
          1612
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

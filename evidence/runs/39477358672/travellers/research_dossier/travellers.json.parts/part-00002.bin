        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "communities and to eliminate any commercial competitors, European, \nAsian, or African. Historian Peter Earle has aptly called such practices \n“piratical imperialism”; that is, European governments supporting or condon- \ning piracy committed by their own subjects as a cheap and effective way \nof furthering their commercial and political objectives overseas.3+ There \nwas, in other words, a great difference between the rhetoric about pirates \nas the enemies of all and the reality of clandestine connections between \npirates and other entrepreneurs of illicit maritime violence, and trading \ncompanies and empires.55",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

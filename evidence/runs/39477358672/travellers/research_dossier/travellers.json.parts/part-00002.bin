      {
        "finding_id": "section-9fe99a3cabebc1d79a6d",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "This chapter builds on Benton's and other recent studies on Euro- \npean empires, legal regimes, and piracy by exploring how Qing rulers, \nscholar-officials, agents of foreign states, and pirates interacted with \none another in the construction of empire and sovereignty. While my \nresearch has been inspired by Benton in particular, I nonetheless take \nher studies as my point of departure because there is so much that was \ndifferent in China. She has persuasively argued that the expansion of law \nclosely followed the expansion of European empires across the globe. \nRather than viewing the oceans simply as empty, lawless space, she has \nshown how European explorers, government agents, merchants, and \neven pirates helped in the process of extending Europe's imperial and \nlegal regimes across the seas. The extension of European law (and the \nconcurrent creation of international law), however, took centuries and \nwas never as complete as imperial states would have us believe. Because \nempires and sovereignty extended along narrow corridors and clusters \nof enclaves, they remained fragmented and uneven, or as Benton puts it, \n“lumpy.” Nonetheless, as her studies clearly show, it was the intention of \nEuropean imperial governments to impose European/international law \nacross the oceans and to the far corners of the globe. China in the Qing \nperiod, however, followed a different trajectory, which both reacted and \nadjusted to Western encounters and to piracy.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 444389,
          "end_char": 445863,
          "start_line": 8326,
          "end_line": 8346,
          "printed_page": null,

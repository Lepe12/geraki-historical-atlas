      {
        "finding_id": "section-3bcc6c9542ff2f15c2c9",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "There is clearly something powerfully seductive about the association of \npiracy and universal criminality. The assumption of a strong link has found \nechoes in romanticized representations of pirates as proto-revolutionary \nactors standing in opposition to organized political power. It has been \nreinforced through the revival of interest in the work of Carl Schmitt, \nwho promoted a view of piracy as “the archetype of the so-called world \ncrimes” and portrayed pirates as stateless actors.* The view aligns, too, \nwith a tendency among some scholars to emphasize connections between \na strand of European legal discourse that labelled pirates as hostes humani \ngeneris, enemies of all mankind, and recent definitions of terrorism.5 The",
        "years_in_scope": [],

        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "where they helped open up new lands.?? From the perspective ofthe state, the \nlarge-scale piracy ofthe mid-Qing period presented a formidable challenge \nboth to the political sovereignty and economic health ofthe empire. It also \nexposed severe weaknesses in the dynasty's politico-military establishment \nthat would lead to its near collapse during the onslaught of foreign wars \nand internal rebellions in the mid-nineteenth century.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

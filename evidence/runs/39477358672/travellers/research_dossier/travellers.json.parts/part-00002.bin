      {
        "finding_id": "section-6636b877d3de3cae0768",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Once  again  Christendom  was  nerving  itself  for \na  supreme  effort  against  the  corsairs,  and,  during \nthe  time  that  Barbarossa  was  raiding  and  ravaging \namong  the  islands  of  the  Archipelago,  the  Christian \nfleet  was  gradually  assembling.  At  first  it  numbered \nsome  150  galleys,  81  Venetian.  36  Pontifical,  and  30 \nSpanish ;  Charles  V.  sent,  at  the  last  moment, \n50  ships  on  which  were  embarked  10,000  troops. \nThe  force  totalled  altogether  59,000  to  60,000  men, \n195  ships,  and  2,594  cannons.  This  was  no  doubt",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

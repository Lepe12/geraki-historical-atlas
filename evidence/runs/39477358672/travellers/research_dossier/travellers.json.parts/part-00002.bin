      {
        "finding_id": "section-23ddd1038e8228aea909",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Though Speelman may have attempted to deny Tiworo's political \nand nautical legitimacy, his scornful words came well after the Tiworo \ncontingent shifted their allegiance to Boné, and the Makassar War had \nreached its conclusion. Not only did he call Tiworo piratical after the \nconflict's conclusion. Of note for my purpose here, Speelman also did not \ncouple this invective with any notion of failing political structures. This \nseventeenth-century example thus presents an interesting contrast with \nlater nineteenth-century perspectives that took piracy as a sign of state \ndissolution. Also, whereas Speelman's invective was applied retrospectively, \nin contrast, nineteenth-century assessments of piracy as a sign of state \ndissolution mobilized piracy ascriptions to justify prospective actions and \na politics of intervention.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 244751,
          "end_char": 245585,
          "start_line": 4662,
          "end_line": 4673,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",
        "uncertainties": [
          "ORIGINAL_NOT_INSPECTED",
          "SOURCE_GENEALOGY_PENDING",

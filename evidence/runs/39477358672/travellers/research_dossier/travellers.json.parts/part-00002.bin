      {
        "finding_id": "section-8668e2f219eb184a56bc",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The main goal of this chapter is to highlight the discursive power of piracy \nand coastal raids in Spanish colonial reports produced in the Philippines \nbetween 1570 and 1800, with the key focus on roughly the first hundred \nyears. The chapter focuses on the margins of the South China Sea or the \nwaters and coasts of what is nowadays referred to as the Philippine, Sulu, \nand Indonesian seas. Discourses of external threat played an important role \nin both establishing sovereignty and in creating a sense of common political \ninterest among different subordinate groups. For maritime Southeast Asia, \nnon-European understandings of maritime violence and the relationship \nbetween those who talked and wrote about it and those who were accused \nof committing it are essential yet remain understudied. Approaching the \ntheme through the lens of concurrent concepts of piracy can contribute to \nnuance long-held misconceptions of either religiously motivated raiding or \nspontaneous acts by opportunist seafarers. The perspective of concurrences, \nmoreover, reminds us of the many unheard voices in these unequal encoun- \nters and the slippery recording by contemporaries and later historians.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

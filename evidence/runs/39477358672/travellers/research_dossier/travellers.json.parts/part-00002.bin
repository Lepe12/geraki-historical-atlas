      {
        "finding_id": "section-45bf810a9192c9e64daf",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Just  after  the  first  reinforcements  had  been \nthrown  into  St.  Elmo  there  arrived  on  the  scene \nAll,  the  Lieutenant  of  Dragut.  This  corsair  came \nfrom  Alexandria  with  six  galleys,  on  board  of  which \nwere  nine  hundred  men,  reinforcements  for  the \nTurkish  army.  A  few  days  after  this  the  famous \nDragut  himself  appeared,  with  thirteen  galleys  and \ntwo  galleots,  on  board  of  which  were  sixteen  hundred \nmen.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

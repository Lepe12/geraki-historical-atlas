        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Pires clearly differentiated pillaging from trading. Nevertheless, he char- \nacterized both trading and pillaging as activities common to all nations.^ \nThis view of pillaging as common to all nations contrasts with piracy, which \nis typically understood as being carried out by actors external to states and \ntheir presumption of political and legal authority. Pires often characterized \npillagers as corsairs, a term that derives from a Mediterranean context,",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 211772,
          "end_char": 212233,
          "start_line": 4103,
          "end_line": 4108,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

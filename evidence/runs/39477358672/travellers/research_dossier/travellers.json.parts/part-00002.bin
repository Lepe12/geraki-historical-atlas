      {
        "finding_id": "section-b5a94bb5cea13e92e6ee",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "What  passed  between  Dragut  and  the  council \nof  \"  Africa,\"  who  in  so  unqualified  a  manner  had \nrefused  that  warrior  as  a  citizen,  is  not  on  record  ; \nall  that  we  know  is  that  the  Moslem  leader  dispensed \nwith  their  services,  and  did  not  invite  his  new  fellow- \ntownsmen  to  share  with  him  the  burden  of  govern- \nment. There  was  hurry  in  the  administration  of \nthe  corsair  states,  as  the  form  of  rule  which  they \nadopted  was  apt  to  irk  the  rulers  in  Christendom. \nIn  this  particular  instance  Dragut,  having  expelled \nthe  Spaniards  from  the  coast  towns,  knew  that  a \nreckoning  with  the  Emperor  and  his  militant  admiral, \nAndrea  Doria,  was  but  a  matter  of  time,  and,  in  all \nprobability,  of  a  very  short  time.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-e2d7d7b42201db8e8ee0",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "We come across instances where merchants used pirates to cut a deal, \nto work against local competitors, and even to redeem debts. Pirated \ngoods circulated in grey markets and it is clear that circuits of low-level \ncirculation were supported by petty piratical activity. Okhamandal also \nemerges as an area that could absorb swathes of dispossessed coastal \npeoples and communities who were welcomed by the confederacy of chiefs \nwhose income was dependent on supporting predation. Evidently, seen \nin this way, piracy had a very different set of functions than being simply \ndismissed as savage and barbaric and infinitely antithetical to order and \nfree trade. As it happened, the complexities of the phenomenon surfaced \nwhen the region became a site of intense ethnographic investigation by \nthe English Company, whose officers, especially the Resident of Baroda, \nAlexander Walker (1764—1831), undertook with great attention. Walker \nwas appointed as Resident of Baroda in 1802, initially entrusted with the \nspecific responsibility of stabilizing revenue arrangements in the region \nand subsequently of containing piracy. An unusually sensitive official, \nwith a keen interest in local societies and peoples he encountered, Walker \ncame with considerable experience thanks to his stint as commissioner in \nMalabar. Walker preferred to work with local collaborators to get a better \nsense ofthe ground situation, with the result that his correspondence was \nable to capture the myriad shifts and registers in the emerging discourse \non piracy and predation.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

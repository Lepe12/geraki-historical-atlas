      {
        "finding_id": "section-a547f3a7c59cda2242ba",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Not  only  did  the  indefatigable  corsair  get  clear \naway  without  any  suspicion  on  the  part  of  the \nadmiral,  but  his  first  act  on  gaining  the  open  sea \nwas  to  capture  the  Patrona  galley  sent  from  Sicily \nby  Don  Juan  de  Vega  to  say  that  reinforcements \nwere  on  the  road.  In  this  ill-fated  craft  was \nBuguer,  the  son  of  'Muley  Hassan,  King  of  Tunis, \nwho  was  sent  as  prize  to  Soliman  at  Constantinople, \nwhere  the  Sultan  caused  him  to  be  shut  up  in  the \n\"  Torre  del  Mar  Negro.\"  Here  he  remained  till \nhe  died,  as  a  punishment  for  that  he,  a  Mussulman, \nhad  aided  the  Christians.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

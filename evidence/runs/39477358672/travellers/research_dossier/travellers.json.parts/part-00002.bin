          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "European and non-European concepts of piracy developed concurrently \nwithin the period of European expansion in the seventeenth and eighteenth \ncenturies. Especially noteworthy has been the work of historians of interna- \ntional law who have pioneered important studies of the meaning of piracy.” \nComparatively neglected within this work, however, is an explanation of \nhow piracy functioned as an integrating factor in forming the public law \nof European nations. This paper will explain why the international pirate \nplayed a significant role as a figure of negative integration in the Ius Publicum \nEuropaeum. In forming an international community of nations bound by \nlaw in the seventeenth century, the pirate as the common enemy of all was \na crucial ingredient.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

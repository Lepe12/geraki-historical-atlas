      {
        "finding_id": "section-50a35388ebd0d53993ef",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "This time he presented himself to Khorkud, the \nGovernor of Caramania, brother to Sultan Selim, \nthe Grand Turk. The Governor, recognising him \nas an intrepid mariner, ordered the Basha of Smyrna \nto furnish him with a ship fitted for that guerre de \ncourse, which he desired to pursue against the \nChristians. The value of the corsair as an auxiliary \nwas beginning to be recognised among the high \nTurkish officials. For the complaisance of Khorkud \nthere were two reasons: in the first place, he was \nacting in the interests of his brother in sending to \nsea any really capable man to make head against \nhis enemies, and the fact that Uruj was a pirate \npure and simple did not weigh for a feather in the \nbalance ; in the second place, it was a decidedly \ngood mercantile speculation as he ordered his in- \nferior, the Basha of Egypt, to bear the expense of \nfitting out the necessary ship—which came to some \n5,000 ducats—and doubtless received a handsome \npercentage on all captures from his grateful protégé.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

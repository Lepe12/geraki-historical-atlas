      {
        "finding_id": "section-5178445fd00622b33da1",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "If Ottoman administrative documents were often vague in their descrip- \ntion of piratical actors, it is worth noting that Ottoman court records and legal \nsources were intentionally obscure when it came to the actions of foreign \nChristians, in particular. In the disputes over captured ships and cargo heard \nin Ottoman courts, the question of whether the *enemy infidel\" doing the \ntaking had authorization — of whether they were pirates or privateers — was \nirrelevant, in contrast with many European courts, where determining the \nlegitimacy ofthe taking decided the disposition ofthe property seized. Thus, \nin the court context, Ottoman scribes usually did not differentiate between \nEuropean “enemy infidel” naval vessels, corsairs, and pirates, any of which \nmight seize Ottoman ships and subjects, nor did they record the aggressor's \ngeographic or national origin, except in rare instances.4?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 427505,
          "end_char": 428407,
          "start_line": 7968,
          "end_line": 7979,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

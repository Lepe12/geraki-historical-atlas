      {
        "finding_id": "section-21fe186ce10ccc025422",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "For example, as soon as the war with Venice over Cyprus came to a formal \nend in the spring of 1573, Aya Mavra-based levends were illegally building \nfrigates with which they were raiding nearby Ottoman subjects. Although \nLefkada's Ottoman magistrate was ordered to record the names of the \nlevends “whose crime has been proven\" and forward them to the Imperial \nCouncil for punishment, less than two months later the Imperial Council \nwas dispatching yet another set of commands in response to complaints \nfrom the Ottoman governor ofthe Morea that some levend corsairs (levend \nkorsanlar) from Aya Mavra had been plundering his district and taking \nOttoman captives. Once again, Istanbul ordered that these levends be ap- \nprehended and put to the oar — a model punishment for pirates in a time \nwhen seasoned oarsmen were in dangerously short supply3^",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 410236,
          "end_char": 411091,
          "start_line": 7683,
          "end_line": 7694,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",

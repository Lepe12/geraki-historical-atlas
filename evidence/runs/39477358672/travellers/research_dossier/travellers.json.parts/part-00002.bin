      {
        "finding_id": "section-2c55e7ebd3482bd81e38",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Eastward  the  dispossessed  ruler  of  Algiers  took \nhis  course,  and  very  soon  discovered  that  which  he \nsought — allies  to  assist  him  against  the  revolted \nVenalcadi  and  the  recalcitrant  Hassan.  Lurking \nin  the  neighbourhood  of  Bizerta,  he  discovered \nEl  Judeo  (the  Jew),  Cachidiablo  (Hunt  the  Devil), \nSalaerrez,  Tabas,  and  other  corsairs,  who  collec- \ntively composed  a  formidable  force.  These  were \nall  old  acquaintances  and  some  old  followers  of \nKheyr-ed-Din,  and  to  them  did  he  relate  the  piteous \ntale  of  the  cowardice  of  Venalcadi,  whom  he  accused \nof  having  deserted  his  brother  Uruj  in  his  direst \nnecessity,  thereby  causing  his  death ;  the  abomin- \nable conduct  of  Hassan,  who  had  turned  and  bitten \nthe  hand  that  fed  him.  With  tears  in  his  eyes \ndid  this  accomplished  actor  reluctantly  reveal  the",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

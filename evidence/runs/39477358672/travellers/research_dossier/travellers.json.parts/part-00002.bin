      {
        "finding_id": "section-f2a3b01d494b38a06f11",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "This  latter,  as  may  easily  be  imagined,  had  had \nquite  enough  of  the  Caramanian  coast,  which  had \nturned  out  a  veritable  nest  of  hornets ;  also,  he \nhad  no  desire  at  present  to  cultivate  the  further \nacquaintance  of  the  knights,  and  therefore  put  the \nwhole  width  of  the  Ionian  Sea  between  himself  and \nthem,  and  succeeded  in  taking  several  rich  prizes. \nHe  avoided  Mitylene  and  returned  to  Egypt,  winter- \ning at  Alexandria.  It  may  here  be  remarked  that \nthe  corsairs,  as  a  rule,  regarded  the  winter  as  a \nseason,  as  in  those  early  days  the  mariner \nid  not,  if  he  could  avoid  it,  risk  his  ship  by  sail- \ning her  at  this  period  of  storm  and  tempest.  In \nconsequence  there  was  nothing  to  tempt  the \npirates  to  range  the  seas  during  these  months,  and \nif  they  had  had  a  successful  summer  and  autumn, \nas  they  generally  did,  they  could  well  afford  to  lay \nup  and  await  the  coming  of  spring.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

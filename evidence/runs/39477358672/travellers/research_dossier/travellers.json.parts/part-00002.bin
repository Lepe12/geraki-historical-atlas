      {
        "finding_id": "section-b09eeb15547dea0d01df",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The quotation indicates that the so-called pirates regarded their business \nas legitimate warfare, carried out with a pronounced code of conduct. \nMoreover, in spite of all his maverick enterprises, Pamolikang may have \nenjoyed secret support from the aristocracy of Gowa and Tallo’. At least \nthis is how the Dutch understood the situation, as they pointed out that the \nrequest by the Gowa court to assist their brothers-in-faith in Selaparang \nwas merely “a hidden way of corresponding with the old brigand Karaeng \nPamolikang and so once again strengthen him in his robberies.”3* But the",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

        "verified": false
      },
      {
        "finding_id": "section-4d6a910d8939db0adfda",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Therefore, while it is true that the designation of \"pirate\" is both a political \nand a legal one, there was in the Ottoman case a pronounced cleavage \nbetween the two arenas when it came to non-Ottoman sea raiders. Ottoman \nadministrators might indeed brand them pirates (or “thieving corsairs\") \nand reserve particularly harsh treatment for some, but to Ottoman jurists \nand judges, the home-country legal status of an *enemy infidel\" ship that \ncarried out attacks on Ottoman ships, subjects, and shores did not merit \nthe slightest recognition. In terms of Ottoman Islamic law, there was no \ndifference between the foreign Christian pirate and the foreign Christian \ncorsair, even though in the secular realm of Ottoman international maritime \nlaw, enshrined in the ahdnames, those differences persisted.^9",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

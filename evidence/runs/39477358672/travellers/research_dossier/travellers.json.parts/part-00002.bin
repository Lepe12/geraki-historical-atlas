      {
        "finding_id": "section-cae285d90c654a0f8cca",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Sea raiding was closely paired with slaving across ocean regions. Plunder \nfor slaves in waters off the Philippines and “slaving piracy\" off Indochina \nillustrate the way sea raiding was integral to vast complexes of captivity. \nSuch systems had distinctive regional dimensions, but the widespread \ninterdependence of slaving and sea raiding also created continuities across \nregions. Sojourners, merchants, naval captains, and slave owners deployed \nknowledge gained in one region when maneuvering in newly encountered \npolitical landscapes. If all politics is local, then all piracy politics was local \nand regional.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-f32a9899206a68567365",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "ravening pursuit closed in on the doomed corsair. \nAs the interval between chaser and chased became \nless and less, those on board the pirate ship could \nsee for themselves the fate which was awaiting \nthem, as on the central gang-plank, which separated \nthe rowers’ benches, the boatswain and his mates \nwere unmercifully flogging the bare backs of the \nstraining oarsmen to urge them to greater exertions. \nHe who was captured at sea in those days was set \nto row until he died, and the calculating mercy \nwhich causes a man to feed and treat his beast well \nin order that it may do the better work was not to \nbe relied upon here, as life was cheap and slaves \nwere plentiful. Very soon the beak of the galley \noverhung the stern of the little ship. Escape was \nimpossible, to fight would have meant the massacre \nof all on board; the choice was instant submission \nor a watery grave. Uruj lowered his sail, and he \nand his little company were ironed and flung into \nthe depths of the galley until such time as they \nshould be wanted to take their turn at the oars. \nIn this ignominious fashion ended his first attempt \nat independent piracy.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 81145,
          "end_char": 82290,
          "start_line": 2280,
          "end_line": 2302,
          "printed_page": null,
          "scan_indexes_0_based": [],

        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "have had similarities, but there were great differences in the understanding \nof who deserved to be labelled a pirate or giác. Whereas the Nguyen Dynasty \nregarded the French encroachments and aggression as such subversion, the \nFrench were convinced that the Black Flags were the main pirates or giác, \nand later this scope of the term was expanded further to include anyone \nwho resisted French colonization of Vietnam, regardless of their motives. In \nseveral respects, the use of the terms pirate and giác in Vietnam during the \nsecond half of the nineteenth century demonstrates the concurrent nature \nofthe concepts, including simultaneity, contradiction and entanglement.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 678957,
          "end_char": 679635,
          "start_line": 12838,
          "end_line": 12846,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

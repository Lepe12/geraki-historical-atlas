      {
        "finding_id": "section-d39589cb01f162da359b",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Christian fleet is 271. Ali Basha was in supreme \ncommand of the Turkish forces, “a man of an \nintrepid spirit, who had given many proofs of a \nhumane and generous mature—qualities more rare \namong the Turks, perhaps among all nations, than \nmere physical courage.” With Ali was the Basha \nof Algiers, that other Ali, the corsair, who since his \narrival at Coron had done more than his share of \nthe fighting, marauding, and devastating which \nwere the preliminaries to the battle of Lepanto. \nIn this historic conflict he was to show once again \nhow, on the face of the waters, the Sea-wolves \nwere supreme ; as it was he and his corsairs, out of \nthe whole of the Moslem host, who acquitted them- \nselves with the greatest credit on that day so fatal \nto the arms of the Ottoman Turk.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-9df63d2979a06fc8bb44",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Another way to approach piracy is by understanding how activities consid- \nered piratical in a given time and place contrast with the things mariners did \nwhen they were not busy behaving like \"pirates,\" for maritime piracy takes \nmore than theft. It requires skill in handling boats, and social knowledge \nabout what to do with the things or people taken. Rarely does one find \nfull-time pirates. Therefore, to grasp the motivations and means of piracy \ncalls for some understanding ofthe social, political, and economic seascapes \nin which mariners lived when they were not out and about marauding, \nmatters that must be sought in the sources.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

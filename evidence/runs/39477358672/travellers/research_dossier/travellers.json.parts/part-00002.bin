      {
        "finding_id": "section-1491703ab78178cf1926",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "one hand, throughout European history, pirates have been associated with \ndefiance, subversion, and rebellion, and have often been seen as constituting \nexistential threats to society, peace and order, international trade, and the \nsecurity of seafarers and coastal communities around the world. On the other \nhand, pirates, both historical and fictional, have also been seen as romantic \nheroes and non-conforming revolutionaries or champions of the common \npeople. The word pirate, in the modern European understanding ofthe word, \nthus has a wide range of social, cultural, and political connotations that by \nfar transcend its generic meaning of a robber or bandit operating at sea.?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

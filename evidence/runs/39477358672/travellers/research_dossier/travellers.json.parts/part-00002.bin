          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Prevesa illustrates for us more than any other \naction the difficulties with which the path of the \npartisan leader in these days must always have \nbeen filled; and how it was that personal ascendancy \nwas the only force to which such a leader had to \ntrust. Sheer dominance of the minds, the wills, \nand the bodies of others had placed Kheyr-ed-Din \nwhere he was; all his life he had commanded \nundisciplined pirates, and yet now, when he was \nthe properly accredited officer of a mighty monarch, \nwhen he might have expected far more discipline \nand subordination than had ever been his lot in the \npast, he was met with a contumaciousness which \nhe was unable to quell, and was forced into taking \nsteps which, in his own unequalled knowledge of \nwar, he knew to be doomed to disaster.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

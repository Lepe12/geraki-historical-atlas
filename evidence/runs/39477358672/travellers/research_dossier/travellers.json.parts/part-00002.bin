          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Second, many privateers stretched the limits of their commissions and \nattacked not only enemy ships, but also the vessels of neutral of even friendly \nnations. When their commissions expired many privateers turned pirates \nand piracy frequently surged following the end of major European wars, \nsuch as the War of the Spanish Succession (1701-1714), the end of which \ninaugurated the last great wave of Atlantic Piracy, which lasted until around \n1726. Further contributing to the grey zone between piracy and privateering \nwas what Lauren Benton has called \"legal posturing\" that is, the numerous \nand often creative strategies that pirates adopted to defend their actions \nand protect them from prosecution.39",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 43060,
          "end_char": 43772,
          "start_line": 885,
          "end_line": 894,
          "printed_page": null,
          "scan_indexes_0_based": [],

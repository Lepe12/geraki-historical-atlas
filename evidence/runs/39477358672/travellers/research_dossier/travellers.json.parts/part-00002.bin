      {
        "finding_id": "section-717ad83421a8cd1f6127",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Unquestionably, a strand of legal discourse did exist in Europe that \nclassified pirates as the enemies of all; political advantage often lay in \nlabelling sea raiders as men operating beyond the reach of law. Yet other \nrepresentations of sea raiders and pirates flourished alongside this dis- \ncourse. Few mariners labelled themselves as pirates, even when they were \nundertaking raids of questionable legality. In fact, raiders and their sponsors \nroutinely engaged in \"legal posturing\" to represent their actions as lawful. \nIn most cases, states treated piracy as a common crime under municipal \n(domestic) law. Jurisdiction over pirates' actions was not universal but \ndepended on their subjecthood, religious identification, diplomacy, the \nlocation of ship captures, prevailing conditions of war and peace, and \nother factors.?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "“From thenceforward this redoubtable corsair \npassed not one summer without ravaging the \ncoasts of Naples and Sicily ; nor durst any Christian \nvessel attempt to pass between Spain and Italy ; \nfor if they offered it he infallibly snapped them up, \nand when he missed his prey at sea, he made \nhimself amends by making descents along the \ncoasts plundering villages and towns and dragging \naway multitudes of inhabitants into captivity.”",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-98a5dd7fdde9e8cd849d",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The exercise requires first registering some points of critique. I am claim- \ningfor the volume a more expansive set of goals and accomplishments than \nthose outlined in the editors' introduction. Amirell, Buchan, and Hágerdal \ndescribe the volume as contributing to the global history of piracy mainly \nby offering a “conceptual history of piracy\" that is global in scope, with an \nemphasis on \"encounters between different concepts.\" Many ofthe chapters \ntake a different tack or go much further, and some show the difficulties of \na focus on concepts in interaction. Authors analyse the dynamic and fluid \nproduction of multiple discourses about piracy in relation to layered and \ncomplex political contexts. They contribute to a critique of the idea that \na single or uniquely European perspective on piracy existed that can be \ncompared or contrasted with other approaches. Most of the works follow \nrecent trends in global history in analysing intellectual currents and social \nrelations as interrelated phenomena, a perspective also endorsed by the \neditors.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

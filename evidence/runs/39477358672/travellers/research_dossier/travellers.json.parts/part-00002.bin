      {
        "finding_id": "section-7df0c77bd6081fcd5bbb",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "36 For some indication of the extent of the corruption: in 1617, Istanbul was informed that \nthe previous district governor of Karlieli (which included Lefkada) had been kidnapping the \nresidents of villages in his district, possibly with the connivance of Aya Mavra’s levends, and then \nexporting them to North Africa, where they were exchanged for captives with legal provenance \nwho were then imported into Karlieli; for more on this case and its implications, see Joshua \nM. White, “Piracy of the Ottoman Mediterranean: Slave Laundering and Subjecthood,” in The \nMaking of the Modern Mediterranean: Views from the South, edited by Judith Tucker (Berkeley, \nCA: University of California Press, 2019), 95-122.",
        "years_in_scope": [
          1617
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

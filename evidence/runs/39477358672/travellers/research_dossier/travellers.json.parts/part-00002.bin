      {
        "finding_id": "section-0488b92082f3e86848b9",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The early historiography of piracy is overwhelmingly concentrated to the \nMediterranean, where the concept itself first appeared in the final centuries \nBCE, although the term is often applied anachronistically to earlier historical \nperiods as well. For example, the first documented instance of piracy is often \nassociated with the Sumerians, who supposedly were attacked by pirates \nat the end of the third millennium BCE.?? The cuneiform records from Ur, \nhowever, do not use the word piracy or any similar term, and the assertion \nseems to be based on a passage in the so-called Code of Ur-Nammu, who, \nin the twenty-first century BCE, boasted of having established freedom of \ntrade, presumably in the Persian Gulf, from a certain \"chief sea captain.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 26237,
          "end_char": 26994,
          "start_line": 582,
          "end_line": 591,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Can we, in fact, see in Walker's own statements an expression of customary \nrights and obligations that connected various kinds of subjects in a common \nweb of relationships, albeit extractive and exploitative, cemented within an \noverriding moral economy wherein piracy was a lawful means of subsistence, \nan inheritance, a gift by the veritable godhead Krishna? By this, he probably \nmeant that the intersecting interests ofthe chiefs and the temple at Dwarka \nlent legitimacy to the operations that characterized the region and economy \nof Okhamandal. What stands out in the Resident's communication is his \nunderstanding of predation as an inevitable consequence of the pressures \nthat the local economy experiences and a studied appreciation ofthe violence \nof Company politics, which had dismantled existing structures of rights \nand obligations, compelling marginal and mobile communities to opt for \na policy of raiding.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Uruj  now  established  himself  at  the  island  of \nJerba,  on  the  east  coast  of  Tunis,  which  formed \nan  admirable  base  from  which  to  \"  work \"  the \nMediterranean  from  the  piratical  point  of  view. \nJerba  had  originally  been  conquered  and  occupied \nby  the  Spaniards  in  1431,  but  the  occupation  had \nbeen  allowed  to  lapse,  and  the  island  was  lying \nderelict  when  the  Barbarossas  made  it  their  head- \nquarters. Here  Uruj  was  joined  by  his  younger \nbrother  Khizr,  destined  to  become  so  much  the",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,

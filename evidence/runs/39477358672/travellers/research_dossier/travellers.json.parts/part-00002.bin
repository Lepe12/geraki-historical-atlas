      {
        "finding_id": "section-b68919d4784f010edc5e",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "From the early 1870s, the French began to take more control over the \ncolony and leading colonial officials started to advocate further intervention \nin the region and the annexation of the rest of Vietnam. The prevalence \nof piracy in Vietnamese waters seemed to provide a legitimate reason for \nsuch intervention. On two occasions in 1872 the dispatch boat Bourayne \nwas sent to northern Vietnam, officially for the purpose of collecting geo- \ngraphical and political information, but covertly in order to prepare for a \npossible French military attack. On her second expedition, the Bourayne \nhad several encounters with pirates based off the north Vietnamese coast, \nresulting in the sinking or burning of altogether seven pirate junks crewed \nby 700-800 men, more than 500 of whom were killed. The exploits of the \nBourayne gained much attention in France and were celebrated as glorious \nvictories, much in contrast to the country's embarrassing loss in the war \nagainst Prussia the previous year. An outcome ofthe publicity given to the \nBourayne expeditions, moreover, was to establish an image in the mind of \nthe French public of the otherwise largely unknown Vietnam as a lawless \nand pirate-infested country.”",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 654933,
          "end_char": 656154,
          "start_line": 12389,
          "end_line": 12405,
          "printed_page": null,
          "scan_indexes_0_based": [],

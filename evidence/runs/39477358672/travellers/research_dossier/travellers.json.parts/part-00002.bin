      {
        "finding_id": "section-e68fc920d6091655e2fe",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Although questions of piracy often rely on authority over a particular \nlocation, as with the legal concept of jurisdiction generally, piracy may also \nentail a subject’s political affiliation, as well as the nature of the acts in \nquestion. Whether through spatial authority or political subjecthood, the \ntheft of goods and persons made pirates outlaws. Yet, whereas outlawry \nmay exist in relation to a single state, piracy subsists in a fundamentally \ninternational or interpolity arena. That is, when the agents of a state or polity \nmade piracy claims or designations, they signalled not just the bounds ofa \nsingle state, but also the limits of sovereignty — both theirs, and from their \nview, that of others.'?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",

      {
        "finding_id": "section-af0e9299fbaaeae2a815",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The after-life of this ethnography is something I would like to touch \nupon by way of conclusion. I wish to reflect on how this complicated history \nof piracy, which was an integral part of the changing coastal polity, was \nrepresented in subsequent narratives and, in fact, erased from later histories \nof Gujarat, whose maritime dimension disappeared in the more mainstream \nhistories that were put together.\" The maritime dimensions of Gujarat were \nplayed down in the new histories that were produced and that emphasized \nthe centrality of the Rajputs and of the merchant nexus with state power, \nleaving no space for the vibrant and robust maritime communities that made \nup the region. It was only as pirates and outlaws that specific communities \nwere recalled. Occasionally, piracy narratives in Gujarat and Kathiawar \nwere framed within the themes of religion and valour. It is likely that the",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",

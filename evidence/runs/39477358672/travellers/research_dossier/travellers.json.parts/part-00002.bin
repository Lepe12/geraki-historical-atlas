      {
        "finding_id": "section-93f3fc92956b6162f64e",
        "file": "journalofvoyagei00digbiala_journalofvoyagei00digbiala_djvu.txt",
        "title": "Journal of a voyage into the Mediterranean",
        "url": "https://archive.org/details/journalofvoyagei00digbiala",
        "source_bibliography": {
          "creator": [
            "Digby, Kenelm, Sir, 1603-1665",
            "Bruce, John, 1802-1869"
          ],
          "date": [
            "1868-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "d2defe6ff388b631877f74b1fb4b681f503d63d34637330ce13bec173be3c0b1",
        "evidence_excerpt": "The  reign  of  James  I.  was  a  period  of  peculiar  importance  to  both \nthese  branches  of  the  family  of  Digby.  One  special  incident  in  that \nreign  made  what  is  called  the  fortune  of  one  of  them,  and  over- \nwhelmed the  other  with  disgrace.  John  Digby,  a  handsome \nyoungest  son  of  the  Warwickshire  house,  was  despatched  to  the \nCourt  by  Lord  Harrington  to  apprise  the  King  of  the  design  of  the \nGunpowder  Conspirators  upon  the  Princess  Elizabeth,  and  of  the \nmeasures  taken  for  her  security.  The  well-favoured  messenger \nattracted  his  Majesty's  attention.  After  a  preliminary  course  of \npreferment  in  the  royal  household,  he  was  sent  to  Spain  as  ambas- \nsador; he  afterwards  played  a  conspicuous  part  in  the  difficulties \narising  out  of  the  intended  Spanish  match,  and  was  created  Earl  of \nBristol  in  1622.  Nor  was  this  the  only  dignity  procured  by  the \nWarwickshire  branch  of  the  family.  The  Earl  of  Bristol's  eldest \nsurviving  brother,  Robert,  was  knighted  by  the  Earl  of  Essex  in \nIreland  in  1596,  and  married  the  Baroness  Offaley,  heir-general  of \nthe  House  of  Kildare.  He  died  in  1618,  leaving  as  his  eldest  son \nanother  Robert,  who  was  created  an  Irish  peer  in  1620,  by  the  title \nof  Lord  Digby  of  Geashill,  with  the  condition  that  his  mother's  dig- \nnity, which  had  been  a  subject  of  dispute,  should  revert,  upon  her \ndecease,  to  the  House  of  Kildare.  t",
        "years_in_scope": [
          1618,
          1620,
          1622
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/journalofvoyagei00digbiala",
          "source_file": "journalofvoyagei00digbiala_journalofvoyagei00digbiala_djvu.txt",
          "start_char": 3623,
          "end_char": 5182,
          "start_line": 124,

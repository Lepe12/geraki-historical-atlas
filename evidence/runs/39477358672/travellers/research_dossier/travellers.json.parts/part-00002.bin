      {
        "finding_id": "section-00bee0e8c59b376f2ade",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "European powers, Chinese imperial states, and various groups of pirates, \ntherefore, continuously contended with each other over maritime space. \nPiracy was both a form of economic predation and political subversion \nthat no sovereign could afford to ignore. Both in China and in Europe this \nperiod saw their respective governments universally condemn piracy with \nthe enactment of increasingly harsh laws and military build-ups that aimed \nto eradicate the pirate menace. The careful examination of anti-piracy \nmeasures and extension of sovereignty into the outer ocean provides a useful \nwindow for viewing the authority of the Qing imperium and its limits, as \nwell as the overlapping spheres of influence and contestations between \nforeign, national, and local constituents.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-3c8f1ae0acb99f433753",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Accordingly, reinforced by the fifteen fustas and \none galley of Delizuff, the Algerian fleet once more \nproceeded on its voyage. Although bound for \nConstantinople at the request of Soliman, at a \ntime when it would have been thought that delay \nwas not only dangerous but impolitic, and although \nthe corsair was endeavouring to merge the pirate \nin the king who dealt on terms of equality with \nthose whom he now regarded as his brother \nmonarchs, still the old instinct of robbery was \ntoo strong to be resisted; the lust of gain and \nthe call of adventure were still inherent in the \nman whose famous beard was now far more white",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

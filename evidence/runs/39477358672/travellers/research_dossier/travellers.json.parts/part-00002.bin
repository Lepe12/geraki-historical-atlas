      },
      {
        "finding_id": "section-5d1a89a040a8c7bc26ac",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Some of the levends based at Aya Mavra in this period harboured grander \nambitions than sacking impoverished nearby fishing villages and plundering \nsmall coastal traders. It was still much as Mustafa Ali described; for many \nof the petty criminal levends who built piratical careers on the backs of \ntheir neighbors, whom they raided and enslaved, and then moved on to \nLefkada to acquire a bigger ship in order to take bigger prizes, the next \nstep on the aspirational career ladder was Algiers, where corsairing was \nwholly supported by the local administration even when it was frowned \nupon in Istanbul.” Relations between Algiers and Istanbul had deteriorated",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

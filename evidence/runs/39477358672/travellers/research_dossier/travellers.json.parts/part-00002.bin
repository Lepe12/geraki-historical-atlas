      {
        "finding_id": "section-3a82f19cf88e5849515d",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,
          "date": [
            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "One has some trouble in realizing the sort of navi- \ngation employed by Corsairs. We must disabuse our \nminds of all ideas of tall masts straining under a \nweight of canvas, sail above sail. The Corsairs’ ves- \nsels were long narrow row-boats, carrying indeed a \nsail or two, but depending for safety and movement \nmainly upon the oars. The boats were called galleys, \ngalleots, brigantines (“galleotas ligeras o vergatines,” \nor frigatas), &c., according to their size: a galleot is \na small galley, while a brigantine may be called a quar- \nter galley. The number of men to each oar varies, \ntoo, according to the vessel’s size: a galley may have \nas many as four to six men working side by side to \neach oar, a galleot but two or three, and a brigantine \none; but in so small a craft as the last each man must \nbe a fighter as well as an oarsmen, whereas the larger \nvessels of the Corsairs were rowed entirely by Chris- \ntian slaves.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/greatpiratesstor0000jose",
          "source_file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
          "start_char": 167117,
          "end_char": 168054,
          "start_line": 4308,
          "end_line": 4325,
          "printed_page": null,
          "scan_indexes_0_based": [],

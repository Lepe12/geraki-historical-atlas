        "verified": false
      },
      {
        "finding_id": "section-286a9cd3be04d9bfa305",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The discourse on piracy was not only a French colonial or metropolitan \nphenomenon, however. In Vietnam, the term gidc had similarities with the \nFrench and European concept of piracy. Just as a pirate was seen in Europe as an \nenemy of society and mankind as a whole, a gic in Vietnam was a person who \nengaged in subversive and illegitimate hostilities. As such, the concepts may",
        "years_in_scope": [],

        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "define anyone who defied their self-proclaimed and papally sanctioned \njurisdiction over oceans as pirates or corsairs, the two concepts being used \nlargely interchangeably during the sixteenth and seventeenth centuries. \nIn the Indian Ocean, the Portuguese tried to assert their presumed rights \nover the sea by forcing Arab, Indian, Malay, and other merchants to buy \ncartazes (licences) in order to avoid being plundered or sunk by Portuguese \nvessels. These and other violent or coercive acts on the part of Portuguese \nnavigators gave rise to much resentment and resistance among merchants, \nrulers, and dispossessed coastal groups around the Indian Ocean, as Lakshmi \nSubramanian discusses in her chapter.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",

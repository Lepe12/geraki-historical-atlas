      {
        "finding_id": "section-8bf4d4344de96c24d905",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Against this background, the concept of piracy has been used for centuries \nin numerous contexts, often far removed from the original meaning ofthe \nword. This chapter explores one such case, in which the concept of piracy was \nstretched to its limits, namely, when the French invaded and subsequently \ncolonized Vietnam in the second half of the nineteenth century. In Vietnam, \nthe French or European concept of piracy took on a special significance, and \nwas used extensively to denote not just pirates at sea, but also bandits on \nland and all members ofthe Vietnamese anti-colonial resistance movement. \nThis development was not just the result ofa discourse or political develop- \nments in France. It was atleast as much the result of a meeting, or perhaps \nentanglement, between two concurrent concepts related to subversion and \nbrigandage: pirate in French and gidc in Vietnamese.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

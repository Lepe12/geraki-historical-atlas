        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Asia: After coming into power in 1600, the Tokugawa Shogunate sent let- \nters to foreign rulers, denouncing Japanese private seagoing merchants as \npirates and inviting foreign regimes to collaborate in fighting and punish- \ning Japanese outlaws. Several such letters were addressed to the Spanish \ngovernor general in Manila and contributed to existing stereotypes about \nJapanese pirates.5+",
        "years_in_scope": [
          1600
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

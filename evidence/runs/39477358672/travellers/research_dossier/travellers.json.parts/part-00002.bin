      },
      {
        "finding_id": "section-5cbe78630e1ca91618c5",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "The offer was no sooner made than accepted, \nand the Spanish veterans, fresh and unwearied, \nthrew themselves into the heart of the fray. \nShoulder to shoulder and blade to blade in their \ndisciplined valour, they broke through all opposi- \ntion; they fought for liberty as well as life, to \nexchange the noisome confinement of the piratical \ngalley for the free air of their homes and their \ncountry. Soon the soldiers of Venalcadi turned \nand fled back to the city ; the day was once again \nwith Kheyr-ed-Din. For four days longer did \nAlgiers hold out, and then a traitor betrayed \nVenalcadi into the hands of his enemies. Instantly \nhis head was struck off, placed on a pole, and \nparaded in full sight of the garrison, who were \npromised their lives on condition of surrender.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "dilemma for Istanbul was balancing the financial and political costs ofthe \nlevends' piratical activities, both on Lefkada and elsewhere within Ottoman \ndomains, against the military and even economic benefits of maintaining \n(or simply permitting) these inexpensive, self-sustaining, highly motivated \ndefence forces that occupied strategic points and injected valuable booty \ninto their communities, which were often otherwise marginalized ports \nthat had been left behind by tectonic shifts in Mediterranean trade routes \nand patterns of licit commerce during the sixteenth century.^?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

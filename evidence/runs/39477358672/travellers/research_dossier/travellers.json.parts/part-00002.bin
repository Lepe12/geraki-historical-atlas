      {
        "finding_id": "section-765a91736ce2e1ec3304",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Sailing from Tunis in the spring of the year \n1512, the brothers, with three galleys, fell in with \nThe Galley of Naples, an enormous nef with a \ncrew of three hundred. They instantly attacked, \nbut were repulsed, night falling without either side \nhaving gained an advantage. This audacious pro- \nceeding illustrates the hardihood of the Moslem \ncorsairs at this time. They were amply strong \nenough to range the Mediterranean and to capture, \nwith no risk to themselves, the weak and unpro- \ntected argosies plying their trade in this sea; but \nthis was not the method of the Barbarossas. \nVillains they may have been according to modern \nstandards, pirates they were unquestionably ; but \nthey were grim, hard-bitten, fighting men, whoshrank \nfrom no dangers in the pursuit of their prey, who \nreckoned that the humiliation and defeat of their \nChristian antagonists was as sweet a morsel as the",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 90363,
          "end_char": 91261,
          "start_line": 2502,
          "end_line": 2519,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",

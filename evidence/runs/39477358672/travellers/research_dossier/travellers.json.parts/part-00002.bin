      },
      {
        "finding_id": "section-61b4ae1c83f8b2ff8888",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Piracy has long been a prominent topic in world history and arguably \npreceded the current boom in global history by at least a century. C.R. \nPennell, in a brief review of the academic (mainly anglophone) literature \non piracy, sets the start of serious study of piracy based on documentary \nand archival sources to 1890, when Stanley Lane-Poole's book The Barbary \nCorsairs was published. This was followed, twenty years later, by C.H. \nHaring's The Buccaneers in the West Indies in the Seventeenth Century.’ \nThere were, however, several studies published earlier in the nineteenth \ncentury in other languages, including French, Dutch, and Spanish, which \nwere also (biases notwithstanding) based largely on documentary sources, \nsuch as: Ch. de Rotalier, Histoire d'Alger et de la piraterie des Turcs dans la \nMéditerranée (1841); J. H.P.E. Kniphorst, Historische schets van den zeeroof \nin den Oost-Indischen Archipel (1875); and J.M. Montero y Vidal, Historia de \nla pirateria Malayo-Mahometana en Mindanao (1888).",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-bec7a4e5073e93e89318",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "THE  events  recorded  in  the  last  chapter  bring  us \ndown  to  the  end  of  the  year  1515,  and  while \nevery  endeavour  has  been  made  to  present  affairs  in \nchronological  sequence,  it  must  be  remembered  that \nthe  dates  of  piratical  expeditions  are  often  im- \npossible to  obtain  :  the  wrath  of  the  chroniclers \nat  the  nefarious  deeds  of  the  corsairs  greatly  ex- \nceeding their  desire  for  a  meticulous  accuracy  in \nthe  matter  of  the  exact  time  of  their  occurrence. \nUruj,  as  has  been  seen,  had  by  his  headstrong  folly \nonce  again  placed  his  brother  and  himself  in  a \ndecidedly  awkward  situation.  By  the  losses  which \nhe  had  incurred  in  his  second  ill-advised  attempt \non  Bougie  he  had  so  weakened  the  piratical  con- \nfederation that  the  countenance  of  some  potentate \nhad  again  become  necessary  for  their  continued \nexistence,  and  the  Sultan  of  Tunis  had  now  re- \npudiated all  connection  with  these  ingrates.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-7147b6b173b8251f2336",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,
          "date": [
            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "But the pirates had not yet concluded their das- \ntardly work. Lumsden and Cowper were warned \nthat unless they produced the money, which the pirate \nwas convinced still remained, the Zephyr, with all her \npeople in her, should be burnt to the water’s edge. \nIt is to the credit of these two men that they strenu- \nously declined to oblige the pirate. This only served \nas fuel to the latter’s temper, and he sent them below \nand began a series of heartless tortures which were \nmore in keeping with some of the worst features of \nthe Middle Ages than the nineteenth century. De- \ntermined to attain his object, no matter what the cost, \nhe caused the two men to be locked to the ship’s pumps \nand proceeded to carry out the threat which he had \njust promised. Every preparation was made for \nstarting a fire, combustibles were piled round about \nthe unfortunate men, and the light was just about to \nbe applied when Lumsden, unable to endure the tor- \nture any longer, confessed that there was money. He \nwas accordingly released, and rummaging about pro- \nduced a small box of doubloons.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

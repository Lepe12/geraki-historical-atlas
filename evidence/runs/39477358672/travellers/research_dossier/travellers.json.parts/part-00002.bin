      {
        "finding_id": "section-dd9b587f8a93e937782d",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Assessing the significance of Thelaus' dissertation brings us back to its \ncontext. Though the topic of his dissertation was not entirely novel, its \nconstruction, location, and timing made it distinctive. As a student at- \ntending one of the premier institutions of learning in the country, Thelaus \ncould hardly have been ignorant of the dire situation of Sweden’s teetering \nempire and beleaguered foreign trade. Piracy was a topic widely discussed \nin both popular culture and high politics; it was also a frequent topic among \nphilosophers of law. A distinctive feature of Thelaus's dissertation is his \ninterweaving of an entirely conventional moral framework for assessing \npiracy, with a much more pragmatic interpretation of the place of the \npirates in European affairs. The familiar natural law premises of Thelaus's \narguments rendered pirates as common enemies, barely recognizable as \npart ofthe human race. Yet, Thelaus's discussion ofthe corsairs manifested \na much more pragmatic awareness that the pirate cities and kingdoms \nof the Barbary coast could be accommodated. This accommodation was \nnothing like the recognition due to other Christian, European kingdoms or \nrepublics. Nonetheless, he was prepared to concede that even the barbary \ncorsairs maintained a kind of piratical order that imbibed something akin to \nhonour. The Barbary corsairs were analogous yet anomalous in comparison \nto European states. His argument might be regarded as merely an obscure \ninstance of scholastic expression, were it not for Thelaus's context which \nillustrated a concurrent development — seemingly in isolation one from the",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 617877,
          "end_char": 619512,
          "start_line": 11663,
          "end_line": 11684,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

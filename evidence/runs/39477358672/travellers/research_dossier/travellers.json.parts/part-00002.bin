      {
        "finding_id": "section-ab7b8b4c37babc9cccac",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "From around 1990, the rise of global (or world) history combined with \na surge in contemporary piracy in some parts of the world (particularly in \nthe Strait of Malacca, the South China Sea, the Gulf of Guinea, and the Gulf \nof Aden), to stimulate interest in piracy as a global historical phenomenon. \nMuch ofthe scholarly attention has been directed towards the role of piracy \nin the European overseas expansion and imperialism and its role in the \ndevelopment of international law, with important contributions by, among \nothers, Janice E. Thomson, Alfred P. Rubin, Lauren Benton, Peter Earle, and \nDaniel Heller-Roazen.\" Several articles, particularly in the Journal of World \nHistory, have also dealt explicitly with piracy in global historical contexts. \nA recent thirtieth anniversary special issue of the journal on the theme \n\"Roads and Oceans\" featured no less than three articles (out of ten) with \nthe words pirates or piracy in the title.\"",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 16433,
          "end_char": 17386,
          "start_line": 422,
          "end_line": 434,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

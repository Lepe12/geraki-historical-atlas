      {
        "finding_id": "section-eb6eaf60d77a105d09d4",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "expression of King Philip IL. of Spain; the same \nidea might have crossed the mind of Doria on \nthis memorable occasion. He had only to wait; \nthe longer he waited the more secure he would be \nof success, the more certain would he be of the \ncomplete undoing of his enemy. But even yet \nthe admiral did not know the man to whom he \nwas opposed; in all the years in which he had \ndone battle against Dragut, he had never gauged \nthe limitless resource and calculated audacity of \nthis lineal successor of Kheyr-ed-Din Barbarossa, \nWhile the admiral had been sending his despatches, \nand idly watching that which he considered to be \nthe futile construction of earthworks on the shore \nat the Bocca de Cantara, his enemy was preparing \nfor him that surprise which was shortly afterwards \nto make of him the laughing-stock of the whole of \nEurope. Dragut was in a trap, and he was quite \naware of the fact; by way of the Bocca de Cantara \nescape was impossible, and neither a tame surrender \nnor complete annihilation was by any means to the \ntaste of the pirate leader. Had Doria gone in and \nattacked at once, the fate of the corsair had been \nsealed ; the policy of delay adopted by the Christian \nadmiral was his salvation.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

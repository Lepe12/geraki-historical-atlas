      {
        "finding_id": "section-86a2cd204f936d7d8da4",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Doria  left  Bona  in  the  charge  of  Alvar  Gomez \nand  a  company  of  Spanish  troops  and  then  sailed \naway,  if  possible  to  find  and  capture  Barbarossa, \nthus  to  set  the  seal  of  completeness  on  the  victory \nwhich  had  been  won  by  his  master  the  Emperor. \nAnother  stronghold  of  the  corsairs  was  now  in \nmost  competent  hands,  as  Alvar  Gomez  Zagal \nwas  one  of  the  most  renowned  caballeros  of  Spain, \nson  of  that  Pero  Lopez  de  Horusco  on  whom  the \nMoors  themselves  had  bestowed  the  title  of  \"  Al \nZagal,\"  or  \"  The  Valiant,\"  on  account  of  his  extra- \nordinary bravery.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/seawolvesofmedit00curruoft",

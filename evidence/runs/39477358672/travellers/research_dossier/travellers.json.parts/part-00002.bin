      {
        "finding_id": "section-6b5dc87dc7f91c5474f5",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "latter lived on borrowed time. When he once again attacked the Tambora \nkingdom with his seaborne raiders in 1704, the locals managed to surround \nand break into the house where he was staying. To be on the safe side, they \nshot Pamolikang with his own musket, conforming to a local belief that a \nman of great innate powers had to be killed with a personal object.33 While \nSumbawa had not seen the last of piracy, it entered a slightly more peaceful \nera, while Lombok would remain under Balinese domination until 1894.34",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 297781,
          "end_char": 298304,
          "start_line": 5650,
          "end_line": 5656,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,

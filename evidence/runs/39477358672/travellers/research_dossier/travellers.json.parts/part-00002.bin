      {
        "finding_id": "section-46208148bc11e4b101e3",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The chapter sets out to counter Eurocentric bias in depictions of maritime \npower and violence along India's western littoral during the period of \nBritish expansion in the late eighteenth and early nineteenth centuries. \nThe author adapts analyses oflegal pluralism in maritime spaces to explore \nthe role of piracy in Indian conceptions of power and jurisdiction at sea. \nPiracy was a matter of contention among Indian and British governing \nauthorities that drew both of them into efforts to understand the phe- \nnomenon as part of local histories and traditions. Despite the efforts of \nsome to understand piracy in this context, the British ultimately portrayed \nmaritime predation as an ethnographic marker of a “savagery” over which \ntheir sovereignty could be asserted.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

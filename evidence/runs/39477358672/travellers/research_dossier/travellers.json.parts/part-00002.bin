      {
        "finding_id": "section-0f1cff9d736aa3bebadb",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Challenging official claims that pirates, by definition, were the enemies \nof mankind, popular notions of piracy instead suggested that they were \nbold and daring heroes. Such is the impression that emerges from Douglas \nBurgess's study of the popular reception of the pamphlets summarizing the \nproceedings of the trial against the pirate John Avery (aka Henry Every) \nand his crew in London in the late seventeenth century. Contrary to the \nintention of the authorities and the directors of the East India Company, the \npamphlets were read by many people in England and the colonies as heroic \nadventure stories. Avery’s aura was enhanced by his escape from justice in \n1696 and the mystery of his subsequent whereabouts. Popular poems and \nsongs were composed in his honour, and in 1712, a theatre play called The \nSuccessful Pyrate, written by Charles Johnson, a British playwright, opened \nin London, loosely based on Avery’s adventures. Although Johnson was \nchastised by critics for glamourizing Avery and his piratical exploits, the \nplay was a great popular success.9",
        "years_in_scope": [
          1696
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

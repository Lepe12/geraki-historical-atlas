      },
      {
        "finding_id": "section-581d6707ba1c55fd7105",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In French Cochinchina, pro-interventionist sentiments were even stronger \nthan in France. In 1882, the Governor of French Cochinchina, Charles Le \nMyre de Vilers, largely on his own accord, but believing that his actions \nwere in accordance with those of the metropolitan government, dispatched \na military expedition to Vietnam. Officially, the purpose was to protect \nthe life and property of French citizens in the country, but covertly the \nintention was to take control over the Red River delta in order to formalize \nand strengthen the implicit French protectorate over Vietnam.” Like ten \nyears earlier, piracy once again figured in the Governor's instructions to \nthe commander of the expedition, Captain Henri Riviére: “You must not \nhave any relations, direct or indirect, with the Black Flags. To us, they are \npirates, and you shall treat them as such [...].\"?",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 665281,
          "end_char": 666153,
          "start_line": 12579,
          "end_line": 12590,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

      {
        "finding_id": "section-163d6491b3a9e7e127bc",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "The night grew worse, the wind backed, and the \ngalley began to drag her anchors. The slaves were \nroused, and the oars got ready to shift her from her \ndangerous position on what had now become a lee- \nshore. Uruj had managed to slip his shackles, a \ndefective bolt having given him his liberty; for him \nit was now or never, and he was a bold swimmer. \nHe had seen enough and heard enough of Our \nLady of the Conception, and, as the great oars \nplunged once more into the sea, the corsair, pre- \nferring the mercy of the elements to that of the \nknights, slipped over the side unobserved and \nswam for the shore. He reached dry land by a \nmiracle, and from Satalie he found his way to",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

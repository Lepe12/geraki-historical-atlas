      {
        "finding_id": "section-f7baec7a86152718ab57",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "During the nineteenth century, many ofthe popular English pirate novels \nwere translated into French, such as The Pirate (1822), The Red Rover (1827), \nand Treasure Island (1885). In addition, several successful French authors \nand playwrights, such as Gustave Aimard and, above all, Édouard Corbiére, \ncontributed to popularizing the image ofthe adventurous and a bohemian \npirate in France around the mid-nineteenth century.\" In this cultural \ncontext, the word pirate came to be used occasionally to describe not only \nbandits at sea, but also to refer to bandits on land, such as in Aimard's novel \nLes pirates des prairies (1858) and in the theatre play Les pirates de la savane, \nwhich opened in Paris in 1859.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 640635,
          "end_char": 641351,
          "start_line": 12118,
          "end_line": 12127,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

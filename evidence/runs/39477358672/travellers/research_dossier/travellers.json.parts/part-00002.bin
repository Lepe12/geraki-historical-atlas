        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Doria left Bona in the charge of Alvar Gomez \nand a company of Spanish troops and then sailed \naway, if possible to find and capture Barbarossa, \nthus to set the seal of completeness on the victory \nwhich had been won by his master the Emperor. \nAnother stronghold of the corsairs was now in \nmost competent hands, as Alvar Gomez Zagal \nwas one of the most renowned caballeros of Spain, \nson of that Pero Lopez de Horusco on whom the \nMoors themselves had bestowed the title of “ Al \nZagal,” or “The Valiant,” on account of his \nextraordinary bravery.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-964d26c6e5f6c97b9498",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Although the concept of pirates as hostes humani generis appears to be \naxiomatic, it is argued in this chapter that piracy elicited more ambiguous \nresponses from philosophers and lawyers in late seventeenth-century \nBritain. Pirates were merely one among a pantheon of archetypal enemies \nof good order. By examining references to piracy in the work ofthe English \npolitical philosopher John Locke in particular, it is argued here that pirates \nvied with tyrants for the title of “common enemy of all humankind.” \nLocke’s prevarications were mirrored by continuing doubts and legal \ndebates about who the hostis humani generis really was.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

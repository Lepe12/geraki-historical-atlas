        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Hardly, however, had the brothers succeeded in \nthis enterprise when that tireless fighter Uruj \nagain attempted the capture of Bougie; but his \nsecond attempt was even more disastrous than his \nfirst, and he lost half his flotilla. Then he asked \nfor succour from Tunis; but the Sultan, much \noffended at the idea of the brothers setting up in \na piratical business in which he was no longer a \nsleeping partner, angrily refused.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-d9b819e79984d3eaddf4",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The timing of De piratica in 1716 was especially significant. The early \ndecades of the eighteenth century were a pivotal period in the extension \nof European state sovereignty at sea and with it, ofthe claims of European \ninternational law As European states were intensifying their war-making \npowers throughout the late seventeenth century, so war itself came to be \ndefined existentially in terms ofthe elimination of an enemy's war making \ncapacity.^ In this context, as Marcus Rediker and Peter Linebaugh have \nargued, the legal definition of piracy provided a rationale for this war-making \nethos at sea; pirates were “denounced [...] as sea monsters, vicious beasts, \nanda many-headed hydra - all creatures that [...] lived beyond the bounds \nof human society.”",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",

      {
        "finding_id": "section-e84762bfd85c5f18956d",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "recoiled before the foe but who fought only to \nconquer or die, seem to have failed when embarked \nfor sea-service. That which the hard teaching of \nexperience alone could show—that the man who \nfights best upon the sea is he who has the habit of \nthe sea—was at this time not generally recognised, \nand this it was that rendered the corsairs so \nsupreme on the element which they had made their \nown. Some among the great ones of the earth \nthere were who appreciated this fact, who, like that \ngreat statesman Ibrahim, Grand Vizier to Soliman \nthe Magnificent, recognised what it was to lay their \nhands upon “a veritable man of the sea”; but the \nrule was to embark men from the shore and to \nentrust to them the duty of fighting naval actions.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 20885,

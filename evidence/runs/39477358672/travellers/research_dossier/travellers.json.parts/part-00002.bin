      {
        "finding_id": "section-cf30665897133dc5a6c8",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "fact that after taking his Master's degree he became a lecturer in oriental \nlanguages and theology at Uppsala in 1733, and eventually rose to become a \nDean of the Lutheran church.’ In this chapter, we use Thelaus's De piratica \nto explore the malleable meanings of piracy in eighteenth-century Swedish \nphilosophical and scholarly discourse against the backdrop of Sweden's \ndire diplomatic situation. Various chapters in this book have considered \nthe striking concurrence that characterized European and non-European \nnotions of piracy in the seventeenth and eighteenth centuries. This was not \nsimply a matter ofthe coexistence of divergent understandings and cultural \npractices around the world, but, as we show here, of the entanglement of \ndifferent discourses of piracy within one state. In this chapter, we reveal \nhow a conventional scholarly articulation of the pirate as a “common enemy \nof all humankind\" coexisted with an urgent but almost secret debate about \nthe uses that may be made of pirates in statecraft.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 579505,
          "end_char": 580533,
          "start_line": 10988,
          "end_line": 11001,

      {
        "finding_id": "section-775266c26fe1f2ac2d9d",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The legal and intellectual discourse on piracy in Early Modern Europe \nwas literally a world apart from the reality of maritime encounters overseas. \nPortuguese, Spanish, Dutch, English, French, and other European navigators \nall pursued ruthless policies to further their strategic and commercial inter- \nests in distant seas and on the coasts. With few goods to trade in exchange \nfor the spices, textiles, porcelain, tea, and other Asian commodities that \nthe Europeans craved, the main competitive advantage of the latter was \ntheir superior naval power. Europeans thus made frequent use of maritime \nviolence and coercion in order to force their will on Asian sovereigns and",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",

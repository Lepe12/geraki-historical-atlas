      {
        "finding_id": "section-aec8a73bb3bff6cc3727",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The General History was long thought to have been the work of the \nEnglish journalist, writer, and controversialist Daniel Defoe (1660-1731). \nMore recently, another candidate has been suggested as author, namely, \nDefoe's erstwhile employer: the former sailor and anti-Whig journalist, \nNathaniel Mist (?-1737).\" Mist was the editor of the eponymous Mist’s Weekly \nJournal: or Saturday's Post with Fresh Advices Foreign and Domestick between \n1716 and 1728, followed by Fog's Weekly Journal from 1728 to 1737. Evidence \nsuggests that Mist was a Jacobite, an adherent to the exiled Stuart dynasty \nof Scotland and England. If so, he would have shared with at least some \namong the pirate crews an opposition to the political establishment that \narose from the deposition ofthe last Stuart king of Britain, James II (1633-1701; \nreigned 1685-1688), in the Glorious Revolution of1688. The charge of piracy \nhad been employed by the Whig government, as we shall see, in the early \n1690s, in widely publicized trials to deny the validity of commissions issued \nby James authorizing privateers to prey upon British shipping.\" If Mist was \na Jacobite, and was also the author of the General History, it would help \nto explain the ambivalence of the text. Whether or not he authored the \nwork, Mist's provided the first and glowing review of the first edition of \nthe General History.",
        "years_in_scope": [
          1633,
          1660,
          1685,
          1688
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

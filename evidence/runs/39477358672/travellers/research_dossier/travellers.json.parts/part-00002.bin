        "verified": false
      },
      {
        "finding_id": "section-7585efe7516dd00d2146",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The imperial centre understood that these levends and others like them \nworked closely with contacts on land to supply victuals and fence their plun- \nder, and it repeatedly dispatched orders to provincial administrators not to \nsupply criminal levends with grain, guides, water, or intelligence; all ships built \nwithout authorization or belonging to those suspected of engaging in piracy \nwere to be seized and burned?» But such orders had little effect. The governors \nofthe mainland district in whose jurisdiction Lefkada fell frequently colluded \nwith the island's levends, bankrolled their operations, both legal (there was a \nsurfeit of licit targets in Habsburg- and papal-controlled Italy) and illegal, and \nturned a blind eye to all but their most egregious offences.3° The same was \noften true for the governors, fortress commanders, and customs officers of \nmany of the Ottoman port towns of the Adriatic, Ionian, and Morean coasts, \nwho either chose or were forced to collaborate with the local levends. Collusion \nmay have been a choice for some officials, but for the soldiers and irregulars \nstationed along the Ottoman Empire’s maritime frontiers who were paid, if \nthey were paid at all, in debased coin at wages that had stagnated despite \ndecades of inflation, participation in the raiding, whether legal or illegal, was \na matter of financial necessity. And so the rash of piracy that began in the \naftermath of peace in 1573 persisted until the Ottoman invasion of Venetian \nCrete in 1645 gave the levends a new war to fight.",
        "years_in_scope": [
          1645
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 411765,
          "end_char": 413312,
          "start_line": 7712,
          "end_line": 7731,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",

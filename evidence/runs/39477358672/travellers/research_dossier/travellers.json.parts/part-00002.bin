      {
        "finding_id": "section-82a3cff220cf7bb2209e",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "No feature of piracy could be more redolent of this defiance of moral and \nlegal authority than the practice of piratical oath-making and oath-taking.5 \nIn Early Modern European political and legal discourse, oaths had a double \nmeaning. Oaths were made not only in abusive “swearing,” but in the formal \nsolemnities of “swearing in.” In this latter sense, oaths were pledges or \npromises oftrust, truthfulness, and fidelity made under the divine authority \nof God, or the secular authority of law.57 Oath-taking, on assuming public \noffice or in giving legal testimony, was therefore a testament of veracity, \nvalidated by divine and political hierarchy. These oaths were verbal symbols \nof the ideal of liberty Locke recommended - a liberty underwritten by \ndivine, legal, and political sanctions. This was precisely the sense in which \nLocke spoke of oaths of allegiance and obligation marking the transition \nof subjects from child to \"free\" adult:",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

      {
        "finding_id": "section-466e2e5b52623c95e215",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "as Dutch propaganda in the East made out, were a \"nation of pirates\" is debat- \nable, but it is certain that many of the most well-known pirates of the so-called \nGolden Age of Atlantic piracy in the seventeenth and eighteenth centuries \nwere English. Although the well-researched field of Atlantic piracy is not the \nmain focus of this volume, English pirates inevitably appear in several of the \ncontributions, particularly those by Kempe and Buchan, demonstrating the \nambiguous attitude that European states and authorities had towards piracy.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 45461,
          "end_char": 46008,
          "start_line": 927,
          "end_line": 933,
          "printed_page": null,
          "scan_indexes_0_based": [],

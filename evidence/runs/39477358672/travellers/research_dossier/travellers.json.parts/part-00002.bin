      },
      {
        "finding_id": "section-5136b0ba37714870c5bc",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The French troops - who were more numerous and better equipped than \nGarnier's force ten years earlier — quickly seized the citadel at Hanoi but \nwere again unable to move against the Black Flags. Riviére was also unable \nto undertake an intended survey of the Red River because the water was too \nlow for the French gunboats. Forced to wait for the rain season the French \ntroops were thus confined to the citadel, where they were besieged by the \nBlack Flags. An obviously despondent Riviére wrote in a letter to one of his \nsub commanders that the country seemed to be teeming with pirates and \nthat more or less everybody was a pirate.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 666156,
          "end_char": 666795,
          "start_line": 12592,
          "end_line": 12600,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

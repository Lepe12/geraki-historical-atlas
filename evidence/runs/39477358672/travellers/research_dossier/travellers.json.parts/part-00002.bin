      {
        "finding_id": "section-5d07a69a71f582da110c",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "There was also a degree of common ground between the Vietnamese and \nFrench in the decade before the French conquest of Vietnam with regard to \nthe need to suppress pirates or giác. In the 1870s and early 1880s, the French \nand Vietnamese made some efforts to collaborate in the suppression of \npiracy in Vietnamese waters, mainly with regard to the Chinese pirates who \nplagued the islands and coasts of the country and abducted thousands of \nVietnamese who were trafficked to China or colonial outposts.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 679638,

      {
        "finding_id": "section-030131fe46dbdc196a16",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Ottomans shared much with their Mediterranean neighbours, particu- \nlarly the Venetians, in how they understood the forms and practitioners of \nmaritime violence. However, the ambiguity surrounding what separated \nlegitimate corsairing from seemingly indiscriminate piracy - both often \npracticed by the same people, not only over the course of a career but \nsometimes on the same cruise - inflected the Ottoman vocabulary of \nmaritime violence in the late sixteenth and seventeenth centuries. That \nvocabulary reflected the deep ambivalence Ottoman administrators felt \ntowards those who might cheaply provide the state with intelligence and \ncoastal defence and augment the imperial navy, but who might also be, \nhave been, or become pirates attacking Ottoman ships and shores as well \nas those ofthe Ottomans' treaty-partners, thereby posing a grave challenge \nto Ottoman security and sovereignty.*",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 381295,
          "end_char": 382196,
          "start_line": 7195,
          "end_line": 7207,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",

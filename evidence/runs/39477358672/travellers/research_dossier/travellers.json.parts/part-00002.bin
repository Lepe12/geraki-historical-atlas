      {
        "finding_id": "section-3a7d6092e38551540f5b",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "This detail of allegiance switching perhaps escaped the notice of Admiral \nCornelis Speelman when he wrote his lengthy narrative of the Makassar \nWar three years later. On the verso side of its first page, he labelled Tiworo a \nnasty (or vile) pirate's nest. Rather than any actual piracy claim, however, his \nderisive tone was precisely the result of Tiworo's effectiveness as Makassar's \nally. We know from Speelman and other sources that Tiworo had a ruler \n(raja) who, along with his family, maintained close ties with Makassar's \nruling elite. We also know the VOC regarded Tiworo as an important ally of \nMakassar's. In addition, we know details about how Tiworo and its mariners \nbolstered both Makassar's expansionary endeavours, as well as shared its \ninterests in conflicts over spices.”° Despite these close ties between Tiworo \nand Makassar, the writing on the wall led a large Tiworo contingent to \nshift their allegiances to Boné. Each of these sixty men gained a gun along \nwith their new prominent positions under the Bugis leader Arung Palakka, \nand both the guns and the status conferral make it very unlikely that their \nfamily members would have been taken and involuntarily relocated or \nsubordinated.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 242006,
          "end_char": 243228,
          "start_line": 4616,
          "end_line": 4632,
          "printed_page": null,
          "scan_indexes_0_based": [],

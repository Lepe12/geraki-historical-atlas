      {
        "finding_id": "section-f0097778fa97cc33c370",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Such evidence from linguistic traces, properly contextualized, offer a \nway to show that piracy could exist in settings where states did not. Yet, \nthis, in a sense, silent testimony of language still cannot eliminate the \nchallenge of analysing the historical record without reproducing statist \nperspectives. Especially in colonial contexts, relativist analyses usefully \nunderscore the frequent ascription of piracy claims by those in positions of \npower, along with their assumption of epistemological privilege in legal and \nmoral terminologies. The structure and substance of piracy claims, however, \nmerit a fuller theoretical explanation than that provided by the relativist",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-08470cf58ae3ff2c4aba",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Dire was the vengeance taken by the corsairs. \nThey sacked Fundi and burned the town; they \nkilled every man on whom they could lay their \nhands, and carried off the women and girls to \nthe fleet.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

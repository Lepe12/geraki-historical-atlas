      {
        "finding_id": "section-6e6c821167f44348ebcf",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The third and last section ofthe book deals primarily with discourses of \npiracy and highlights how representations of piracy emerged in different \ninternational and colonial contexts from the late sixteenth to the early \nnineteenth century. Birgit Tremml-Werner focuses on how piracy was \nrendered in Spanish records from the Philippine Islands from around 1570 \nto 1800. She demonstrates that the label “pirate” was used to denote a wide \nrange of hostile elements or peoples, including other Europeans, Chinese, \nJapanese, and indigenous Philippine groups. Several of these alleged pirates \nhave been largely overshadowed by later, mainly nineteenth-century, ac- \ncounts that focused exclusively or overwhelmingly on the maritime raiding \nof indigenous Muslim “Moro piracy.” Her chapter thus demonstrates the \ncomplex nature of piracy and the multiplicity of actors, practices, and \nrepresentations of the phenomenon during the long period under study.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

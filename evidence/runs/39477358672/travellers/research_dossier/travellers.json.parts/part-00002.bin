      {
        "finding_id": "section-af0c8c723a09d38b998b",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Pirates, it is frequently claimed, have existed since the dawn of history, \nas long as there has been traffic and commerce at sea.’ Presumably, the \norigins of piracy would thus be sometime in the pre-historic past, when \npeople first took to the sea for commercial purposes, probably around eight \nthousand years ago, along the coast of the Persian Gulf.? Historical records \nover close to three and half millennia, from ancient Egypt to the present, \nseem to provide documentation of piratical activity from all around the \nworld. Piracy would appear to be ubiquitous across a very longue durée in \nthe history of humanity, and only with the projection of sea power by major \nstates and empires, whether ancient (when Rome or Srivijaya controlled \ntheir adjacent seas) or modern (when Great Britain or the United States did \nso) was piracy efficiently suppressed, at least temporarily.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 5213,
          "end_char": 6100,
          "start_line": 232,
          "end_line": 243,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

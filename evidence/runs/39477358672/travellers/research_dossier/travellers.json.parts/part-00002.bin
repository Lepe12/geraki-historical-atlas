      {
        "finding_id": "section-dca0d7019061963f2766",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "That the central government considered these raiders to be engaged in illegal, \npiratical activity is clear enough. What is not clear is who these frigate-sailing \npirates actually were, nor how they conceived of their own actions. Were \nthese formerly licenced corsairs, left unemployed and disgruntled by the \nrestoration of peace with Venice in 1573 after three years of war? Were \nthey local irregulars stationed in a nearby fortress who, underpaid and \ndeprived of legitimate plunder in peacetime, chose to raid their neighbours? \nOr were they simply local amphibious bandits who had made, or coerced, \nrelationships with local officialdom? The broader body of Ottoman decrees \nfrom this period makes clear that the culprits included people from all \nthree categories.’",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 391100,
          "end_char": 391874,
          "start_line": 7365,
          "end_line": 7375,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

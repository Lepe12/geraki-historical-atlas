      {
        "finding_id": "section-25226b7284bc075a26aa",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Pope and Emperor, King, Duke, and Viceroy \nhad tried conclusions with the pirates, and their \nfleet and army had melted away as the mists melt \nin the hot sunshine on the Mediterranean; truly \nwere the descendants of the dispossessed Moors of \nCordoba and Granada taking a terrible revenge on \nthose by whom they had been expropriated.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

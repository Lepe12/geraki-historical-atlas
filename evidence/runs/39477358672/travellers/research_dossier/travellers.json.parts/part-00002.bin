      {
        "finding_id": "section-e317441f1e1f3a18bfad",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "engaged  in  communications  with  Muley  Hamid, \nthe  then  King  of  Tunis,  who  was  feudatory  of \nSpain.  Anxious  as  was  the  corsair  to  aid  in  attack- \ning his  implacable  enemies,  the  Knights,  he  could \nnot  afford  to  leave  his  own  flank  unguarded  in \nAfrica.  He  succeeded,  however,  in  arriving  at  an \nunderstanding  with  the  King  of  Tunis,  and,  further \nthan  this,  he  had  assured  himself,  by  means  of  his \nspies,  that  the  succours  which  were  to  be  sent \nfrom  Sicily  by  the  Spanish  King  could  not  possibly \narrive  for  another  two  months.  It  was  the  negotia- \ntions which  he  was  obliged  to  undertake  with  Muley \nHamid  which  had  caused  his  late  arrival.  As  far  as \nit  is  possible  to  judge,  it  was  this  circumstance  which \n(added  to  their  own  incomparable  valour)  turned  the \nscale  in  favour  of  the  Knights.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

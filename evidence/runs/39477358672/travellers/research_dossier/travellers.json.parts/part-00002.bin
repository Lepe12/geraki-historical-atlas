          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Mist's purported Jacobitism, and his opposition to Prime Minister \nWalpole's Whig government, might help to explain why pirates and piracy \nshould be selected as the unlikely medium for political critique. The General \nHistory publicized the seditious actions of pirates who represented an \nalternate sovereign legal order registered, for example, in the pointedly \nJacobitical re-naming of pirate vessels The Revenge, the Royal James, and",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

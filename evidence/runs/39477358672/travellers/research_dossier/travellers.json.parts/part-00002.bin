      {
        "finding_id": "section-b6b02eef13da0e9d52bd",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Ostlund and Buchan consider how piracy intersected both scholarly \ndiscourse and state policy in a period of acute political crisis in Sweden in the \nearly years ofthe eighteenth century. By focusing on one student dissertation \npresented and printed at Uppsala University in 1716, they contend that \nSweden's precarious position necessitated a delicate navigation of piracy \nin both the Baltic and the Mediterranean. Effectively, Sweden's weakness \ndictated a policy of partial recognition of Barbary pirate states along the \nNorth coast of Africa, and even led to offers of employment for former \npirates as a substitute navy closer to home. While the scholarly traditions \nof natural law provided ample resources to condemn pirates as mere sea \nrobbers, this one dissertation illustrates how moral, philosophical, and \nhistorical arguments could be marshalled in defence of a more equivocal \nattitude to piracy, which also reflected the delicate balancing act performed \nby the Swedish state.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

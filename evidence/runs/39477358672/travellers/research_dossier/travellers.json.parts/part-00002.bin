        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Ifthe levend galliots of North Africa and the korsan caiques of other places \ngo by sea, or if other thieves go by land, and raid the islands and other \nplaces subject to Venice and capture their people and take them and sell \nthem in Rumelia or Anatolia or in North Africa or in other places, or if \nthey use them themselves; that sort of slave, in whoever's possession he is \nfound, shall be taken from them without delay and be turned over to the \nVenetian Senate's bailos or their deputies or their agents and those robber \nlevends (harami levendleri, i.e. pirates) shall be captured and strongly \npunished, and if that slave became Muslim, he shall be emancipated \nand freed.”",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-2661dc83d6da93044b88",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The rhetoric contributed to the government's success in getting Parliament \nto ratify the treaty, and the year after it was followed by a commercial \ntreaty in which the need to suppress piracy was further emphasized. The \ncommercial treaty extended the French obligation to suppress piracy to \ncomprise pirates on land, in addition to those at sea, stating that France \nwas obliged to *make all efforts to destroy the pirates of the land and the \nsea, particularly in the vicinity of the towns and ports open to European \ncommerce.\" Neither treaty mentioned the word “protectorate,” but for \npractical purposes the treaties seemed to establish such a relation between \nthe two countries.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 662513,
          "end_char": 663201,
          "start_line": 12529,
          "end_line": 12538,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",

      {
        "finding_id": "section-2464ccd78be68392390c",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "England therefore had to undertake urgent measures to rid itself of a \nreputation as a \"pirate nation\" that had stuck to it since the times of the \nElizabethan buccaneers. In order to demonstrate that the English govern- \nment was seriously committed to fighting such troublemakers, \"advertise- \nments\" calling for the arrest of Cusack's band of pirates were sent to all the \nlarger harbours in England, Scotland, Ireland, Holland, and France.9? The \nAdmiralty in London thus stamped Cusack as a universal criminal above \nall because he had done international damage to the national interests of \nEngland. By adopting these severe measures, England could also present \nitself to neighbouring sovereigns as the deliverer from a universal scourge \nof humanity.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 119212,
          "end_char": 119970,
          "start_line": 2317,
          "end_line": 2327,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

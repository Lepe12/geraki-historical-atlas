      },
      {
        "finding_id": "section-9213d0a933f20291615d",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Piratical imperialism did not go unnoticed at the time. European sources \nfrom the sixteenth, seventeenth, and eighteenth centuries are packed with \naccusations of piracy by the members of one nation against another or \nseveral other nations, particularly other Europeans.36 Europeans also tried \nto convince Asian merchants and rulers that fellow Europeans were pirates, \nand the Dutch, in particular, worked hard to spread their view ofthe English \nas a “nation of pirates.”37",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 40305,
          "end_char": 40783,
          "start_line": 836,
          "end_line": 842,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

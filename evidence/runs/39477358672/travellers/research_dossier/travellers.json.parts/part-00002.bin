      {
        "finding_id": "section-2c3363efc2ebe2ac8d6e",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "It is interesting to compare the pirate fleets of Jarannika and Pamolikang \nwith the more anonymous enterprises in eastern Indonesia. The pirate \nprinces of Sulawesi went to Java, East Kalimantan, Bali, Lombok, Sumbawa, \nand western Flores, but usually no further than that. During the impe- \nrial era, Makassar made inroads in the sandal-rich Timor, most notably \nin 1641 when certain ports in the north-east were reduced to tributaries. \nCoastal sites on the nearby Alor Island likewise had to pay tribute. Similar \nto Sumbawa-Lombok, the sudden collapse of Makassarese state power \ncreated a power vacuum. The ethnically mixed Portuguese community \n(the Black Portuguese or Topasses) had hitherto kept a power base in Lifau \nin West Timor and Larantuka in Flores, but were now able to expand their \ninfluence to East Timor in 1668-1671, just in time to prevent the Dutch rivals \nfrom doing the same. But the Portuguese and Dutch communities in Timor \nwere small and unable to police the vast waters.3°",
        "years_in_scope": [
          1641,
          1668,
          1671
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

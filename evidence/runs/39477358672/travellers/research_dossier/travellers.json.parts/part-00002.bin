      {
        "finding_id": "section-cd119a5f561d73d9c00c",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "One of the difficulties in dealing with the career \nof Kheyr-ed-Din Barbarossa is that, in times when \nhe was unsuccessful, or when, as on the present \noccasion, he had received a severe setback, it is \nnext to impossible to find out what he was doing \nor where exactly he was preparing for his next \ncoup. In this case, in particular, the old-time \nhistorians were thanking God that the Emperor \nhad rid the world of a particularly pestilent knave, \nand ceased to trouble themselves much about \nhim until he forced himself once more upon their \nnotice. Had Charles at this time recognised the \ngreatness of the man whom he had just so signally \ndefeated he might have changed the course of \nhistory. Had he, instead of sailing back to Europe, \ncontent with that which he had accomplished in \nTunis, pushed his attack home on Algiers, he \nmight have made himself master of the whole of \nNorthern Africa, as, in the disorganised state in \nwhich the corsairs now found themselves, they \ncould certainly have offered no effective resistance.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

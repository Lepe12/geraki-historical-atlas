      {
        "finding_id": "section-97f7b1d568b52e775c06",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "This conclusion followed from a consideration of piracy's many defini- \ntions, and a detailed examination of cases across different eras in Southeast \nAsia's engagement with the world, before and after the arrival of Europeans. \nTaking a close look at how the question of piracy unfolded in relation to \nparticular configurations of politics, power, and cultural comprehension, \n“Piracy in the Offing\" examined three examples. First, amidst the relations \nbetween Southeast Asian polities and China during the early fifteenth \ncentury, it looked at how Chen Zuyi, a transplant to the western archipelago, \nappeared to the fifteenth-century naval commander, Zheng He, and to the \nChinese chroniclers of his deeds. Here, “pirates” (as Western scholars have \ntranslated the term), presented an impediment to the setting up of orderly \ntributary relations, or at least the fiction of them, with subordinate states \nalong established trade routes through the Malacca Straits to the Indian \nOcean.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 221158,
          "end_char": 222149,

        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "called pirates. Well, they are neither pirates nor bandits outside the law. \nThey are regular soldiers in the service of King Tu Duc [...].5'",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

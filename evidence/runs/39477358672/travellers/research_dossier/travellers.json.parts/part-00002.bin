      },
      {
        "finding_id": "section-eb0901bc255c2d9fec95",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "From the perspective ofthe new Qing government, pirates were rebels and \ntraitors; laws and official documents referred to them as \"sea rebels/traitors\" \n(haini). But from the perspective of the pirates and their supporters, they \nwere righteous freedom fighters in opposition to the alien Manchu invaders. \nMany pirate leaders assumed roles as Ming loyalists (Ming xiang), which \ngave them a sense of legitimacy to cloak their otherwise nefarious business.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 469523,
          "end_char": 469980,
          "start_line": 8794,
          "end_line": 8799,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

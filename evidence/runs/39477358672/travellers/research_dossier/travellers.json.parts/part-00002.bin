      {
        "finding_id": "section-7795ad3e345056615c03",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The eighteenth century saw the establishment across Europe of this \nimage of pirates as both subversive criminals prone to excessive violence \nand debauchery and as romantic heroes and freedom fighters. At times, \nthey could even be associated with social banditry in the sense of Eric \nHobsbawm.” Such images were largely based on two purportedly true \naccounts of the lives and deeds of actual pirates, mainly in the Caribbean, \nduring the second half of the seventeenth and the beginning of the eight- \neenth century: Alexander O. Exquemelin's De Americaensche zee-rovers (The \nBuccaneers of America, 1678) and Charles Johnson's General History of the \nPyrates (1724). Both of these books became very popular and were widely \ntranslated and disseminated in several editions across Europe shortly after \ntheir publication. The latter book in particular continued to command \ngreat popularity throughout the eighteenth and nineteenth centuries (and \nbeyond). In addition, several popular adventure novels featuring pirates \nwere published during the eighteenth and nineteenth centuries, such as",
        "years_in_scope": [
          1678
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

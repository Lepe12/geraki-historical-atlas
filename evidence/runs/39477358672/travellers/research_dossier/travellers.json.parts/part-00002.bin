        "finding_id": "section-b5a6166a2bea1b8e7bef",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The issue of sovereignty was crucial to the construction and maintenance \nofthe Qing Empire. At key stages throughout the dynasty's history armed \nmaritime organizations, what the state labelled as pirates, rose up to threaten \nthe security and sovereignty of the state and well-being of society. Qing naval \nstrategy steadfastly promoted coastal defence and protecting coastlines \nand hinterlands, at the expense of offensive campaigns beyond the inner \nocean. By the late nineteenth century, however, in the face of mounting \nforeign aggression and the persistence of piracy, the Qing state gradually \nextended naval campaigns and claims of sovereignty into the outer ocean. \nThrough battles with pirates and interaction with European maritime laws, \nthe Qing imperium pragmatically adapted to changes and transformed its \nown notions of maritime sovereignty to extend its legal regime further and \nfurther into the outer ocean, especially over the course of the second half \nofthe nineteenth century.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 493419,
          "end_char": 494422,
          "start_line": 9325,

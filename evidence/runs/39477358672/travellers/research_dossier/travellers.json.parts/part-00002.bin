      {
        "finding_id": "section-dc02d1f2e0764ac01f8d",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Catholic missionaries drew the attention of the French public to the \nproblem, and French naval vessels occasionally undertook anti-piracy \ncruises off the Vietnamese coast. Compared with the other major colonial \npowers in Southeast Asia at the time - Great Britain, the Netherlands, and \nSpain - however, the French did relatively little to suppress piracy at sea \nbefore the 1870s. In the 1860s, the main priority of the French navy was \ninstead to establish order and control over French Cochinchina (southern \nVietnam), which the French had seized from the Nguyen Dynasty in 1858.78 \nSecurity conditions were anything but good in Cochinchina during the first \nyears of French rule, when river piracy and brigandage were rife.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 654200,
          "end_char": 654930,
          "start_line": 12378,
          "end_line": 12387,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

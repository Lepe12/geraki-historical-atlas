      {
        "finding_id": "section-6ad291e12fbd6cdc4411",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "The capture of Algiers by Count Pedro Navarro \nwas a crowning misfortune for the exiles, and when \nthis commander seized upon the place he extracted \nfrom the inhabitants an oath of fidelity to the \nSpanish crown; he further erected a strong tower \nto overawe the town, and to keep its turbulent \ninhabitants in order. But such an oath as this, \nextracted at the point of the sword, was writ in \nwater; it meant, of course, the suppression of \npiracy, and it also meant the starvation of most \nof those persons who dwelt in the vicinity. How \nthe Moslem population existed for the six years \nafter the incursion of Navarro is a mystery ; but \nthey probably moved their galleys, of which they \npossessed some twenty, further along the coast",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

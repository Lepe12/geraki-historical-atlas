        "verified": false
      },
      {
        "finding_id": "section-db40eec7de798f671b8d",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In accordance with the treaties, French naval vessels undertook several \nanti-piracy operations in Vietnamese waters in the second half ofthe 1870s \nand the beginning of the 1880s. The result was that some of the piratical \ndepredations were contained, but the French navy's capacity to suppress \npiracy in the region was insufficient and the abductions and trafficking \nof Vietnamese to China, Hong Kong, and Macau continued. For those who \nfavoured a more aggressive colonial policy in Indochina, the need to suppress \npiracy and trafficking provided a strong argument for intervention. Paul \nDeschanel, an influential French Republican Party politician and author, \nfor example, argued that it was a matter of dignity for France to uphold \nmaritime security in Vietnamese waters. He also worried that the prevalence \nof piracy might induce another foreign power, in the first place Great Britain \nor Germany, to intervene and thus threaten French interests in Indochina.3?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 663204,
          "end_char": 664179,
          "start_line": 12540,
          "end_line": 12552,
          "printed_page": null,
          "scan_indexes_0_based": [],

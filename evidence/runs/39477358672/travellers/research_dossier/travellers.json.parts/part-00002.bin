      {
        "finding_id": "section-61711034086b64485a33",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "It was late autumn when the expedition at last \nset sail, and the imperious temper of Charles was \nsuch that he refused to be governed by the \nadvice of the seasoned mariners, such as Andrea \nand Antony Doria, and others who dreaded the \neffect of the gales which the armada was likely \nto encounter on the coast of Africa. The Emperor \nwas not to be gainsaid, and the fleet set sail. \nThey arrived, says Sandoval, “en el dia de San \nHieronymo,” Saint Bartholomew’s day ; and there \nthen arose such a storm as the Mediterranean \nseldom sees. Some of the army had landed, some \nwere still afloat, the corsairs accounted for the \nluckless soldiers ashore, the elements destroyed \nmany left in the ships: 26 ships and 4,000 men \nwere lost.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

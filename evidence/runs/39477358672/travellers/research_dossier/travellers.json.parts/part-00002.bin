      {
        "finding_id": "section-5bfc3bf565fd0f604441",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In several of his texts and speeches, Cicero described pirates as a per- \nvasive evil. For example, in his spirited defence of the Roman General \nand Statesman Gnaeus Pompeius Magnus, who supposedly cleared the \nMediterranean of Cilician pirates in just three months in 67 BCE, Cicero \npresented the situation as one of unprecedented crisis, which could only be \nsolved by immediate and decisive military action.» The tendency to securitize \npiracy - that is, rhetorically presenting it as a grave security threat requiring \nextraordinary measures? — thus accompanied the concept of piracy from \nthe time it was first used in the last century BCE.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 634733,
          "end_char": 635380,
          "start_line": 12015,
          "end_line": 12023,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",

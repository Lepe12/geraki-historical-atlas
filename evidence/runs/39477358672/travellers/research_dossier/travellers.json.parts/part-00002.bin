      {
        "finding_id": "section-bde315222ff24cb41a42",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Most pirates feature in history as the enemies of some, not the enemies \nof all. We cannot tell piracy's history through genealogies of universal \ncriminality. The global imprint of maritime violence was produced instead \nthrough repeating patterns of interpolity engagement. Diverse political \ncommunities followed a range of interests and impulses in sponsoring \nviolence, asserting jurisdiction on parts of the seas, and permitting or \nenjoining others to do the same. Interpolity regimes worked both to contain \nmaritime violence and to make space for it, rendering piracy a protected \nbut always controversial and unstable phenomenon. Historians exploring \nsuch practices and patterns are writing new, truly global histories of piracy.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-8d8ef30ae0d7327222b5",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "It will be useful here to analyse sections of Walker's correspondence \nwith the higher authorities in Bombay in order to underline the subtle \ndistinctions that marked official representations of piracy and to attend \nto the complexities of the local situation that made a simple translation \nof coastal politics intelligible. For the Resident, it was clear that the pirate \nstates operated under very low margins and that it was impossible to expect \nthem to conform to any agreements that the Company initiated. At the",

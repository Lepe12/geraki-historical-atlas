      {
        "finding_id": "section-3564bcc1d04a2e1defeb",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "On closer examination, however, this grand narrative has several weak- \nnesses. As for the allegedly pre-historic origins of piracy, it is not an activity \nthat has left distinct traces in archaeological records - unlike, for example, \nfarming, hunting, or fishing. It may be inferred from material remains \nand ancient depictions that maritime violence occurred. In the absence of \nwritten sources, however, it is generally not possible to determine whether \nsuch violence was piratical by modern definitions, or by those current at \nthe time. As Philip de Souza put it, a history of piracy can “be written only \non the basis of texts which mention pirates or piracy in explicit terms, or",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

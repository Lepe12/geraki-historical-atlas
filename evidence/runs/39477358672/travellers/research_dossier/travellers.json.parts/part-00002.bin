      {
        "finding_id": "section-703850ddce527fd0a69e",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "There was one exception to this characterization, though: Kanhoji Angria, \nthe Maratha chieftain of Kolaba, who assumed almost mythic perceptions \nin European representations as the archetypal Indian pirate, whose ruth- \nless attacks on the English trading company and its protected merchants \nsmacked of villainy and cruelty. In putting together such a representation, \nboth of the sporadic and episodic violence of small time marauders along \nthe Indian littoral and ofthe violence ofthe combat in containing Angrian \npiracy, European writers were arrogating to themselves exclusive claims to \nsovereign jurisdiction on the Indian Ocean, which they could not share with \nany other, while simultaneously denying possibilities of political agency to \nIndian littoral groups that included rulers, their merchants and privateers, \nand pirates who chafed at restrictions.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",

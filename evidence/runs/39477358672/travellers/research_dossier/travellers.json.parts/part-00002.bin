      {
        "finding_id": "section-3c417303fae98278d3e3",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "There  remained  for  an  appreciable  period  after  he \nhad  spoken  a  tense  silence  ;  the  red  light  from \nthe  burning  houses  shone  on  the  lean  faces  alight \nwith  the  fierce  fire  of  fanaticism,  with  an  inex-^ \ntinguishable  lust  of  slaughter.  There  came  an' \nanswering  frenetic  roar,  ''Lead!  Lead!  Dragut! \nDragut !  Dragut ! \"  It  was  enough  :  the  corsair \nhad  tried  the  temper  of  the  steel,  he  had  now  but \nto  use  the  edge.  There  was  an  ordered  movement \non  the  part  of  the  pirates :  a  fresh  hundred  men, \nwho  had  hitherto  taken  no  part  in  the  combat,  now \npressed  to  the  front  and  formed  the  advance, \nthose  who  had  been  before  engaged  now  forming \nthe  supports ;  that  which  had  been  the  shaft  of \nthe  spear  now  forming  its  head.  With  Dragut \nleading,  these  fresh  unwounded  men  swept  forward \nover  the  burning  beam  ;  irresistible  as  some  mighty \nriver  in  spate,  these  disciplined  ruffians,  headed  by \nthis  master  spirit,  burst  through  the  ill-organised \nresistance  opposed  to  them,  and  slew  and  slew  and \nslew.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

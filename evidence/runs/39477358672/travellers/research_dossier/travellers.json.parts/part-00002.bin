      {
        "finding_id": "section-ce8b5770810cbec382f5",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "De piratica was one of only a small number of other dissertations \ncommenting on Sweden's maritime activities and its contemporaneous \ninteractions with non-Christian states and empires. What makes De piratica \nso unusual was that it openly considered the moral justification of piracy \nand its political expediency. Historians of Sweden's imperial and maritime \nambitions in the period rarely use dissertations as source material. This \nomission seems all the more striking given the sensational subject matter in \nDepiratica. Three layers of analysis will need to be traversed to fully unveil its \nsignificance. The first involves the political context of European experiences \nof piracy exacerbated by the desperate political and economic situation \nSweden faced in the first decades of the eighteenth century. The second \nconnects this context to the genre in which Thelaus wrote and published, \nthe scholarly dissertation. The third involves an investigation of Thelaus's \nuse of the major philosophical and historical works on piracy and pirates.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "On  board  his  galley,  decorated  for  this  occasion \nwith  scarlet  banners,  Barbarossa  himself  directed \nthe  assaulting  line.  Never  before  when  the  battle \nwas  joined  had  the  gallant  corsair  been  known  to \ndraw  back ;  and  yet  on  this  occasion  he  not  only \nhesitated  but  actually  hauled  off.  The  Venetians \nsaw  to  their  amazement  that  the  expected  attack \nwas  not  to  be  pushed  home ;  for  Barbarossa  and",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

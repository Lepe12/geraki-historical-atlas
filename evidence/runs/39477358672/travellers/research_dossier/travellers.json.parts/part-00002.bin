        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "We are now ready to survey some of the valuable contributions to the \nglobal history of piracy in this volume. Multiple authors observe the way \na cacophony of pronouncements about piracy informed fluid legal strate- \ngies. Several probe the relation of piracy to political contexts, including \nconsolidating empires and pluri-political regions. Still others demonstrate \nthe value of histories of piracy to understanding the social and temporal \ndimensions of global and regional ordering in the early modern world.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

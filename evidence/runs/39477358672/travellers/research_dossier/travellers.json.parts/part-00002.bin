      {
        "finding_id": "section-995061abed5c46e8125b",
        "file": "oceananddesertb00oceagoog_oceananddesertb00oceagoog_djvu.txt",
        "title": "The ocean and the Desert",
        "url": "https://archive.org/details/oceananddesertb00oceagoog",
        "source_bibliography": {
          "creator": "Ocean",
          "date": [
            "1846-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "c2f999b655a9d2d8edd844f4c36978223abb7ee845aa1fc331bcd91dc5b4a9ce",
        "evidence_excerpt": "November,  1843,  bidding  farewell,  for \nawhile,  to  those  we  loved  dearly  in  the \nland  of  the  sunny  east,  to  all  the  com- \nforts and  discomforts  of  an  Indian  life; \nto  all  the  pleasures  and  disagremens  of \nmilitary  duty ;  and  looking  forward,  with \njoyful  anticipations,  to  the  still  more \ndelightful  return  to  our  native  land ;  to  a \nre-union  with  those  from  whom  we  had \nbeen  sundered  for  a  series  of  years ;  to \nre-visiting  those  spots  rendered  dear  to \nus  from  the  recollections  of  childhood,—- \nhappy  prospect,  indeed ;  engendering  feel- \nings in  our  breasts,  which  none,  but  those \nwho  have  experienced  them,  can  have  any \nidea  of,  or  express !  Many  a  time  and  oft, \ndid  I  sigh  for  the  expiration  of  my  ten \nyears,  that  I  niight  once  more  see  old \nEngland :  often  have  I  envied  those, \nwhom  I  saw  month  after  month,  embark",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

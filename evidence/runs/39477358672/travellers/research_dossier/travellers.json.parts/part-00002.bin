      {
        "finding_id": "section-e23f6acd793ed0654f38",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "sought—allies to assist him against the revolted \nVenalcadi and the recalcitrant Hassan. Lurking \nin the neighbourhood of Bizerta, he discovered \nEl Judeo (the Jew), Cachidiablo (Hunt the Devil), \nSalaerrez, Tabas, and other corsairs, who collec- \ntively composed a formidable force. These were \nall old acquaintances and some old followers of \nKheyr-ed-Din, and to them did he relate the \npiteous tale of the cowardice of Venalcadi, whom \nhe accused of having deserted his brother Uruj \nin his direst necessity, thereby causing his death ; \nthe abominable conduct of Hassan, who had turned \nand bitten the hand that fed him. With tears in \nhis eyes did this accomplished actor reluctantly \nreveal the base ingratitude of which he had been \nthe recipient ; so much did he contrive to work \nupon the feelings of his auditors that they one \nand all vowed to stand by him, and to replace him \nas ruler of Algiers, from which he had been thrust \nby men whose shameful treachery was only equalled \nby their ingratitude.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 148422,
          "end_char": 149436,
          "start_line": 3992,
          "end_line": 4012,

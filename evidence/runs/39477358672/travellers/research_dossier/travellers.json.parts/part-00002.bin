      {
        "finding_id": "section-6e480426eaab85db2365",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The extent to which pillaging in sixteenth-century Southeast Asia actually \ntook place with political sponsorship remains hazy. Nevertheless, we can \ndistinguish between Pires saying that pillaging was common to all nations, \nand the notion that piracy was intrinsic to everyday life in the maritime \nworld. Regardless of whether plunder took place under some political \nauthority, or despite it, it is hard to imagine that those who suffered the \ndepredations of raids would have blithely accepted such violence as just a \npart of daily life, no matter how common it may have been. Though this \nmay seem obvious, the point must be made explicitly: whatever one calls \nit — piracy or corsairing — we cannot presume that people simply accepted \npillaging as something natural. Rather, a sceptical and curious approach \nrejects explanations of piracy as \"natural,\" which indeed explains nothing \nat all, to probe instead its social and political dimensions. In other words, \nthe critical task is to resist approaches that naturalize piracy, in order to \nhistoricize piracy's dynamics.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

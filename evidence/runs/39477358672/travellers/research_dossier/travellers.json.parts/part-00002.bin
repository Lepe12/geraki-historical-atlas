      {
        "finding_id": "section-e831f06a0141cd59190a",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The present volume thus aims to contribute to the research effort that \nbegan around 2000 and that aims to unpack the rich and complex history \nof how the essentially European concept of “piracy” was translated and \nperceived when different cultures came increasingly into contact with one \nanother from the sixteenth century onward. In doing so, the book can be \nsaid to be part of the effort to “capture maritime history's still-unrealized \npotential as a vehicle for world history,” as Lauren Benton and Nathan \nPerl-Rosenthal recently put it, and to overcome the “ocean regionalism” \nthat has shaped much research in maritime history to date.’",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

      {
        "finding_id": "section-dacd451fbe4afdc7a18a",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "It  may  here  be  mentioned  how  terrible  was  the \ndamage  wrought  by  the  piratical  fraternity  in  the \nMediterranean,  and  the  manner  in  which  it  has \nbeen  brought  to  light  in  somewhat  remarkable \nfashion  quite  recently.  Since  the  French  occupa- \ntion of  Tunis  it  was  charged  against  them  that \nthey  had  taken  away  from  the  natives  of  the  country \nthose  fertile  lands  which  lay  upon  the  shores  of  the \nsea,  and  had  given  them  to  French  subjects.  The \nfacts  of  the  case  were  that  for  centuries  these  lands \nhad  been  entirely  out  of  cultivation,  the  reason  being \nthat,  until  the  complete  suppression  of  piracy  in \nthe  Mediterranean  took  place,  none  dared  to  dwell \nwithin  raiding  distance  of  the  sea  for  fear  of  being \ncarried  off  into  slavery.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

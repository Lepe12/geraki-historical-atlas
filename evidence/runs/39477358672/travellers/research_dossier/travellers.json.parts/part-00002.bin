      {
        "finding_id": "section-4f61a6dc1171521f1a2c",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In posing these questions, our aim is to contribute to the global history \nof piracy and, in particular, to the global conceptual history of piracy, by \nhighlighting both legal and theoretical perspectives and several empirical \ncase studies involving colonial or imperial encounters in the maritime \ncontext. The cases include studies of piratical violence in Europe, the Philip- \npines, Indonesia, India, the Ottoman Empire, China, and Vietnam across \nalmost four hundred years. European overseas expansion is an important \ntheme in many of the studies, but a significant feature of our chapters is \nthat they also bring non-European - particularly Asian — perspectives to \nbear on the analysis of piracy. By confronting these competing, or concur- \nrent, understandings of piracy as a historical, legal, and rhetorical concept, \nthe book sets out to highlight how piratical violence and its suppression \ncontributed to shaping imperial forms of domination, particularly in Asian, \nEuropean, and Mediterranean waters and coastal areas, including several \nregions that have hitherto not been as extensively studied as the Atlantic \nwith regard to piracy during the Early Modern period.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 11769,
          "end_char": 12955,
          "start_line": 343,
          "end_line": 358,
          "printed_page": null,

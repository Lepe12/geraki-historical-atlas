      {
        "finding_id": "section-9a8815c06802809b675b",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Cicero's famous description of pirates as the enemy of all (communis hostis \nomnium) became the starting point ofthe international legal discourse on \npiracy that developed in Europe during the Renaissance, when Cicero's \nwritings on piracy (among other things) were rediscovered. In particular, the \nconcept of piracy developed as a legal concept during in the Early Modern \nera, as recounted by Michael Kempe in this volume. In addition, there was a \nconcurrent development by which popular cultural understandings of piracy \nemerged, particularly in England from Elizabethan times, and subsequently \nthroughout Europe. This development occurred simultaneously and in \nconjunction with the growth of the international legal discourse about \npiracy, but in some respects it also stood in opposition to the hegemonic",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

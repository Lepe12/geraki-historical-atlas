      {
        "finding_id": "section-24b08ae135b66788a60a",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Dragut  Reis,  and  Occhiali,  or  All  Basha,  were  men \nwho,  in  the  sixteenth  century,  did  much  to  change \nthe  conditions  of  the  times  in  which  they  lived: \nit  was  the  time  of  the  Renaissance  in  Europe,  a \nperiod  of  splendour  in  all  the  arts  and  sciences. \nThese  men  added  nothing  to  the  knowledge  of  the \ncivilised  world  as  it  then  existed,  save  and  except \nin  one  particular,  which  was,  as  Kheyr-ed-Din \nexplained  to  Soliman  the  Magnificent  on  a  certain \nmemorable  occasion,  that  he  who  rules  on  the  sea \nwill  rule  on  the  land  also.  In  the  present  day, \nwhen  all  the  nations  and  languages  sit  at  the  feet \nof  Captain  (now  Rear-Admiral)  Mahan,  and  ac- \nclaim his  \"Sea  Power\"  series  of  books,  it  is  in- \nteresting to  find  that  he  was  anticipated  in  the \nmost  practical  fashion  possible  by  a  corsair  of  the \nsixteenth  century.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

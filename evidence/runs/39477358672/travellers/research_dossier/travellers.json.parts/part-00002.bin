      {
        "finding_id": "section-ac3fe61af271b6c6243c",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "If pointing out the wider ambitions of the volume resembles a friendly \namendment, a second line of criticism might land more forcefully. This \nvolume is haunted, as is the subfield of piracy studies more generally, by \nan enduring emphasis on European understandings of piracy centering on \nrepresentations of pirates as hostes humanis generis, enemies of all mankind. \nThe bias towards this discourse — sometimes explicit but also often implicit \n- can introduce distortions into comparative analyses of European and \nnon-European representations of piracy. It privileges a narrow reading of \na handful of European legal tracts over both vernacular discourses on sea \nraiding and maritime practices. These dangers, and the evident attraction of \nthis perspective, by no means apply across the chapters in this volume. But",
        "years_in_scope": [],

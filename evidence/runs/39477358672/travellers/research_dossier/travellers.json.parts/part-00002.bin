      {
        "finding_id": "section-6575b5b880602a05cef5",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,
          "date": [
            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "This passage shows a very curious jealousy between \nthe hunters and the corsairs, and a singular distinction \nas to religious feeling. Pére Labat, however, speaks \nof the Flibustiers as attending confession immediately \nafter a sea-fight with most exemplary devotion. A \nmore important distinction than that made by Char- \nlevoix was that between the Protestant and Roman \nCatholic adventurers, the latter being as superstitious \nas the former were irreverent. Ravenau de Lussan \nalways speaks with horror of the blasphemy and irre- \nligion of his English comerades, one of whom was an \nold trooper of Cromwell’s; and Grognet’s fleet even- \ntually separated from the English ships, on account of \nthe latter crews lopping crucifixes with their sabres, \nand firing at images with their pistols. A Flibustier \ncaptain, named Daniel, shot one of his men in a \nSpanish church for behaving irreverently at mass; and \nRingrose gives an instance of an English commander \nwho threw the dice overboard, if he found his men \ngambling on a Sunday.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

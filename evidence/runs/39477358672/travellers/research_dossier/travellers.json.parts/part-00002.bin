      {
        "finding_id": "section-c757f23db5f25a765209",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Piracy and other forms of maritime violence and coercion were a central \ntheme in European overseas expansion from the sixteenth to the early \ntwentieth century, as well as in the rhetoric and discourses that accompanied \nthat expansion. European navigators were experts in maritime violence, \nand their capacity to exercise violence at sea was a decisive comparative \nadvantage throughout the history of European expansion. They frequently \nused this advantage to threaten or destroy their commercial and political \ncompetitors, including both other Europeans and non-European rulers and \nmerchants.5 Meanwhile, maritime violence and raiding was also perpetrated \nby non-European communities, who attacked both European and non- \nEuropean seafarers and coastal settlements in search of booty and slaves. \nSome prominent examples of such non-European \"pirates\" (in the parlance \nof colonial sources) included the so-called Barbary states of North Africa,",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

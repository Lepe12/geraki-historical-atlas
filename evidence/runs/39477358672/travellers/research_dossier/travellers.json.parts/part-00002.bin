      {
        "finding_id": "section-23ecab13db99ab2c4559",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The idea of pirates as hostes humani generis is also in focus in Bruce \nBuchan's chapter. Although the concept may appear to be so entrenched \nas to be axiomatic, Buchan argues that piracy also elicited ambiguous \nresponses from philosophers and lawyers. Pirates were merely one among a \npantheon of archetypal enemies of good order, and there was at least some \ndoubt about whether they deserved the worst opprobrium. By examining \nreferences to piracy in the work of the English political philosopher John \nLocke in particular, Buchan argues that pirates vied with tyrants for the title \nof common enemy of all humankind.\" While Locke's prevarication certainly \ndid not amount to a rehabilitation of either figure, the British intellectual \nand legal context in the last years of the seventeenth and early years ofthe \neighteenth centuries provides some evidence of continuing doubt about \nwho the hostis humani generis really was.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

      {
        "finding_id": "section-ac1a8de3344c9c238873",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Only a few years after publication of De piratica, Swedish authorities \nestablished a state commission to investigate the proposal to make a favour- \nable deal with the pirates of Madagascar. According to a protocol held in a \nCouncil of State on 20 April 1719, the issue was debated in the form of “pro \net contra.” Among the many arguments expressed and evaluated the one \nconcerning “honour” is of interest. One member of the Council, Johan August \nAndersson Meijerfeldt (1664-1749), argued that if Sweden did proceed to deal \nwith the Madagascar pirates: \"the whole world would become our enemies, \nand it would be an everlasting dishonour for our country.” This argument was \ncountered by Daniel Niklas von Hópken (1669-1741), who maintained that, \nby letting the pirates live in Sweden, the state would provide a great service \nfor Europe because they would be pirates no more. The debate concluded \nthat the question should be further discussed in a Secret Committee (Sekreta \nutskottet) where similar “pro et contra” arguments were raised about the \nintegration of pirates into the Swedish state, and the danger that if Sweden \nwere too slow the pirates might make a deal with their rivals, Denmark.3”",
        "years_in_scope": [
          1664,
          1669
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 619838,
          "end_char": 621047,
          "start_line": 11695,
          "end_line": 11710,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",

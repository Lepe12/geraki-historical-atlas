      {
        "finding_id": "section-c1e5c6d6de4394760690",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "D’Aubusson, the veteran Grand Master of the \nKnights of Saint John, was nominated as Captain- \nGeneral of the Christian armies. For the pur- \nposes of this war the admiral of the Papal galleys \nin the Mediterranean, Lodovico del Mosca, pur- \nchased from Ferdinand, King of Naples, all his \nartillery, of which a description is given by the \nPadre Alberto Guglielmotti, a Dominican friar, \nauthor of a work entitled, “ La Guerra dei Pirati \ne la Marina Pontifica dal 1500 al 1560 a.p.” \n« There were thirty-six great bombards, with eighty \ncarts pertaining to them; some drawn by horses, \nsome drawn by buffaloes harnessed singly, or two, \nfour, or even six together; two waggons laden \nwith arquebuses for ships’ boats; nine with about \nforty smaller bombards (bombardelles) placed three, \nfour, or even six on each waggon; twelve with \nordinary pieces of artillery; as many more for \nthe service of twelve big guns; thirty-seven carts \nof iron balls; three with gunpowder ; and finally \nfive laden with nitre, darts, and bullets. Splendid \nartillery of most excellent workmanship and great \npower escorted by two thousand men under arms, \nwithout mentioning the companies who marched \nbefore and after each waggon.”",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 70548,
          "end_char": 71764,
          "start_line": 2019,
          "end_line": 2043,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

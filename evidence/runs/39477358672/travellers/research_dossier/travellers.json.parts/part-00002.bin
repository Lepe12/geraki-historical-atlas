      {
        "finding_id": "section-d0c80d07707a897784d3",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "By the men whose deeds have been here \nchronicled the pirate States of Northern Africa \nwere established; and, as we have seen, they \nmaintained an unceasing warfare against all that \nwas mightiest in Christendom, aided and abetted \nby the Sultans of Constantinople. In the six- \nteenth century the Sea-wolves had this at least \nto recommend them, that they feared neither King \nnor Kaiser, albeit these great ones of the earth \nwere ,bent on their destruction. Villains as they \nwere, they were none the less men to be feared, \nmen in whom dwelt wonderful capabilities of \nleadership. Such, however, was not the case with \nthose by whom they were succeeded; and the \ngreat and civilised nations of the world tolerated \nfor centuries in their midst a race of savage bar- \nbarians whose abominable insolence and fiendish \ncruelty were only equalled by their material weak- \nness and military impotence. Algiers, Tunis, and \nTripoli became recognised States, and the Great \nPowers degraded themselves by actually accredit- \ning diplomatic agents to the “Courts” of these \npeople.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",

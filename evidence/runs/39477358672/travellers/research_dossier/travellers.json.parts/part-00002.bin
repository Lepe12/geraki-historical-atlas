      {
        "finding_id": "section-d11e87f69419119eb0d9",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "dramatically by the mid-seventeenth century, following decades of disputes \nover the harsh treatment of administrators sent from Istanbul and mounting \nOttoman frustration with the failure of Algiers' leaders to consistently supply \nadequate naval support during the interminable campaign to conquer \nCrete. But whereas Algiers' contumacious corsairs and rebellious leader- \nship no longer held the exalted position in the eyes of the Sublime Porte \nthat it had a century earlier, it and the other North African port cities still \nrepresented an alternative locus for the legitimate practice of maritime \nviolence and the image of success in that pursuit for mariners across the \nOttoman Mediterranean. So much so, in fact, that levends elsewhere began \nto adopt its corsairs' distinctive fashions.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

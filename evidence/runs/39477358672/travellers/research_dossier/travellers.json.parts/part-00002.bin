      {
        "finding_id": "section-49c6e370772f0b5a8cc9",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Although one could assume that street robbers also prey on all people \nwithout distinction, the pirate alone did so on seas open to all nations, and \nwas thus, at least potentially, in a position to reach and to afflict members \nof virtually any country. The strategy and tactics of piratical activities \nwere characterized by unpredictable spatial behaviour, namely, sudden \nappearance, immediate attack, and swift disappearance. The unlocalizable \nspatial presence, the emergence and then retreat into invisibility, made \npirates a universal danger. The fact that this aggressor was simultaneously \nnowhere and everywhere made the pirate the enemy of all nations. What \nlinked the people of all nations to one another was the fact that they could \nall become the victims of pirates. As the virtual assailant of all nations, \nthe pirate thus became, as it were, the negative integrational figure for the \ncommunity of all people and nations.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 91178,
          "end_char": 92120,
          "start_line": 1777,
          "end_line": 1789,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",

      {
        "finding_id": "section-a1e8e72cf993b2507229",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In a modem global historical context, scholars have often regarded piracy as \nan essentially European concept which was inappropriately applied by the \nexpanding European powersto the restofthe world, mainly forthe purpose of \nfurthering colonial forms of domination in the economic, political, military, \nlegal, and cultural spheres. By contrast, this edited volume highlights the \nrelevance of both European and non-European understandings of piracy \nto the development of global maritime security and freedom of navigation. \nIt explores the significance of legal posturing' on the part of those accused \nof piracy, as well as the existence of non-European laws and regulations \nregarding piracy and related forms of maritime violence in the early modern \nera. The authors in Piracy in World History highlight cases from various \nparts of the early modern world, thereby explaining piracy as a global \nphenomenon.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 746719,
          "end_char": 747634,
          "start_line": 14882,
          "end_line": 14894,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

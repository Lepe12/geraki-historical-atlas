      {
        "finding_id": "section-7956cde03136faba8a01",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "of  Naples  by  the  stern,  and  a  tide  of  fresh,  un- \nwounded  men  burst  into  the  fray.  This  was  the \nend ;  the  Christians  were  both  outnumbered  and \noutfought,  for  among  them  were  many  who  were \nnot  by  profession  warriors,  whereas  no  man  found \na  footing  among  the  Sea-wolves,  or  was  taken  to \nsea  as  a  fighting  man,  unless  he  had  approved  him- \nself to  the  satisfaction  of  his  captain  that  he  was  a \nvaliant  man  of  his  hands.  We  have  no  record  or \nlist  of  the  dead  and  wounded  in  this  battle,  but \namong  the  latter  was  Uruj,  who  was  severely  hurt. \nNot  so  Kheyr-ed-Din,  who  escaped  scatheless  and \ntook  command  now  that  his  brother  was  incapaci- \ntated. The  dead  were  flung  overboard  with  scant \nceremony,  and  the  wounded  patched  up  as  best  might \nbe,  and  then  The  Galley  of  Naples  was  taken  in \ntow,  and  the  corsairs  returned  in  triumph  to  Tunis. \nFaithful  to  their  treaty,  so  far,  they  laid  one-fifth \nof  their  spoils  at  the  feet  of  the  Sultan.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-666a2d07e5f8ed23094b",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In this chapter, the intersection of piracy with scholarly discourse and \nstate policy is traced through a period of acute political crisis in Sweden \nin the early years of the eighteenth century. By focusing on one student \ndissertation presented at Uppsala University in 1716, it is argued here that \nSweden's then precarious position necessitated a delicate navigation of \npiracy in both the Baltic and the Mediterranean. While the scholarly \ntraditions of naturallaw provided ample resources to condemn pirates as \nmere sea robbers, this one dissertation illustrates how moral, philosophi- \ncal, and historical arguments could be marshalled in defence of a more \nequivocal attitude to piracy, which also reflected the delicate balancing \nact performed by the Swedish state.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

      {
        "finding_id": "section-f191c9c4aa4ea8e4db1f",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "This Afterword describes some limitations of conceptual histories of \npiracy and critiques the field's enduring emphasis on pirates as hostes \nhumani generis, enemies of all mankind. The volume's chapters show a \nwide range of representations of pirates and move beyond the idea of a \nsingle or uniquely European perspective on piracy that can be compared \nor contrasted with other approaches. The Afterword summarizes key \ninsights from the chapters and sketches several promising trajectories \nin research on piracy, including studies of global patterns of maritime \nviolence, analyses of the spatial and political contexts of piracy, and new \napproaches to piracy in the history of international law.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

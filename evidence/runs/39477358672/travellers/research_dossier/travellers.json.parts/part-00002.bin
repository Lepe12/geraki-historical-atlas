        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "In the year 1546, Kheyr-ed-Din Barbarossa died, \nand to replace him the Sultan Soliman ordered all \nthe mariners in his dominions to acknowledge \nDragut-Reis as their admiral, and to obey him in \nthe same manner as they had obeyed his prede- \ncessor. From this date he was the foremost \ncorsair in the Mediterranean, and the feats which \nwere performed by him showed that the Padishah \nhad not erred in his selection.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

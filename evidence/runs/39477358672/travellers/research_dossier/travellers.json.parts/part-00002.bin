      {
        "finding_id": "section-f2000c1d46a57edb8b8b",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,
          "date": [
            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "The Buccaneers’ history is a singular example of \nhow evil generates evil. The Spaniards destroyed the \nwild cattle, and the hunters turned freebooters. \nSpain discontinued trading to prevent piracy, and the \nadventurers, starved for want of gold, made descents \nupon the mainland. The evil grew by degrees till the \nworm they had at first trod upon arose in their path \nan indestructible and devastating monster of a hun- \ndred heads. First single ships, then fleets, were swept \noff by these locusts of the deep; first, islands were \nburnt, then villages sacked, and at last cities con- \nquered. First the North and then the South Pacific \nwere visited, till the whole coast from Panama to \nCape Horn trembled at the very flutter of their flag. \nThe first Flibustier, Lewis Scott, scared Campeachy \nwith a few canoes. Grognet grappled the Lima fleet \nwith a whole squadron of pirate craft. The Bucca- \nneer spirit arose from revenge, and ended in robbery \nand murder. At first fierce but merciful, they grew \nrapacious, loathsome, and bloody. Their early chiv- \nalry forsook them—they sank into the enemies of God \nand all mankind, and the last refuse of them expired",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/greatpiratesstor0000jose",
          "source_file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",

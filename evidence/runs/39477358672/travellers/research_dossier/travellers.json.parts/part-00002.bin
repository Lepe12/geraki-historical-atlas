      {
        "finding_id": "section-7d719b5144bbe34461aa",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "That Paul III. had good warrant for the pre- \ncautions which he designed to take is not only \ninstanced by the fact of Barbarossa anchoring in \nthe mouth of the Tiber on the occasion of the raid \nwith which we are at present concerned, but from \nwhat had occurred to his predecessor on the Papal \nthrone in 1516. Pope Leo, son of Lorenzo the \nMagnificent, was accustomed to leave Rome in \nthe autumn for hunting, and fishing in the sea, of \nwhich latter pastime he was particularly fond. \nOne of his favourite resorts was the castle of \nMagliana, five miles from Rome, on the banks of \nthe Tiber. On September 18th, 1516, he left \nRome and proceeded to Civita Lavinia, on the \nLaurentian coast. Here he was waited for by \nthe corsair Curtogali, who, with fifteen ships off the \ncoast and an ambush on shore, was ready to carry \nhim off. Curtogali is supposed to have derived \nhis information as to the movements of the Pope \nfrom some traitor about the Papal Court who de- \nsired the downfall of “the fatal House of Medici.”",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 230346,
          "end_char": 231370,
          "start_line": 6070,
          "end_line": 6090,
          "printed_page": null,
          "scan_indexes_0_based": [],

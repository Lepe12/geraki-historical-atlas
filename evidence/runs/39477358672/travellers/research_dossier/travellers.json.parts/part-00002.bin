      {
        "finding_id": "section-d2cef8b375f93c6f1a4a",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Found neither in state archives, nor in pirate memoirs, instead, the inadvert- \nent traces of past predations left their mark on the historical languages of \nthe region's captives, the victims of marauding, and their communities' \nmeans of expression. For instance, the word lanun, now glossed as Malay for \n“pirate,” became common throughout the region. It derives from the ethnic \nname Iranun, or Ilanun, famed for their pan-archipelagic raiding during \nthe late eighteenth and nineteenth centuries from bases in what is now the \nsouthern Philippines.'^ The name \"Tobelo\" strikes a similar chord among \npeople of coastal Sulawesi and parts of the eastern archipelago, though \nit retains its original ethnic overtones, like the names for other notorious \nhistorical pillagers, such as the Vikings and Cossacks. \"Camucones\" and \n\"Tidong\" were names the Spanish used during the sixteenth and seventeenth \ncenturies to label particularly fierce, non-Muslim pirates with bases in \nnortheastern Borneo and western Sulu, now parts of east Malaysia and the \nsouthern Philippines. \"Tidong\" survived for a time as a term for \"pirate\" in \nseveral central and northern Philippine languages, distant from where those \nbases lay, though this sense of it has since fallen out of use.5 These notions \nof pirate, or what we translate with this word, did not rely on differentiating \nthe violence of pirates from the violence of states. Instead, these \"pirates\" \ninhere in the notoriety ofa group's raiding and the traces left by the memory \nof their depredations.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

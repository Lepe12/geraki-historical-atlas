      {
        "finding_id": "section-e38cb719b41454eec44e",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "These insights about the spatial and regulatory contexts of piracy point \nin two further research directions. One is towards an understanding of \nmaritime politics in relation to vernacular political thought and imperial \nconstitutionalism; another is towards a new narrative ofthe history of piracy \nin international law. Perhaps these aspects of repositioning the history \nof piracy smack of overreaching; certainly, their full discussion belongs \nin another venue. But numerous findings in the chapters of this volume \naccelerate these analytical moves.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

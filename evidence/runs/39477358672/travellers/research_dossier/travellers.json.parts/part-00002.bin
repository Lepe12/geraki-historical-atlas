      {
        "finding_id": "section-897c2b24d9545cf4e246",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "With the wars of the late 1660s, the stage was set for a comprehensive \ndiaspora that took Bugis-Makassar people to as diverse places as Siam, \nPoulo Condor, Aceh, and Australia. The forced nature of the diaspora cre- \nated preconditions for a wide range of overseas activities, from peaceful \ncommerce to service as mercenaries to outright piracy. In this chapter, I \nwill look at two geographical cases where Bugis-Makassar people undertook \npiratical activities, and ask how such activities correlated with other types \nof activities, such as commerce or service as auxiliaries. The first case \nis Lombok and Sumbawa in the late seventeenth and early eighteenth \ncenturies. These two islands were brought under Makassarese suzerainty in",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 279706,
          "end_char": 280445,
          "start_line": 5321,
          "end_line": 5330,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",

      {
        "finding_id": "section-1cac9c253a4fd0549dab",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In response to the edited volume’s appeal to revisit the role of maritime \nviolence in asymmetrical settings, this chapter reflects on the contradictions \nbetween the power discourses of land-based elites and the experiences of \nvarious maritime actors and the coastal population. For that purpose, it \ncompares a plethora of sources, mostly produced by land-based authorities, \nin different languages. A central point of departure is that the Filipino- \nSpanish discourse on piracy was co-produced: It entailed European legal \nconcepts, East Asian views of sovereignty and local maritime practices. In \nthis sense, examples from the Filipino coasts and its surrounding waters \ninform us about non-European understandings of piracy and maritime \nsecurity policies and more generally, about the attitudes of land-based \ncentres towards seagoing-people and their efforts to control the ocean. \nWhat was considered maritime violence and who was persecuted for com- \nmitting it? Selected case studies of prominent pirate attacks against what \nis conventionally known as the colonial Philippines will help to answer \nthese questions.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

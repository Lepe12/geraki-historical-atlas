      {
        "finding_id": "section-3730c837b037d9bcbd31",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "In  command  of  the  Penon  d'Alger,  as  it  was \ncalled  by  the  Spaniards,  was  a  valiant  and  veteran \ncavalier,  by  name  Martin  de  Vargas.  For  twenty \nyears,  as  we  have  said,  the  gold-and-crimson  banner \nof  Spain  had  floated  from  its  crenellated  bastions ; \nsince  the  days  of  Pedro  Navarro  it  had  held  its \nown  against  all  comers.  It  must  have  been  with  a \nsinking  heart  that  Martin  de  Vargas  and  his  brave \ngarrison  beheld  the  town  fall  once  again  into  the \nhands  of  Kheyr-ed-Din ;  they  knew,  as  by  this \ntime  did  all  the  Mediterranean  and  the  dwellers \non  the  coast  thereof,  the  implacable  enmit}^  of  the \ncorsair  to  the  Christians,  and  how  short  a  shrift  would \nbe  theirs  should  they  fall  into  his  hands.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

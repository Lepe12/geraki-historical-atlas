      {
        "finding_id": "section-1966dd7c296c55d2bee0",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "A privateering system that had run out of control, whose excesses affected \nvirtually all the nations of Europe, gave rise to a minimal legal consensus \namong the states concerned, which was not only expressed in unilateral \nenactments on privateering, but also in bilateral treaties. By declaring the \nfreelance booty hunter a pirate, these treaties identified the sea robber \nas the common enemy of the community of nations in general and the \nEuropean community in particular. When all sovereigns, without excep- \ntion, ceased to give pirates protection in their harbours (at least officially), \nthe policy of exclusion in the context of the law regulating naval warfare \ncould lead to a kind of legal congruency. The exclusion of the pirate created \na normative compatibility between the individual national systems of \nmaritime law, and this provided an important component for the formation \nof interrelationships in international law. The exclusion of pirates was the \nlowest common normative denominator in a community of nations that was \notherwise profoundly divided. No matter how “anarchical” an international \ncommunity composed of equal, sovereign political units internally disrupted \nby competition, conflict, and the struggle for power was,*? the members \nof this community acted in concert externally (at least theoretically), in \norder to exclude the privateer who no longer had any national attachment",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",

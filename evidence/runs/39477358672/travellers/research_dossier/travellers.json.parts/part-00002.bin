      {
        "finding_id": "section-463010ce6b7c0cb3f46e",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Doria  put  to  sea  with  twenty-two  royal  galleys \nbefore  Dragut  was  aware  of  the  fact.  The  Genoese \nadmiral  heard  that  his  prey  was  at  Jerbah ;  he \nrepaired  thither  without  losing  a  moment,  found \nthat  he  had  been  correctly  informed,  and  anchored \nat  the  mouth  of  the  harbour,  at  a  place  known \nas  La  Bocca  de  Cantara.  Dragut  was  completely \nhemmed  in,  Doria  was  in  such  strength  that  he \ncould  not,  reckless  as  he  was,  attempt  to  force \nthe  passage.  But  as  the  hour  came  the  spirit  of \nthe  corsair  rose  to  answer  the  challenge ;  it  was \none  thing  to  get  Dragut-Reis  into  a  trap,  it  was \nquite  another  to  keep  him  there.  Accordingly,  he \nassembled  all  his  troops,  dragged  cannon  to  the \nmouth  of  the  harbour,  and  opened  so  brisk  a  fire",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/seawolvesofmedit00curruoft",
          "source_file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",

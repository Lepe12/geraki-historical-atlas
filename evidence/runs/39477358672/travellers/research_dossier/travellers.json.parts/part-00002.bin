      {
        "finding_id": "section-4dd977ca9aeb5b32b6d4",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "At key stages throughout the Qing dynasty's long history, well-organized \nand heavily armed pirates rose up to threaten the security and sovereignty \nof the state and well-being of society. For analytical purposes, I divide \nthis section into three periods: (1) early Qing (1630s—1680s); (2) mid-Qing \n(17708-18105); and (3) late Qing (1840s-1910s). While each period had its own \ndistinct characteristics, nonetheless there were certain recurring themes \nacross each period. It should be emphasized, however, that the Qing Empire's \nmaritime policies were never static or unresponsive, but rather continuously \nevolved to meet contingent circumstances and conditions. Over the course \nofthree centuries of rule, the Qing state gradually extended law and made \nclaims of sovereignty beyond the inner ocean.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 467744,
          "end_char": 468551,
          "start_line": 8767,
          "end_line": 8777,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

      },
      {
        "finding_id": "section-dacd6d8d1d4b04f06a58",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Urus had arrogated to himself the title of King \nof Tlemcen, but with his death this shadowy \nsovereignty came to an end, and the Spaniards \nseized upon the province. This, however, did not \navail them much, as the Sultan of Fez sent against \nthem an innumerable army, and they in their turn \nwere dispossessed. It was in the year 1518 that \nUruj fell beneath the pike of Garzia de Tineo, and \nnow the first place in the piratical hierarchy was \ntaken by Kheyr-ed-Din. In this man the genius \nof the statesman lay hidden beneath the outward \nsemblance of the bold and ruthless pirate; ever \nforemost in the fight, strong to endure, swift to \nsmite, he had by now long passed his novitiate, had \nestablished an empire over the minds of men which \nwas to endure until the end of his unusually pro- \nlonged life. With a brain of ice and a heart of \nfire, he looked out, serene and calm, upon the \nturbulent times in which he lived, 2a monstrous \negotist desiring nothing but his own advancement, \nall his faculties bent upon securing more wealth \nand yet more power.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 128273,
          "end_char": 129336,
          "start_line": 3449,
          "end_line": 3470,
          "printed_page": null,

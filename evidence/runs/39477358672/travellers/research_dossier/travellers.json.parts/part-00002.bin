      },
      {
        "finding_id": "section-6957caed7552227aac00",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Already during the following century, however, pirates, in the Ro- \nman imagination, became charged with additional connotations that \nforeshadowed the later, modern European understanding of piracy. The \nCilicians — who were regarded by the Romans as the Mediterranean pirates \npar excellence — were described as exotic outlaws with a weakness for \ndrinking and ostentatious displays of wealth — an image not unlike our \nunderstanding of the classic Atlantic pirates of the seventeenth and early \neighteenth centuries.\" The concept of piracy thus has a long history of a \ndouble and partly contradictory association, both with loathsome and \nsubversive criminals and with colourful and exotic libertarians.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",

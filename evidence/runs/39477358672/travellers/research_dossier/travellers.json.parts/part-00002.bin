      {
        "finding_id": "section-e3154236e6b34e4e2370",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "This structure provides a useful way to think abstractly about piracy \nacross contexts, and how, in similar ways, cross-cutting interpolity po- \nlitical and legal relations structure piracy. Thus, the offing presents an \napt metaphor for the structures of orientation and position that piracy \nquestions raise. Able to distil commonalities among divergent examples, \nthis approach to piracy works not through a static definition, but rather \nthrough an analytical framework for grasping dynamic sets of relations. \nLike the offing, questions of piracy play out in relations between ship and \nshore, and through political, legal, and social claims in which perceiving \npiracy relies, in part, on positionality in this structure of relations. Moreover, \nlike the offing, the term \"pirate\" points towards, or indicates, the opposing \nside of that scaffold's structure. In other words, for the offing, this scaffold \norients one from ship towards shore or from shore towards ship; while for \npiracy, it structures perspectives from within the state to what lies beyond \nsovereignty’s limits, or, conversely, towards the state from beyond its graces.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 233443,
          "end_char": 234588,
          "start_line": 4472,
          "end_line": 4486,

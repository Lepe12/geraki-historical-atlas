        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Pope  and  Emperor,  King,  Duke,  and  Viceroy \nhad  tried  conclusions  with  the  pirates,  and  their \nfleet  and  army  had  melted  away  as  the  mists  melt \nin  the  hot  sunshine  on  the  Mediterranean  ;  truly \nwere  the  descendants  of  the  dispossessed  Moors  of \nC6rdoba  and  Granada  taking  a  terrible  revenge  on \nthose  by  whom  they  had  been  expropriated.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

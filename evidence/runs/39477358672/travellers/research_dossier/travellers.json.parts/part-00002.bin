          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Even so, the attempts to write a more balanced and genuinely global \nhistory of piracy has only just begun, and to date there have only been a \nfew attempts to understand piracy from a cross-cultural point of view. A \npioneering article by Patricia Risso in the Journal of World History in 2001 \nentitled “Cross-cultural Perceptions of Piracy,” attempted to analyse the \ndifferent terms used in the Western Indian Ocean and the Persian Gulf to \nrefer to what Europeans called piracy and privateering.” A few other scholars \nhave followed suit with regard to East and Southeast Asia. Robert Antony",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

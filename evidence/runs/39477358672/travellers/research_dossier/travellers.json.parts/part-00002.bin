          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Combined with the well-published anti-piracy operations ofthe Bourayne \nthe year before, the failed intervention contributed to strengthen the image \nin France of Vietnam as a country teeming with pirates. The image drew on \na discourse that linked piracy both to the unrest in China in the wake ofthe \nOpium War and to the notion that an inclination to piracy was a hallmark of \ncertain, allegedly less civilized, \"races.\" Such views were widespread among \nthe British, for example with regard to the Malays and other ethnic groups \nin the Malay Archipelago, as evidenced by the writings of self-proclaimed \nauthorities on the subject such as John Crawfurd and James Brooke35",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      },
      {
        "finding_id": "section-64026fe0f8b7c54c987f",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Uruj said he would consider the matter. No doubt \nthere were many ways of making profit out of the cargo \ncommitted to one’s care, but the slow gains of honest \nand humdrum business did not commend themselves \nto him. He loved the free and reckless life of a corsair, \nwas glad when there was prospect of a fight, and yearned \nfor the wealth which a successful piratical raid would \ngive a bold fighter and a good seaman.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

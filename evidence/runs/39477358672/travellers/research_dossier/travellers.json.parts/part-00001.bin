      {
        "finding_id": "section-c30e57efd5ed80d8ef71",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "and  he  seized  upon  them  without  distinction. \nWhen  in  the  full  tide  of  his  success  there  was \nbut  one  thing  which  preoccupied  the  mind  of  the \ncorsair,  which  was  to  find  a  ready  market  for  his \nspoils  and  a  convenient  place  in  which  to  rid  him- \nself of  an  embarrassing  number  of  captives.  This, \nhowever,  did  not  present  an  insuperable  difficulty, \nas  we  have  already  seen  in  the  case  of  Curtogali, \nand  a  similar  arrangement  was  carried  out  by \nUruj  Barbarossa  and  his  brother.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

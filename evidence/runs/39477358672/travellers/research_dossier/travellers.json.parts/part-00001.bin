      {
        "finding_id": "section-e2383e00f1888b105d5d",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "In  command  of  the  Penon  d'Alger,  as  it  was \ncalled  by  the  Spaniards,  was  a  valiant  and  veteran \ncavalier,  by  name  Martin  de  Vargas.  For  twenty \nyears,  as  we  have  said,  the  gold-and-crimson  banner \nof  Spain  had  floated  from  its  crenulated  bastions  ; \nsince  the  days  of  Pedro  Navarro  it  had  held  its \nown  against  all  comers.  It  must  have  been  with \na  sinking  heart  that  Martin  de  Vargas  and  his \nbrave  garrison  beheld  the  town  faU  once  again \ninto  the  hands  of  Kheyr-ed-Din  ;  they  knew,  as \nby  this  time  did  all  the  Mediterranean  and  the \ndwellers  on  the  coasts  thereof,  the  implacable \nenmity  of  the  corsair  to  the  Christians,  and  how",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

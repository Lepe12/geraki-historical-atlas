      {
        "finding_id": "section-2c523a890b23d5e1189a",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "The Berber chieftain’s eyes gleamed with satisfaction \nfor a moment and then clouded. It was the rule along \nthe shores of Barbary that corsairs to whom kings \nafforded the hospitality of their ports should pay for this \nconvenience by giving up a fifth of their booty to the ruler \nwho provided them with this ‘ protection.’ But, re- \nflected Mohammed, what would Genoa say if he sheltered \nthis prince of pirates, this ‘ pestilence’ whose ravages had \nwrought destruction among the wealth of the merchants \nof Genoa, to say nothing of those of Venice, the Papal \nStates, and of Spain ?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

      {
        "finding_id": "section-fe5a54dce08c4a3502a0",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "For forty days this wholesale ‘ round up ’of pirates was \ncontinued, with such energy that it was seen that the \nwestern waters were practically cleared of the rovers. \nThere was still a great number in the eastern seas, however, \nwho included the most bloodthirsty and the fiercest of \nthe corsairs. These had sent their families, treasures, \nand slaves into secret fastnesses among the glens and \nprecipices of Mount Taurus, while they themselves, \nmanning their galleys, resolved to join in one last attempt \nto crush their conqueror.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/bookofpirates0000gilb",
          "source_file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
          "start_char": 66333,
          "end_char": 66870,
          "start_line": 1963,
          "end_line": 1972,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

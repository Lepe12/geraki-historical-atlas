      {
        "finding_id": "section-bc78a132e918be463b8c",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "and  to  recollect  how  Barbarossa  had  sooner  or \nlater  always  risen  from  defeat  as  strong  or  stronger \nthan  before;  also  they  recalled  the  fact  that  he \nwas  the  chosen  of  the  Padishah,  and  that  that \npotentate,  the  representative  of  the  Prophet  on \nearth,  would  assuredly  come  to  his  assistance  now \nthat  Tunis,  which  had  been  taken  in  his  name, \nhad  been  reft  from  Barbarossa  by  the  Christians. \nGradually  hope  took  the  place  of  despair,  and \nwhen  the  corsairs  took  to  the  sea  in  the  early \npart  of  the  following  year  it  was  with  renewed \nconfidence  in  both  themselves  and  their  leader.",
        "years_in_scope": [],

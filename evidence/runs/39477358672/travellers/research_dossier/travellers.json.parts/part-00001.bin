      {
        "finding_id": "section-ecf6bc93d07e048e3bc8",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Attending to such evidence, where it exists, is as important to understand- \ning piracy as the writings and practices of slaves are to slavery, and as the \nvoices of women are to our understanding of, well, history. Southeast Asia \nis typical in that records left by agents ofthe state are vastly more abundant \nthan the seemingly non-existent jottings of pirates. Yet, this holds true \nespecially for the colonial state, while indigenous Southeast Asian polities \nand imperial formations left far fewer resources for historical scrutiny. The \nvast region of maritime and coastal Southeast Asia, notorious for piracy in its \npast, remains so even today. Yet, in this region ofinfamously legion pirates, \nscholars have nevertheless found it a challenge to locate sources in Southeast \nAsian languages to illuminate acts that even states considered piratical.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

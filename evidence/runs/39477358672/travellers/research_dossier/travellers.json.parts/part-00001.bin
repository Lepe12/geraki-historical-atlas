      {
        "finding_id": "section-5e48d2bdd9d867455cd1",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "The task of Theodosius was a heavy one, and only \nto be accomplished by energy and patience. It took \nhim two years. The scattered Picts and pirates avoided \nset battles with his forces, so that he was reduced to \nfighting them by means of strong columns sent out in \nvarious directions, whose task it was to hunt down, \nambush, and destroy the cruel raiders. So unwearied \nwas he, and so well did he infuse his sleepless spirit \ninto his lieutenants and soldiery, that by the end \nof the summer of 368 he had cleared the country \nsouth of the Humber and the Dee; and next year, by \nthe same relentless methods, he freed the northern \nlands right up to the Wall, which he repaired and re- \ngarrisoned.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

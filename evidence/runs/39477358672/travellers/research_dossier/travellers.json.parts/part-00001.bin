      {
        "finding_id": "section-7dc8840e91bcf2e3b593",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,
          "date": [
            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "One day Cesar went to a party of the pirates as. \nthey sat after their evening meal and told them he \nwould recite an oration which he had composed. It \nwas a revised version of the final portion of the speech \nwhich he had given in the Forum when he had im- \npeached Antonius Hybrida for corrupt government \nin Macedonia. With all solemnity, while the men \ngaped at him in wonder, he told them that this speech \nhad always dissatisfied him, and, more than any of \nhis other orations, had convinced him that a few ses- \nsions with the great orator Molo at Rhodes—whither \nhe had been proceeding when their rascalities had \nseized his person—were necessary to perfect him in \nthe art of rhetoric.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/greatpiratesstor0000jose",
          "source_file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
          "start_char": 124243,
          "end_char": 124938,
          "start_line": 3261,
          "end_line": 3274,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",

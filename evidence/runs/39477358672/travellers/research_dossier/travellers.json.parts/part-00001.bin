        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "the traders had increased their speed, had stretched \nanother sail, and incited their rowers to greater \nefforts. But the vessels were too heavily laden, and the \nchief merchant, a fat, pursy man, wrung his hands as he \nsaw how swiftly the pirates were lessening the interval \nbetween the boats.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

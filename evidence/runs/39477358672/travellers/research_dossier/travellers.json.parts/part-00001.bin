      {
        "finding_id": "section-4f2651e4f066dce0485f",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "This was the first venture of their reis, or captain, \nSidi ben Muza, son, as they had heard, of the valiant \nMuza, who had been one of the great heroes of their \npeople in the old days when they ruled in Spain. Sidi \nwas but eighteen, but already he had the name of a bold \nand daring mariner, as expert with the bow, the sword, \nand the boarding-iron as with oar and sail. Hitherto \nhe had formed one of the crew of the galleys sailing under \nthe flag of Hajji Reis, a reckless and successful corsair, \nbut now, with the share of booty earned under Hajji, \nand the money and jewels left him by his grandfather, \nTaric ben Abbu, he had bought the brigantine which \nhad just been launched, resolved to begin his own career \nin the campaign of hatred and spoliation against the \nSpaniards, the enemies of his people.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/bookofpirates0000gilb",
          "source_file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
          "start_char": 210347,
          "end_char": 211162,
          "start_line": 5635,
          "end_line": 5649,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

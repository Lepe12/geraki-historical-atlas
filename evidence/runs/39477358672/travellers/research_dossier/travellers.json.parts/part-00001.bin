          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Qing imperium whose laws only slowly stretched beyond the coastline; \nsecond, that of the European empires, which sought to impose their own \nuniversalistic laws over all oceans; and third, that ofthe pirates themselves, \nwho devised autonomous laws on island strongholds in the dark spaces that \nthe state labeled the outer ocean.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

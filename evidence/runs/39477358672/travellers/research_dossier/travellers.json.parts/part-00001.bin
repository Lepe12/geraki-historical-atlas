      {
        "finding_id": "section-bc591d49c30083a5597b",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "There  was  so  much  history  made  at  this  period, \nthe  stage  of  world  politics  was  occupied  by  so \nmany  great,  striking,  and  dazzling  personalities, \nthat  the  Sea-wolves  and  all  they  accomplished \nwere  to  a  great  extent  overshadowed  by  happen- \nings which  the  chroniclers  of  the  time  considered \nto  be  of  greater  importance.  In  this  no  doubt \nthey  were  right  in  the  main ;  but,  in  spite  of  this \nopinion  which  they  held,  we  find  that  time  and \nlagain  the  main  stream  of  events^  is  ruffled  by  the \nprows  of  the  pirate  galleys.  Such  men  as  the \nBarbarossas,  as  Dragut,  and  Ali  Basha  could \nonly  have  been  suppressed  and  exterminated  had \nthe  whole  might  of  Christendom  been  turned \nagainst  them,  for  they  held  in  their  hands  two \nweapons,  the  keenest  and  most  powerful  with \nwhich  to  attain  the  objects  which  they  had  in  view.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

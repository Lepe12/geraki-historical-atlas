      {
        "finding_id": "section-aa16a9bd4625538cc925",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "same time, Walker was critical of the half-hearted efforts by the Company \nwhose military excursions were compromised by financial constraints. \nThis meant that he was able to come up with a more layered understanding \nof the nature of littoral politics. What comes through repeatedly in the \ncorrespondence is his effort to expand the idea of local custom that the \nchiefs were invoking, to include new treaty arrangements, and, thereby, to \npersist in convincing chiefs to give up their habits of predation. It was not \nas though the Resident was unaware of the curious and complex entangle- \nments of local trade, pilgrimage, and piracy, or that the chiefs entertained \nvery different notions of equity. As he put it in one of his letters to Bombay \n(dated 2 December 1807):",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

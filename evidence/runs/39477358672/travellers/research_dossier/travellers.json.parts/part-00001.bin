      {
        "finding_id": "section-ba70cc63fea8e26e33f2",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "On  board  his  galley,  decorated  for  this  occasion \nwith  scarlet  banners,  Barbarossa  himself  directed \nthe  assaulting  line.  Never  before  when  the  battle \nwas  joined  had  the  gallant  corsair  been  known  to \ndraw  back  ;  and  yet  on  this  occasion  he  not  only \nhesitated  but  actually  hauled  off.  The  Venetians \nsaw  to  their  amazement  that  the  expected  attack \nwas  not  to  be  pushed  home;  for  Barbarossa  and \nhis  captains  feU  upon  some  lesser  vessels :  the \nGalleon  of  Venice  was  victorious.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

      {
        "finding_id": "section-f6110e9b7dc5180625a6",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The alleged opposition between piracy and state power is often also much \nless straightforward than it may seem. Maritime raiding and violence were \nregularly central to the accumulation of power, wealth, and state building, \nwhether we look to ancient Greece, medieval Scandinavia, Elizabethan \nEngland, pre-colonial Southeast Asia, or the Chinese coasts in late imperial \ntimes. As the capacity to project sea power and exercise maritime violence \nbecame institutionalized and linked to state building the need to draw a \nborder between licit and illicit violence arose. From this perspective, the \nconcept of piracy understood by definition as illicit violence, applies only \nin relation to a state or system of states (whether real or imagined).*",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 7591,
          "end_char": 8341,
          "start_line": 275,
          "end_line": 284,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",
        "uncertainties": [
          "ORIGINAL_NOT_INSPECTED",
          "SOURCE_GENEALOGY_PENDING",
          "INDEPENDENCE_UNRESOLVED",
          "TOPONYM_AND_USAGE_REQUIRE_SEMANTIC_EXTRACTION",
          "EVENT_DATE_UNRESOLVED",
          "REGIONAL_SCOPE_REQUIRES_REVIEW"
        ],
        "evidence_state": "ACQUIRED",
        "original_inspected": false,
        "verified": false,
        "status": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "lead_type": "SOURCE_SECTION",
        "occurrence_count": 1

      {
        "finding_id": "section-002f1c5893f1cdf8f1a1",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Terror  stalked  abroad  in  Algiers.  No  man  knew \nwhen  his  turn  might  come  after  this  awful  example \nof  what  it  meant  to  incur  the  wrath  of  Barbarossa. \nThe  corsair  gave  orders  for  the  execution  of \nVenalcadi,  who,  it  will  be  remembered,  was  with \nUruj  when  that  warrior  came  by  his  death  ;  but \nVenalcadi  was  popular  among  the  pirates,  and \nthey  connived  at  his  escape.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

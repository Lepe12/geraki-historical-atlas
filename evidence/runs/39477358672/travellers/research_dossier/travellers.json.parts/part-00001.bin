      {
        "finding_id": "section-512b34afbfd11341a3c3",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "end  ;  the  Christians  were  both  outnumbered  and \noutfought,  for  among  them  were  many  who  were \nnot  by  profession  warriors,  whereas  no  man  found \na  footing  among  the  Sea-wolves,  or  was  taken  to \nsea  as  a  fighting  man,  unless  he  had  approved  him- \nself to  the  satisfaction  of  his  captain  that  he  was  a \nvaliant  man  of  his  hands.  We  have  no  record  or \nlist  of  the  dead  and  wounded  in  this  battle,  but \namong  the  latter  was  Uruj,  who  was  severely  hurt. \nNot  so  Kheyr-ed-Din,  who  escaped  scatheless  and \ntook  command  now  that  his  brother  was  incapacit- \nated. The  dead  were  flung  overboard  with  scant \nceremony,  and  the  wounded  patched  up  as  best \nmight  be,  and  then  The  Galley  of  Naples  was  taken \nin  tow,  and  the  corsairs  returned  in  triumph  to \nTunis.  Faithful  to  their  treaty,  so  far,  they  laid \none-fifth  of  their  spoils  at  the  feet  of  the  Sultan.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

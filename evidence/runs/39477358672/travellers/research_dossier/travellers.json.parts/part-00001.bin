      {
        "finding_id": "section-e222ef3ac6d549bc3951",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "as La Bocca de Cantara. Dragut was completely \nhemmed in, Doria was in such strength that he \ncould not, reckless as he was, attempt to force \nthe passage. But as the hour came the spirit of \nthe corsair rose to answer the challenge: it was \none thing to get Dragut-Reis into a trap, it was \nquite another to keep him there. Accordingly, he \nassembled all his troops, dragged cannon to the \nmouth of the harbour, and opened so brisk a fire \non the Christian ships as to compel them to haul \nout of range. These tactics left Doria unaffected; \nthere was but one way out of the harbour, and he \nfelt quite convinced that when Dragut had had \nenough of starvation he would either surrender or \nelse fight a hopeless action. The admiral surveyed \nhis anchored fleet with a contented mind; his \nenemy had been delivered into his hand, he had \nnothing to do now but wait for that final triumph \nof appearing before his master the Emperor with \nthe famous corsair as his prisoner. He saw a \ngreat fort rising before his very eyes at the mouth \nof the harbour, and merely smiled serenely ; he \nsent off to Sicily and Naples for reinforcements in \norder that when the psychological moment should \narise he might crush the corsair stronghold so \nthoroughly that it should never rise again. In \nthe despatches which he sent he said “the fox is \ntrapped ”—“ which news rejoiced all parts of \nChristendom, and most powerful succours came \ndaily flocking to the seaports from every quarter ; \nso eager were the sufferers to revenge themselves \non this so much dreaded corsair.”",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 442938,
          "end_char": 444501,
          "start_line": 11396,
          "end_line": 11427,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false

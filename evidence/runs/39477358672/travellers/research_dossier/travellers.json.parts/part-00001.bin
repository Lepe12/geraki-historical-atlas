      },
      {
        "finding_id": "section-77285162c14c961d4a51",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,
          "date": [
            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "Then for some time he exerted all his gifts of elo- \nquence upon the group of wretches before him. \nWith every addition of fine phrasing, noble gesture, \nand telling intonation, he strove to make them realize \nthe force of the arguments by which he sought to \nprove how utterly evil and injurious to the State had \nbeen the actions of the governor in taking bribes from \nsuitors and from merchants and in robbing travellers \nof their goods. But all his efforts were in vain: the \npirates were not impressed in the least, and even \nlaughed at him, and half-way through his oration",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",

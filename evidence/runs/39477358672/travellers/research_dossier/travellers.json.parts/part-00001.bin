      {
        "finding_id": "section-872f91ef124143944a0c",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "some  150  galleys,  81  Venetian,  36  Pontifical,  and \n30  Spanish ;  Charles  V.  sent,  at  the  last  moment, \n50  ships  on  which  were  embarked  10,000  troops. \nThe  force  totalled  altogether  59,000  to  60,000  men, \n195  ships,  and  2,594  cannons.  This  was  no  doubt \na  most  formidable  armada,  but  the  pohcy  of  those \nby  whom  it  was  composed  was  not  all  directed \nto  the  same  end.  While  Charles  desired,  above  all \nthings,  to  exterminate  the  corsairs  for  good  and  all, \nwhich  was,  in  the  circumstances,  the  only  sound \nview  of  the  matter,  the  Venetians  were  for  fighting \ndefensive  actions  to  maintain  their  supremacy  in \nthe  Ionian  Islands,  and  were  disposed  to  let  the \nfuture  take  care  of  itself.  There  was  not,  in  con- \nsequence, that  absolute  unanimity  among  the \nvarious  commanders  of  the  expedition  as  was \nnecessary  for  its  complete  success.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

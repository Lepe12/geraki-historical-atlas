      {
        "finding_id": "section-274d38e3ec76a7cc626e",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "In May 1701 Captain Kidd and nine of his crew were \nbrought to trial at the Old Bailey. All of the accused \nwere found guilty except three, who proved that they \nwere apprentices and therefore not free agents. There \nwere two trials. At the first the men were charged with \nacts of piracy on the high seas, but it appears that Kidd \nwas charged only with the murder of the gunner, Moore. \nThis was in order to prevent him going into the question \nof his commissions, whereby he might have been able to \nmake some very awkward revelations as to the noble \nlords who had been behind him.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/bookofpirates0000gilb",
          "source_file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
          "start_char": 481866,
          "end_char": 482451,
          "start_line": 12339,
          "end_line": 12349,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

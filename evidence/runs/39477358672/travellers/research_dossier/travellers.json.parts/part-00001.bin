      {
        "finding_id": "section-b125a817cbd5d927f32f",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Uruj  Barbarossa,  Kheyr-ed-Din  Barbarossa, \nDragut  Reis,  and  Occhiali,  or  Ali  Basha,  were \nmen  who,  in  the  sixteenth  century,  did  much  to \nchange  the  conditions  of  the  times  in  which  they \nlived :  it  was  the  time  of  the  Renaissance  in  Europe, \na  period  of  splendour  in  all  the  arts  and  sciences. \nThese  men  added  nothing  to  the  knowledge  of  the \ncivilised  world  as  it  then  existed,  save  and  except \nin  one  particular,  which  was,  as  Kheyr-ed-Din \nexplained  to  S oilman  the  Magnificent  on  a  certain \nmemorable  occasion,  that  he  who  rules  on  the  sea \nwill  rule  on  the  land  also.  In  the  present  day, \nwhen  all  the  nations  and  languages  sit  at  the  feet \nof  Captain  (now  Rear-Admiral)  Mahan,  and  ac- \nclaim his  \"  Sea  Power \"  series  of  books,  it  is \ninteresting  to  find  that  he  was  anticipated  in  the \nmost  practical  fashion  possible  by  a  corsair  of \nthe  sixteenth  century.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Barbarossa  had  succeeded  in  assembling  122 \nships.  He  was  accompanied  by  all  the  most  famous \ncorsairs  of  the  day,  among  whom  was  Dragut, \nwho  fell  at  the  siege  of  Malta,  and  of  whom  we \nshall  have  more  to  say  in  due  time.     Far  and  wide",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "The  Emperor  Charles  V.  was  roused  to  action, \nstung  by  the  intolerable  humiliation  of  the  posi- \ntion into  which  he  had  been  placed  by  a  mere \ncorsair.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

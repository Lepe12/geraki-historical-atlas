      {
        "finding_id": "section-8a61ce501a227aef07db",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The findings I have surveyed illustrate several new directions in histories \nof sea raiding in general, and piracy in particular. Many of the chapters \npointto the importance of histories of piracy for understanding the spatial \ndimensions of sea raiding and its regulation. Others open new vistas on the \npolitics of piracy and its relation to processes of forming and sustaining \nvarieties of political communities across the globe. Still others support \nthe movement towards new approaches to the history of international law.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 717380,
          "end_char": 717909,

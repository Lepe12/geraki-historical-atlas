      {
        "finding_id": "section-082d0f6b31987fe11159",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "There  remained  for  an  appreciable  period  after \nhe  had  spoken  a  tense  silence ;  the  red  light  from \nthe  burning  houses  shone  on  the  lean  faces  alight \nwith  the  fierce  fire  of  fanaticism,  with  an  in- \nextinguishable lust  of  slaughter.  There  came  an \nanswering  frenetic  roar,  \"  Lead  I  Lead  !  Dragut  I \nDragut !  Dragut  1 \"  It  was  enough  :  the  corsair \nhad  tried  the  temper  of  the  steel,  he  had  now  but \nto  use  the  edge.     There  was  an  ordered  movement",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

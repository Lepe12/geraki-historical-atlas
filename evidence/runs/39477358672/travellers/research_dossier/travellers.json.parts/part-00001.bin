      {
        "finding_id": "section-0068596950ccc732c306",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "The  practical  retirement  of  Barbarossa  from  that \nsphere  of  activity  in  which  his  life  had  been  passed \nnOw  left  Dragut-Reis  the  most  feared  and  the \nmost  formidable  of  all  the  Moslem  corsairs  in  the \nMediterranean.  From  the  time  of  his  release  by \nBarbarossa  until  the  day  of  his  death  at  the  siege \nof  Malta  in  1565,  he  followed  the  example  shown \nhim  by  that  prince  among  pirates  with  so  much \nassiduity  as  to  render  him  only  second  to  Kheyr- \ned-Din  in  the  detestation  in  which  he  was  held.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

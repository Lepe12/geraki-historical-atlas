      {
        "finding_id": "section-b6b645fd21672c9d9fc4",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Preparations for the voyage were immediately \nbegun, and, as an earnest of the new importance \nwhich he derived from the advances of Soliman, \nthe corsair actually sent presents to the King of \nFrance and proffered him his aid against his \nenemies. To such a pass as this had one of the \nmost powerful monarchs in Christendom been re- \nduced by the defection of Andrea Doria. Algiers",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

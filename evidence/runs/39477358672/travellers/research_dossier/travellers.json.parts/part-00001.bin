        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Sardinia had ceased to yield up either booty or \nslaves the fleet sailed for Tunis, where it arrived \nbefore Bizerta on August 15th. The arrival of \nthe corsairs was totally unexpected, and caused \nthe greatest consternation. The story which \nBarbarossa had told to Sultan Soliman concerning \nthe reigning King Muley Hassan was correct in \nevery detail, and there is no doubt that he was \na bloody and cruel tyrant of the worst description.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

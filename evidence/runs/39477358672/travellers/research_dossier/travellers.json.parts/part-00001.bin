      {
        "finding_id": "section-07e124a761ec93baddf9",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Like Kheyr-ed-Din Barbarossa, Ali was now lord \nof Algiers and Tunis, and as he was, for a corsair, \na man of wide views, he treated his new subjects \nwith consideration. He made, however, one curious \nmistake not to have been expected from one so \npolitic: he demanded tribute from the tribes of \nthe hinterland. In those days, particularly in \nNorthern Africa, men paid tribute to an overlord",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 570913,
          "end_char": 571307,

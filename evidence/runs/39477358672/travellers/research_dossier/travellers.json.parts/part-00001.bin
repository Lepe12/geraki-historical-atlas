      {
        "finding_id": "section-5794f9c0393e5aa55bdb",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Pirate oaths can be understood as deliberately subversive, marking their \ndiscourse as both uncivil and illegal under existing British statutes (which \nimposed fines for public swearing), freely made in defiance of authority. \nPirate oaths were the most “uncivil” of vocal expressions because they \nwere not made to affirm a hierarchy of moral, spiritual, or political author- \nity. Rather, they affirmed the radical autonomy of the individual from \nthose hierarchies. Pirate oaths, like those of the cruel and \"sacrilegious\" \nl'Olonnais, affirmed individual judgement as the sole criterion, disdaining \nGod's authority. When that \"cruel Tyrant\" l'Olonnais thought he had been \nled astray in the jungle by his Spanish captives, he swore “with great choler \nand indignation: ‘By Gods Death, the Spaniards shall pay me for this.\"59 If \nLocke ever saw such instances as evidence for his own view of piracy, he \noverlooked Exquemelin's counter-examples. Even the pitiless l'Ollonais was \nsaid to have given his word to the request of some Spanish inhabitants of \na besieged town to be given two hours to evacuate.^? The two hours being \ngiven and scrupulously obeyed for the duration, the poor Spaniards were \nnonetheless looted upon the expiry of time. More significant perhaps, \nis the emphatic evidence that oaths among the pirates themselves were \nconsidered as binding on the individual pirate as any sacred promise. \nExquemelin described the buccaneers of the Caribbean adopting the \npractice of making a “solemn Oath” that all their pillaged goods were \nsurrendered for redistribution according to the system of shares, and should \nany of them be found to have \"contraven'd the said Oath, immediately he \nis separated and turned out ofthe society.”™ Here is unequivocal evidence \nof the egalitarianism and consent of pirate political order. Pirate order \ndid not only consist in pure rebellion, or in sacrilegious oath-making, or \nextortionate robbery, but in the reconstitution of an egalitarian social and \npolitical structure based on a form of consent much more radical than \nLocke could abide.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 182461,
          "end_char": 184562,
          "start_line": 3498,
          "end_line": 3526,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",
        "uncertainties": [
          "ORIGINAL_NOT_INSPECTED",
          "SOURCE_GENEALOGY_PENDING",
          "INDEPENDENCE_UNRESOLVED",
          "TOPONYM_AND_USAGE_REQUIRE_SEMANTIC_EXTRACTION",
          "EVENT_DATE_UNRESOLVED",
          "REGIONAL_SCOPE_REQUIRES_REVIEW"

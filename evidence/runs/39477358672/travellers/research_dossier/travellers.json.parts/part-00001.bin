      {
        "finding_id": "section-371c9f42b888cecd3142",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "When we of the present day read of the deeds \nof the corsairs we are filled with horror, we fail \nto understand how such things could have been \ntolerated, we seek for some explanation. When \nwe hear of a “ League of Christian Princes,” and \nfind that all its members could accomplish was to \nturn their arms the one against the other, we are \neven still more puzzled. What was it, then, that \nlay at the root of this problem? The answer \nwould appear to be in the ethical standpoint of \nthe sixteenth century. We are so accustomed in \nthe present day to hear of the rights of man that \nwe are apt to forget that, in the time of Barbarossa, \nof Dragut, of Charles V., and the Medicean \nPopes such a thing did not exist, and the only \nrights possessed by the common man were those",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

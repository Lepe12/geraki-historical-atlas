      {
        "finding_id": "section-fd4eec06b49d5dbc57e7",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  ambition  of  Dragut  increased  with  his  power, \nand  he  determined,  following  the  example  of  the \nBarbarossas,  to  seize  and  hold  some  strong  place  of \narms  possessed  of  a  commodious  port  in  which  he \nmight  be  the  supreme  ruler.  Accordingly,  in  the \ndepth  of  winter  in  the  year  1548,  at  a  time  which  was, \nas  we  have  pointed  out,  a  close  season  for  piratical \nenterprises,  and  during  which  attack  from  the  sea  was \nnot  expected,  he  collected  all  the  corsairs  whom  he \ncould  gather,  and  fell  upon  the  Spaniards  on  the \ncoast  of  Tunis,  at  Susa,  at  Sfax,  and  at  Monastir. \nThese  places  had  been  taken  from  the  corsairs  in  the \nprevious  summer  by  Andrea  Doria  ;  they  formed  a \nsort  of  regular  battle-ground  when  the  combatants \nwere  in  want  of  something  to  do,  and  were  held  alter- \nnately by  the  King  of  Tunis,  the  Spaniards,  and  the \ncorsairs.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

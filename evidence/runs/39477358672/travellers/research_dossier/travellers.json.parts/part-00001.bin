      {
        "finding_id": "section-fee3cb4df187e1015d00",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "A similar view of piracy as linked to race developed among the French with \nregard to the Vietnamese during the second half of the nineteenth century. \nFor example, according to Henry Frey, a colonel in the Marine Infantry, who \nserved for several years in Vietnam: \"The number of Vietnamese and Chinese \nwho engage in piracy in Tonkin [northern Vietnam] is considerable. Above \nall, the taste for plunder and pillage [...] assumes this particular character",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

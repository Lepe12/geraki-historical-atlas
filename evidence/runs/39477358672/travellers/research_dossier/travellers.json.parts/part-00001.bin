      {
        "finding_id": "section-47fd6dcb4f328c577441",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "In  character,  in  capability,  in  strategic  insight,  in \ntactical  ability,  not  one  of  the  predecessors  or  the \nsuccessors  of  Kheyr-ed-Din  Barbarossa  can  be  com- \npared to  him ;  he  was  the  greatest  and  most  out- \nstanding figure  of  all  those  corsairs  of  whose  deeds \nwe  hear  so  much  during  the  sixteenth  century,  the \nman  above  all  others  who  was  feared  and  hated  by \nhis  contemporaries  in  Christendom.     He  lived,  as \nwe  have   said,   for  another   eight  years  after  the \nbattle  of  Prevesa,  but  his  great  age  prevented  him \nfrom  pursuing  a  very  active  career.     There  were, \nhowever,  other  and  younger  men,  trained  in  the \nterrible  school  of  hardship  in  which  his  life  had  been \npassed,  who  proved  themselves  to  be  his  very  worthy \nsuccessors,  even  if  they  did  not  display  the  same \ngenius  in  war  and  statecraft.      The  conditions  of \nthis   period   are    somewhat    remarkable   when  we \ncome  to  consider  them ;  Europe,  which  had  been \nsunk  in  a  rude  and  uncultured  barbarism  during \nthe  middle  ages,  was  emerging  under  the  influence \nof  the  Renaissance  into  a  somewhat  higher  and  nobler",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-6384dc1125fdd011c0a3",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "That  cool  calculator  of  the  chances  of  hfe  knew \nthat  this  must  be  so ;  the  power  of  the  corsairs \ngenerally  had  received  the  worst  blow  it  had  ever \nencountered  since  the  dispossessed  Moriscoes  had \ntaken  to  the  sea  for  a  living ;  those  of  them  who \nremained  alive  were  without  ships — that  is  to  say, \nwithout  their  only  means  of  making  a  livelihood — \nand  that  they  should  gravitate  towards  Algiers \nand  its  master  was  as  nearly  a  certainty  as  any- \nthing human  could  be.     And,  as  was  anticipated",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

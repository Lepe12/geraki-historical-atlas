      {
        "finding_id": "section-d132709e806d33d16018",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,
          "date": [
            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "a ship coming with full sail towards the shore. They \nconcealed themselves, lest they should prevent her \nfrom approaching, and deliberated what steps it would \nbe advisable for them to take. Some were of opinion \nthat they should beseech the officers to take them on \nboard: others were apprehensive of their liberty; and, \nfearing yet greater danger, wished to prepare for self- \ndefence. Alexander proceeded yet further: in his \nopinion, it was of little use to defend themselves; \nthey ought to make an attack, and with his proposal \nthey all coincided. In the meantime the ship, cast an- \nchor: it was a Spanish merchantman, armed for war, \nwhose crew were in want of water, which they had \ncome to procure from that island, where it was excel- \nlent. The officers were far from suspecting that any \nPirates were there; but, knowing the treachery of the \nislanders, they directed those, who were to fill the \nhogsheads, to advance with very great caution, and \ngave them an escort of their best soldiers, of whom \nthey took the command in person.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/greatpiratesstor0000jose",
          "source_file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
          "start_char": 224752,
          "end_char": 225803,
          "start_line": 5685,
          "end_line": 5704,
          "printed_page": null,
          "scan_indexes_0_based": [],

      {
        "finding_id": "section-e55c4a2c02a370a04fa9",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The origins of modern international law are frequently sought in the Early \nModern period, and piracy has often been accorded a major role in this \ndevelopment, as well as in the emergence of an international system of \nstates. The chapter highlights how internationallaw developed through \na process that Kempe calls \"integration by exclusion.\" Specifically, the \nauthor focuses on the piratical exploits and subsequent trial of John \nCusack, executed in 1675. The case illustrates how accusations of piracy \nasa crime against all nations was a central element in the emergence of \ninternational law in Europe and in the establishment of England's claim \nto bean effective global sea power. This demonstrated its ability to project \nits jurisdiction at sea far beyond the country's shorelines.",
        "years_in_scope": [
          1675
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

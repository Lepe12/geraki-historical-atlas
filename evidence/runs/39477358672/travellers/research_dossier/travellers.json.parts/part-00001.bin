        "file": "marine-et-marins-alger-version-al-futuhat.-com_Marine_et_Marins_Alger-Version-AlFutuhat.Com_djvu.txt",
        "title": "Marine Et Marins Alger Version Al Futuhat. Com",
        "url": "https://archive.org/details/marine-et-marins-alger-version-al-futuhat.-com",
        "source_bibliography": {
          "creator": [

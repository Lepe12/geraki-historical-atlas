      {
        "finding_id": "section-85e6be79adaca04a767c",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Sardinia  had  ceased  to  yield  up  either  booty  or \nslaves  the  fleet  sailed  for  Tunis,  where  it  arrived \nbefore  Bizerta  on  August  15th.  The  arrival  of \nthe  corsairs  was  totally  unexpected,  and  caused \nthe  greatest  consternation.  The  story  which \nBarbarossa  had  told  to  Sultan  Soliman  concerning \nthe  reigning  King  Muley  Hassan  was  correct  in \nevery  detail,  and  there  is  no  doubt  that  he  was \na  bloody  and  cruel  tyrant  of  the  worst  description.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

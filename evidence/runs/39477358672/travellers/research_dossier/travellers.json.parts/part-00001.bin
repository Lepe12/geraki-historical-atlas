      {
        "finding_id": "section-f98c8a1eedcbf64f63bf",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "There was no need to lay up the ships at any time while \nthey were in the Middle Sea, for there wasno winter. The \nvikings would, however, rest awhile now and then, and, \ndragging their boats up the sand in the mouth of some \ncreek or river, they would make a camp and trade with \nthe people of the country, or, tiring of the softening life, \nthey would go fighting among the Moors, the Frenchmen, \nor Italians, burning villas and towns, or setting them to \nransom, in the very places and in the very manner in \nwhich the pirates of Cilicia had acted some nine hundred \nyears before.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/bookofpirates0000gilb",

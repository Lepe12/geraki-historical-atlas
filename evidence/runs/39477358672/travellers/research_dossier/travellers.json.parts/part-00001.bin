      {
        "identifier": "cia-readingroom-document-cia-rdp08c01297r000300180010-1",
        "title": "CIA Reading Room cia-rdp08c01297r000300180010-1: SOVEREIGNTY CLAIMS IN THE SOUTH CHINA SEA",
        "creator": "CIA Reading Room",

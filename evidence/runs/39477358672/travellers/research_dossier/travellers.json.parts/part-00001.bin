      {
        "finding_id": "section-d855b3a6f6d2492544bc",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "stumbled,  was  struck  on  the  head  with  another \nweapon ;  he  reeled  and  fell.  The  fight  was  over, \nand  one  of  the  Barbarossas  bit  the  dust.  Garzia \nde  Tineo  leaped  upon  the  fallen  man  and  cut  off \nhis  head.  It  is  recorded  that  Garzia  de  Tineo  was \nwounded  in  the  finger  by  Uruj  in  the  course  of  the \ncombat,  and  that  for  the  rest  of  his  life  he  proudly \nexhibited  the  scar  as  a  sign  that  it  was  none  other \nthan  he  who  had  killed  the  famous  corsair.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-072462d372c6c46b4dfe",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "because  he  was  stronger  than  they ;  because  retri- \nbution followed  swiftly  and  suddenly  upon  refu- \nsal. To  order  tribute  to  be  paid  without  being \nready  to  strike  was  merely  to  expose  the  man \nmaking  the  demand  to  derision.  Particularly  was \nthis  the  case  with  the  fierce  land-pirates  of  the \ndesert,  whose  habit  it  was  to  exact  and  not  to  pay \ntribute.  To  Ali  the  Sheiks  replied  that  \"  if  he \nwanted  tribute  from  them  he  must  demand  it  lance \nin  hand  in  the  field,  for  there  and  nowhere  else \nwere  they  accustomed  to  pay  :  that  their  coin  was \nsteel  lance-heads  and  not  golden  aspers.\"  After \nthis,  says  Morgan,  \"the  Basha  thought  it  well \nto  dissemble.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/cu31924087978445",
          "source_file": "cu31924087978445_cu31924087978445_djvu.txt",

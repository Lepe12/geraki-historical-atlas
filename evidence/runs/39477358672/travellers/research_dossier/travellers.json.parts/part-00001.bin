      },
      {
        "finding_id": "section-1503fbecc977e094127b",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "It is evident that Kidd’s irregular proceedings in the \nEastern seas had raised up powerful enemies against him, \nbut as he had been sent out by other equally powerful \nfriends, and as persons in high places had found the \ncapital for his expedition, it was sought to punish him \nwithout bringing to light the names of those who were \nassociated with him in the enterprise. His doings on \nthe Indian seas had frightened the merchants trading \nthere, and they caused questions to be asked in Parlia- \nment, and some investigations were accordingly made \ninto the commissions which had been given to him. \nThe result of all this was to incense Lord Bellamont and \nthe other highly placed men against Kidd, since the \ninvestigations made them appear to be aiders and abettors \nof a man whose dealings were very like those of a pirate.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

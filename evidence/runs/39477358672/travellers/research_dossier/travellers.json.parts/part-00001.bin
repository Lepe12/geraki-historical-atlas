      {
        "finding_id": "section-f6ddf16aaf62f0e187a4",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "pirates  ;  but  their  exploits  were  so  daring,  the  con- \nsequences thereof  were  so  far-reaching,  that  the \nominous  crimson  thread  had  to  be  woven  into  any \nnarrative  of  the  times  in  despite  of  the  annoyance \nof  the  man  by  whom  the  rope  was  twisted.",
        "years_in_scope": [],

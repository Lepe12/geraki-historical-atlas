      {
        "finding_id": "section-ca2b1bfa6b67fc747499",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The present chapter is an attempt to respond to recent attempts at question- \ning the Eurocentric bias in depictions of maritime power and violence in a \nperiod of European expansion. It takes its cue from new and significant work \ndone on the idea of legal pluralism in maritime spaces, on non-European \nconceptions of power and jurisdiction at sea, and on the value of using \npiracy as a lens for understanding the articulation of sovereignty.' As the \ntitle indicates, the chapter focuses on both the materiality of maritime",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

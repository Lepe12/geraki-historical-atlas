      {
        "finding_id": "section-627b15657a1e64bd22f0",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Personal  pique  and  vanity,  racial  detestation,  and \nreligious  fanaticism  were  in  his  case  all  allied \ntogether  to  spur  him  on  in  the  chase  of  this  the \nlast  of  the  Emperor's  foes ;  but,  search  as  he \nmight,  during  that  summer  Doria  could  never  get \non  to  the  track  of  Dragut.  The  corsairs,  as  we \nhave  just  remarked,  were  fine  fighters  on  occasion \nwhen  it  was  necessary  for  the  purposes  of  loot,  or \nof  escape  from  those  who,  like  Doria,  interfered \nwith  their  particular  method  of  gaining  a  liveli- \nhood ;  but,  on  the  other  hand,  they  were  no  fools, \nthey  did  not  covet  hard  knocks  and  the  possi-",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-0c1b581bc191e03cfb6a",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Terror stalked abroad in Algiers. No man knew \nwhen his turn might come after this awful example \nof what it meant to incur the wrath of Barbarossa. \nThe corsair gave orders for the execution of \nVenalcadi, who, it will be remembered, was with \nUruj when that warrior came by his death; but \nVenalcadi was popular among the pirates, and \nthey connived at his escape.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

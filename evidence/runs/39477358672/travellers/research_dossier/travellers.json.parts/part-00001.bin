      {
        "finding_id": "section-7382100579291aa6a623",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Suddenly the flash of a lantern gleamed on the poop \nof the galley, and voices rose in quick question and \nanswer. At the same moment Sidi’s silver whistle rang \nout. With a shudder the brigantine scraped the side \nof the galley and the pirates swarmed over the poop. \nInstantly there arose the fierce turmoil of fighting. \nThe Spanish officers, though taken wholly by surprise, \nfought bravely ; the soldiers sleeping in the vambades, \nhearing the alarm, started up and made to run along \nthe gangway between the rowing benches, but the first \nwere struck down in the darkness by they knew not what, \nand those who hesitated quickly perceived that the first \nfew benches were empty. Then arose the dreadful cry \nwhich, once heard, struck terror into the hearts of all \nSpaniards on a galley: ‘“‘ The slaves are free! The \nslaves are free!”",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-e1026055a575ad7675dc",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "It  was  against  his  better  judgment  that  Kheyr- \ned-Din  at  last  yielded ;  the  men  were  backing  up \ntheir  officers,  a  spirit  of  disaffection  was  abroad \nin  the  armada :  such  a  thing  as  this  a  wise  chief \nmust  gauge  at  its  true  value,  and  stop  before  it \ngoes  too  far.  The  Osmanli  were  murmuring  against \n\"  the  corsair  \"  ;  it  was  time  to  let  them  see  whether \nthey  or  their  war-worn  leader  possessed  the  greater \nwisdom.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

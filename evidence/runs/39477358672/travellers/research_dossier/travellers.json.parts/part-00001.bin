      {
        "finding_id": "section-b3ac41d98ed26961764d",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Soon afterward Kidd, having placed some of his men \non the prize, sailed for Madagascar, where he fell in with \na pirate ship named the Resolution, commanded by \nCaptain Culliford. Kidd proposed to seize this vessel \nunder his commission, but, on broaching the design to \nhis men, they demurred, and on pressing it they threat- \nened to mutiny and to shoot him. Culliford and his men \nappear to have expected nothing less than capture at the \nhands of Kidd, and were agreeably surprised when he \nand his men fraternized with them.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "(receptatores), are anathematized.'? What was assumed here was that pirates \nwere indiscriminate in attacking anybody, regardless of origin, nation, \nor religion. But it was also sufficient cause for the anathema if the pirate \ncruised the seas with the intention of plundering people from one nation, \nfor example if French pirates preyed on the Portuguese alone.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

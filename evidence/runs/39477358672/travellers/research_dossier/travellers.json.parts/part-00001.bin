      {
        "finding_id": "section-e2f80d53cf92932fcaec",
        "file": "journalofvoyagei00digbiala_journalofvoyagei00digbiala_djvu.txt",
        "title": "Journal of a voyage into the Mediterranean",
        "url": "https://archive.org/details/journalofvoyagei00digbiala",
        "source_bibliography": {
          "creator": [
            "Digby, Kenelm, Sir, 1603-1665",
            "Bruce, John, 1802-1869"
          ],
          "date": [
            "1868-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "d2defe6ff388b631877f74b1fb4b681f503d63d34637330ce13bec173be3c0b1",
        "evidence_excerpt": "Sir  Everard  was  so  entirely  blind  to  the  moral  character  of  the \naction  upon  which  he  had  embarked  as  to  be  astonished  and  shocked \nwhen  he  found  that  even  \"  Catholics  and  priests  \"  condemned  the \nmeans  resorted  to  by  the  conspirators  as  \"a  great  sin.\"  He  began, \nunder  such  circumstances,  even  to  question  his  own  \"  good  state,\" \na  consideration  which  overwhelmed  him  with  \"more  bitterness  of \ngrief \"  than  all  his  other  miseries.  Such  is  his  own  statement  in \nprivate  letters  which  he  found  means  to  have  conveyed  from  the \nTower  to  his  friends.f  He  afterwards  either  settled  his  mind  to  a \ncontrary  conclusion  upon  this  point,  or  did  not  care  to  make  so  large \nan  admission  to  the  audience  assembled  around  his  scaffold.  To  them \nhe  declared,  even  at  the  moment  of  his  death,  that  \"  in  respect  of  his \nreligion  \"  he  held  the  action  for  which  he  was  about  to  suffer  to  be \n\"  no  offence,\"  although,  in  respect  of  the  law,  it  was  otherwise.!",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/journalofvoyagei00digbiala",
          "source_file": "journalofvoyagei00digbiala_journalofvoyagei00digbiala_djvu.txt",
          "start_char": 8405,
          "end_char": 9501,
          "start_line": 198,
          "end_line": 211,
          "printed_page": null,

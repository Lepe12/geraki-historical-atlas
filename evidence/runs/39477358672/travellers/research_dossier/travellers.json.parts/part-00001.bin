      {
        "finding_id": "section-4366ce827754d889bd9d",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Casting about for a suitable commander to place in \ncharge of The Adventure Galley, Bellamont bethought him \nof a man whom he had met in the West Indies, named \nCaptain Kidd, or Kid, who had commanded a privateer in \nthose seas, who knew the haunts and habits of the pirates, \nand who, moreover, had the reputation of being a good \nseaman and a bold leader. To give the affair a legal \nappearance, the King’s commission was procured for \nKidd, whereby “our trusty and well-beloved Captain \nWilliam Kid,” was given “full power and authority to \napprehend, seize and take into custody, certain wicked \nand ill-disposed persons, to wit, Captain Thomas Too, \nJohn Ireland, Captain Thomas Wake, and Captain \nWilliam Maze, or Mace,” who had associated themselves \nfor the purpose of committing “‘ many and great piracies, \nrobberies and depredations on the seas upon the ports of \nAmerica, and in other ports, to the great hindrance and \ndiscouragement of trade and navigation, and to the great \ndanger and hurt of our loving subjects,” etc. etc.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

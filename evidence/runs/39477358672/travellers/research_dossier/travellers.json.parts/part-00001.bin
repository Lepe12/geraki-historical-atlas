      {
        "finding_id": "section-4f782c8fbbb268ce1e7e",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The Grand Pyrate's presentation of Cusack as the enemy of humankind \nfreely blended fact and fiction. It was built on the ascription of negative \nattributes to his personal character and behaviour. It was said that Cusack \nwas always aggressive and treacherous, that he had stolen £6 and a watch \nfrom a close relative as a child.“ Furthermore, he was accused of blatant \natheism and contempt of God, symbolized by the renaming ofthe Sáo José as \nFlying Devil. Moreover, when some ofhis pirates supposedly tried to prevent \nhim from throwing the Hopewell's ship Bible overboard, he is said to have \ncalled out to them, “You Cowards, what do you think to go to Heaven and \ndo such Actions as these? No, I will make you Officers in Hell under me.” \nHe was also regarded as immoral and totally antisocial. In New England, he \napparently even cheated his own crew of their share of the booty.°3 Some \neven went as far as to accuse him of breaking sexual taboos. After his escape \nfrom arrest, he was supposedly rearrested in the bed of a woman whom \nsome claimed to be his sister.9",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 113874,
          "end_char": 114951,
          "start_line": 2215,
          "end_line": 2229,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

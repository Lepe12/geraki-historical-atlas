      {
        "finding_id": "section-3b066bd5f21ae2581cf3",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "unexampled  cruelty,  a  prototype  of  those  other \ncorsair  kings  by  whom  he  was  succeeded.  But  the \nreal  source  of  his  power  lay,  not  in  stone  walls  and \nfortifications,  nor  in  ill-trained  levies  of  African \ntribes,  but  in  his  own  genius  for  command  at  sea, \nand  the  manner  in  which  he  was  able  to  inspire \nwith  his  own  dauntless  and  desperate  spirit  those \nhardy  mariners  who  followed  in  his  train,  the \ndescendants  of  the  \"  Moriscoes  \"  who  hailed  from \nthe  ancient  Moorish  kingdoms  of  Cordoba  and \nGranada.",

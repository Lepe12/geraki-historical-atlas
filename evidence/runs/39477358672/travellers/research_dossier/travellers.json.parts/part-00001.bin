      {
        "finding_id": "section-2cdaf1baca779762d30c",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Now, as Elphin walked home he thought that, maybe, \nWulf had felt that he could not allow those pirates to be \ncut off and massacred without trying to warn them. \nAfter all, they were his own kin, and spoke the Saxon \ntongue, which he still remembered, though he had rarely \nspoken it during these seven years. And therefore, \nmaybe, he had run back along the causeway and warned \nthe pirates guarding the boats and had gone off with them. \nElphin was depressed to think that he had lost Wulf in \nthis way, and wondered whether he could ever get to \nknow whether this was really what had happened.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

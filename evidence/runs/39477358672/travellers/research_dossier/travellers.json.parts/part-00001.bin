      {
        "finding_id": "section-0825440b377ff46fbbf4",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "It  is  of  this  legacy  that  we  have  to  speak,  and \nthere  has  been  none  more  terrible,  none  fraught \nwith  more  awful  suffering  for  the  human  race. \nThe  broken  hosts  of  the  Moslem  chivalry  became \nthe  corsairs  of  the  Mediterranean  :  ruthless  pirates \nfreed  from  all  restraint  of  human  pity,  living  only \nto  inflict  the  maximum  of  suffering  upon  their \nChristian  foes,  who,  having  sown  the  wind  at  the \n,  taking  of  Granada,  reaped  in  the  coming  centuries \na  whirlwind  of  blood  and  agony  which  continued \ndown  to  the  bombardment  of  Algiers  by  Lord \nExmouth  in  1816,  and  even  later  than  that  date.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,

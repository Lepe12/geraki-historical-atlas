      {
        "finding_id": "section-02c79b28ad2cdd780a0d",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Grim  and  sinister,  the  corsairs  came  flocking \nto  the  standard  of  Barbarossa.  Well  they  knew \nthat,  should  he  fall,  it  was  but  a  matter  of  time \nfor  them  all  to  be  chased  from  off  the  face  of  the \nwaters.  Of  cohesion  there  was  but  little  among \nthem,  and,  in  spite  of  the  bond  of  a  common \nreligion  and  a  common  hatred  of  the  Christian, \nthey  were  swayed  far  more  by  a  lust  for  plunder \nthan  by  such  considerations  as  these.  In  times \nof  imminent  danger,  however,  men  naturally  crave \nfor  a  leader,  and  in  piratical  circles  all  was  now \nsubordinated  to  the  instinct  of  self-preservation.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-5a47b70f04cb53c795f1",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "In  all  the  ages  of  which  we  have  any  record  there \nhave  been  men  who  gained  a  living  by  that  practice \nof  robbery  on  the  high  seas  which  we  know  by  the \nname  of  Piracy.  Perhaps  the  pirates  best  known \nto  the  English-speaking  world  are  the  buccaneers \nof  the  Spanish  Main,  who  flourished  exceedingly \nin  the  seventeenth  century,  and  of  whom  many \nchronicles  exist :  principally  owing  to  the  labours \nof  that  John  Esquemelin,  a  pirate  of  a  literary \nturn  of  mind,  who  added  the  crime  of  authorship \nto  the  ill  deeds  of  a  sea-rover.  The  Sea- Wolves \nof  the  Mediterranean  in  the  preceding  century \ndid  not  raise  up  a  chronicler  from  among  them- \nselves :  for  not  much  tincture  of  learning  seems \nto  have  distinguished  these  desperate  fighters  and \naccomplished  seamen,  descendants  of  those  Spanish \nMoslems  who  had,  during  the  Middle  Ages,  lived \nin  a  land  in  which  learning  and  culture  had  been \nheld  in  the  highest  estimation.  Driven  from  their \nhomes,  their  civilisation  crushed,  their  religion \nbanned  in  that  portion  of  Southern  Spain  in  which \nthey  had  dwelt  for  over  seven  centuries,  cast  upon \nthe  shores  of  Northern  Africa,  these  men  took  to",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

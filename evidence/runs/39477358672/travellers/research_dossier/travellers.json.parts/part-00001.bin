      {
        "finding_id": "section-43911d78e8c64d6e94cf",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Identifying discursive shifts thus is an important pointer to the subsequent \npiracy narratives in the Indian Ocean. The phenomenon of escalating piracy \nwas definitely connected to the overall militarization of coastal society \nthat came in the wake of European claims over the seas from the sixteenth \ncentury and of Mughal-Maratha conflicts in the seventeenth century, which \nhad definite coastal chapters, and, subsequently, ofthe policies ofthe English \nCompany that saw itself as the supreme policeman of the seas to ensure \nthe virtues of free and fair trade. From about the 17205, or thereafter, the \nEnglish East India Company would appear to have reinvented itself as the \nombudsman ofthe ocean, undertaking the important task of guarding the \nseas, ensuring protection to all merchants against arbitrary violence at \nsea and condemning all piracy as immoral. The English Company in India \nreflected the changing disposition of the English nation that no longer relied",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

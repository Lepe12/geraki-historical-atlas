      {
        "finding_id": "section-83fd76a88294c8187f3d",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "A shrill whistle sounded from the poop of the galley \nwhere Uruj sat, and every face turned expectantly at \nthe call. It meant ‘‘ Prepare to attack.”” Two more \nshrill calls sounded, and with whips at work the boat- \nswains ran up and down their gangways as the three \ngalleys raced over the waves toward the oncoming nef. \nSkilful handling was required as the galley met the giant \nship, but good seamanship was not wanting, and while the \ngreat oars on one side were lifted as by one man at the \nword of command, the grappling irons were thrown and \ntwo of the galleys were securely hooked to the nef. \nThe galleys swung round to the way made by the nef, \nwhich still sailed lumberingly on. The iron hooks held \nfast in spite of the efforts of the Italians to cut or knock \nthem off, the crews hauled upon the chains which held \nthem, and in a few minutes, while stones and arrows \nflew among the pirates, the beaks of the galleys were \ngrinding the sides of the nef. One galley was on each \nside of the big ship, while the third, the Sea-hawk, was \nheld in reserve.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

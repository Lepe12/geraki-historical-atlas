      {
        "finding_id": "section-7c56bc9b4d31e90ac048",
        "file": "7201c06d810a438109222b2d.txt",
        "title": "Piracy and captivity in the Mediterranean, 1550-1810 / edited by Mario Klarer",
        "url": "https://catalogue.bnf.fr/ark:/12148/cb45536221m",
        "source_bibliography": {

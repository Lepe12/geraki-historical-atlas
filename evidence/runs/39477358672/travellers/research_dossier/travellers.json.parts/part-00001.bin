      {
        "finding_id": "section-44ae998f0e21a4538016",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "as  ever  ready  to  join  in  a  fray  with  promise  of \nbooty  :  doubly  ready  in  this  case,  as  it  was  to  harass \nso  unpopular  a  tyrant  as  Hamid.  Passing  through \nConstantine  and  Bona,  he  continued  to  march \ntowards  Tunis,  his  following  augmenting  as  he \nproceeded,  and  adding  to  his  forces  ten  light  field- \nguns.  Arriving  at  Beja,  a  town  which  Haedo \ndescribes  as  being  but  two  short  days'  march  from \nTunis,  he  came  upon  a  fortress,  recently  erected \nby  Hamid,  mounting  fourteen  brass  cannon.  Here \nhe  halted,  whereupon  Hamid  sallied  out  to  give \nhim  battle  at  the  head  of  some  three  thousand \ntroops,  horse  and  foot.  The  engagement  had \nscarcely  begun  when  the  three  Alcaids,  who  had \nbeen  in  communication  with  Ali,  deserted  with  all \ntheir  following.  Hamid  fled  to  Tunis,  expecting \nto  find  shelter  there,  but  he  was  hotly  pursued  by \nthe  corsairs,  who  followed  him  up  to  Al-Burdon, \nwhere  his  summer  palace  was  situated.  Hamid, \nfinding  that  his  people  were  everywhere  in  revolt, \nfled  to  the  Goletta,  carrying  with  him  a  quantity \nof  money,  jewels,  and  portable  valuables,  and  placed \nhimself  under  the  protection  of  the  Spanish \ngarrison — ^not,  however,  without  the  loss  of  the \nmajor  portion  of  his  baggage,  plundered  from  him \nby  certain  Moors  in  the  course  of  his  flight.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

      {
        "finding_id": "section-d43d4d8c30d2f9eacde7",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "There  were  no  longer  among  the  Moors  of \nAndalusia  learned  philosophers,  expert  mathema- \nticians, wise  astronomers,  and  practical  agriculturists; \nthere  was  among  them  but  one  art,  one  science, \none  means  of  gaining  a  livelihood — the  practice  of \nwar — and  their  very  existence  depended  on  the \nspoils  which  could  be  reft  from  the  hereditary  enemy. \nI'he  corsair  who  grew  to  man's  estate,  brought  up \nin  Algiers,  Tunis,  Tenes,  Jerba,  or  any  other  of  the \nlurking  places  in  which  the  sea- wolves  congregated, \nhad  as  a  rule  no  chance  but  to  follow  the  sea,  to \nexist  as  his  father  had  existed  before  him  ;  he  must",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

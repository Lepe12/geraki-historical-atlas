            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "On board his galley, decorated for this occasion \nwith scarlet banners, Barbarossa himself directed the \nassaulting line. Never before when the battle was \njoined had the gallant corsair been known to draw \nback; and yet on this occasion he not only hesitated \nbut actually hauled off. The Venetians saw to their \namazement that the expected attack was not to be \npushed home; for Barbarossa and his captains fell \nupon some lesser vessels: the Galleon of Venice was \nvictorious.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/greatpiratesstor0000jose",
          "source_file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
          "start_char": 205576,
          "end_char": 206055,
          "start_line": 5223,
          "end_line": 5232,
          "printed_page": null,
          "scan_indexes_0_based": [],

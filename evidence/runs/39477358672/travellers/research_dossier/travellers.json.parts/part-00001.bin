      {
        "finding_id": "section-7319aeaee63cb28fd295",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "No better success attended the attempt of a local \nruler, the Prince of Tinnis, who conceived the idea of \nthrusting out the usurper. He raised a great army \nagainst Barbarossa, and brought it toward Algiers. \nUruj, gathering a force of fifteen hundred picked men, \nwent out against him, and, disdaining the use of cannon, \nthrashed the forces of Tinnis and pursued them into their \nown city of Tenes, capturing the place. The Prince \nfled to the hills, and Uruj became ruler of his land. \nThis success whetted the pirate’s appetite for still further \nterritory, and he moved on to Tlemcen, where the Sultan \nwas the last of a long line of well-known kings. This \npotentate was conquered by the mere terror of the name \nof Barbarossa, for he fled without waiting to meet the \nfoe.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-ebc2575f94eae742390f",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "were  one  whit  better  than  were  they,  when  they \ncould  point  to  the  fact  that,  to  serve  a  private \nrevenge,  a  great  Christian  king  could  betray  his \nco-religionists  to  their  Moslem  foes.  Shamelessly \ndid  the  Sea-wolves  seek  their  prey  wherever  it  was \nto  be  found ;  their  methods  were  villanous  and \nseemingly  without  excuse,  but,  after  all,  there  was \nsome  colour,  some  shadow  of  right  in  what  they \ndid,  for  their  argument  was  that  they  were  merely \ngetting  back  from  Christendom  that  which  had \nbeen  reft  from  them  in  the  near  past  in  the \nkingdoms  of  Cordova  and  Granada.  But  who \nshall  find  excuse  for  the  Christian  kings,  governors, \nand  princes  at  this  epoch?  They  sought  their \nprey  no  less  ravenously  than  did  the  pirates,  and \nwith  just  about  the  same  amount  of  justification  : \nwitness  the  sacking  of  Rome  by  Charles  V.  in  1527, \nand  the  unexampled  act  of  treachery  just  recorded \nof  Francis  of  France.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,

        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "It is with these constituent elements that the \npiratical leader had to deal, trusting to the strength \nof his own arm, the subtlety of his own unassisted \nbrain. Some among these leaders have risen to \neminence in their evil lives, most of them have \nbeen the captains of single ships preying on com- \nmerce in an indiscriminate manner; but this was \nnot the case with the Sea-wolves of the Mediter- \nranean. Primarily sea-robbers they were of course, \nbut as time and opportunity developed their \ncharacters they rose to meet occasion, to take \nfortune at the flood, in a manner that, had they",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",

      {
        "finding_id": "section-cc4387b586148db70639",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "On a somewhat different note — and without explicitly referring to the Black \nFlags - a former governor general of French Indochina, Ernest Constans, \nsaid in the Chamber of Deputies that the label pirate often was used in a \nsomewhat “pompous” way in Indochina to describe what often was nothing \nbut instances of petty theft, similar to what happened regularly in the \nfaubourgs of Paris. Such rhetoric, he said, was reminiscent of the language \nof comic opera.53",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 674420,
          "end_char": 674885,
          "start_line": 12752,
          "end_line": 12758,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",

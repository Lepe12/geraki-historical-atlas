          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Furthermore, we have laws regulating warfare, and fidelity to an oath \nmust often be observed in dealings with an enemy: for an oath sworn with \nthe clear understanding in one's own mind that it should be performed \nmust be kept; but if there is no such understanding, it does not count as \nperjury if one does not perform the vow. For example, suppose that one \ndoes not deliver the amount agreed upon with pirates (praedonibus) as \nthe price of one's life, that would be accounted no deception - not even \nif one should fail to deliver the ransom after having sworn to do so; fora \npirate (pirata) is not included in the number of lawful enemies, but is the \ncommon foe of all the world (communis hostis omnium); and with him \nthere ought not to be any pledged word nor any oath mutually binding.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

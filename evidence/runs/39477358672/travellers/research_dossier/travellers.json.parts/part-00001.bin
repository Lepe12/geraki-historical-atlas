      {
        "finding_id": "section-d4b3a8413ea28a5eddbe",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "“Britain is in desperate straits,” said Vibius. “I \nwill instantly send troopers to York with the news, asking \nfor reinforcements. Do you make all speed. To save \nthe province, Nectarides must smash the pirates ere they \nland to join forces with the barbarians.”",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",

      {
        "finding_id": "section-62b6a88192a55b2c5d00",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Then, also, prominent citizens or other rich men would \njoin them, either for the adventurous life or for the \nwealth to be gained from booty. As a result the daring \nof the pirates grew more and more.. The number of their \ngalleys increased, and the richness of their gear was a \nthing of wonder. Their great sails would be made of \nred or purple cloth, the beaks and sterns of their galleys \nwould flash back the sunlight from bright bronze, canopies \nof silk would be stretched along the poops, and the hafts \nof the great oars would be plated with silver. Thus, \ninstead of creeping out of their hiding-places secretively \nto do their evil deeds, they now boldly drew attention to \nthemselves, and flaunted their ill-gotten adornments in \nthe broad light of day.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

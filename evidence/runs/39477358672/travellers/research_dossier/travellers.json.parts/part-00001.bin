        "identifier": "cia-readingroom-document-cia-rdp08c01297r000300180013-8",
        "title": "CIA Reading Room cia-rdp08c01297r000300180013-8: DISPUTED ISLANDS IN THE SOUTH CHINA SEA",
        "creator": "CIA Reading Room",

      {
        "finding_id": "section-0c1c19a9ecef2f638954",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Once  again  had  a  Moslem  corsair  bid  defiance \nto  that  ruler  whom  Sandoval  and  Marmol  in  their \nhistories  greet  by  the  name  of  the  \"Modern  Caesar.\" \nIt  was  told  to  Charles  that  Susa,  Sfax,  and  Monastir \nhad  fallen,  that  \"  Africa  \"  was  in  the  hands  of  the \ncorsairs  ;  \"  was  he  never  to  be  free  from  these \npestilent  knaves,\"  he  demanded  of  his  trembling \ncourtiers  ?  Hot-foot  came  the  couriers  from \nCharles  to  Andrea  Doria,  with  orders  to  take \nDragut  dead  or  aUve,  but  alive  for  choice ;  and \nup  and  down  the  tideless  sea  in  the  summer  of \n1549  did  the  great  Genoese  seaman  range  in  search \nof  the  bold  corsair.  Doria  was  getting  a  very  old \nman  now,  but  his  eye  was  undimmed,  his  strength \nyet  tireless,  his  vigilance  and  zeal  in  the  service  of \nhis  master  unabated.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

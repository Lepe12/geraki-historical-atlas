      {
        "finding_id": "section-f649b44ad00640a6ce8a",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Muley  Hassan  had  exchanged  the  comparatively \ndignified  position  of  a  prince  in  exile,  who  has  been \nexpropriated  by  the  strong  hand,  for  that  of  the \npuppet  of  one  of  the  greatest  enemies  of  his  religion. \nNeither  he  nor  his  people  were  one  whit  the  better \nfor  the  change,  and,  as  far  as  vassalage  was  con- \ncerned, they  would  in  all  probability,  in  the  state  of \nreligious  feeling  at  the  time,  have  sooner  been \nsubordinate  to  the  Moslem  corsair  than  to  the \nChristian  King.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

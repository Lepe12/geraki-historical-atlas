      {
        "finding_id": "section-cc65a9cb24e89dd91ae9",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "God, each retired to his post ta die on the bed \nof honour with arms in his hand.” Those among \nthe Knights who were too severely wounded or \ntoo ill to stand caused chairs to be carried to the \nbreach in which they seated themselves and awaited \nthe assault. For four hours did these indomitable \nmen withstand the might of a host innumerable: \nat the conclusion of this period there remained \nalive but sixty of the garrison. Mustafa ceased \nthe assault for a few moments only to replace the \nstorming party by fresh troops, and then the end \ncame. Almost the last to fall were the Chevalier \nLamirande and the veteran Bailli of Negropont, \nand when the crescent banner was planted on the \nwalls there remained alive not one of those de- \nfenders who had held the fort. Several of Dragut’s \nofficers ran to his tent and announced the taking \nof St. Elmo. The great captain was in his last \nextremity and unable to speak, “He, however, \nmanifested his joy by several signs, and, raising his \neyes to heaven as if in thankfulness for its mercies, \nimmediately expired: a captain of rare valour and \neven abundantly more humane than are ordinarily \nthese corsairs.”",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 555628,
          "end_char": 556792,
          "start_line": 14148,
          "end_line": 14171,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

      {
        "finding_id": "section-8ddf7348973020adaf70",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Nine months after he left Plymouth Kidd arrived at \nMadagascar, where was the hunting-ground of pirates \nwho preyed on the growing East India trade. But mis- \nfortune dogged him from the beginning. He could find \nno pirates in the seas about Madagascar, and no better \nsuccess attended him when he extended his cruise to the \ncoast of Malabar. Meanwhile his crew became dis- \ncontented by reason of the continued non-success, and \nsickness also came among them. Fifty of them died from \ncholera within the first year. Added to this, the ship \nhad become foul and leaky and the stores were giving out. \nIt is pretty evident that in the last few months of this \nperiod Kidd had a difficult task to keep his men under \ncontrol, bitterly disappointed as they were.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

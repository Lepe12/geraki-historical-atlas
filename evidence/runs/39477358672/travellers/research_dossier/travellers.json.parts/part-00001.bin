      {
        "finding_id": "section-f0d2c1c4cd217dfeb1ce",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Doria  got  information  that  Dragut  was  at \nMonastir,  information  that  was  perfectly  correct ; \nbut  by  this  time  the  corsair  knew  that  not  only \nhad  he  raised  all  Christendom,  but  that  the  ad- \nmiral was  on  his  track.  In  consequence,  he  slipped \nout  of  Monastir,  \"  for,\"  as  it  is  pithily  put  by \nMarmol,  \"  our  corsair  cared  not  to  be  shut  up \nin  so  defenceless  a  port ;  he  had  good  heels  and \nloved  sea-room.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-de42f0dda430dfd7b78f",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "It  was  shortly  after  the  death  of  his  brother \nUruj  that  the  storm  arose  which  bade  fair  to  sweep, \nnot  only  Kheyr-ed-Din  but  all  the  corsairs  of \nthe  North  African  coast,  clean  out  of  their  strong- \nholds, for  the  Emperor  Charles  V.,  at  this  time",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

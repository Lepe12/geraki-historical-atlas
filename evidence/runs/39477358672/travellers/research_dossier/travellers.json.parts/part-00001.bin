      {
        "finding_id": "section-cff64b1cf4ad3f248113",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Only black looks greeted the five pirates where they \npassed, and though they were served with wine when they \nasked for it, if looks and wishes could have killed, their \ndrink would have poisoned them. The five rogues took \nno notice, however, and laughed and jested and jeered \nwithout hindrance, but it was only the fear of the pirate \nship outside the bar that kept many a sturdy citizen from \ntrying conclusions there and then with the insolent \nrascals. In two hours Richards and his men went to the \nCourthouse again to learn the answer of the magistrates \nand to reclaim Mr Marks. The latter, who was waiting \nfor them, told them that the town councillors had decided \nto give them the medicine chest they desired, and that it \nwas probably on its way to the quayside at that moment. \nThe pirates then betook themselves to their boat, and \nfound, indeed, that a chest was awaiting them, filled \nwith the finest medical stores the town could produce, \nand amounting in value to between three and four \nhundred pounds.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

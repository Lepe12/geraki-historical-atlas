      {
        "finding_id": "section-c5ce75924aa067b720a2",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "For the remainder of that season, and indeed for the \nnext two years, the brothers Barbarossa confined their \nactivities to the sea. Every month found their success \nattaining greater proportions, and the strings of their \ncaptives and the bales of their booty became a common \nsight in the streets and on the quays at Tunis. The \ncombination of craft and reckless daring possessed by \nthis partnership of the pirate brothers was an exceptional \none, and when the tales of their depredations were told \nhowls of rage at the losses inflicted by them sounded \nin every harbour and in every merchant’s counting house \nfrom Seville to Brindisi, while pride and delight rose \nin the heart of every Moslem, in the streets of Con- \nstantinople as in the skin tents of the Berbers.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

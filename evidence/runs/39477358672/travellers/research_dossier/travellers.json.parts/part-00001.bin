      {
        "finding_id": "section-da739052d781dbe8306f",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "It  must  be  remembered  that  the  inhabitants  of \nMehedia  were  by  no  means  enamoured  of  Dragut- \nReis  and  his  piratical  followers :  King  Stork  had \nsucceeded  to  King  Log,  the  part  of  the  former \nmonarch  being  taken  by  that  singularly  capable \nand  ferocious  person,  Aisa,  whose  rule  was  far \nfrom  being  to  the  liking  of  the  richer  and  more \nrespectable  portion  of  the  townsfolk.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

        "lead_type": "SOURCE_SECTION",
        "occurrence_count": 1
      },
      {
        "finding_id": "section-58913a66fa0db468b7c2",
        "file": "DTIC_ADA138436_DTIC_ADA138436_djvu.txt",
        "title": "DTIC ADA138436: Subnational Conflict in the Mediterranean Region,",
        "url": "https://archive.org/details/DTIC_ADA138436",
        "source_bibliography": {
          "creator": "Defense Technical Information Center",
          "date": [
            "1983-03-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "2ed18f8aad60a6ce22f503b2453cbfcb10623acd84cb152e6c47b18b23ee3a23",
        "evidence_excerpt": "In  their  pursuit  of  independence,  the  Algerian  nationalists  carried \ntheir  struggle  to  the  French  metropole  to  maintain  an  impression  of  war \nin  France  as  well  as  Algeria.  Vhile  terror  was  employed  by  all \nparticipants  in  the  Algerian  conflict--by  the  FLN  against  Algerian  and \nFrench  targets  in  Algeria  and  France,  by  the  French  Army  particularly  in \nthe  battle  for  Algiers,  by  the  OAS  against  French  and  Algerian  targets \nin  Algeria  and  France,  by  the  barbouzes  (secret  French  agents)  against \nthe  OAS--  it  is  the  FLN  that  provided  inspiration  and  instruction  to  the \nPalestinians  in  their  struggle  against  Israel.  The  victory  of  the  FLN \nrepresented  a  triumph  of  Arabs  over  a  Western  power.  A  number  of \nPalestinian  leaders  went  to  Algeria  in  the  early  1960s  where  they  met \nFLN  leaders  whose  doctrines  and  tactics  were  later  to  influence  the \ndevelopment  of  the  Palestinian  movement,  in  particular,  Fatah. [6]",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/DTIC_ADA138436",
          "source_file": "DTIC_ADA138436_DTIC_ADA138436_djvu.txt",
          "start_char": 9438,

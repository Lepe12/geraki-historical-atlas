        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "These points of departure, we believe, are conducive for studying how \nthe concept of piracy was defined, translated, and used in various contexts \nmarked by global interaction and imperial encounters from the sixteenth to \nthe early twentieth century. By highlighting these complex global historical \nprocesses, we hope that the present volume will contribute to the current \nefforts to understand the role that piracy and, more broadly, maritime \nviolence have played in world history.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-97f2d7947203393597c9",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Thus  balked  of  his  prey,  Barbarossa  swung  his \nfleet  round  to  the  southward  and  westward  and \nsailed  for  Sardinia,  where,  from  the  Straits  of \nBonifacio  to  Cape  Spartivento,  he  left  no  house \nstanding  that  would  burn,  or  man  alive  who  was \nnot  swept  in  as  a  captive.  The  descent  of  the \ncorsairs  in  force,  such  as  Kheyr-ed-Din  now  had \nat  his  disposal,  was  one  of  the  most  awful  calamities \nfor  a  country  that  it  is  possible  to  imagine.    When",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

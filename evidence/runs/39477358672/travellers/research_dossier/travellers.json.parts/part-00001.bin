      {
        "finding_id": "section-613d74d8497da63a309d",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "So headstrong was Uruj and so lacking in all foresight \nthat he left his fleet drawn upon the shore with the most \nmeagre guard. The last thing which he expected was \nan attack from the sea so soon after the opening of his \nsecond attempt on Bougie. While he was assembling \nhis men for his great effort, however, the Spanish admiral, \nunder cover of the darkness, was advancing with muffled \noars to the attack on the pirates’ flotilla. The Spaniards \nreached the boats without being seen, and the first \nknowledge of their presence the pirates had came to \nthem in the midst of their fierce attacks upon the walls \nof the fort, amid the blinding flashes of the cannon and \nthe roar of exploding charges. Suddenly cries arose: \n“The boats are on fire! The boats are on fire!”",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

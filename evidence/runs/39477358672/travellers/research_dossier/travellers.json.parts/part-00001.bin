      {
        "finding_id": "section-ee2583d176e2f31283cc",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "This  quotation  is  given  in  full  to  set  out  the \namazing  fact  that  in  this  battle  over  three  thousand \nwere  killed  while  only  four  hundred  were  cap- \ntured, which  shows  that  it  must  have  been  in  the \nnature  of  an  indiscriminate  massacre ;  the  only \ncaptive  of  any  note  was  the  captain,  Juan  del \nBio.  Diego  de  Vera  had  had  enough  of  the \ncorsairs,  and  sailed  away  with  the  remainder  of \nhis  force.  Of  what  became  of  him  or  of  them \nthere  is  no  record,  but  he  must  have  been  a \nsingularly  incompetent  commander  when  he  could \nnot  make  head  against  a  rabble  of  pirates  and \nMoors  with  the  army  at  his  disposition.  Sandoval \ndoes  not  attempt  to  minimise  the  defeat,  which, \nof  course,  would  have  been  impossible  ;  he  contents \nhimself  with  the  following  delightfully  quaint  re- \nflection :    \"  But  many,  many  times  Homer  nods  5",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

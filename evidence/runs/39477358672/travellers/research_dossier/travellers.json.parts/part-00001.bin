        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "It  is  somewhat  difficult  to  fathom  the  reasons \nwhich  induced  Barbarossa  to  treat  Soliman  to  his \nsanctimonious  diatribe  concerning  the  King  of \nTunis;    coming,  as  it  did,  from   a  pirate,  it  was",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

      {
        "finding_id": "section-6d4ec4856d679c251d57",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "According to Exquemelin, the buccaneers made decisions about the \ndirection of their voyages and raids in \"Council,\" wherein “they agree upon \ncertain Articles which are put in writing, by way of Bond or Obligation, the \nwhich every one is bound to observe.”>' The Captain and other office bearers \nof their pirate vessels were also elected by common vote, and their dismissal \ncould just as easily be accomplished by the same means. William Dampier, \nfor example, noted that captains were seconded by a Quartermaster who",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "“Pieces of eight! Pieces of eight!’’ Everyone can \nenvisage Long John Silver stumping across the \nsand on his wooden leg with his parrot perched \non his shoulder. The magic of Treasure Island \nstill enthralls everyone with its tales of dastardly \nduels and adventure. The Book of Pirates is \npacked with sea faring lore and tells of the \nthrilling adventures of the great pirates of \nhistory.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

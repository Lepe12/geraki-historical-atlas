      {
        "finding_id": "section-c0ac2576c0eac1203b9b",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "put forth his utmost endeavours, to strain every \nnerve and sinew in the chase. All his life he had \nbeen fighting the corsairs, mostly with conspicuous \nsuccess ; but what Andrea could never forget— \nand what his enemies never allowed him to forget \neven had he been so inclined—was the fact that, \nat the supreme crisis of his valiant life, when he \nmet with Kheyr-ed-Din Barbarossa at the battle \nof Prevesa, he had come off so badly that his \nunder officers of the Papal and Venetian fleets had \nmade representations, on their return to their \nrespective headquarters, which had detracted from \nhis fame, and lowered him in the estimation of \nEurope. Further than this, he knew that Barbarossa \nhad laughed at and made game of him among his \nwild followers : this to the aristocrat, the Prince of \nOneglia, the admiral who treated on almost equal \nterms with such men as the Pope, Charles of Spain, \nand Francis of France, was an insult hard to be \nborne ; the next corsair with whom he should meet \nshould not escape so easily as had Kheyr-ed-Din, \nthat the admiral had sworn.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 426742,
          "end_char": 427823,
          "start_line": 10989,
          "end_line": 11010,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,

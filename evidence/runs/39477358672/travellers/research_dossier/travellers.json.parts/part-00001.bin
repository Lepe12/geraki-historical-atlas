      {
        "finding_id": "section-67cb526e6bc494bb03ce",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The region described by the colonial archive as the Northward, consisted \nof coastal Gujarat, Kathiawar, Cutch, and Sind, a region that was held to \nransom by the operations of the Cooley pirates of Okhamandal, a small \narea at the westernmost extremity of Kathiawad. Emerging as an epicentre \nof piracy and piratical activity, the small confederacy of Okhamandal en- \ncompassed a complex range of operations located within a specific moral \neconomy of rights and obligations that were not easily or accurately captured \nby the colonial ethnographic exercise. The phenomenon of piracy in the \nNorthward had important links and intersections with local conventions \nand politics in a period of political instability and turbulence. The politics \nof Northern piracy was thus part of the regionalization and localization of \npower in north-western India in the regions of Kathiawar and Cutch, where \na complex mosaic of political arrangements emerged as a result of coastal \nmigrations, Rajput agrarian colonization, Mughal and Maratha interventions, \nand the slow but insidious expansion of the English East India Company, \nwhich insisted on the sacrosanctity of their trading permit. The emergence \nof smaller states in the region — foremost among them being Junagadh under \nthe Babi rulers, Bhavnagar under the Gohels, and Nawanagar - testified to \nnew political equations that rested on commercial ambitions, on aggressive \npolicies of controlling trade and markets, on countering the violence of",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 341167,
          "end_char": 342664,
          "start_line": 6484,
          "end_line": 6503,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false

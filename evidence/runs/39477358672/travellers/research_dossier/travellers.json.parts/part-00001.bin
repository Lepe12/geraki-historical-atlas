      {
        "finding_id": "section-72e60fec366e61f7da7b",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "The  ambition  of  Dragut  increased  with  his \npower,  and  he  determined,  following  the  example \nof  the  Barbarossas,  to  seize  and  hold  some  strong \nplace  of  arms  possessed  of  a  commodious  port  in \nwhich  he  might  be  the  supreme  ruler.  Accordingly, \nin  the  depth  of  winter  in  the  year  1548,  at  a \ntime  which  was,  as  we  have  pointed  out,  a  close \nseason  for  piratical  enterprises,  and  during  which \nattack  from  the  sea  was  not  expected,  he  collected \nall  the  corsairs  whom  he  could  gather,  and  fell \nupon  the  Spaniards  on  the  coast  of  Tunis,  at  Susa, \nat  Sfax,  and  at  Monastir.  These  places  had  been \ntaken  from  the  corsairs  in  the  previous  summer \nby  Andrea  Doria ;  they  formed  a  sort  of  regular \nbattle-ground  when  the  combatants  were  in  want \nof  something  to  do,  and  were  held  alternately  by \nthe  King  of  Tunis,  the  Spaniards,  and  the  corsairs.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-dfff1dae9ea9e24126ca",
        "file": "DTIC_ADA138436_DTIC_ADA138436_djvu.txt",
        "title": "DTIC ADA138436: Subnational Conflict in the Mediterranean Region,",
        "url": "https://archive.org/details/DTIC_ADA138436",
        "source_bibliography": {
          "creator": "Defense Technical Information Center",
          "date": [
            "1983-03-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "2ed18f8aad60a6ce22f503b2453cbfcb10623acd84cb152e6c47b18b23ee3a23",
        "evidence_excerpt": "Governments  have  dealt  with  terrorists  in  the  last  quarter  of  the \ntwentieth  century  much  as  the  European  powers  dealt  with  the  pirates \nthat  plagued  the  Mediterranean  in  the  early  seventeenth  century.  They \nhave  simultaneously  tolerated,  combatted,  fomented,  supplied,  and \nexploited  them.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/DTIC_ADA138436",
          "source_file": "DTIC_ADA138436_DTIC_ADA138436_djvu.txt",
          "start_char": 18968,
          "end_char": 19294,
          "start_line": 388,
          "end_line": 392,
          "printed_page": null,

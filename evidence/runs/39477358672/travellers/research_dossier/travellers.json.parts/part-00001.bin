      {
        "finding_id": "section-1326b96ddb7be6c6a0e8",
        "file": "DTIC_ADA138436_DTIC_ADA138436_djvu.txt",
        "title": "DTIC ADA138436: Subnational Conflict in the Mediterranean Region,",
        "url": "https://archive.org/details/DTIC_ADA138436",
        "source_bibliography": {
          "creator": "Defense Technical Information Center",
          "date": [
            "1983-03-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "2ed18f8aad60a6ce22f503b2453cbfcb10623acd84cb152e6c47b18b23ee3a23",
        "evidence_excerpt": "Almost  since  the  beginning  of  Western  civilization,  the \nMediterranean  Sea  has  been  a  theater  of  conflict,  a  boulevard  for \nbattleships  and  invading  armies,  a  moat  between  great  empires,  diverse \ncultures,  religions,  and  political  systems.  What  the  nations  of  the \nMediterranean  have  in  common,  besides  a  shoreline,  is  25  centuries  of \nwarfare--warfare  between  the  Romans  and  the  Carthaginians,  between \nMoslems  and  Christians,  between  the  corsairs  of  the  Barbary  Coast  and \nthe  merchant  fleets  of  the  European  kingdoms,  between  the  weaker  non- \nEuropean  countries  and  the  colonial  powers,  between  revolutionary \nregimes  in  North  Africa  and  the  Middle  East  and  the  industrial  nations \nof  Western  Europe.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/DTIC_ADA138436",
          "source_file": "DTIC_ADA138436_DTIC_ADA138436_djvu.txt",
          "start_char": 1229,
          "end_char": 2024,
          "start_line": 105,
          "end_line": 115,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",

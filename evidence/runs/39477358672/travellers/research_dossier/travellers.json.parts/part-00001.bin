      {
        "finding_id": "section-f3098bf2ad925f74a811",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "As the strong sun of a perfect May morning in \nthe Mediterranean leapt above the horizon, Uruj \nloosed his hounds upon their prey; the oars of \nthe galleys churned the clear blue waters into \nfoam, and the air was filled with the yells of the \ncorsairs. “ Allah! Allah!” and “ Barbarossa! Bar- \nbarossa!” they cried. It was a war-cry that was \ndestined to re-echo over many a conflict, both by \nland and sea, in the years that were to come.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 93522,
          "end_char": 93962,
          "start_line": 2582,
          "end_line": 2590,
          "printed_page": null,
          "scan_indexes_0_based": [],

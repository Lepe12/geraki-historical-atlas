          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "[In Indochina, Europeans indiscriminately mix up under the label \"pirate\" \nnot only marauders, highway robbers and smugglers, but also adventurers \nof all sorts who, yielding to the lure of a roaming life and defying the \nimpotence of the laws, carry out their depredations, in armed bands, \non land, on the coast or on the rivers of Tonkin; but also the natives \nwho, rising up against the French domination, fight to regain national \nindependence.*?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

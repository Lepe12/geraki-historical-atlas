      {
        "finding_id": "section-7c23444c5e34b480525a",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "As  the  strong  sun  of  a  perfect  May  morning  in \nthe  Mediterranean  leapt  above  the  horizon,  Uruj \nloosed  his  hounds  upon  their  prey  ;  the  oars  of \nthe  galleys  churned  the  clear  blue  waters  into \nfoam,  and  the  air  was  filled  with  the  yells  of  the \ncorsairs.  \"  Allah  !  Allah  !  \"  and  \"  Barbarossa  !  Bar- \nbarossa  !  \"  they  cried.  It  was  a  war-cry  that  was \ndestined  to  re-echo  over  many  a  conflict,  both  by \nland  and  sea,  in  the  years  that  were  to  come.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

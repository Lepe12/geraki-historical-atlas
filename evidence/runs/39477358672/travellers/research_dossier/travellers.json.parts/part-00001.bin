      {
        "finding_id": "section-2281b5063f221df50f5d",
        "file": "dli.bengal.10689.5735_10689.5735_djvu.txt",
        "title": "A Voyage Up The Mediterranean",
        "url": "https://archive.org/details/dli.bengal.10689.5735",
        "source_bibliography": {
          "creator": "Willyams, Cooper",
          "date": [

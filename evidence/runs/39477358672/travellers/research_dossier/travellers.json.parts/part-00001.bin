      {
        "finding_id": "section-f4209cbb3022ae2a9ec0",
        "file": "d662ae36ae6f25434a3b4e8c.txt",
        "title": "Rodos’un Fethi Öncesinde (1499-1520) Akdeniz’de Hıristiyan Korsanlar",
        "url": "https://makale.isam.org.tr/server/api/core/bitstreams/8789a8c9-de5d-4508-acf2-3252ecd15f48/content",
        "source_bibliography": {
          "creator": null,
          "date": null,
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "16d6c2edf07743d2f6f967465c5fd3cb0d285d175170cefb150bccbbfafc05e4",
        "evidence_excerpt": "ve Sicilya’da bulunma ihtimali olan bütün gemileri ele geçirmek ve onları Cerbe’ye\nyollamak fikriyle Mağrib’den ayrılmıştır. Ancak Siraküza’ya vardığında fikri\ndeğişmiş, Tunus elçilerinin kıymetli mal ve parayla dolu gemilerini ele geçirmenin\ndaha kârlı olacağını düşünmeye başlamıştır.90\n3 Aralık 1518 tarihinde Konsolos Pellegrino Venero’ya ulaşan bir haber,\nsöz konusu korsanların akıbeti hakkında önemli ipuçları barındırmaktadır. Bu\nhabere göre, korsan Frà Januzo, Cenevizli Korsan Centurione’yi rekabet\nsebebiyle kendi kamerasında Biskay’lı birine boğdurmuştur.91 Bu korsan,\nCenturione’nin barçasındakilerin top atışına rağmen azimle gemiyi ele\ngeçirmiş92, korsanların reisi olmuş, gemide bulduğu 17.000 duka (12.00093 veya\n18.00094 duka) parayı ile çok sayıda eşyayı Mesinalılara dağıtmıştır.95 Mesinalılar\nda ona Aosta Limanı’na kadar dolaşma izni vermişlerdir. O da oradan Messina’ya\ngitmiştir.96 Frà Januzo, Centurione’yi öldürmeyi daha önce iki kez denemiş,\netrafındaki elli Rum muhafız sebebiyle bunu gerçekleştirememiştir.97\n90 Mağrib kadırgalarında tüccar olarak görev alan Sebastiano Pisani, 5 Şubat 1518 tarihinde Spilit",
        "years_in_scope": [],

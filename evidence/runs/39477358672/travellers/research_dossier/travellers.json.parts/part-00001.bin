      {
        "finding_id": "section-c4fa4739ea614220a48e",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "In the Trade and Navigation Treaty of Nijmegen in 1678, France and the \nUnited Provinces also reached an agreement on such a verdict.55 In France, \nthese regulations were included in the Ordonnance touchant la marine, \nproclaimed by Louis XIV, which set up binding rules for the conduct of war \nat sea.®° It forbade French sailors from acquiring commissions from foreign \ngovernments for the equipment of warships flying under the French flag \nwithout the approval of the king. Whoever violated the regulation was to \nbe treated as a pirate.\" The Ordonnance broadly reflects the tendency, by \nthen dominant in Europe, to tighten up the regulation of warfare at sea by \nextending the definition of piracy. In this way, the room for manoeuvre of \nbooty hunters, who used the competition between the leading sea powers \nto acquire documents legalizing their plundering raids from rulers or even \npotentates whose own authority was dubious, was increasingly narrowed \ndown in the final third of the seventeenth century.",
        "years_in_scope": [
          1678
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

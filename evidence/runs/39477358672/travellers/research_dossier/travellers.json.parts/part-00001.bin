      {
        "finding_id": "section-ac374b98e3811226a90a",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "By  his  side  was  his  faithful  lieutenant  Venalcadi. \nIn  a  breathless  mel^e  Christian  sword  and  Moslem \nsabre  clashed  and  rang.  His  turban  gone,  his \ngreat  curved  scimitar  red  to  the  hilt,  the  undaunted \ncorsair  fought  his  last  fight  as  became  the  terror \nof  his  name.  Almost  had  he  succeeded  in  breaking \nthrough  the  ring  of  his  foes  when  Garzia  de  Tineo, \nalferez  (or  lieutenant)  to  Captain  Diego  de  An- \ndrade,  wounded  him  severely  with  a  pike.     Uruj",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

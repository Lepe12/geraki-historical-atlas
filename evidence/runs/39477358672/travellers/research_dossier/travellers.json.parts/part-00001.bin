      {
        "finding_id": "section-00945fb7f4db74bb3c3a",
        "file": "esclaveschretiensmaitresmusulmans._Esclaves_chretiens_Maitres_musulmans._djvu.txt",
        "title": "Esclaves Chretiens, Maitres Musulmans.",
        "url": "https://archive.org/details/esclaveschretiensmaitresmusulmans.",
        "source_bibliography": {
          "creator": [
            "Robert Davis"
          ],
          "date": [
            "2006-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "4a2d2b110cb8f12d567aff2ce6c6f62b1f48738406a2cc8aa72c9ead2f63c0e2",
        "evidence_excerpt": "importante, la prochaine cible des corsaires, cédaient souvent à la \npanique la plus complète, ce qui ne pouvait que faciliter encore \nun peu plus la tâche de leurs prédateurs. On raconte qu’en 1623, \nla simple rumeur que des corsaires avaient abordé à Sperlonga \npoussa les habitants de la bien plus grande et « bien armée » \nGaeta, située à une quinzaine de kilomètres, à « fuir vers les col- \nlines aussi vite qu’ils le pouvaient », ne prenant que le temps de \ncacher leurs objets de valeur :",
        "years_in_scope": [
          1623
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/esclaveschretiensmaitresmusulmans.",
          "source_file": "esclaveschretiensmaitresmusulmans._Esclaves_chretiens_Maitres_musulmans._djvu.txt",
          "start_char": 168994,
          "end_char": 169489,
          "start_line": 3298,
          "end_line": 3305,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",

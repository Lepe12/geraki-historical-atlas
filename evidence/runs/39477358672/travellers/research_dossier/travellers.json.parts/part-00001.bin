      {
        "finding_id": "section-42d2207b348fd7610011",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "At this time I was able to be of great service to the \nCaptain. I had seen for some days past certain of the \nmore truculent and ambitious fellows among our men \ncolloguing together with great secrecy when they thought \nthey were not observed. When I approached they \nseparated or began joking and jesting together. I took \noccasion to overhear what they were speaking about, and \nmuch to my surprise learned from this and that that \nthey had made a plot to desert the Captain with some \nthree hundred other men. I made the Captain aware \nof what I had learned, and he put certain spies to work \nin whom he had great reliance. In a few days we had \nas pretty a conspiracy exposed as ever one could imagine. \nThe conspirators, at the head of whom was a man named \nMichael Macmanus, a turbulent Irishman, designed to \nseize a certain ship then in the port of Panama, and in it \nto go cruising in the South Seas, a-pirating, until they \nhad secured as much wealth as they desired, when they \nwould return home by way of the East Indies.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/bookofpirates0000gilb",
          "source_file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",

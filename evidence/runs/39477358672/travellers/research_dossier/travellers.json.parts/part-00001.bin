      },
      {
        "finding_id": "section-54f311d07642b0d25420",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "It  was  late  autumn  when  the  expedition  at  last \nset  sail,  and  the  imperious  temper  of  Charles  was \nsuch  that  he  refused  to  be  governed  by  the \nadvice  of  the  seasoned  mariners,  such  as  Andrea \nand  Antony  Doria,  and  others  who  dreaded  the \nelFect  of  the  gales  which  the  armada  was  likely \nto  encounter  on  the  coast  of  Africa.  The  Emperor \nwas  not  to  be  gainsaid,  and  the  fleet  set  sail. \nThey  arrived,  says  Sandoval,  \"  en  el  dia  de  San \nHieronymo,\"  Saint  Bartholomew's  day ;  and  there \nthen  arose  such  a  storm  as  the  Mediterranean \nseldom  sees.  Some  of  the  army  had  landed,  some \nwere  still  afloat,  the  corsairs  accounted  for  the \nluckless  soldiers  ashore,  the  elements  destroyed \nmany  left  in  the  ships :  26  ships  and  4,000  men \nwere  lost.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/cu31924087978445",
          "source_file": "cu31924087978445_cu31924087978445_djvu.txt",
          "start_char": 161690,
          "end_char": 162542,
          "start_line": 3677,

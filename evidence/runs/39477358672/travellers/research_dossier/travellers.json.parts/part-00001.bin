      {
        "finding_id": "section-ee0c1a71186d52634776",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "A wealth of work on piracy theory, from Cicero to Alfred P. Rubin, and \nmore recent work by scholars such as Daniel Heller-Roazen, views piracy \nfrom the state's perspective.\" What might a theoretical description of \npiracy that does not assume statist perspectives look like? One approach to \nbuilding an analytical framework that neither privileges statist perspectives, \nnor inverts them, is to analyse a broad set of historical instances, and, \ncomparing them, to abstract the features their dynamics share. By drawing \non both non-European and pre-European settings alongside colonial ones, \ncomparing analytical inferences from concrete historical settings offers \nopportunities to critique power, as well as to infer a theoretical description \nabstracted from the commonalities shared among their historical dynamics.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 230241,
          "end_char": 231065,
          "start_line": 4420,
          "end_line": 4430,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

      {
        "finding_id": "section-7f1a6ea3fb8c4d0f5528",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "and  bloodshed.  Barbarossa  had  in  his  train  sixty \nSpanish  soldiers  captured  by  him  from  the  force \nof  Don  Hugo  de  Moncada.  Well  did  the  corsair \nknow  their  value :  there  were  no  finer  fighting \nmen  in  all  the  Christian  armies.  Hastily  sum- \nmoning them,  he  promised  them  their  freedom  if \nthey  would  now  throw  in  their  lot  with  him  and \nassist  in  the  downfall  of  Venalcadi.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

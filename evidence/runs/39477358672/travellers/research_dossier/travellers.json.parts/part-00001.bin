      {
        "finding_id": "section-9df41098c51f6c957bcc",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Christian  fleet  is  271.  Ali  Basha  was  in  supreme \ncommand  of  the  Turkish  forces,  \"a  man  of  an \nintrepid  spirit,  who  had  given  many  proofs  of  a \nhumane  and  generous  mature — quahties  more  rare \namong  the  Turks,  perhaps  among  aE  nations,  than \nmere  physical  courage.\"  With  Ah  was  the  Basha \nof  Algiers,  that  other  Ali,  the  corsair,  who  since  his \narrival  at  Coron  had  done  more  than  his  share  of \nthe  fighting,  marauding,  and  devastating  which \nwere  the  preliminaries  to  the  battle  of  Lepanto. \nIn  this  historic  conflict  he  was  to  show  once  again \nhow,  on  the  face  of  the  waters,  the  Sea-wolves \nwere  supreme  ;  as  it  was  he  and  his  corsairs,  out  of \nthe  whole  of  the  Moslem  host,  who  acquitted  them- \nselves with  the  greatest  credit  on  that  day  so  fatal \nto  the  arms  of  the  Ottoman  Turk.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

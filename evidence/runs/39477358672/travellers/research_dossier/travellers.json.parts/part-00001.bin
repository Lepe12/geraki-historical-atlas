      {
        "finding_id": "section-e62baa9fab0393cad905",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The hostis humani generis subsisting fitfully on the cruel seas beyond the \nreach of law was a fiction of territorial sovereignty. As Carl Schmitt put it, \nthe European tradition of public law was inscribed with a fundamental \nbinary opposition between land and sea. Land was the seat of sovereignty \nand law, whereas the seas were conceptualized as a realm of freedom over \nwhich sovereign power did not extend, or had only a tenuous reach.^ In \nthis context, the pirate inhabited an indeterminate domain; and hence \ntheir lives, however uncertain, were a defiance to the idea of sovereign \nstates.5 In Schmitt's narrative, the perpetual statelessness of pirates was \na necessary problem only up until the end of the eighteenth century. In \nthe nineteenth, territorial states had more effective means to project force \nat sea, and international law followed in their wake. By century's end, the \nanathema of the sovereign-less, stateless pirate had simply become an \nanachronism, not only in Europe but in most waters around the world.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

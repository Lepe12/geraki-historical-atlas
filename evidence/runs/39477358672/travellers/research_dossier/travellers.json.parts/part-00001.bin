      {
        "finding_id": "section-3e927978589b220c0500",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "discipline  or  command.  This,  be  it  observed,  was \nthe  theory.  As  a  matter  of  fact  the  corsairs,  who \nwere  extraordinarily  successful  in  their  abominable \ntrade,  abode  beneath  an  iron  and  rigid  discipline. \nThis  was  enforced  by  the  lash,  as  we  shall  see  later \non  when  it  is  related  how  Kheyr-ed-Din  Barbarossa \nflogged  one  Hassan,  a  captain  who,  he  considered, \nhad  failed  in  his  duty :  or  by  the  actual  penalty  of \ndeath,  which  Uruj  Barbarossa  inflicted  on  one  who \nhad  dared  to  act  independently  of  his  authority.",
        "years_in_scope": [],

          "start_char": 449506,
          "end_char": 450167,
          "start_line": 8409,
          "end_line": 8417,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",

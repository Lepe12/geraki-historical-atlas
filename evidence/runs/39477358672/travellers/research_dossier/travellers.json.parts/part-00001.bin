      {
        "finding_id": "section-a69d82455efced2ade7b",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Netherlands Indies recognized the independence of allied realms and vassal \nprincipalities in Celebes (Sulawesi) between 1871 and 1881. Though the \nCouncil of the Indies reconsidered this fact of their independence in the \n1890s, and the Minister of Colonies in 1902 denied self-governing realms \nany possibility of having their own territorial waters, these realms’ shores \nhad not previously been washed by the waters of the Netherlands East \nIndies.? Such efforts to extend colonial territorial control coincided with \ncolonial cooperation against “piracy” and the idea that it signalled native \nstate dissolution.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

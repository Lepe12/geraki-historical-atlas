      {
        "finding_id": "section-69e3dda7985c24859149",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "In this way the sins of bigotry and ignorance com- \nmitted by Spain and her rulers were visited upon her \nsons and daughters for many generations. The cruelties \nand oppression inflicted upon the Moors from 1492 until \nthe last wretched remnants were expelled from the \ncountry in 1609-10 were paid for in the mental and \nphysical suffering of un-numbered Christians for three \ncenturies. The corsairs, however, did not limit their \nreprisals to Spaniards ; every Christian nation suffered, \nand in the course of time so bold did the corsairs become \nfrom the knowledge of the mastery they held of the sea \nand the terror which their name inspired that their \nfleets sailed as far north as Iceland, and they brought \ncaptives for the harem and the slave-bench from the \nshores of England and Northern Europe.",
        "years_in_scope": [
          1609
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-da0e7287817e51dd7f33",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Aisa Reis, however, would hear no word of \nsurrender, telling those who murmured against the \ndefence that “if he heard a word more of these \nplots he would infallibly sacrifice every mother’s \nson amongst them, and then lay the town in ashes.” \nHaving already had a taste of the quality of this \nredoubtable corsair, and feeling perfectly certain \nthat should the occasion arise he would be as good \nas his word, there was no more disaffection among \nthe inhabitants, who had to put up with their \nnative place being made a cockpit for Doria and \nDragut to fight out their quarrel. It is permissible \nto sympathise very sincerely with these unfortunates, \nwho, having been betrayed in the first instance, \nwere compelled to stand a siege in the second.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

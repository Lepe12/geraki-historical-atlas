      {
        "finding_id": "section-ec1371425d5a59f9c7be",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "The  city  opened  its  gates  once  more,  and  Bar- \nbarossa entered  in  triumph.  The  corsair  was  as \ngood  as  his  word  to  his  Spanish  captives,  and \nrestored  to  them  their  liberty.  He  went  even \nfurther,  and  was  liberal  in  his  largesse  to  those \nwho  had  fought  so  well  for  him.  If  he  can  be \ncredited  with  such  an  emotion  as  gratitude,  he \nmust  have  felt  it  for  Moncada's  stout  infantrymen, \nas,  had  it  not  been  for  them,  it  would  have  been \nhis  head  and  not  that  of  Venalcadi  which  would",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

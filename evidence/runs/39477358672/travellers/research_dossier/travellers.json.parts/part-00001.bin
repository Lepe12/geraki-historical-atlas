      {
        "finding_id": "section-fd414b3d8d8269d6a96a",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Contrary  to  all  precedent,  which  enjoins  the \nmost  perfect  silence  in  the  mosque,  these  bold \nutterances  were  received  with  something  more \nthan  murmurs  of  applause  :  never  in  all  his  long \nand  glorious  reign  had  the  great  and  magnificent \ndespot  heard  so  plainly  the  voice  of  his  people. \nApart,  however,  from  eunuchs,  women,  and  Mullahs, \nSoliman  had  long  been  importuned  by  Dragut  to  take \nthe  course  which  was  now  being  urged  upon  him  with \nso  much  insistence.  There  was  at  this  time  no \nwarrior  in  all  his  entourage  for  whose  opinion  the \nSultan  had  the  same  respect  as  he  had  for  that  of \nthe  ruler  of  Tripoli.  Dragut  had  more  than  a \ntincture  of  learning  :  he  was  first  of  all  an  incompar- \nable leader  of  men  and  an  entirely  competent  seaman. \nHe  was  also  a  scientific  artillerist,  and  was  learned \nin  the  technique  of  the  fortification  of  his  time. \nAdded  to  this  he  was — albeit  by  no  means  so  cruel \nas  most  of  his  contemporaries — one  of  those  men \nbefore  whom  all  trembled  :  as  we  have  seen  in  the \ncase  of  the  corsairs  who  defended  \"  Africa/'  \"  they \nfeared  the  wrath  of  Dragut  more  than  death  itself.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/seawolvesofmedit00curruoft",
          "source_file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
          "start_char": 592000,
          "end_char": 593291,
          "start_line": 12346,
          "end_line": 12367,
          "printed_page": null,

      {
        "finding_id": "section-03454adede9700c792eb",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "In  addition  to  the  fifteen  galleys  which  Kheyr- \ned-Din  picked  up  at  Bona  he  had  in  reserve  at \nAlgiers  some  fifty  others.  Escaping  the  attention \nof  Adan  Centurion  and  John  Doria,  and  the  in- \nfinitely more  formidable  squadron  of  Andrea,  he \nheaded  once  more  for  Algiers,  and  for  a  time \nseems  to  have  remained  quiet,  no  doubt  recupera- \nting from  the  fatigues,  disappointments,  and \nphysical  hardships  which  he  had  so  recently  under- \ngone. He  was  apparently  undisturbed  during  the \nwinter  by  his  Christian  enemies,  and  was  in  con- \nsequence able  to  think  out  his  future  plans  of \ncampaign  and  to  collect  and  put  heart  into  his \nscattered  followers,  who,  in  ones  and  twos,  were \ngradually,  such  of  them  as  were  left,  finding  their \nway  back  to  the  headquarters  of  piracy  and  its \nindomitable  chieftain.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

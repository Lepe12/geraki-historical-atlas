      {
        "finding_id": "section-b86bff8b487824b20f18",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "It  is  of  this  legacy  that  we  have  to  speak,  and \nthere  has  been  none  more  terrible,  none  fraught \nwith  more  awful  suffering  for  the  human  race. \nThe  broken  hosts  of  the  Moslem  chivalry  became \nthe  corsairs  of  the  Mediterranean  :  ruthless  pirates \nfreed  from  all  restraint  of  human  pity,  living  only \nto  inflict  the  maximum  of  suffering  upon  their \nChristian  foes,  who,  having  sown  the  wind  at  the \ntaking  of  Granada,  reaped  in  the  coming  centuries \na  whirlwind  of  blood  and  agony  which  continued \ndown  to  the  bombardment  of  Algiers  by  Loi'd \nExmouth  in  1816,  and  even  later  than  that  date.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/cu31924087978445",
          "source_file": "cu31924087978445_cu31924087978445_djvu.txt",
          "start_char": 66115,
          "end_char": 66794,
          "start_line": 1556,
          "end_line": 1567,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,

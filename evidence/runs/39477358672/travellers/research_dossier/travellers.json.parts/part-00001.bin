      {
        "finding_id": "section-3f8ff03f969363843efa",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "With  the  results  to  Europe  of  this  amazing \nbattle  we  have  nothing  to  ^do  in  this  book.  That \nwhich  it  demonstrated,  as  far  as  the  Sea-wolves \nwere  concerned,  was  that  they  still  remained  the \nmost  competent  seamen  and  sea-fighters  in  the \nMediterranean,  and  that  the  legend  of  the  invinci- \nbility of  the  Ottomans  at  sea  rested  on  what  had \nbeen  accomplished  during  a  long  period  of  years  by \nthese  insatiable  pirates  and  magnificent  warriors.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

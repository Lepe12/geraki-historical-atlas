          "start_char": 640635,
          "end_char": 641351,
          "start_line": 12118,
          "end_line": 12127,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false

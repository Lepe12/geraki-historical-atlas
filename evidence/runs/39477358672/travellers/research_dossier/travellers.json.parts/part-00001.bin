      {
        "finding_id": "section-e48a6aee20a5d448b44b",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "A  corsair,  who  had  been  slave  to  the  Knights, \nnow  approached  Sinan,  and  told  him  that  he  had \nassisted  at  the  building  of  the  fortress ;  which,  he \naverred,  was  so  strong  that  if  the  admiral  delayed \nuntil  he  had  taken  it  that  the  winter  would  be \nupon  them,  although  it  was  then  only  the  month \nof  July.  Sinan,  as  we  have  said,  was  a  hesitating \ncommander.  He  had  the  ever-present  fear  of  the \nGrand  Turk  before  his  eyes,  and  was  not  inclined \nfor  so  difficult  and  dangerous  an  enterprise  as  this \nwas  represented  to  be.     Leaving  the  fortress  in  his",
        "years_in_scope": [],

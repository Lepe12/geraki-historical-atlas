      {
        "finding_id": "section-fd8d54fbabecc62054d2",
        "file": "d93d6b79e1279425698c8392.txt",
        "title": "[Noel Malcolm, Agents of Empire: Knights, Corsairs, Jesuits and Spies in the Sixteenth Century Mediterranean World, London: Allen Lane, 2015, xxv+604 pp., ISBN: 978-019-0262-78-5.]",
        "url": "https://makale.isam.org.tr/server/api/core/bitstreams/8f3e2fcd-854b-49c7-b4da-cee67ce08071/content",
        "source_bibliography": {
          "creator": null,
          "date": null,
          "source_type": null,

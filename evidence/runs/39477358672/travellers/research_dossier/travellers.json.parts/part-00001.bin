      {
        "finding_id": "section-d0958ed0577a099c4264",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Constans's reference to comic opera pointed to a further dimension of \nthe discourse of piracy in the context of French colonisation in Indochina, \nnamely, the role that pirates played in popular culture in France. The last \ndecade of the nineteenth century and the first decade of the twentieth \ncentury saw an unprecedented output in France of novels and short stories \nabout piracy set in Indochina, in addition to numerous purportedly true \naccounts by French colons, soldiers, and travellers of their encounters with \npirates in the region. The subject offered a fruitful terrain for the authors \nof the genre to explore, and the books and stories were often successful in \nterms of sales and public appreciation. The scene was an exotic and ominous \ncountry, far from France both culturally and geographically. There was a \nwealth of dramatic effects that could be exploited and associated with",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

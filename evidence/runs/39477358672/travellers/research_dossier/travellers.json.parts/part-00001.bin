      {
        "finding_id": "section-4435f1c3d1faa943457d",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Edward Teach was a Bristol man born, and took to the \nsea when young. He sailed out of Bristol on board a \nprivateer which some merchants there fitted out during \nthe French wars. He exchanged from one privateer to \nanother, always as a common sailor, distinguishing himself \nby personal bravery and reckless daring. About the \nend of the year 1716 he joined a well-known pirate in the \nWest Indies named Captain Benjamin Hornygold, by \nwhom he was put in charge of a big French Guineaman \nwhich the pirates had captured. After a successful \ncruise in this vessel he was put in a sloop, and went ona \nvoyage as consort to Hornygold himself. Then Teach \nand his friend and captain fell out. Hornygold was \nbecoming afraid of his profession, and was for taking \nadvantage of the King’s proclamation which had just \nbeen published at Providence, promising the King’s \nmercy to all pirates if they surrendered by a certain date.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/bookofpirates0000gilb",
          "source_file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
          "start_char": 434724,

      {
        "finding_id": "section-0dea6ff171971f715586",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "The  strain  must  have  been  great,  the  effort \nenormous,  and  he  knew,  as  he  was  bound  to  know, \nthat  his  coming  had  unloosed  jealousies  and  heart- \nsearchings  innumerable,  with  which  he  could  not \ndeal  in  the  usual  drastic  fashion  common  to  him. \nThe  winter  was  coming  on,  which  was,  as  we  have \nbefore  remarked,  very  much  of  a  close  season  both \nfor  the  pirate  and  the  honest  merchant  seaman. \nIn  consequence  there  was  not  very  much  chance \nagainst  the  foes  of  Soliman  for  the  present.  When \nthat  opportunity  offered  he  promised  himself  that",
        "years_in_scope": [],

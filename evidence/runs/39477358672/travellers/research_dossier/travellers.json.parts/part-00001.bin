        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "He now proposed to return and render an account of his \nexpedition to the wealthy men who had fitted him out, \nbut when the crew learned of this most of them left him, \nnot caring to return to humdrum methods of existence. \nA good many joined the pirate Culliford, while others \nstrayed off into Madagascar. Kidd was left with about \nforty men. apy",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/bookofpirates0000gilb",
          "source_file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",

      {
        "finding_id": "section-a10538ec9e546a9b147b",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "One word in conclusion. That which they did \nhas been set down here; the record, however, is \nnot complete, as many of their acts of cruelty, lust, \nand oppression are not fitted for publication in the \npresent day. It has been said, with truth, that no \nman is much better or much worse than in the age \nin which he lives ; and to hold the scales evenly— \nif one were tempted to shock contemporary opinion \nby too literal a transcript of all that was done by \nthe corsairs—it would also be necessary to cite \nthe reprisals of their Christian antagonists. It has \nseemed better to leave such things unchronicled : \nto present, with as much fidelity as possible, the \npublic lives and acts of these troublers of the peace \nof the sixteenth century. Looking back, as we do, \nover three hundred and fifty years, and judging as \nfairly as is possible, it would seem that there is \nlittle which can be said in their favour.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

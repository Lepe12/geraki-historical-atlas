      {
        "finding_id": "section-0eb9fb896166adbc00f4",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Uruj  had  arrogated  to  himself  the  title  of  King \nof  Tlemcen,  but  with  his  death  this  shadowy \nsovereignty  came  to  an  end,  and  the  Spaniards \nseized  upon  the  province.  This,  however,  did  not \navail  them  much,  as  the  Sultan  of  Fez  sent  against \nthem  an  innumerable  army,  and  they  in  their  turn \nwere  dispossessed.  It  was  in  the  year  1518  that \nUruj  fell  beneath  the  pike  of  Garzia  de  Tineo,  and \nnow  the  first  place  in  the  piratical  hierarchy  was \ntaken  by  Kheyr-ed-Din.  In  this  man  the  genius \nof  the  statesman  lay  hidden  beneath  the  outward \nsemblance  of  the  bold  and  ruthless  pirate  ;  ever \nforemost  in  the  fight,  strong  to  endure,  swift  to \nsmite,  he  had  by  now  long  passed  his  novitiate,  had \nestablished  an  empire  over  the  minds  of  men  which \nwas  to  endure  until  the  end  of  his  unusually  pro- \nlonged life.  With  a  brain  of  ice  and  a  heart  of \nfire,  he  looked  out,  serene  and  calm,  upon  the \nturbulent  times  in  which  he  hved,  a  monstrous \negotist  desiring  nothing  but  his  own  advancement, \nall  his  faculties  bent  upon  securing  more  wealth \nand  yet  more  power.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/cu31924087978445",
          "source_file": "cu31924087978445_cu31924087978445_djvu.txt",

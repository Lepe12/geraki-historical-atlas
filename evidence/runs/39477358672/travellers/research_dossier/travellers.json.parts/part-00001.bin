      {
        "finding_id": "section-7901f9cd71867cbe5602",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "With the money I had now made I bought a small \nplantation, and though I was but twenty-two years of \nage I thought to settle down and earn a modest com- \npetence as a planter. But, as you shall hear, my friend \nCaptain Henry Morgan drew me forth again later to share \nsome of his famous exploits among the idolatrous and \nhaughty Spaniards. Through several of the crew who \nsailed with Lolonais, I heard of all that befell them on \ntheir next ill-fated expedition. A huge storm drove \nthem on shore when they reached the coast of Campeachy. \nAll the men were saved, but the Spaniards were watching \nthem as they struggled ashore, and killed most of them \nwhen they came up into the forest. The pirates fought \nvaliantly, but they were outnumbered, and Lolonais \nonly saved himself by hiding under the bodies of his dead \nshipmates. When the Spaniards quitted the place he \ncrawled forth, killed a half-breed and assumed his dress,",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/bookofpirates0000gilb",
          "source_file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
          "start_char": 369505,
          "end_char": 370436,
          "start_line": 9523,
          "end_line": 9539,
          "printed_page": null,
          "scan_indexes_0_based": [],

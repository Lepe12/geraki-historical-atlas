      {
        "finding_id": "section-ab789d37f193a100cdd5",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Very  soon  the  Moslems  acquired  the  habit  of  the \nsea,  and  very  soon  the  Christian  States  discovered \nhow  different  was  the  Mohammedan  dwelling  at \npeace  in  Andalusia,  or  at  worst  fighting  with  his \nco-religionists,  to  the  desperate  corsairs  created  by \ntheir  own  act  who  now  ravaged  the  shores  of  the \ntideless  sea.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/cu31924087978445",
          "source_file": "cu31924087978445_cu31924087978445_djvu.txt",

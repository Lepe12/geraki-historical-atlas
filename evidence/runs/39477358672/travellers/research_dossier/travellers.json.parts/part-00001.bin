      {
        "finding_id": "section-034e7aa329427f77f8b6",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Uruj  Barbarossa  was  undoubtedly  a  remarkable \nman.  At  a  time  when  the  Mediterranean  swarmed \nwith  warriors  none  was  more  feared,  none  was \nmore  redoubtable  than  he.  By  sheer  valour  aind \ntenacity  he  had  fought  his  way  to  the  front,  and \nthe  son  of  the  obscure  renegado  of  Mitylene  died \na  king.  It  is  true  that  his  sovereignty  was  pre- \ncarious, that  it  was  maintained  at  the  edge  of  the \nsword  ;  none  the  less,  in  that  welter  of  anarchy \nin  which  he  lived  he  had  forced  himself  to  the \nsummit,  and,  pirate,  sea-wolf,  and  robber  as  he \nwas,  we  cannot  withhold  from  him  a  meed  of  the \nmost  hearty  admiration.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

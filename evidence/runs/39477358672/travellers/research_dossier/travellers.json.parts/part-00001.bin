      {
        "finding_id": "section-1db0fcb0798711a8243f",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "It  is  the  autocrat  who  is  made  by  the  circum- \nstances of  his  life  who  ultimately  becomes  supreme. \nThe  leaders  among  the  corsairs  were  tried  by  every \ntest  of  prosperity  and  of  adverse  fortune  ;  they \nemerged  from  the  ruck  in  the  first  instance  because \nit  was  in  them  to  display  a  more  desperate  valour \nthan  did  their  contemporaries,  and  it  was  only \nwhen  they  emerged  triumphant  from  this,  the \nfirst  test,  that  they  could  begin  to  impose  their \nwill  upon  others.  It  was  then  that  their  real \ntrials  began,  as  the  undisciplined  are  ever  prone \nto  suspicion,  much  given  to  murmuring  against \na  leader  who  is  not  perpetually  successful.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/cu31924087978445",
          "source_file": "cu31924087978445_cu31924087978445_djvu.txt",
          "start_char": 56074,
          "end_char": 56808,
          "start_line": 1347,
          "end_line": 1359,
          "printed_page": null,

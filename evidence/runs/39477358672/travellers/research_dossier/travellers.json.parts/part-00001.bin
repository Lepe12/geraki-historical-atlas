      {
        "finding_id": "section-60558cdd03b7be7ef3ff",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "\"  My  ambition,\"  said  the  silver-tongued  corsair, \n\"  is  to  become  a  citizen  of  your  great  and  beautiful \ncity.  If  you  will  admit  me  to  its  privileges  it \nshall  be  my  business  to  render  you  the  richest \npeople  in  the  whole  Mediterranean,  and  your  city \nthe  most  dreaded  place  in  the  world.\"",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

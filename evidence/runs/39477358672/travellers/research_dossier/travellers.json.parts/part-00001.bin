      {
        "finding_id": "section-bc2a64725f93e6c15ec7",
        "file": "esclaveschretiensmaitresmusulmans._Esclaves_chretiens_Maitres_musulmans._djvu.txt",
        "title": "Esclaves Chretiens, Maitres Musulmans.",
        "url": "https://archive.org/details/esclaveschretiensmaitresmusulmans.",
        "source_bibliography": {

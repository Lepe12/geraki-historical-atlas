      {
        "finding_id": "section-a78c85bb75956d3f8f31",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "On other occasions Cesar delivered orations to the \npirates, and even recited some of his poems to them. \nHe saw, indeed, that they had no appreciation for any- \nthing so strange to their way of life as oratory and \npoetry; but his masterful and imperious character, \nwhich knew no fear of their brutal natures, caused him \nto impress himself upon them in this way. And so great \na mixture of pleasantry and mastery was in his bearing \nto these men that some began to feel the charm which \nin later years he exercised so powerfully over his rough \nsoldiers in Spain and Gaul. Micio in particular felt a \nkind of devotion for this fearless and wonderful stranger, \nand often went aside to speak to Czsar, who treated \nhim with the haughty familiarity which a great man \nmight show for a freedman or favourite slave.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

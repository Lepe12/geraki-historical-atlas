      {
        "finding_id": "section-638eb9d37614df40d80d",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "At length a cry akin to horror arose: ‘“‘ They come over \nthe stern! To the stern, lads, and beat them off the \npoop!” It was true. Here was a swarm from the \nthird galley pouring over the high bulwarks of the \nsterncastle, and the men of the weak guard that had been \nstationed there were dead or dying. At the same time \nthe corsairs to port and starboard made another deter- \nmined onslaught. The Christians, disheartened by the \nsight of the new foes running down from the stern, had \nlittle further fight in them and soon were overpowered. \nThe dead were cast overboard, as well as those whose \nwounds were severe; while those who still lived were \nmanacled and thrust below.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

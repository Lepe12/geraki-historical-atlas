        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Dynasty presided over a formidable navy, which it used to suppress the \nChinese pirates who had allied with the Tay Son rebels during the upheaval \nof the previous decades.?? In the 1820s, the Vietnamese navy reportedly \nconsisted of around 200 large boats armed with between 16 and 22 cannons \neach, in addition to 100 large and 500 small galleys armed with cannons \nand catapults. By the 1850s, however, the maritime forces had deteriorated \nto the point that they were unable to fend off the depredations of Chinese \nand Vietnamese pirates.?^",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 650883,
          "end_char": 651428,
          "start_line": 12321,
          "end_line": 12328,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

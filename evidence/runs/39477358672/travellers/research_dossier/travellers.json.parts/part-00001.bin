      {
        "finding_id": "section-d3cbb01bd31579a72030",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "It  was  the  custom  of  the  corsair  and  his  chief \nadherents  to  attend  the  principal  mosque  on \nFridays  ;  and  therefore,  when  the  conspirators  were \ncordially  invited  to  attend  on  the  following  Friday, \nand,  after  the  service  was  over,  to  attend  Uruj  to \nhis  dwelling  and  there  confer  with  him,  they  went, \nnothing  doubting,  to  their  deaths.  As  the  discourse \nof  the  Mullah  came  to  an  end  a  crash  resounded \nthroughout  the  building :  six  stalwart  swordsmen \nhad  flung  the  great  gates  of  the  mosque  together, \nand  barred  all  exit.  Excepting  the  conspirators, \ntwenty-two  in  number,  the  remainder  of  the  edi- \nfice was  filled  with  the  galley's  crews  of  the \ncorsair,  men  who,  had  he  given  the  order,  would \nhave  cheerfully  set  alight  to  the  sacred  building \nitself  and  roasted  the  Mullahs  themselves  in  the \nflames.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

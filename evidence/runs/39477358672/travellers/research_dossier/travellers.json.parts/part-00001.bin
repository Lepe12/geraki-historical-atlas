      {
        "finding_id": "section-58558840ef62e7d135cb",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "he  left  in  the  keeping  of  his  son  Hassan,  and  in \ncharge  of  Hassan  his  kinsman  Celebi  Rabadan  and \na  captain  of  the  name  of  Agi.  In  the  middle  of \nAugust,  1533,  Barbarossa  left  Algiers,  his  fleet \nconsisting  of  seven  galleys  and  eleven  fustas. \nSailing  northward,  he  fell  in  with  a  fleet  which \nhe  at  first  feared  was  that  of  Doria,  but  which, \nfortunately  for  him,  was  that  of  a  corsair  named \nDelizuff  from  Los  Gelues.  Courtesies  were  inter- \nchanged between  the  two  leaders,  and  Barbarossa \nsucceeded  in  persuading  Delizuff  to  accompany \nhim  to  Sicily,  where  it  was  possible  they  might \nfall  in  with  Doria,  and  with  their  combined  forces \ninflict  defeat  upon  the  Christian  admiral.  Delizuff \nwas  nothing  loath  to  join  forces  with  so  noted  a \ncommander  as  Kheyr-ed-Din,  as  he  had  no  desire \nto  tackle  Doria  single-handed,  and  at  the  same \ntime  wished  to  extend  the  sphere  of  his  plunder- \nings,  which  had  been  cruelly  restricted  recently  by \nthe  wholesome  fear  instilled  into  the  Sea-wolves \nby  the  new  admiral  of  Charles  V.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

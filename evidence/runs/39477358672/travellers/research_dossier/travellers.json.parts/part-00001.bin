      {
        "finding_id": "section-97b47dd2ad9198593cbe",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "It was an appeal for aid to the Moslem corsairs \nfrom Algiers, from Tlemcen, from Oran, from Los \nGelues (or Jerbah), and from all the countless \nislands of the Archipelago, where they lurked to \nseize their prey—Tunis, which flew the Crescent \nflag of the Prophet, was in danger—let them rally \nagainst the grandson of the man who expelled \nthe Moors from Spain.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-b0541ce2ed90727ea4ad",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "Hardly,  however,  had  the  brothers  succeeded  in \nthis  enterprise  when  that  tireless  fighter  Uruj \nagain  attempted  the  capture  of  Bougie ;  but  his \nsecond  attempt  was  even  more  disastrous  than  his \nfirst,  and  he  lost  half  his  flotilla.  Then  he  asked \nfor  succour  from  Tunis ;  but  the  Sultan,  much \noffended  at  the  idea  of  the  brothers  setting  up  in \na  piratical  business  in  which  he  was  no  longer  a \nsleeping  partner,  angrily  refused.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

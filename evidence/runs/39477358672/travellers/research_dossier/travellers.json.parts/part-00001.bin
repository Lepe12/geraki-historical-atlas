          "end_char": 324952,
          "start_line": 6179,
          "end_line": 6189,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },

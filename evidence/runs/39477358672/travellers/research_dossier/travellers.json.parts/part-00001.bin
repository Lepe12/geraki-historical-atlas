      {
        "finding_id": "section-a0723f767c5e5121d53a",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "The  corsair  must  have  meditated  long  and \nanxiously  on  the  best  way  in  which  to  approach \nthe  autocrat  of  Constantinople ;  in  the  end  he \nprobably  hit  upon  the  best  solution  of  the  problem \nby  again  sending  an  ambassador  with  precise \ninstructions  as  to  the  manner  in  which  he  was \nto  act.  For  this  important  service  his  choice  fell \nupon  one  of  his  captains,  Hadj-Hossein  by  name, \nand  to  him  he  imparted  all  that  he  was  to  say, \nand — what  was  almost  as  important — what  he  was \nnot  to  say.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/cu31924087978445",
          "source_file": "cu31924087978445_cu31924087978445_djvu.txt",
          "start_char": 151540,
          "end_char": 152108,
          "start_line": 3345,
          "end_line": 3355,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

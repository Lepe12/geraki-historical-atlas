      {
        "finding_id": "section-c58da14b4dbf1dbe5c9a",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "almost  without  striking  a  blow,  Uruj  found  himself \nmaster  of  a  province  from  which  the  Spaniards \nwere  accustomed  to  draw  the  necessary  provisions \nfor  the  upkeep  of  the  garrison  of  Oran.  But \nTlemcen  is  but  some  seventy  miles  from  Oran, \nand  Oran  is  so  close  to  Spain  as  to  be  easily \nreinforced  ;  in  consequence  Uruj  was  soon  block- \naded by  the  Spaniards,  and  remained  so  for  seven \nmonths.  But  no  blockade  could  keep  Uruj  Bar- \nbarossa  for  long  within  stone  walls ;  sortie  after \nsortie  did  the  gallant  corsair  lead  against  the  foe, \nand  it  was  in  one  of  these  that  he  characteristically \ncame  by  his  death.  Ever  rash  and  impetuous,  he \nallowed  himself  to  be  drawn  too  far  away  from \npossible  shelter  or  support ;  and,  as  there  was \nsomething  dramatic  in  the  whole  life  of  this  man, \nso  also  was  there  in  the  manner  of  his  death. \nThey  had  him  trapped  at  last,  this  grim  Sea-wolf, \nand  he  stood  at  bay  in  a  stone  corral  used  for  the \nherding  of  goats.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "For forty days this wholesale ‘ round up ’of pirates was \ncontinued, with such energy that it was seen that the \nwestern waters were practically cleared of the rovers. \nThere was still a great number in the eastern seas, however, \nwho included the most bloodthirsty and the fiercest of \nthe corsairs. These had sent their families, treasures, \nand slaves into secret fastnesses among the glens and \nprecipices of Mount Taurus, while they themselves, \nmanning their galleys, resolved to join in one last attempt \nto crush their conqueror.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

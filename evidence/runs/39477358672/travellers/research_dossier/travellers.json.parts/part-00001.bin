      {
        "finding_id": "section-1efe867a8934857edbb4",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "That  which  is  most  extraordinary  in  the  life \nof  Kheyr-ed-Din  is  the  perpetual  danger  and \nstress  in  which  it  was  lived.  Time  and  again \nthe  heavy  menacing  clouds  gathered  around  his \nhead ;  strenuous  and  unceasing  were  the  efforts \nmade  by  his  enemies  to  destroy  his  power,  to \ncapture  the  person  of  this  militant  robber  who \nflung  an  insolent  defiance  to  the  whole  of  Christen- \ndom. The  storms  gathered  and  broke  with  various \neffects,  which  sometimes  sent  the  corsair  flying \nfor  his  life  a  hunted  fugitive,  as  others  saw  him \nonce  more  victorious.  But  no  reverses  had  the \npower  to  damp  his  ardour,  or  to  render  him  less \neager  to  arise,  like  some  ill-omened  phoenix,  from \nthe  ashes  of  defeat :  to  vex  the  souls  of  those \nwho  held  themselves  to  be  the  greatest  men  on \nearth.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

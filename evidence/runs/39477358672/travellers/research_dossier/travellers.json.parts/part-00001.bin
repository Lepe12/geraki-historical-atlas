      {
        "finding_id": "section-2e9de336f2fb559ed142",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "We  who  in  the  present  day  sit  in  judgment \nupon  the  virtues  and  vices  of  a  bygone  age  can, \nin  the  ordered  security  of  our  modern  civilisation, \nsee  many  things  which  were  hidden  from  our  fore- \nfathers, even  as  in  another  three  hundred  years  our \ndescendants  will  be  able  to  point  the  finger  of  scorn \nat  the  mistakes  which  we  are  now  committing. \nWe  have  seen  how  it  was  that  the  pirate  States \narose ;  we  have  seen  also  how,  in  future  genera- \ntions, they  were  allowed  to  abide.  We  cannot,  in \ncommon  honesty,  echo  the  words  already  quoted \nof  the  historian  that  \"  these  are  the  judgments  of \nGod,  and  things  ordered  by  His  divine  providence \nand  infinite  wisdom,\"  neither  can  we  acquit  the \nheirs  of  the  ages  for  that  slackness  which  pre- \nvented them   from  doing  their  duty ;  we  have,",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-3bfa21329aecfb6488bf",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Sidi ben Muza, seated at the tiller, directed the course \nof the brigantine toward the Spanish coast. The term \nbrigantine did not then have anything like the meaning \nnow attached to it. The pirates of the Barbary coast \nused the word to denote a large rowing-boat, carrying \nfrom sixteen to twenty-six or thirty oars. A mast could \nbe stepped and a sail hoisted when conditions were \nspecially favourable, but the boat being hardly fit for the \nopen sea and all chances of weather it was the ambition \nof every young pirate to seize or purchase a galley, \nto be manned by Christians captured in a raid, who \nwould be chained three or four to a bench, and would \nbe whipped if the heavy oars which they had to pull \nwere not served smartly enough. Some twenty-four \nworked the oars of the brigantine, but there were some \ntwenty more fighters who took turns with them, who \nwere lodged in the vambades or prow, and Sidi with \nhis five subordinate officers lived in a little cabin on \nthe poop.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

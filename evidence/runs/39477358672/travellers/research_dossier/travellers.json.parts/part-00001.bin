      {
        "finding_id": "section-8538a02cff2333b25f38",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "In the choking heat of the African night towns- \nmen and corsairs wrestled in deadly conflict hand \nto hand and foot to foot; but these untrained \nlandsmen stood but a poor chance against the picked \nfighting men of the Moslem galleys who had been \ninured to bloodshed from their earliest youth and \ntrained by such a master in the art of war as \nDragut. That warrior, his great curved scimitar \nred to the hilt, the blood dripping from a gash in \nhis cheek, his clothing torn and in disarray, followed \nby a gigantic negro bearing a flaming torch, was \never in the thickest of the fray. Behind him his \nlieutenants Othman and Selim strove to emulate \nhis prowess, while all around surged his devoted \nband of fanatics.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

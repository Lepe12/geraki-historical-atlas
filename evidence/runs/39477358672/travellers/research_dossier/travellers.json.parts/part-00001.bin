      {
        "finding_id": "section-e3d7823354a6fbd3e1c8",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "But  \"the  corsair\"  kept  his  head,  and  kept  his \ntemper,  and  saved  the  Ottoman  fleet  for  his  master \nfrom  his  great  rival,  Doria.  That  noble  Genoese \nseaman  was  for  once  in  his  life  \"  letting  I  dare \nnot  wait  upon  I  would  \"  ;  he  would  not  order  the \nattack  for  which  his  men  were  waiting,  and  no \nprovocation,   apparently,  could   tempt   Barbarossa",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-55eb49eb2fa15bdbea55",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "It  was  an  appeal  for  aid  to  the  Moslem  corsairs \nfrom  Algiers,  from  Tlemcen,  from  Oran,  from  Los \nGelues  (or  Jerbah),  and  from  all  the  countless \nislands  of  the  Archipelago,  where  they  lurked  to \nseize  their  prey — Tunis,  which  flew  the  Crescent \nflag  of  the  Prophet,  was  in  danger — let  them  rally \nagainst  the  grandson  of  the  man  who  expelled \nthe  Moors  from  Spain.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

      {
        "finding_id": "section-d5929cb1346640e95e5e",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "We  have  spoken  of  the  two  weapons  held  by \nthe  leaders  of  the  Sea-wolves.  The  first,  as  we \nhave  said,  was  cupidity  ;  the  second  was  fanaticism, \nthe  deadly  religious  hatred  engendered,  not  only \nby  the  wholesale  expropriation  of  the  Moslem \npopulation,  but  also  by  the  persecution  to  which \nthe  Moriscoes — as  those  Moslems  were  known \nwho  remained  in  Spain — were  subjected  by  their \nChristian  masters.  It  requires  little  imagination \nto  see  how  these  two  weapons  of  avarice  and \nintolerance  could  be  made  to  serve  the  purpose \nof  those  dominant  spirits  who  rose  to  the  summit \nof  the  piratical  hierarchy.  Not  only  did  they \ndazzle  the  imaginations  of  those  who  followed \nin  their  train  by  promises  of  wealth  uncounted, \nbut  they  added  to  this  the  specious  argument \nthat,  in  slaying  and  robbing  the  Christian  where- \nsoever he  was  to  be  found,  the  faithful  Moslem \nwas  performing  the  service  of  God  and  the  act \nmost  grateful  to  his  holy  Prophet.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

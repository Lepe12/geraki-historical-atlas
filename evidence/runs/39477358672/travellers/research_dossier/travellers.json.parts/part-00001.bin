      {
        "finding_id": "section-98aa4c9acf35b373dd54",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "For some years thereafter Sidi ben Muza carried on \nhis depredations through the length and breadth of the \nMediterranean, his following growing every year, and his \nbold exploits becoming more daring and successful. \nMany expeditions were sent out against him by Genoa, \nVenice, Spain, and the Pope. Sometimes these fleets \nsucceeded in vanquishing some of the galleys belonging \nto the corsair, but any such success was always followed \nby some particularly bold stroke against his enemies \nwhich brought the balance again in his favour.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/bookofpirates0000gilb",
          "source_file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
          "start_char": 252139,
          "end_char": 252678,
          "start_line": 6648,

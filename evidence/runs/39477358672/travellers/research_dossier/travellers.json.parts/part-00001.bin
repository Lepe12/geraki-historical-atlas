        "occurrence_count": 1
      },
      {
        "finding_id": "section-39cd70b0f33d314b8bd1",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The error of reading the history of piracy as a genealogy of international \ncriminality is compounded when historians assume that early modern \ncourts were in fact invoking universal jurisdiction. In his chapter in this \nvolume, Kempe illustrates this problem when he asserts that George Cusack \nwas charged in a British court for crimes against the laws of nations. The \nquote comes from a pamphlet about the case, one of two that, as Kempe \nnotes, reproduced inflammatory rhetoric about pirates as enemies of all \nand highlighted Cusack's indiscriminate raiding in order to ratchet up \npopular enthusiasm for his prosecution and punishment. Yet, as Kempe \nalso seems to acknowledge without foregrounding, English courts were \nnot in the business of enforcing \"international\" law, and judges, even if \nthey referenced piracy as a violation of naturallaw, could not characterize \n\"international\" law consistently. Prize courts did not offer greater clarity. \nAlthough operating according to law with elements shared across European \nborders, prize courts did not bring criminal charges but adjudicated the \nownership of captured ships and cargoes. British admiralty courts could \ntry mariners for piracy, but in the long eighteenth century they seemed to \ngrasp at \"any excuse not to convict foreigners of piracy.\" Jurisdictional \npuzzles pervaded actions against piracy across centuries. In Cusack's case, \nalthough the judge alluded to the universal nature of piracy as a crime, he \nalso grasped the necessity of establishing the foundations for the court's \njurisdiction over Cusack's acts of mutiny and robbery at sea.\" No amount \nof rhetoric about Cusack's depravity or pirates' calumny could convert his \nprosecution into an act of \"international\" justice.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 701630,
          "end_char": 703392,
          "start_line": 13329,
          "end_line": 13352,
          "printed_page": null,
          "scan_indexes_0_based": [],

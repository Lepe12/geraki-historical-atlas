      {
        "finding_id": "section-791c445e59f2012c3b17",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Saihng  from  Tunis  in  the  spring  of  the  year \n1512,  the  brothers,  with  three  galleys,  fell  in  with \nThe  Galley  of  Naples,  an  enormous  nef  with  a \ncrew  of  three  hundred.  They  instantly  attacked, \nbut  were  repulsed,  night  falling  without  either  side \nhaving  gained  an  advantage.  This  audacious  pro- \nceeding illustrates  the  hardihood  of  the  Moslem \ncorsairs  at  this  time.  They  were  amply  strong \nenough  to  range  the  Mediterranean  and  to  capture, \nwith  no  risk  to  themselves,  the  weak  and  unpro- \ntected argosies  plying  their  trade  in  this  sea  ;  but \nthis  was  not  the  method  of  the  Barbarossas. \nVillains  they  may  have  been  according  to  modern \nstandards,  pirates  they  were  unquestionably ;  but \nthey  were  grim,  hard-bitten,  fighting  men,  who  shrank \nfrom  no  dangers  in  the  pursuit  of  their  prey,  who \nreckoned  that  the  humiliation  and  defeat  of  their \nChristian  antagonists  was  as  sweet  a  morsel  as  the",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/cu31924087978445",
          "source_file": "cu31924087978445_cu31924087978445_djvu.txt",

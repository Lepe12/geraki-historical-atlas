      {
        "finding_id": "section-7b75fbed9b2b4b3d29f4",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "them  to  terrible  straits  ;  immediately  afterwards \nthe  action  of  the  Grand  Turk  once  more  set  them \nupon  their  feet  and  enabled  them  to  pursue  an \nunchecked  career  of  devastation.  Aided  by  the \nreinforcements  sent  by  Selim,  their  depredations \nassumed  ever  larger  proportions,  and,  had  they \ncontinued  to  receive  this  assistance,  the  course  of \nhistory  itself  might  have  been  changed.  Ground \nto  powder  beneath  the  iron  heel  of  their  ruthless \nconquerors,  the  Moriscoes  of  Southern  Spain  were \never  waiting  the  chance  to  rise  and  shake  off  the \nyoke  by  which  they  were  so  sore  oppressed  ;  from \nfar  and  near  reports  were  coming  to  hand  of \nthe  continued  successes  of  the  corsairs,  and  all \nAndalusia  seethed  with  passionate  hope  that  the \nday  of  deliverance  was  at  ,hand.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

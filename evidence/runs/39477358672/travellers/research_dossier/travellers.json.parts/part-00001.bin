      {
        "finding_id": "section-bf42fbd574852b386b00",
        "file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
        "title": "Sea-wolves of the Mediterranean : the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/seawolvesofmedit00curruoft",
        "source_bibliography": {
          "creator": "Currey, Edward Hamilton",
          "date": [
            "1913-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8ded5d2596f6b8b5da24b9515a2ae1cca80e39c88e17cfd932f28761d003774e",
        "evidence_excerpt": "problem  :  which  was,  why  did  Christian  soldiers \nso  often  become  renegadoes  and  fight  for  the  cor- \nsairs under  the  banner  of  those  who  were  the  fiercest \nand  most  irreconcilable  foes  of  themselves  and  their \nkindred  ?  The  life  of  the  common  soldier  or  sailor \ndid  not  offer  many  advantages  ;  it  was  generally  a \nshort  and  anything  but  a  merry  one,  and  the  thing \nby  which  it  was  most  profoundly  affected  was  cap- \nture by  the  corsairs.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/seawolvesofmedit00curruoft",
          "source_file": "seawolvesofmedit00curruoft_seawolvesofmedit00curruoft_djvu.txt",
          "start_char": 710345,

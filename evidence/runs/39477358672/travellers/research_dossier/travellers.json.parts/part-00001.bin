      {
        "finding_id": "section-fa2f5c554488927eff56",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Egypt, where he took service as a mariner in a \nship of the Soldan of Egypt which was bound for \nthe coast of Caramania, from which province the \nEgyptians, as well as the knights, drew the timber \nwhich they required for shipbuilding. But again \nthis neighbourhood proved disastrous to Uruj, as \nthe ship in which he sailed was attacked by a \nChristian galley, and he once more had to save \nhimself by swimming on shore. There was no lack \nof incident in the life of a corsair of the sixteenth \ncentury.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

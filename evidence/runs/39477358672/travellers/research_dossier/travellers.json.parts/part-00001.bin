        "identifier": "cia-readingroom-document-cia-rdp80t00246a017800350001-6",
        "title": "CIA Reading Room cia-rdp80t00246a017800350001-6: (SANITIZED)UNCLASSIFIED SOVIET PAPER ON RESEARCH ON THE INDIAN OCEAN(SANITIZED)",
        "creator": "CIA Reading Room",

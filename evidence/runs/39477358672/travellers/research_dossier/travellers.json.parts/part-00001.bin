      {
        "finding_id": "section-8b6fdb2f459ae657f66c",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Like  Kheyr-ed-Din  Barbarossa,  Ali  was  now  lord \nof  Algiers  and  Tunis,  and  as  he  was,  for  a  corsair, \na  man  of  wide  views,  he  treated  his  new  subjects \nwith  consideration.  He  made,  however,  one  curious \nmistake  not  to  have  been  expected  from  one  so \npolitic:  he  demanded  tribute  from  the  tribes  of \nthe  hinterland.  In  those  days,  particularly  in \nNorthern  Africa,  men  paid  tribute  to  an  overlord",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

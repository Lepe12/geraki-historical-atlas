      {
        "finding_id": "section-6b6a935d1242820f8902",
        "file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
        "title": "Great pirate stories. Second series",
        "url": "https://archive.org/details/greatpiratesstor0000jose",
        "source_bibliography": {
          "creator": null,
          "date": [
            "1925-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "97e06b715ec15879e9da76b05cd5250edc5df0b287c0736c121fbebff2f7fc41",
        "evidence_excerpt": "In the mind of the mariner, there is a superstitious \nhorror connected with the name of Pirate; and there \nare few subjects that interest and excite the curiosity \nof mankind generally, more than the desperate ex- \nploits, foul doings, and diabolical career of these \nmonsters in human form. A piratical crew is gener- \nally formed of the desperadoes and runagates of every \nclime and nation. The pirate, from the perilous \nnature of his occupation, when not cruising on the \nocean, the great highway of nations, selects the most \nlonely isles of the sea for his retreat, or secretes him- \nself near the shores of rivers, bays and lagoons of \nthickly wooded and uninhabited countries, so that if \npursued he can escape to the woods and mountain \nglens of the interior. The islands of the Indian",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/greatpiratesstor0000jose",
          "source_file": "greatpiratesstor0000jose_greatpiratesstor0000jose_djvu.txt",
          "start_char": 1219,
          "end_char": 2013,
          "start_line": 112,
          "end_line": 126,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",

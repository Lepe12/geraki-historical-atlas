      {
        "finding_id": "section-fded922c0fb090ec334a",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "The  maritime  Christian  States  of  the  Medi- \nterranean at  this  epoch  were  at  the  height  of  their \npower  and  prosperity,  but  were  faced  by  the  might \nof  the  Ottoman  Empire,  against  which  they  waged \nperpetual  warfare.  Bitter  and  unceasing  was  the \nstrife  prosecuted  by  the  Cross  against  the  Crescent, \nand  by  the  Crescent  against  the  Cross  ;  and  riding \nlike  eagles  on  the  storm  came  the  corsairs  in  their \nswift  galleys  ready  to  strike  down  the  luckless \nargosy  of  the  merchantman  wheresoever  she  was \nto  be  met.  But  this  was  not  all,  as  the  shore  as \nwell  as  the  sea  yielded  up  to  them  its  tribute  in  the \nshape  of  slaves  and  booty,  and  Christian  mothers \ntrembling  in  the  insecurity  of  their  homes  would",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

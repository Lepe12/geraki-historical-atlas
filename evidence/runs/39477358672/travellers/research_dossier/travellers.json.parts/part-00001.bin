      },
      {
        "finding_id": "section-845225ec9f096a272fd4",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Pope  and  Emperor,  King,  Duke,  and  Viceroy \nhad  tried  conclusions  with  the  pirates,  and  their \nfleet  and  army  had  melted  away  as  the  mists  melt \nin  the  hot  sunshine  on  the  Mediterranean ;  truly \nwere  the  descendants  of  the  dispossessed  Moors  of \nC6rdoba  and  Granada  taking  a  terrible  revenge  on \nthose  by  whom  they  had  been  expropriated.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

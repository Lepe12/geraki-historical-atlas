      },
      {
        "finding_id": "section-0f8e871413614d8c483f",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "To elaborate the point, Thelaus discussed Augustine's dialogue in the City \nof God between Alexander the Great and a pirate. The dialogue famously \ndepicted the double standards by which emperors and rulers could wage \nwar and practice pillage legitimately, while mere pirates without the dignity \nof law were condemned. As the pirate in this dialogue saw it, kingdoms \nwere only \"great robberies,” and there was no essential difference beyond \nscale between the robberies of pirates in *a petty ship\" and the robberies of \nemperors armed with “a great fleet.\"? For Augustine, the dialogue served \nas a parable of the tainted justice available in the godless Civitas Terrena \n(earthly city). All earthly justice was compromised by human vanity and \npride and therefore was inseparable from violence, resulting in the futility \nof making a distinction between pirates and emperors. Augustine's solution \nconsisted in human submission to divine order manifested in the Civitas \nDei (city of god).",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 602723,
          "end_char": 603717,
          "start_line": 11404,
          "end_line": 11417,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],

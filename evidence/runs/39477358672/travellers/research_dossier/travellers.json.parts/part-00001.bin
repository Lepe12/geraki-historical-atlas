      {
        "finding_id": "section-714d3556216fae8fd349",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Plunder  and  slaves  were  all  very  well  in  their \nway,  and  acceptable  enough  on  the  shores  of  the \nGolden  Horn ;  but  Kheyr-ed-Din  had  a  pet \nproject  in  view  on  this  particular  cruise,  which \nwas  to  capture  Julia  Gonzaga  and  to  present  her \nto  Soliman  for  his  harem.  The  lady  destined  by \nhim  for  this  pleasant  fate  was  reported  to  be  the \nloveliest  woman  in  Europe,  a  fitting  gift  for  such \nan  one  as  the  Grand  Turk.  The  fame  of  her \nsurpassing  loveliness  had  reached  even  the  corsairs. \nShe  was  the  widow  of  Vespasian  Colonna,  Duchess \nof  Trajetto,  and  Countess  of  Fundi ;  she  had  now \nbeen  a  widow  since  1528,  and  lived  at  Fundi,  some \nninety  miles  north-east  of  Naples.     Barbarossa  laid",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],

        "evidence_excerpt": "discourse, according to which pirates were described as the enemies of \nmankind (hostis humani generis, a paraphrase of Cicero's formulation).?",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-0022626b75f5a058637b",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "Once again was Andrea Doria ordered to put \nto sea to fight against neither small nor great \nsave Dragut alone; he was to take him dead or \nalive, but alive for choice, in order that he might \nbe made to answer at the bar of Christian justice \nfor all the atrocities committed by him both by \nland and sea. The corsair had returned in the \nmeanwhile to Jerbah, an island on the east coast \nof Tunis much affected by the sea-wolves, and \nwhich in contemporary histories is known as \nJerbah, as Los Gelues (by the Spanish writers), \n-as Gelves, and various other names which greatly \nconfuse its identity.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",

      {
        "finding_id": "section-816a7ab4e223e57a7b18",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "put  forth  his  utmost  endeavours,  to  strain  every \nnerve  and  sinew  in  the  chase.  All  his  life  he  had \nbeen  fighting  the  corsairs,  mostly  with  conspicuous \nsuccess  ;  but  what  Andrea  could  never  forget — \nand  what  his  enemies  never  allowed  him  to  forget \neven  had  he  been  so  inclined — was  the  fact  that, \nat  the  supreme  crisis  of  his  valiant  life,  when  he \nmet  with  Kheyr-ed-Din  Barbarossa  at  the  battle \nof  Prevesa,  he  had  come  off  so  badly  that  his \nunder  officers  of  the  Papal  and  Venetian  fleets  had \nmade  representations,  on  their  return  to  their \nrespective  headquarters,  which  had  detracted  from \nhis  fame,  and  lowered  him  in  the  estimation  of \nEurope.  Further  than  this,  he  knew  that  Barbarossa \nhad  laughed  at  and  made  game  of  him  among  his \nwild  followers  :  this  to  the  aristocrat,  the  Prince  of \nOnegha,  the  admiral  who  treated  on  almost  equal \nterms  with  such  men  as  the  Pope,  Charles  of  Spain, \nand  Francis  of  France,  was  an  insult  hard  to  be \nborne  ;  the  next  corsair  with  whom  he  should  meet \nshould  not  escape  so  easily  as  had  Kheyr-ed-Din, \nthat  the  admiral  had  sworn.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

      {
        "finding_id": "section-9fab508b76dd73c018c0",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Many were the fights in which Elphin assisted, for \nsometimes he was transferred to a war-galley forming one \nof a fleet sent out to intercept a pirate squadron. A \npilot was not generally required to fight, but when the \nbattle raged hotly and the pirates pressed on board his \ngalley he had to snatch up buckler and sword or pilum \nand help thrust the rascals out again. So thrilled was \nElphin by these encounters that often he wished he was a \nsoldier: to match himself with some sturdy rogue of a \npirate, to fence awhile with him, and then by a deft thrust \nto send him into the scuppers or overboard seemed to \nbe more a man’s work than to con the wind and the tides \nand when he saw a pirate craft to scuttle away to give \nwarning. But all his life now was tinged with excite- \nment and adventure; always there was the thrilling \nsmell of the salt sea, the beat of the brave wind upon his \nface, and the living heave of the waves under his feet, and \nany shift of the breeze might bring the enemy over the \nrim of tossing waves on the far horizon.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

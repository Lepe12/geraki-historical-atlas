      {
        "finding_id": "section-5b6c7ff977f0ed15b689",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "It is a pity to have to record that, so far as such visions \nrelate to the Captain William Kidd known to history, \nthey are utterly without basis infact. Kidd was far from \nbeing the typical pirate. He seems to have begun the \nvoyage which ended in his undoing with intentions which \nwere quite honourable, and it was only ill-luck, the \nmurmurs of a mutinous crew, and favourable opportunity \nwhich forced him to do those things which branded him \nas a pirate and brought him to the gallows.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      },
      {
        "finding_id": "section-51cbf02a131ab2786f4a",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "By commission other than that empowering him to \nfight and seize pirates, Kidd was authorized to capture \nFrench ships. Just about this time he came up with a \nvessel which looked like a trader. Kidd hoisted French \ncolours, whereupon the trader ran up a similar flag. \nWhen the vessels had approached each other, Kidd hailed \nthe stranger in French, and was answered in the same \nlanguage. On this Kidd ordered the Captain to come \naboard, whereupon it turned out that the master was a \nDutchman, but that the ship belonged to native owners.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

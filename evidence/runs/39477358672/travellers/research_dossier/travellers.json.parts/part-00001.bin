      {
        "finding_id": "section-d089a936ff8f4390f6bf",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "La  Valette  was  ready  to  die  ;  there  was  no  man \nin  all  that  garrison  so  ready.  With  pike  and  sword \nthis  veteran  of  seventy-one  years  of  age  was  ever  at \nthe  post  of  the  greatest  danger,  repelling  the  assaults \nof  Janissaries  and  corsairs,  fighting  with  the  spirit \nof  the  youngest  among  the  Knights  in  the  breaches \nrent  in  the  walls  of  II  Borgo.  In  vain  did  his \ncomrades  try  to  prevent  him  from  this  perpetual \nexposure  ;  in  vain  did  they  point  out  that  the  value \nof  his  life  outnumbered  that  of  an  army.  He  was \nvery  gentle  with  these  remonstrances,  but  quite \nfirm.  There  were  plenty  as  good  as  he  to  take  his \nplace  should  he  fall,  he  insisted  ;  till  that  time  came \nit  was  his  duty  to  inspire  all  by  his  example,  to \nshow  to  the  simplest  soldier  that  he  was  cared  for \nby  his  Grand  Master.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

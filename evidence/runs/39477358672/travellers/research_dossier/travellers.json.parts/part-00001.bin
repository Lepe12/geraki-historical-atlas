      {
        "finding_id": "section-1c6a1e1721ebbf35b00d",
        "file": "india.history.resource.112019_112019_djvu.txt",
        "title": "Sea-Wolves of the Mediterranean: The Grand Period of the Moslem Corsairs",
        "url": "https://archive.org/details/india.history.resource.112019",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "02bcc5c0781b01bf6c6e78ee0d5b8bfb31a02ea35b47565b888e171e88ef6ad9",
        "evidence_excerpt": "which is the commonplace of piratical deeds: it \nresides in the perennial interest which men take \nin individual achievement, in the spectacle of \nabsolute and complete domination by one man \nover the lives and the fortunes of others. This \nintense form of individualism is nowhere so well \nexhibited as in the story of piratical enterprise, \nwhere a band of men, outside of the law and \ndivorced from all human kind by the atrocity of \ntheir deeds, has had to be welded into one homo- \ngeneous mass for the purpose of preying upon \nthe world at large. Therefore he who would hold \nrule among such outlaws must himself be a man \nof no common description, for in him must be \nthat quality which calls for instantaneous obedi- \nence among those with whom he is associated ; \nbehind him is no constituted authority, discipline \nis personal, enforced by the leader, and by him \nalone. Beneath him are men of the rudest and \nroughest description, slaves to their lusts and \ntheir passions, prone to mutiny, suspicious, and— \nworst of all—stupid.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/india.history.resource.112019",
          "source_file": "india.history.resource.112019_112019_djvu.txt",
          "start_char": 32405,
          "end_char": 33445,
          "start_line": 1060,
          "end_line": 1081,
          "printed_page": null,

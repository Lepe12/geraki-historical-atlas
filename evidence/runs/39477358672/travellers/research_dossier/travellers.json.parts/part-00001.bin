      {
        "finding_id": "section-15a232b74a8fde11ae43",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Turbulent,  rash,  unstable  as  water,  were  these \nprimitive  dwellers  of  the  desert ;  but  they  were \nfighters  and  raiders  to  a  man,  and  ready  for  any \ndesperate  encounter  if  only  it  held  out  the  promise \nof  loot :  they  were  as  veritably  the  pirates  of  the \nland  as  were  the  Barbarossas  pirates  of  the  sea.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

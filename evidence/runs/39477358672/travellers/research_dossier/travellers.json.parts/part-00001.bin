      {
        "finding_id": "section-7c8e298d30328e681ae2",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "Hardly,  however,  had  the  brothers  succeeded  in \nthis  enterprise  when  that  tireless  fighter  Uruj \nagain  attempted  the  capture  of  Bougie ;  but  his \nsecond  attempt  was  even  more  disastrous  than  his \nfirst,  and  he  lost  half  his  flotilla.  Then  he  asked \nfor  succour  from  Tunis  ;  but  the  Sultan,  much \noffended  at  the  idea  of  the  brothers  setting  up  in \na  piratical  business  in  which  he  was  no  longer  a \nsleeping  partner,  angrily  refused.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

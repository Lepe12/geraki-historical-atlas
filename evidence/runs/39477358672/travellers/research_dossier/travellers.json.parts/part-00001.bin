        "verified": false
      },
      {
        "finding_id": "section-f63e05ad495b939d4334",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "On 30 August 1674, after several months of pursuit, the English Admiralty \nfinally succeeded in capturing George Cusack, one of the most sought and \nfeared pirates in Europe, in the Thames estuary. Soon after, a short treatise \nwas published detailing the arrest of Cusack. In it, he was classified among \nthe most evil kinds of criminal, namely, a pirate and sea robber. Pirates \nwere the direst enemies of the human race, who must be wiped out like \ntroublesome vermin:",
        "years_in_scope": [
          1674
        ],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

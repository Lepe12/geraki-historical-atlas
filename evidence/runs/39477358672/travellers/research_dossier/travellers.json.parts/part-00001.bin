      {
        "finding_id": "section-dbc9fb6dc0a918f5f9de",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Word of this was given to Sidi by a corsair of Tunis \nwhom he spoke in mid-ocean, and it was told him \nthat already the fleet of the Christians was searching \nthe A®gean for the Turkish galleys. Sidi wondered \nwhether it would be to his advantage to tender his \nservices to the Grand Turk, but decided that while he \nhad but one vessel his offer would not be rated very \nhighly. He therefore decided to visit the shores of the \nPapal States of Italy, thinking that as the Italian fleet \nwas engaged farther west there would be few to guard \nthe shores of Naples and the Roman States, and there \nwould be a good chance of rifling a rich villa, capturing \na few wealthy Christians, or carrying off villagers to man \nhis slave benches.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],

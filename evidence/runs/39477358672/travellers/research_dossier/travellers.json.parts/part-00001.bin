      {
        "finding_id": "section-388d730ead0b88bca2f3",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "Captain Charles Johnson’s General History of the Pyrates (1724) has long \nintrigued scholars, not least for its ambivalent tone towards its eponymous \nsubjects — the “pyrates.” With both shocked outrage and breathless fascina- \ntion, the book presented brief biographies of maritime violence and plunder, \nembellished and invented from the life stories some of the most notorious \nof Europe’s pirate captains. The General History confirmed the figure of",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",

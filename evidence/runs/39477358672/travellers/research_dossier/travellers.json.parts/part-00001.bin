      {
        "finding_id": "section-d3062fe6350983582d28",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "Pirates have been in existence for over 2,000 \nyears. A band of pirates captured Julius Caesar \nwhen he was a young man, but he escaped, \ncaptured the pirate band and executed them all. \nAnother famous pirate was Rolf, son of Ragnvald \nthe Powerful, who helped King Alfred beat the \nViking invaders at the Battle of Maldon, and \nearned himself the Dukedom of Normandy, \nwhere he governed long and with justice. Then \nthere are the famous Corsairs of the Mediter- \nranean, including Sidi ben Muza who became \nGovernor of Rhodes and Uruj Barbarossa who \nfounded the dynasty of the pirates of Algiers. \nAlgiers remained a pirate stronghold for over 250 \nyears until the Battle of Algiers in 1816 when Ed \nPellew, Lord Exmouth, shattered the pirate \nstronghold for ever.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

        "original_inspected": false,
        "verified": false
      },
      {
        "finding_id": "section-c75b4c6f3b596a6aa103",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "The fight took place at Coracesium, in Cilicia, and was \nstubbornly waged. Here again the pirates had no chance \nagainst the disciplined soldiers of the Republic, who, \nhardened by many a rough campaign, and skilled in all the \ndevices of war craft, were more than a match for the \nvicious assailants of undefended towns and lonely villas \nand the murderers of defenceless women and priests. \nSeeing that their efforts were vain, the pirates ran their \ngalleys ashore and fled to the fort which they had built. \nBut when from their walls they saw the grim determina- \ntion with which the legionaries prepared to besiege them \ntheir courage forsook them and they capitulated, offering \nto give up all the strongholds and maritime towns which \nthey had fortified, together with a vast treasure and many \nhundreds of captives.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/bookofpirates0000gilb",

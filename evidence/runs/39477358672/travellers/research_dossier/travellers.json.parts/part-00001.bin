      },
      {
        "finding_id": "section-59ca0d06ae3bc92b4947",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "As these and other European legal tracts show, jurists were operating \nwith a repertoire that encompassed both rhetorical references to piracy \nas a violation of natural law and recognition of the legal foundations for \nstate regulation of sea space. When judges described piracy as a natural \ncrime but failed to assert that their courts had authority to try pirates, as \noccurred with most British jurists in the eighteenth century, they were \nnot just responding to practical pressures.'^ They were also recognizing \nfundamental legal ambiguities. Put differently, it was precisely because \ntheory was every bit as complex and contradictory as the world of practice \nthat debates about legalities at sea continued for centuries to roil European \nstrategies of sponsorship and containment of sea raiding.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 700025,
          "end_char": 700831,
          "start_line": 13298,
          "end_line": 13308,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false
        },
        "reported_cited_pages": [],
        "decision": "REVIEW_CONTEXT",
        "reason": "THEMATIC_SOURCE_PASSAGE_NOT_VERIFIED_BASE",
        "extraction_method": "DETERMINISTIC_THEMATIC_PASSAGE_READING",
        "uncertainties": [
          "ORIGINAL_NOT_INSPECTED",
          "SOURCE_GENEALOGY_PENDING",

      {
        "finding_id": "section-250c9b29857cac3a2ed5",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "The  \"  Africans,\"  however,  were  obdurate ;  they \nknew  a  pirate  when  they  saw  him  quite  as  well \nas  any  one  else,  and  they  were  quite  aware  that, \nshould  they  open  their  gates  to  Dragut,  sooner  or \nlater  they  would  have  to  stand  a  siege  frortt  the \nChristian  forces,  which  was  a  thing  they  by  no \nmeans  desired.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-39424393e06b51bd6154",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "In  the  year  1546,  Kheyr-ed-Din  Barbarossa  died, \nand  to  replace  him  the  Sultan  S oilman  ordered  all \nthe  mariners  in  his  dominions  to  acknowledge \nDragut-Reis  as  their  admiral,  and  to  obey  him  in \nthe  same  manner  as  they  had  obeyed  his  prede- \ncessor. From  this  date  he  was  the  foremost \ncorsair  in  the  Mediterranean,  and  the  feats  which \nwere  performed  by  him  showed  that  the  Padishah \nhad  not  erred  in  his  selection.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",

      {
        "finding_id": "section-8679d15aea9382a8cb64",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "The essay focuses on Bugis and Makassar seafarers of South Sulawesi \nthrough two cases. The first is Lombok and Sumbawa in the late sev- \nenteenth and early eighteenth centuries, where landless Makassarese \naristocrats fought or allied with various groups to create a political plat- \nform. The second case is the seascape around Timor, further to the east, \nwhere a socially different type of maritime enterprise evolved, entailing \nboth commercial activities and raiding of vulnerable small-scale island \nsocieties. While Dutch writers termed all these seafarers \"pirates,\" this \nfails to capture the range of their socio-political roles. Moreover, the study \ndemonstrates how the Dutch East India Company contributed to the rise \nof piratical activity through colonial advances on Sulawesi in the 1660s.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 270157,
          "end_char": 270963,
          "start_line": 5154,
          "end_line": 5164,
          "printed_page": null,
          "scan_indexes_0_based": [],
          "pdf_file": null,
          "pdf_reference_base": "LANE_ROOT",
          "original_inspected": false

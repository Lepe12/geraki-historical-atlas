      {
        "finding_id": "section-61fe28c47f694afa565e",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "The  corsair  recognised  that  he  could  do  no \nmore:  sullenly  he  cast  off  the  tow,  and,  forming \nup  some  thirty  of  his  galleys,  still  in  a  condition \nto  navigate,  stood  boldly  through  the  centre  of \nwhere  the  battle  had  once  raged,  and  escaped. \nThe  Capitana  of  Malta  had  been  taken ;  and  to \nthe  Sultan  did  Occhiali  present  the  great  standard \nof  Saint  John,  as  an  earnest  of  his  achievement.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {

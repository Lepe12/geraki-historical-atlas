      {
        "finding_id": "section-365361b62ceedc6679ae",
        "file": "oapen-20.500.12657-53019_external_content_djvu.txt",
        "title": "Piracy in World History",
        "url": "https://archive.org/details/oapen-20.500.12657-53019",
        "source_bibliography": {
          "creator": null,
          "date": [
            "2021-01-01T00:00:00Z"
          ],
          "source_type": "OCR_CONTEXT",
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "8f3c05c7515e4753fdbf1e6c89ebadf36b36a537f0572450eb8246a8822c8366",
        "evidence_excerpt": "rather they were penned by a nineteenth-century Spanish historian of \nmilitary background, Pio de Pazos y Vela Hidalgo (1841-1913), who personally \nparticipated in an expedition against Mindanao rebels in 1866. They were \npart ofa chronological account of what he called a Military History of Jolo. \nIt is an apt introductory quote reflecting both the key topoi and muddled \nchronologies of the history of piracy in the Spanish Philippines.",
        "years_in_scope": [],
        "date_basis": "EXPLICIT_PARAGRAPH",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/oapen-20.500.12657-53019",
          "source_file": "oapen-20.500.12657-53019_external_content_djvu.txt",
          "start_char": 509426,
          "end_char": 509866,
          "start_line": 9678,

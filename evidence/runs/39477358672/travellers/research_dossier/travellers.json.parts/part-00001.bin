      {
        "finding_id": "section-27254abae07ca7e33cba",
        "file": "cu31924087978445_cu31924087978445_djvu.txt",
        "title": "Sea-wolves of the Mediterranean; the grand period of the Moslem corsairs",
        "url": "https://archive.org/details/cu31924087978445",
        "source_bibliography": {
          "creator": "Currey, E. Hamilton (Edward Hamilton)",
          "date": [
            "1910-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "e53211270a60a26aa03dc5168c85f7a9043def78664e708f0be035cea4a28c60",
        "evidence_excerpt": "This  was  done,  and  to  the  horror  even  of \nthose  hardened  men  of  blood  who  followed  in \nthe  train  of  Barbarossa,  they  were  all  executed. \nEven  this  wholesale  massacre  did  not  assuage \nthe  wrath  of  the  corsair.  Standing  and  survey- \ning the  weltering  shambles  which  tainted  the  air, \nhe  pulled  ferociously  at  his  red  beard,  and  com- \nmanded that  they  should  whip  Hassan  till  the \nblood  ran  ;  when  this  was  done  thoroughly  and  to \nthe  satisfaction  of  the  despot,  he  gave  orders  that \nhe  should  be  chained  and  thrust  into  the  prison  of \nthe  fortress.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,

      {
        "finding_id": "section-67e19eeef701419fe0ea",
        "file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
        "title": "The book of pirates",
        "url": "https://archive.org/details/bookofpirates0000gilb",
        "source_bibliography": {
          "creator": "Gilbert, Henry, 1868-1937",
          "date": [
            "1916-01-01T00:00:00Z"
          ],
          "source_type": null,
          "evidence_level": null,
          "rights": null
        },
        "source_text_sha256": "1901bb10294e81f32d98c63cba8e03792d5ae5388c5c8aacfc5b904d67fab94d",
        "evidence_excerpt": "girl sprang forth, threw her arms passionately about \nher mother’s neck, and seemed for a moment about to \nburst into a madness of grief. But next instant she had \nrun to the old Saxon chief with her wrists close together \nin token of her wish to take the place of her mother. \nBut he thrust her aside: her mother had been chosen \nby chance, as the rite required, and no substitute could \nbe taken. Nevertheless a victim was acceptable if she \nwere willing, and the old pirate gestured to her to take \nher place beside her mother, who had already been forced \nto lie along the slipway. Elphin’s heart. was moved to \nsee how the young girl, having bowed in gratitude to \nthe Saxon chief, walked quickly as if with gladness, \nand with a beautiful smile upon her face, toward her \nmother. He saw the lips of the two women meet in a \nlong kiss; then the young girl, laying her arm across \nher mother as if to protect her, sank down quietly as if \nnow she were quite content.",
        "years_in_scope": [],
        "date_basis": "UNRESOLVED",
        "date_evidence": null,
        "matched_names": [],
        "name_basis": "THEMATIC_CONCEPT",
        "locator": {
          "url": "https://archive.org/details/bookofpirates0000gilb",
          "source_file": "bookofpirates0000gilb_bookofpirates0000gilb_djvu.txt",
          "start_char": 128822,
          "end_char": 129792,
          "start_line": 3542,
          "end_line": 3559,
          "printed_page": null,
          "scan_indexes_0_based": [],

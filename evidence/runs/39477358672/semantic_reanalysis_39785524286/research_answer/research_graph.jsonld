    {
      "@id": "urn:nabou:att_eac90e492524f0ebab3b96ec%3Asnapshot%3A6083c66a240494fd63cb",
      "@type": "Attestation",
      "schema:name": "The source reports that Dieudé left Crete in 1686 and settled in Milos, collaborating with Ottoman adversaries.",
      "properties": {
        "attestation_id": "att_eac90e492524f0ebab3b96ec",
        "status": "UNREVIEWED",
        "historically_verified": false,

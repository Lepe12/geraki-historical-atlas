      "@type": "Citation",
      "schema:name": "{\"end_char\": 431520, \"end_line\": 8034, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 431329, \"start_line\": 8031}",

    {
      "@id": "urn:nabou:cite_68cdc94cdc6ea193c236e294",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 3074, \"end_line\": 39, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_ottoman/library_acquisition/f3ff600394e2d8eae319fecc.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 2621, \"start_line\": 35}",
      "properties": {
        "source_id": "src_0faaedf1814e19eacfed2a7c7bc38df2",
        "locator": "{\"end_char\": 3074, \"end_line\": 39, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_ottoman/library_acquisition/f3ff600394e2d8eae319fecc.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [0], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 2621, \"start_line\": 35}",
        "exact_excerpt": " In our study, an assessment will\nbe made on examples of the fact that some of the British, Venetian, Genoese, Dutch and French commercial ships\noperating from the Ottoman ports where trade gained intensity in the second half of the 17th century were exposed to\nattacks by pirates before Algeria, Tunisia and Tripoli in the Mediterranean, their property was confiscated by them\nand its effects on bilateral relations between Western states and Ottomans.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

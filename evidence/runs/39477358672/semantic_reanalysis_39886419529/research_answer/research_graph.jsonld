    {
      "@id": "urn:nabou:cite_9da353ac1e726d4724b6906b",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 589866, \"end_line\": 11164, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 589635, \"start_line\": 11161}",

    {
      "@id": "urn:nabou:cite_92d991e36338adb0f545c860",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 1137443, \"end_line\": 12992, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_greek/library_acquisition/bad2f54f36da12ea92871556.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [337], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1137155, \"start_line\": 12989}",
      "properties": {
        "source_id": "src_74df6aa6839c67db94df35350874162f",
        "locator": "{\"end_char\": 1137443, \"end_line\": 12992, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_greek/library_acquisition/bad2f54f36da12ea92871556.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [337], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1137155, \"start_line\": 12989}",
        "exact_excerpt": "\nIn the summer of 1602, the Spanish pirate Alonso de Contreras sought refuge on the deserted islands\nof Phournoi with his Maltese frigate and companions, following a series of successful operations in Serifos,\n­Astypalaia, Amorgos and Patmos, intending to regroup and divide their spoils.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

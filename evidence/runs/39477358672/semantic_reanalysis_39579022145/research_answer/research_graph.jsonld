    {
      "@id": "urn:nabou:att_674bc6e5137316e2060dbc67%3Asnapshot%3A3589f68e0eafe80dd6e9",
      "@type": "Attestation",
      "schema:name": "In the summer of 1602, the Spanish pirate Alonso de Contreras sought refuge on the deserted islands of Phournoi with his Maltese frigate and companions, following a series of successful operations in Serifos, Astypalaia, Amorgos and Patmos, intending to regroup and divide their spoils.",
      "properties": {
        "attestation_id": "att_674bc6e5137316e2060dbc67",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",

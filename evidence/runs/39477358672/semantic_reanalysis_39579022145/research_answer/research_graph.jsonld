    {
      "@id": "urn:nabou:att_603029990879c197fea687ed%3Asnapshot%3A49e68e13ce94390c8095",
      "@type": "Attestation",
      "schema:name": "Astypalaia provided safe anchorages and provisions for corsairs, making it an excellent hideout during the 17th century.",
      "properties": {
        "attestation_id": "att_603029990879c197fea687ed",
        "status": "UNREVIEWED",

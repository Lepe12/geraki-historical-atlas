    {
      "@id": "urn:nabou:cite_b23a8be6ac2bf51fb40f038d",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 10456, \"end_line\": 524, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 10219, \"start_line\": 519}",
      "properties": {

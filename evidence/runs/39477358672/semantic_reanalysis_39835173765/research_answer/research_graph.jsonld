    {
      "@id": "urn:nabou:cite_cd0d4b80410d67b511f04b81",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 589866, \"end_line\": 11164, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 589635, \"start_line\": 11161}",
      "properties": {
        "source_id": "src_3411af3abac3d90c62706c40d7ac5c37",
        "locator": "{\"end_char\": 589866, \"end_line\": 11164, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 589635, \"start_line\": 11161}",
        "exact_excerpt": " Throughout the latter seventeenth century, Constan- \ntinople's control over its North African vassals declined and the Barbary \nCoast became a base of operations for corsairs whose activities spread to \nMalta and Livorno in Italy.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

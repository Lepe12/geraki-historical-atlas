    {
      "@id": "urn:nabou:cite_93a5df449eae9203d3345fa9",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 12579, \"end_line\": 410, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 12308, \"start_line\": 405}",
      "properties": {
        "source_id": "src_93b08e48f1f985e6f707c7fe72bce182",
        "locator": "{\"end_char\": 12579, \"end_line\": 410, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 12308, \"start_line\": 405}",
        "exact_excerpt": "  From \nthese  places  the  rovers  issued  to  capture,  to  destroy, \nand  to  enslave :  in  Oran  and  Tlemcen,  in  Tenes, \nShershell,  Bougie,  Jigelli,  Bizerta,  Sfax,  Susa, \nMonastir,  Jerbah,  and  Tripoli  they  lurked  ready \nfor  the  raid  and  the  foray.",

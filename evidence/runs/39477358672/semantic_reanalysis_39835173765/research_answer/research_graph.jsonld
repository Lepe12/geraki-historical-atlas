    {
      "@id": "urn:nabou:cite_ffcc2addef32b3226b1af3c7",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 431520, \"end_line\": 8034, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 431329, \"start_line\": 8031}",
      "properties": {
        "source_id": "src_f56f5417d0f0d54b12a41a993107ae31",
        "locator": "{\"end_char\": 431520, \"end_line\": 8034, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 431329, \"start_line\": 8031}",
        "exact_excerpt": " \nNevertheless, disavowed Ottoman, English, and Dutch privateers all found \nrefuge in North Africa, where they received the authorization they sought \nto continue their war under new banners.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

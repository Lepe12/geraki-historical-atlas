  "attestations": [
    {
      "entity_id": "mention:fb6a205f0bff0d241f28ad9c",
      "predicate": "SOURCE_STATEMENT",
      "value": "The consulted source reports that a harbor named Creveliers is mentioned in the portolan of Joseph Roux, a hydrographer for the French king, as a possible anchorage for corsairs.",
      "citations": [
        {
          "source_id": "src_0b97cdb8653fa9ccbb2da4122b77da8b",
          "locator": "{\"end_char\": 33585, \"end_line\": 565, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/18f781280144b88f0b78dfa5.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [8], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 33019, \"start_line\": 556}",
          "exact_excerpt": " Στον λιμενοδείκτη της Αστυπάλαιας\nσημειώνεται, μεταξύ άλλων, ένα αγκυροβόλιο που\nφέρει το όνομα του Creveliers, προφανώς λόγω του\nθανάτου του ή και της συχνής παρουσίας του εκεί.\nΠρόκειται για το «Port Couvelier», το οποίο αναγράφεται στη θέση του Βαθιού (εικ. 1)54. Η παραφθορά\nτου ονόματος του κουρσάρου στον λιμενοδείκτη δεν\nπρέπει να προκαλεί εντύπωση, καθώς στις γαλλικές\nεκδόσεις του 17ου και του 18ου αιώνα το όνομά του\nαπαντά με πολλές διαφορετικές γραφές: Connelier,\nCreuvilier, Crevelié, Crevil(l)ier(s), Crivilliers, Cruvelier, Cruvillier, Kervilliers55.",
          "attribution": "stated"
        }
      ],
      "start_year": null,
      "end_year": null,
      "status": "UNREVIEWED",
      "reviewer": null,
      "reviewed_at": null,
      "id": "att_1e88689f2862dbfb87f0e190",
      "historically_verified": false,
      "model_claim_id": "c-b781c7aa0784ebf80e7c",
      "assertion_class": "SOURCE_STATEMENT",
      "source_classification": "UNVERIFIED",
      "model_review": {
        "decision": "SUPPORTED_ATTRIBUTION",
        "flag": null,
        "historical_verification": false
      }
    },
    {
      "entity_id": "mention:8cf26966ccc13d98e050ca83",
      "predicate": "SOURCE_STATEMENT",
      "value": "The consulted source reports that the harbor named Creveliers is associated with the corsair Creveliers, and that it was a known location for raids by corsairs in the 17th century.",
      "citations": [
        {
          "source_id": "src_0b97cdb8653fa9ccbb2da4122b77da8b",
          "locator": "{\"end_char\": 34372, \"end_line\": 575, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"library_acquisition/18f781280144b88f0b78dfa5.pdf\", \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [8], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 33585, \"start_line\": 565}",
          "exact_excerpt": "\nΤο «Λιμάνι Creveliers» δεν είναι το μοναδικό στην\nιστορία του ελληνικού Αρχιπελάγους με το όνομα\nενός κουρσάρου: Ένας από τους όρμους των Φούρνων ονομάζεται σήμερα όρμος Μανέτα και θα ήταν\nδύσκολο να υποστηρίξει κανείς ότι το πλοίο του ομώνυμου ζακυνθινού, συνεργάτη του Creveliers, δεν είχε\nαράξει αρκετές φορές σε αυτό το νησιωτικό σύμπλεγμα, γνωστό τόπο ενέδρας των κουρσάρων56. Και\nόπως ο τραγικός θάνατος της γυναίκας του Μανέττα\nείχε γίνει ρίμα και τραγουδιόταν στην ευρύτερη περιοχή του Αιγαίου έως τον 20ό αιώνα57, κατά τη δεκαετία του 1670 είχε διαδοθεί μια «σάγκα» με τα\nκατορθώματα του Creveliers, τα οποία αποδείκνυαν,\nόπως πίστευαν, την υπερφυσική δύναμή του. Μάλιστα, περίπου έναν μήνα μετά τον θάνατο του κουρσάρου, μερικές από αυτές τις διηγήσεις κατέγραψε\nστη Μήλο ο A.",
          "attribution": "stated"
        }
      ],
      "start_year": null,
      "end_year": null,
      "status": "UNREVIEWED",
      "reviewer": null,
      "reviewed_at": null,

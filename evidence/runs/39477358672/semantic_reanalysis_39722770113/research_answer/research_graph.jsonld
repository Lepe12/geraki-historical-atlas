    {
      "@id": "urn:nabou:cite_b24a84b653ec820993c6a7e8",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 1182799, \"end_line\": 13580, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_greek/library_acquisition/bad2f54f36da12ea92871556.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [355], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1182447, \"start_line\": 13577}",
      "properties": {
        "source_id": "src_a1fe372d7e4b81d02f5bb01dc0679beb",
        "locator": "{\"end_char\": 1182799, \"end_line\": 13580, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_greek/library_acquisition/bad2f54f36da12ea92871556.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [355], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1182447, \"start_line\": 13577}",
        "exact_excerpt": " The local tradition of the Frankish origins of the church is\nultimately verified by the records of the French consulate of Melos, which refer to a 1695 decision of capitan\ngenerale Antonio Zeno, acknowledging that the Tuscan corsair Francesco Barbieri had built a Catholic church\nhonoring Saint George in Ayionissi (CADN, Milo et l’Argentière 3, 216).",
        "attribution": "stated"
      },
      "historically_verified": false
    },
    {
      "@id": "urn:nabou:cite_83081d0306f8f310088ea373",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 1182799, \"end_line\": 13580, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"greek/library_acquisition/bad2f54f36da12ea92871556.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [355], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1182447, \"start_line\": 13577}",
      "properties": {

    {
      "@id": "urn:nabou:cite_663494d23e66a36cc13cce1d",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 4159, \"end_line\": 859, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 3585, \"start_line\": 859}",
      "properties": {
        "source_id": "src_4ac9638fabfd56d5f67238f88b3b43c9",
        "locator": "{\"end_char\": 4159, \"end_line\": 859, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 3585, \"start_line\": 859}",
        "exact_excerpt": " English and Dutch pirates, accustomed to navigating the oceans of the world on square-rigged sailing ships with their armament disposed along their sides, introduced these vessels to their hosts, and instructed them in their construction and use. The corsairs, quick to realise the advantages of the broadside sailing-ship over the galley, mastered the arts of navigation and warfare with these new vessels with remarkable speed, and before long fleets from North Africa were sailing beyond the Straits of Gibraltar and ravaging as far away as Madeira, England and Ireland.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

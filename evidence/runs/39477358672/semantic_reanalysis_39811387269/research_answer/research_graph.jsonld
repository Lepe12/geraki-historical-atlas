    },
    {
      "@id": "urn:nabou:cite_823ac3907eb7fa83374eaf85",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 201888, \"end_line\": 3978, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 201553, \"start_line\": 3973}",
      "properties": {

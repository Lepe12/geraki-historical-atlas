    {
      "@id": "urn:nabou:att_94a97223abbcd559c772987b%3Asnapshot%3A627861c1532138accfdb",
      "@type": "Attestation",
      "schema:name": "The source mentions that Astypalaia provided safe anchorages for corsairs.",
      "properties": {
        "attestation_id": "att_94a97223abbcd559c772987b",
        "status": "UNREVIEWED",
        "historically_verified": false,
        "assertion_class": "SOURCE_STATEMENT",

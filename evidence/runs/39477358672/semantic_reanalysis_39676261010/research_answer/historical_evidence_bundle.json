    {
      "entity_id": "mention:7fed3e4f3b2310e88ead8c0f",
      "predicate": "SOURCE_STATEMENT",
      "value": "The passage states that a Catholic church honoring Saint George was built by the Tuscan corsair Francesco Barbieri in Ayionissi in 1695.",
      "citations": [
        {
          "source_id": "src_c0ce1b544a23804fab182fde2ff1ed84",
          "locator": "{\"end_char\": 1182799, \"end_line\": 13580, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"citation_continuation_greek/library_acquisition/bad2f54f36da12ea92871556.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [355], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1182447, \"start_line\": 13577}",
          "exact_excerpt": " The local tradition of the Frankish origins of the church is\nultimately verified by the records of the French consulate of Melos, which refer to a 1695 decision of capitan\ngenerale Antonio Zeno, acknowledging that the Tuscan corsair Francesco Barbieri had built a Catholic church\nhonoring Saint George in Ayionissi (CADN, Milo et l’Argentière 3, 216).",
          "attribution": "stated"
        },
        {
          "source_id": "src_9e0446a4625470d1d0fa1fb0365d2af0",
          "locator": "{\"end_char\": 1182799, \"end_line\": 13580, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": \"greek/library_acquisition/bad2f54f36da12ea92871556.pdf\", \"pdf_reference_base\": \"PARENT_RESEARCH_RUN\", \"printed_page\": null, \"scan_indexes_0_based\": [355], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 1182447, \"start_line\": 13577}",
          "exact_excerpt": " The local tradition of the Frankish origins of the church is\nultimately verified by the records of the French consulate of Melos, which refer to a 1695 decision of capitan\ngenerale Antonio Zeno, acknowledging that the Tuscan corsair Francesco Barbieri had built a Catholic church\nhonoring Saint George in Ayionissi (CADN, Milo et l’Argentière 3, 216).",
          "attribution": "stated"
        }
      ],

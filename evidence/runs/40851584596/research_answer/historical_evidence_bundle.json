          "locator": "{\"end_char\": 598000, \"end_line\": 13940, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 597916, \"start_line\": 13939}",

      "predicate": "SOURCE_STATEMENT",
      "value": "The consulted source reports that Kimolos is mentioned as a place where Cimolit is found.",
      "citations": [
        {
          "source_id": "src_c579306ac9b0c1bf6f8cc7dd835de763",
          "locator": "{\"end_char\": 9626, \"end_line\": 445, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 9399, \"start_line\": 442}",
          "exact_excerpt": "historischer Zeit  zu  Waffen  verarbeitet.^)  Auf  Kimolos  ge- \nwannen schon  die  Alten  den  Cimolit  — Kimolia.  Von \nandern  Erzeugnissen  werden  Honig,  Kraniche  und  Ziegen \nvon  Milos,  Feigen  von  Kimolos  erwähnt.",
          "attribution": "stated"
        },

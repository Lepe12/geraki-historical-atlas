      "entity_id": "mention:a06614b39669617ec1b5ae89",
      "predicate": "SOURCE_STATEMENT",
      "value": "The consulted source reports that the ancient name for the island of Kimolos was terra Cimolia, from which the name Kimolos was derived.",
      "citations": [
        {
          "source_id": "src_ac46ed7321cf880f137cda6139311cab",
          "locator": "{\"end_char\": 694388, \"end_line\": 11948, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 694228, \"start_line\": 11946}",
          "exact_excerpt": "  The  ancients  knew  it  by  the  name \nof  terra  Cimolia,  from  that  of  Kimolos,  which  they  had  given  to  the \niiland  where  it  is  to  be  found.",
          "attribution": "stated"
        }
      ],
      "start_year": null,
      "end_year": null,
      "status": "UNREVIEWED",

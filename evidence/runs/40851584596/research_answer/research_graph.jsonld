        "locator": "{\"end_char\": 602601, \"end_line\": 14040, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 602305, \"start_line\": 14036}",
        "exact_excerpt": "I have convinced myfelf that the true Cimolian earth of the ancients, \nthat which is drawn from Kimoxr or ARGENTIERA, and which is very \ndifferent from all the analogous fubftances with which it has been con- \nfounded, is not at all known in F RANCE, unlefs, perhaps, by a few cu- \nrious perfons.",
        "attribution": "stated"
      },
      "historically_verified": false
    },

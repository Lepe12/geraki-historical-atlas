    {
      "@id": "urn:nabou:cite_196cb2c869bc3d496f3ce07a",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 694388, \"end_line\": 11948, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 694228, \"start_line\": 11946}",

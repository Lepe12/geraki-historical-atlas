    {
      "@id": "urn:nabou:cite_e589e856ab363b3055cef5d0",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 602601, \"end_line\": 14040, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 602305, \"start_line\": 14036}",
      "properties": {

    {
      "@id": "urn:nabou:cite_993249a3be34773abfc86d6e",
      "@type": "Citation",
      "schema:name": "{\"end_char\": 486, \"end_line\": 12, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [6], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 219, \"start_line\": 6}",
      "properties": {
        "source_id": "src_d5d3ede9770d3122c5943266098eb19a",
        "locator": "{\"end_char\": 486, \"end_line\": 12, \"offset_unit\": \"UNICODE_CODE_POINTS\", \"pdf_file\": null, \"pdf_reference_base\": \"LANE_ROOT\", \"printed_page\": null, \"scan_indexes_0_based\": [6], \"span_semantics\": \"EXACT_QUOTE\", \"start_char\": 219, \"start_line\": 6}",
        "exact_excerpt": " |\n\nNote ben sono le carte geografiche, che l'insigne Alfonso\nAiroldi a proprio studio e spesa feceimprimere, riguardando\nla Sicilia sotto le varie divisioni, e la vicendevole esistenza\ne nome delle città, che furono nelle antiche dominazioni e\npopoli di quest'isola;",
        "attribution": "stated"
      },
      "historically_verified": false
    },

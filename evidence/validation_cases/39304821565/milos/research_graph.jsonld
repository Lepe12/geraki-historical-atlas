      "schema:name": "{\"end_char\": 228, \"end_line\": 20, \"original_inspected\": false, \"pdf_file\": null, \"printed_page\": null, \"scan_indexes_0_based\": [150], \"source_file\": \"3163ac038f1ae187933f17af.txt\", \"start_char\": 148, \"start_line\": 19, \"url\": \"https://api.digitale-sammlungen.de/iiif/image/v2/bsb10447069_00151/full/full/0/default.jpg\"}",

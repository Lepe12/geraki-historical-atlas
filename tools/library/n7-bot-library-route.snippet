    if(p==='/api/library/search'){
      if(req.method!=='POST')return json(res,405,{error:'Method not allowed'});
      const submission=await body(req);
      const query=submission?.query;
      if(typeof query!=='string'||query.trim().length<2||query.length>150||/[\\x00-\\x1f]/.test(query)){
        return json(res,400,{error:'Invalid library query'});
      }
      const keyfile=path.join(__dirname,'.n7-library-bridge-key');
      let key;
      try{key=fs.readFileSync(keyfile);}catch(_){return json(res,503,{error:'Library bridge not installed'});}
      if(key.length!==32)return json(res,503,{error:'Library bridge unavailable'});
      const content=JSON.stringify({query:query.trim()});
      const ts=String(Math.floor(Date.now()/1000));
      const signature=crypto.createHmac('sha256',key).update(ts+'.'+content).digest('hex');
      const controller=new AbortController();
      const timer=setTimeout(()=>controller.abort(),12000);
      try {
        const upstream=await fetch('https://pct-live.piratecartography.com/pct-api/live/n7/library/search',{
          method:'POST',redirect:'error',signal:controller.signal,
          headers:{'Content-Type':'application/json','X-N7-Library-Ts':ts,'X-N7-Library-Signature':signature},
          body:content
        });
        const result=await upstream.json().catch(()=>({}));
        if(!upstream.ok)return json(res,503,{error:'Library search service unavailable'});
        if(result.schema!=='n7-library-read-v1'||!Array.isArray(result.matches))
          return json(res,503,{error:'Library response invalid'});
        return json(res,200,{schema:'n7-library-read-v1',matches:result.matches.slice(0,15),source_count:Number.isSafeInteger(result.source_count)?result.source_count:null,page_count:Number.isSafeInteger(result.page_count)?result.page_count:null,historically_verified:false});
      }catch(_){return json(res,503,{error:'Library service connection failed'});}
      finally{clearTimeout(timer);}
    }

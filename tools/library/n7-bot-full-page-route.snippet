    if(p==='/api/library/page'){
      if(req.method!=='POST')return json(res,405,{error:'Method not allowed'});
      const request=await body(req);
      const source_id=request&&request.source_id;
      const scan_index=request&&request.scan_index;
      if(typeof source_id!=='string'||!(/^[a-f0-9]{64}$/.test(source_id))||
         !Number.isSafeInteger(scan_index)||scan_index<1||scan_index>4294967295)
        return json(res,400,{error:'Invalid page reference'});
      let key;
      try{key=fs.readFileSync(path.join(__dirname,'.n7-library-bridge-key'));}
      catch(_){return json(res,503,{error:'Library bridge unavailable'});}
      if(key.length!==32)return json(res,503,{error:'Library bridge unavailable'});
      const content=JSON.stringify({source_id,scan_index});
      const ts=String(Math.floor(Date.now()/1000));
      const signature=crypto.createHmac('sha256',key).update(ts+'.'+content).digest('hex');
      const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),15000);
      try{
        const upstream=await fetch('https://pct-live.piratecartography.com/pct-api/live/n7/library/page',{
          method:'POST',redirect:'error',signal:controller.signal,
          headers:{'Content-Type':'application/json','X-N7-Library-Ts':ts,'X-N7-Library-Signature':signature},
          body:content
        });
        const result=await upstream.json().catch(()=>({}));
        if(upstream.status===404)return json(res,404,{error:'Page not found'});
        if(!upstream.ok||result.schema!=='n7-library-page-v1'||!result.page)
          return json(res,503,{error:'Library page unavailable'});
        return json(res,200,result);
      }catch(_){return json(res,503,{error:'Library connection failed'});}
      finally{clearTimeout(timer);}
    }

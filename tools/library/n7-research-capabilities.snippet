    if(req.method==='GET'&&p==='/api/research/capabilities')return json(res,200,{
      schema:'n7-historical-research-capabilities-v1',
      linked_library:true,alias_normalization:true,auto_chat_retrieval:true,
      independent_historical_verification:false,
      public_bibliography_search:'crossref-metadata-only',
      stages:['TOPONYM_NORMALIZER','LIBRARY_RETRIEVER','SOURCE_CRITIC','PUBLIC_BIBLIOGRAPHY_DISCOVERY','EVIDENCE_SYNTHESIZER'],
      pdf_upload:true
    });

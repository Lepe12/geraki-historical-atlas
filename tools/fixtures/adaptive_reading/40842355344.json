T_EVENT_DATE"},"source_pdf":null,"acquired_text_path":"travellers/library_acquisition/GreekGovernmentGazette-19970200343_19970200343_djvu.txt","finding_id":"finding-e0f5e9adb2d8733cd7bf","locator":{"url":"https://archive.org/details/GreekGovernmentGazette-19970200343","source_file":"GreekGovernmentGazette-19970200343_19970200343_djvu.txt","start_char":51818,"end_char":51871,"start_line":14018,"end_line":14032,"printed_page":null,"scan_indexes_0_based":[],"pdf_file":null,"pdf_reference_base":"LANE_ROOT","original_inspected":false},"source_text_sha256":"385cb4515ddd06286e9048825995111188da43f3ed7851638113c97b1e885caa","page_boundaries":[],"reported_archival_reference":null}],"source_independence":"UNKNOWN_NOT_ESTABLISHED","sampling_features":{"strong_region_match":true,"event_and_use_match":true,"in_scope_year_fraction":1,"title_period_hint":true,"in_scope_century_context":false,"direct_use_vocabulary":false,"conjecture_context":false,"role":"SAMPLING_HEURISTICS_NOT_HISTORICAL_VERIFICATION"}},{"evidence_id":"e-11aa987bd20405112e32","text":"It is, however, explicitly stated by Pausanias (I, 1, 1) that Patroklos fortified the \nisland and established a camp on it when he came to relieve Athens (during the \nChremonidean War, in or about 265 b.c), and this is supported by Strabo (IX, 398). \nThere can be no doubt that both ancient authors are talking about Gaidouronisi. and","similar_text_fingerprint":"54c95407503d8e78be303e50cc8e226c96183ed2d738baef0525323e92222820","years_in_scope":[],"date_basis":"UNRESOLVED","date_evidence":null,"source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"uncertainties":["ORIGINAL_NOT_INSPECTED","SOURCE_GENEALOGY_PENDING","INDEPENDENCE_UNRESOLVED","EVENT_DATE_UNRESOLVED","ACTION_UNRESOLVED"],"occurrences":[{"lane":"travellers","url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","title":"Fortified Military Camps in Attica","source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"source_pdf":null,"acquired_text_path":"travellers/library_acquisition/bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","finding_id":"finding-50952a302851397f7957","locator":{"url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","source_file":"bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","start_char":74601,"end_char":74935,"start_line":1996,"end_line":1999,"printed_page":null,"scan_indexes_0_based":[],"pdf_file":null,"pdf_reference_base":"LANE_ROOT","original_inspected":false},"source_text_sha256":"4e38679bd61083c73a7ab542c62c34030daca0382c6bc49507369495e1cbf4fe","page_boundaries":[],"reported_archival_reference":null}],"source_independence":"UNKNOWN_NOT_ESTABLISHED","sampling_features":{"strong_region_match":true,"event_and_use_match":true,"in_scope_year_fraction":0,"title_period_hint":true,"in_scope_century_context":false,"direct_use_vocabulary":false,"conjecture_context":false,"role":"SAMPLING_HEURISTICS_NOT_HISTORICAL_VERIFICATION"}},{"evidence_id":"e-433ea58d39f3d6d71499","text":"Two fortifications in Attica have been almost certainly identified as military \ncamps; the walls on Gaidouronisi (Patroklos Island) are, on grounds of literary \nevidence, surely those of the camp established by Patroklos during the Chremonidean \nWar, and Koroni, on the evidence of historical situation and the coins found, is another \ncamp established during the same war by the same commander. 1 *","similar_text_fingerprint":"c42dcb734dfd67e2367880e562787adb1c5049d6d32409c82ac7933a6a0b45a9","years_in_scope":[],"date_basis":"UNRESOLVED","date_evidence":null,"source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"uncertainties":["ORIGINAL_NOT_INSPECTED","SOURCE_GENEALOGY_PENDING","INDEPENDENCE_UNRESOLVED","EVENT_DATE_UNRESOLVED","ACTION_UNRESOLVED"],"occurrences":[{"lane":"travellers","url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","title":"Fortified Military Camps in Attica","source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"source_pdf":null,"acquired_text_path":"travellers/library_acquisition/bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","finding_id":"finding-683275950d62f0784f96","locator":{"url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","source_file":"bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","start_char":278221,"end_char":278620,"start_line":6102,"end_line":6106,"printed_page":null,"scan_indexes_0_based":[],"pdf_file":null,"pdf_reference_base":"LANE_ROOT","original_inspected":false},"source_text_sha256":"4e38679bd61083c73a7ab542c62c34030daca0382c6bc49507369495e1cbf4fe","page_boundaries":[],"reported_archival_reference":null}],"source_independence":"UNKNOWN_NOT_ESTABLISHED","sampling_features":{"strong_region_match":true,"event_and_use_match":true,"in_scope_year_fraction":0,"title_period_hint":true,"in_scope_century_context":false,"direct_use_vocabulary":false,"conjecture_context":false,"role":"SAMPLING_HEURISTICS_NOT_HISTORICAL_VERIFICATION"}},{"evidence_id":"e-470e8409c30ae5bcb453","text":"fleet ; he established his forces at convenient and useful points along the Attic coast. \nOnly Piraeus and Sounion appear to have been closed to him, and he took over other \ngood harbors such as Vouliagmeni and Porto Raphti (Koroni), as well as establishing \na small camp on Gaidouronisi to keep watch on Sounion. Cooperation between Athen- \nians and Patroklos was good, and the hipparch Epichares saw to the requirements of \nsome of Patroklos's forces at Rhamnous.","similar_text_fingerprint":"4b9e00c3cda39ee9f0c40a40cf832e0e2f7fb6ca997751d9b04124a876f54a4c","years_in_scope":[],"date_basis":"UNRESOLVED","date_evidence":null,"source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"uncertainties":["ORIGINAL_NOT_INSPECTED","SOURCE_GENEALOGY_PENDING","INDEPENDENCE_UNRESOLVED","EVENT_DATE_UNRESOLVED","ACTION_UNRESOLVED"],"occurrences":[{"lane":"travellers","url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","title":"Fortified Military Camps in Attica","source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"source_pdf":null,"acquired_text_path":"travellers/library_acquisition/bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","finding_id":"finding-f62f0dbaf9faf5dd2157","locator":{"url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","source_file":"bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","start_char":318542,"end_char":319007,"start_line":6847,"end_line":6852,"printed_page":null,"scan_indexes_0_based":[],"pdf_file":null,"pdf_reference_base":"LANE_ROOT","original_inspected":false},"source_text_sha256":"4e38679bd61083c73a7ab542c62c34030daca0382c6bc49507369495e1cbf4fe","page_boundaries":[],"reported_archival_reference":null}],"source_independence":"UNKNOWN_NOT_ESTABLISHED","sampling_features":{"strong_region_match":true,"event_and_use_match":true,"in_scope_year_fraction":0,"title_period_hint":true,"in_scope_century_context":false,"direct_use_vocabulary":false,"conjecture_context":false,"role":"SAMPLING_HEURISTICS_NOT_HISTORICAL_VERIFICATION"}},{"evidence_id":"e-c00927b99400ee595000","text":"Gaidouronisi is a small, rocky, and barren island extending about 2.5 kilometers \nfrom east to west and 1.5 kilometers from north to south (Fig. 2). 9 A long, high \nridge runs the length of the island from east to west; on the south it falls in steep \ncliffs to the sea, offering little hospitable or even habitable area, but on the north the \nslopes are more gradual, and near the sea there are several nearly flat areas. It is \non this side that ancient habitation is to be sought.","similar_text_fingerprint":"2380aa10f4b2b008746f9999d63b7ba6596077a51d906ace34a2bc8bacfe189b","years_in_scope":[],"date_basis":"UNRESOLVED","date_evidence":null,"source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"uncertainties":["ORIGINAL_NOT_INSPECTED","SOURCE_GENEALOGY_PENDING","INDEPENDENCE_UNRESOLVED","EVENT_DATE_UNRESOLVED","ACTION_UNRESOLVED"],"occurrences":[{"lane":"travellers","url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","title":"Fortified Military Camps in Attica","source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"source_pdf":null,"acquired_text_path":"travellers/library_acquisition/bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","finding_id":"finding-2e57b2d982fdfc82fe5f","locator":{"url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","source_file":"bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","start_char":61059,"end_char":61542,"start_line":1676,"end_line":1681,"printed_page":null,"scan_indexes_0_based":[],"pdf_file":null,"pdf_reference_base":"LANE_ROOT","original_inspected":false},"source_text_sha256":"4e38679bd61083c73a7ab542c62c34030daca0382c6bc49507369495e1cbf4fe","page_boundaries":[],"reported_archival_reference":null}],"source_independence":"UNKNOWN_NOT_ESTABLISHED","sampling_features":{"strong_region_match":true,"event_and_use_match":true,"in_scope_year_fraction":0,"title_period_hint":true,"in_scope_century_context":false,"direct_use_vocabulary":false,"conjecture_context":false,"role":"SAMPLING_HEURISTICS_NOT_HISTORICAL_VERIFICATION"}},{"evidence_id":"e-7559f7e816d262ead00e","text":"In addition to the long known site on Gaidouronisi which must be the Patroklou \nCharax of Pausanias and Strabo ( Pausanias, 1,1,1; Strabo, IX, 398) , three additional \nsites have yielded coins and other objects which connect them with the Giremonidean \nwar. Of these, Koroni was certainly a Ptolemaic camp, perhaps the principal camp, \nto judge from its size ; the Ptolemaic establishment at Vouliagmeni can probably be \nconnected with the walls there and be identified as another coastal camp; that there \nwas an establishment at Helioupolis is certain, but its exact nature is now uncertain.","similar_text_fingerprint":"d34c74f2eaf31aa2e581de6dd3b1ada6a8187d2aa5bbb5283e8881ca2866d52b","years_in_scope":[],"date_basis":"UNRESOLVED","date_evidence":null,"source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"uncertainties":["ORIGINAL_NOT_INSPECTED","SOURCE_GENEALOGY_PENDING","INDEPENDENCE_UNRESOLVED","EVENT_DATE_UNRESOLVED","ACTION_UNRESOLVED","SOURCE_EXPRESSES_UNCERTAINTY"],"occurrences":[{"lane":"travellers","url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","title":"Fortified Military Camps in Attica","source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"source_pdf":null,"acquired_text_path":"travellers/library_acquisition/bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","finding_id":"finding-330323471e0787871d1b","locator":{"url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","source_file":"bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","start_char":309610,"end_char":310203,"start_line":6686,"end_line":6692,"printed_page":null,"scan_indexes_0_based":[],"pdf_file":null,"pdf_reference_base":"LANE_ROOT","original_inspected":false},"source_text_sha256":"4e38679bd61083c73a7ab542c62c34030daca0382c6bc49507369495e1cbf4fe","page_boundaries":[],"reported_archival_reference":null}],"source_independence":"UNKNOWN_NOT_ESTABLISHED","sampling_features":{"strong_region_match":true,"event_and_use_match":true,"in_scope_year_fraction":0,"title_period_hint":true,"in_scope_century_context":false,"direct_use_vocabulary":false,"conjecture_context":true,"role":"SAMPLING_HEURISTICS_NOT_HISTORICAL_VERIFICATION"}},{"evidence_id":"e-b1f69ceddbe02a6a99b4","text":"territory outside the city. Patroklos arrived in Attic waters, established his camp on \nGaidouronisi, and held control of the sea. Areus marched out with his Peloponnesian \nforces and advanced as far as Corinth, where his way was blocked by the Macedonian \ngarrison in Acrocorinth. A stalemate had been reached, and when Areus's supplies \nran low, he led his forces back to Sparta. The failure of Patroklos to use his fleet to \ntransport the Peloponnesian troops to Attica by sea around the garrison in Acro- \ncorinth has been seen as the result of Antigonos's control of the harbors of Attica; \nthere would have been no place for the Peloponnesians to disembark.","similar_text_fingerprint":"a613bcc398d2c8616ba50dfeaa3ff92fa0778ced045361c0b07af4e80b78f1e2","years_in_scope":[],"date_basis":"UNRESOLVED","date_evidence":null,"source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"uncertainties":["ORIGINAL_NOT_INSPECTED","SOURCE_GENEALOGY_PENDING","INDEPENDENCE_UNRESOLVED","EVENT_DATE_UNRESOLVED","ACTION_UNRESOLVED"],"occurrences":[{"lane":"travellers","url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","title":"Fortified Military Camps in Attica","source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"source_pdf":null,"acquired_text_path":"travellers/library_acquisition/bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","finding_id":"finding-ad9997d64073ee952fae","locator":{"url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","source_file":"bub_gb_4HMnL8yvbc4C_bub_gb_4HMnL8yvbc4C_djvu.txt","start_char":311917,"end_char":312580,"start_line":6735,"end_line":6742,"printed_page":null,"scan_indexes_0_based":[],"pdf_file":null,"pdf_reference_base":"LANE_ROOT","original_inspected":false},"source_text_sha256":"4e38679bd61083c73a7ab542c62c34030daca0382c6bc49507369495e1cbf4fe","page_boundaries":[],"reported_archival_reference":null}],"source_independence":"UNKNOWN_NOT_ESTABLISHED","sampling_features":{"strong_region_match":true,"event_and_use_match":true,"in_scope_year_fraction":0,"title_period_hint":true,"in_scope_century_context":false,"direct_use_vocabulary":true,"conjecture_context":false,"role":"SAMPLING_HEURISTICS_NOT_HISTORICAL_VERIFICATION"}},{"evidence_id":"e-7a889564dc36bf32c348","text":"Gaidouronisi, 18-25. 98-99. 109-110. 112; see \nalso Patroklos Island Garrison forts, 33. note \n37, 58, 81-84. 87-93. 103-106; see also \nForeign garrisons","similar_text_fingerprint":"52949d0283169a9a4fba7a387ecbdb1b4ee025a0c8236db386b1281c511e85bf","years_in_scope":[],"date_basis":"UNRESOLVED","date_evidence":null,"source_bibliography":{"creator":["James R. McCredie"],"date":["1966-01-01T00:00:00Z"],"source_type":"OCR_CONTEXT","rights":null,"date_field_meaning":"PUBLICATION_OR_CATALOGUE_METADATA_NOT_EVENT_DATE"},"uncertainties":["ORIGINAL_NOT_INSPECTED","SOURCE_GENEALOGY_PENDING","INDEPENDENCE_UNRESOLVED","EVENT_DATE_UNRESOLVED","ACTION_UNRESOLVED"],"occurrences":[{"lane":"travellers","url":"https://archive.org/details/bub_gb_4HMnL8yvbc4C","title":"Fortified Military Camps in Attica","source_bibliography":{"creator"
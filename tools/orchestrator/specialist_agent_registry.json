{
  "schema": "pct-specialist-agent-registry-v1",
  "agents": {
    "pirate_base": {
      "label": "Pirate Base / Anchorage Agent",
      "task_kinds": [
        "place",
        "base",
        "anchorage"
      ],
      "priority": 10,
      "max_queries": 8,
      "query_families": [
        "{target} pirate base corsair base anchorage harbour refuge",
        "{target} pirates corsairs provisioning repairs captives ransom",
        "{target} historical harbour anchorage fort cave island piracy",
        "{target} {date_range} pirates corsairs"
      ],
      "outputs": [
        "base_classification",
        "use_frequency",
        "logistics",
        "actors",
        "date_ranges",
        "evidence_gaps"
      ],
      "source_routes": [
        "registry:moreveneto_browser",
        "repo:SearchCulture.gr / EKT",
        "repo:Internet Culturale",
        "repo:İSAM Kütüphanesi",
        "repo:PARES / Archivo General de Simancas",
        "repo:Gallica/BnF"
      ]
    },
    "pirate_biography": {
      "label": "Pirate Biography Agent",
      "task_kinds": [
        "person",
        "biography"
      ],
      "priority": 10,
      "max_queries": 10,
      "query_families": [
        "\"{target}\" pirate corsair biography",
        "\"{target}\" aliases ships associates",
        "\"{target}\" {date_range} archive",
        "\"{target}\" death capture trial ransom",
        "\"{target}\" patron commission privateer corsair"
      ],
      "outputs": [
        "identity",
        "aliases",
        "chronology",
        "ships",
        "associates",
        "bases",
        "operations",
        "death",
        "uncertainties"
      ],
      "source_routes": [
        "repo:PARES / Archivo General de Simancas",
        "repo:Biblioteca Digital Hispánica",
        "repo:Gallica/BnF",
        "repo:The National Archives Public Content",
        "repo:Nationaal Archief",
        "repo:Archives diplomatiques France"
      ]
    },
    "identity_resolution": {
      "label": "Identity Resolution Agent",
      "task_kinds": [
        "person",
        "place",
        "all"
      ],
      "priority": 20,
      "max_queries": 8,
      "query_families": [
        "\"{target}\" variant spelling",
        "\"{target}\" alias OR aliases",
        "\"{target}\" historical name",
        "\"{target}\" transliteration"
      ],
      "outputs": [
        "entity_candidates",
        "variant_names",
        "same_entity_assessment",
        "collision_warnings"
      ],
      "source_routes": [
        "repo:SearchCulture.gr / EKT",
        "repo:Gallica/BnF",
        "repo:Internet Culturale",
        "repo:Biblioteca Digital Hispánica",
        "repo:Nationaal Archief",
        "repo:Delpher"
      ]
    },
    "timeline": {
      "label": "Timeline Consistency Agent",
      "task_kinds": [
        "person",
        "place",
        "event",
        "all"
      ],
      "priority": 20,
      "max_queries": 8,
      "query_families": [
        "\"{target}\" {date_range}",
        "\"{target}\" chronology",
        "\"{target}\" dated letter report",
        "\"{target}\" voyage operation"
      ],
      "outputs": [
        "dated_events",
        "chronology_conflicts",
        "gaps",
        "impossible_overlaps"
      ],
      "source_routes": [
        "repo:PARES / Archivo General de Simancas",
        "repo:Archives diplomatiques France",
        "repo:The National Archives Public Content",
        "repo:Gallica/BnF",
        "repo:Nationaal Archief",
        "repo:İSAM Kütüphanesi"
      ]
    },
    "relationship_network": {
      "label": "Relationship Network Agent",
      "task_kinds": [
        "person",
        "place",
        "all"
      ],
      "priority": 30,
      "max_queries": 8,
      "query_families": [
        "\"{target}\" associates captain crew",
        "\"{target}\" ship vessel patron",
        "\"{target}\" port base ally enemy",
        "\"{target}\" governor consul merchant"
      ],
      "outputs": [
        "persons",
        "ships",
        "places",
        "patrons",
        "states",
        "relationship_edges"
      ],
      "source_routes": [
        "repo:PARES / Archivo General de Simancas",
        "repo:Archives diplomatiques France",
        "registry:moreveneto_browser",
        "repo:Internet Culturale",
        "repo:The National Archives Public Content",
        "repo:Nationaal Archief"
      ]
    },
    "contradiction": {
      "label": "Contradiction / Adversarial Agent",
      "task_kinds": [
        "person",
        "place",
        "event",
        "all"
      ],
      "priority": 40,
      "max_queries": 8,
      "query_families": [
        "\"{target}\" disputed",
        "\"{target}\" contradiction",
        "\"{target}\" alternative account",
        "\"{target}\" myth legend false"
      ],
      "outputs": [
        "contradicting_evidence",
        "alternative_explanations",
        "uncertainties",
        "falsification_leads"
      ],
      "source_routes": [
        "repo:Gallica/BnF",
        "repo:The National Archives Public Content",
        "repo:PARES / Archivo General de Simancas",
        "repo:Archives diplomatiques France",
        "repo:Nationaal Archief",
        "repo:İSAM Kütüphanesi"
      ]
    },
    "source_genealogy": {
      "label": "Source Genealogy Agent",
      "task_kinds": [
        "person",
        "place",
        "event",
        "all"
      ],
      "priority": 40,
      "max_queries": 6,
      "query_families": [
        "\"{target}\" cited by",
        "\"{target}\" bibliography sources",
        "\"{target}\" edition translation",
        "\"{target}\" chronicle manuscript"
      ],
      "outputs": [
        "source_chains",
        "derivative_sources",
        "independence_warnings",
        "primary_source_targets"
      ],
      "source_routes": [
        "repo:Gallica/BnF",
        "repo:Biblioteca Digital Hispánica",
        "repo:The National Archives Public Content",
        "repo:Internet Culturale",
        "repo:Delpher",
        "repo:Deutsche Digitale Bibliothek"
      ]
    }
  },
  "rules": [
    "Specialist agents complement, not replace, the ten geographic/archive lanes.",
    "Specialist agents run in parallel and may use the connector registry for discovery.",
    "No specialist agent may promote a claim to VERIFIED.",
    "Identity, chronology, relationships and contradictions remain claim-level review outputs.",
    "Specialist source routing is deterministic, context-aware and auditable; routing priority is discovery metadata only and has no evidence effect."
  ]
}
